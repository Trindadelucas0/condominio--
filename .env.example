# Configuração do Banco de Dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/condominio_db

# Chave secreta para JWT (gerar uma chave forte em produção)
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_mude_em_producao

# Porta do servidor
PORT=3300

# Ambiente (development, production)
NODE_ENV=development

# Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=220
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_MS=12000
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_MONTHLY_TOKEN_LIMIT=120000
GEMINI_PER_MINUTE_LIMIT=2

# IA no relatório
REPORT_AI_ENABLED=true
REPORT_AI_MIN_ANOMALY_PERCENT=25
REPORT_DEFAULT_TZ=America/Sao_Paulo

# Email
REPORT_EMAIL_ENABLED=true
RESEND_API_KEY=sua_chave_resend_aqui
RESEND_FROM_EMAIL=relatorios@seu-dominio-verificado.com
RESEND_FROM_NAME=Sistema Condominio
TEST_TO_EMAIL=seu-email@dominio.com
