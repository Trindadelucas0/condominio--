            <span class="text-gray-600">Aprovados</span>
            <span class="font-bold text-green-700"><%= budgetsStats.aprovados || 0 %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Rejeitados</span>
            <span class="font-bold text-red-700"><%= budgetsStats.rejeitados || 0 %></span>
          </div>
          <div class="pt-2 border-t border-gray-300">
            <div class="flex justify-between">
              <span class="text-sm font-semibold text-gray-700">Total</span>
              <span class="text-sm font-bold text-gray-900"><%= budgetsStats.total || 0 %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Últimas Transações -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Últimas Entradas -->
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.3s">
        <div class="flex items-center space-x-3 mb-4">
          <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg p-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">Entradas recebidas no período</h2>
        </div>
        <div class="space-y-3 max-h-96 overflow-y-auto">
          <% if (recentEntries && recentEntries.length > 0) { %>
            <% recentEntries.forEach(entry => { %>
            <div class="p-4 bg-gray-50 rounded-lg border-l-2 border-green-500">
              <div class="flex justify-between items-start mb-2">
                <div class="flex-1">
                  <p class="font-semibold text-gray-900 text-sm"><%= entry.description %></p>
                  <p class="text-xs text-gray-500 mt-1">
                    <%= new Date(entry.entry_date).toLocaleDateString('pt-BR') %> • 
                    <%= (typeof categoryLabels !== 'undefined' && categoryLabels[entry.category]) ? categoryLabels[entry.category] : (entry.category || 'TAXA') %>
                  </p>
                </div>
                <span class="text-lg font-bold text-green-700 ml-4">
                  R$ <%= parseFloat(entry.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </span>
              </div>
              <div class="flex items-center justify-between mt-2">
                <span class="text-xs px-2 py-1 rounded-full <%= entry.received ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= entry.received ? '✓ Recebido' : '⏳ Pendente' %>
                </span>
                <% if (entry.receipt_pdf_path) { 
                  // Garantir que o caminho começa com /uploads
                  let pdfPath = entry.receipt_pdf_path.trim();
                  // Se não começa com /, adiciona
                  if (!pdfPath.startsWith('/')) {
                    pdfPath = '/' + pdfPath;
                  }
                  // Se não começa com /uploads, adiciona
                  if (!pdfPath.startsWith('/uploads')) {
                    // Remove / inicial se existir e adiciona /uploads
                    pdfPath = '/uploads' + (pdfPath.startsWith('/') ? pdfPath : '/' + pdfPath);
                  }
                %>
                <a 
                  href="<%= pdfPath %>" 
                  target="_blank"
                  class="text-xs px-3 py-1 bg-blue-100 text-blue-700 rounded-full hover:bg-blue-200 transition-colors inline-flex items-center space-x-1"
                  title="Visualizar comprovante PDF"
                  onclick="event.stopPropagation();"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <span>Ver PDF</span>
                </a>
                <% } %>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <p class="text-center text-gray-500 py-8">Nenhuma entrada registrada para o período selecionado</p>
          <% } %>
        </div>
      </div>

      <!-- Últimas Saídas -->
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.4s">
        <div class="flex items-center space-x-3 mb-4">
          <div class="bg-gradient-to-br from-red-500 to-rose-600 rounded-lg p-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">Saídas pagas no período</h2>
        </div>
        <div class="space-y-3 max-h-96 overflow-y-auto">
          <% if (recentExits && recentExits.length > 0) { %>
            <% 
              const statusColors = {
                'PAID': 'bg-green-100 text-green-700',
                'APPROVED': 'bg-blue-100 text-blue-700',
                'PENDING': 'bg-yellow-100 text-yellow-700',
                'REJECTED': 'bg-red-100 text-red-700'
              };
              const statusLabels = {
                'PAID': '✓ Pago',
                'APPROVED': '✓ Aprovado',
                'PENDING': '⏳ Pendente',
                'REJECTED': '✗ Rejeitado'
              };
            %>
            <% recentExits.forEach(exit => { %>
            <div class="p-4 bg-gray-50 rounded-lg border-l-2 border-red-500">
              <div class="flex justify-between items-start mb-2">
                <div class="flex-1">
                  <p class="font-semibold text-gray-900 text-sm"><%= exit.description %></p>
                  <p class="text-xs text-gray-500 mt-1">
                    <%= new Date(exit.exit_date).toLocaleDateString('pt-BR') %> • 
                    <%= (typeof categoryLabels !== 'undefined' && categoryLabels[exit.category]) ? categoryLabels[exit.category] : (exit.category || 'OUTRA') %>
                  </p>
                </div>
                <span class="text-lg font-bold text-red-700 ml-4">
                  R$ <%= parseFloat(exit.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </span>
              </div>
              <div class="flex items-center justify-between mt-2">
                <span class="text-xs px-2 py-1 rounded-full <%= statusColors[exit.payment_status] || 'bg-gray-100 text-gray-700' %>">
                  <%= statusLabels[exit.payment_status] || exit.payment_status %>
                </span>
                <% if (exit.payment_receipt_pdf_path) { 
                  // Garantir que o caminho começa com /uploads
                  let pdfPath = exit.payment_receipt_pdf_path.trim();
                  // Se não começa com /, adiciona
                  if (!pdfPath.startsWith('/')) {
                    pdfPath = '/' + pdfPath;
                  }
                  // Se não começa com /uploads, adiciona
                  if (!pdfPath.startsWith('/uploads')) {
                    // Remove / inicial se existir e adiciona /uploads
                    pdfPath = '/uploads' + (pdfPath.startsWith('/') ? pdfPath : '/' + pdfPath);
                  }
                %>
                <a 
                  href="<%= pdfPath %>" 
                  target="_blank"
                  class="text-xs px-3 py-1 bg-blue-100 text-blue-700 rounded-full hover:bg-blue-200 transition-colors inline-flex items-center space-x-1"
                  title="Visualizar comprovante PDF"
                  onclick="event.stopPropagation();"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <span>Ver PDF</span>
                </a>
                <% } %>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <p class="text-center text-gray-500 py-8">Nenhuma saída registrada para o período selecionado</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Gastos por Categoria -->
    <% if (expensesByCategory && expensesByCategory.length > 0) { %>
    <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.5s">
      <div class="flex items-center space-x-3 mb-6">
        <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg p-2">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
          <h2 class="text-xl font-bold text-gray-900">Gastos por Categoria</h2>
          <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full font-medium">Período selecionado</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% expensesByCategory.forEach((cat, index) => { %>
        <div class="p-4 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl border-l-2 border-indigo-500">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900"><%= (typeof categoryLabels !== 'undefined' && categoryLabels[cat.category]) ? categoryLabels[cat.category] : (cat.category || 'Outras') %></span>
            <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded-full"><%= cat.quantidade %> transações</span>
          </div>
          <p class="text-2xl font-bold text-indigo-700">
            R$ <%= parseFloat(cat.total).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
          </p>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Previsões -->
    <% if (typeof analytics !== 'undefined' && analytics.projections && analytics.projections.length > 0) { %>
    <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.6s">
      <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-lg p-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">Previsões Financeiras</h2>
        </div>
        <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">Próximos 3 meses</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% analytics.projections.forEach((proj, index) => { %>
        <div class="border border-l-2 p-4 rounded-lg <%= proj.projectedBalance >= 0 ? 'border-green-300 border-l-green-500 bg-green-50' : 'border-red-300 border-l-red-500 bg-red-50' %>">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-900"><%= proj.label %></h3>
            <span class="text-sm font-bold <%= proj.projectedBalance >= 0 ? 'text-green-700' : 'text-red-700' %>">
              R$ <%= proj.projectedBalance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs mt-3">
            <div>
              <span class="text-gray-600">Entradas:</span>
              <span class="font-semibold text-green-700 ml-1 block">R$ <%= proj.projectedEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
            </div>
            <div>
              <span class="text-gray-600">Saídas:</span>
              <span class="font-semibold text-red-700 ml-1 block">R$ <%= proj.projectedExits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
  
  <!-- Rodapé para impressão -->
  <div class="print-footer">
    <p><strong><%= condominiumName %></strong> - Relatório de Prestação de Contas</p>
    <p>Período: <%= typeof filterDateForPrint !== 'undefined' ? filterDateForPrint : (filterDate || new Date().toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })) %> | 
       Gerado em: <%= new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
    <p class="text-xs mt-2">Este relatório foi gerado automaticamente pelo sistema de gestão condominial.</p>
  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  // Função para lidar com mudança de período
  function handlePeriodChange() {
    const periodSelect = document.getElementById('periodFilter');
    const dateInput = document.getElementById('dateFilter');
    const selectedPeriod = periodSelect.value;
    
    // Mostrar/esconder input de data baseado na seleção
    if (selectedPeriod === 'custom') {
      dateInput.classList.remove('hidden');
      dateInput.focus();
    } else {
      dateInput.classList.add('hidden');
      // Aplicar filtro imediatamente
      applyPeriodFilter(selectedPeriod);
    }
  }

  // Função para aplicar filtro de período
  function applyPeriodFilter(period) {
    window.location.href = `/conselho/dashboard?period=${period}`;
  }

  // Função para filtrar por data (quando período é customizado)
  function filterByDate() {
    const dateInput = document.getElementById('dateFilter');
    const selectedDate = dateInput.value;
    const periodSelect = document.getElementById('periodFilter');
    
    if (selectedDate && periodSelect.value === 'custom') {
      window.location.href = `/conselho/dashboard?date=${selectedDate}&period=custom`;
    }
  }

  // Função para atualizar dashboard
  function refreshDashboard() {
    const periodSelect = document.getElementById('periodFilter');
    const dateInput = document.getElementById('dateFilter');
    const selectedPeriod = periodSelect.value;
    
    if (selectedPeriod === 'custom' && dateInput.value) {
      window.location.href = `/conselho/dashboard?date=${dateInput.value}&period=custom`;
    } else if (selectedPeriod !== 'custom') {
      window.location.href = `/conselho/dashboard?period=${selectedPeriod}`;
    } else {
      window.location.reload();
    }
  }

  // Atualizar label do período selecionado
  function updatePeriodLabel() {
    const periodSelect = document.getElementById('periodFilter');
    const dateInput = document.getElementById('dateFilter');
    const labelElement = document.getElementById('selectedPeriodLabel');
    
    if (!labelElement) return;
    
    const selectedPeriod = periodSelect.value;
    let label = '';
    
    if (selectedPeriod === 'custom' && dateInput.value) {
      const date = new Date(dateInput.value + '-01');
      label = date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
    } else if (selectedPeriod === 'all') {
      label = 'Todos os períodos';
    } else {
      const now = new Date();
      switch(selectedPeriod) {
        case 'current':
          label = now.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
          break;
        case 'last':
          const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
          label = lastMonth.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
          break;
        case 'quarter':
          const quarter = Math.floor(now.getMonth() / 3) + 1;
          label = `${quarter}º Trimestre de ${now.getFullYear()}`;
          break;
        case 'semester':
          const semester = now.getMonth() < 6 ? 1 : 2;
          label = `${semester}º Semestre de ${now.getFullYear()}`;
          break;
        case 'year':
          label = `Ano de ${now.getFullYear()}`;
          break;
        case 'last-year':
          label = `Ano de ${now.getFullYear() - 1}`;
          break;
        default:
          label = now.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      }
    }
    
    labelElement.textContent = label;
  }

  // Atualizar label quando a página carregar
  document.addEventListener('DOMContentLoaded', function() {
    updatePeriodLabel();
    
    // Atualizar label quando o período ou data mudar
    document.getElementById('periodFilter')?.addEventListener('change', updatePeriodLabel);
    document.getElementById('dateFilter')?.addEventListener('change', updatePeriodLabel);
  });

  // Auto-refresh a cada 5 minutos
  setInterval(() => {
    refreshDashboard();
  }, 300000); // 5 minutos

  <% if (typeof analytics !== 'undefined' && analytics.historical && analytics.historical.length > 0) { %>
  // Gráfico de Evolução Histórica
  const historicalCtx = document.getElementById('historicalChart');
  if (historicalCtx) {
    const historicalData = <%- JSON.stringify(analytics.historical) %>;
    
    new Chart(historicalCtx, {
      type: 'line',
      data: {
        labels: historicalData.map(d => d.label),
        datasets: [
          {
            label: 'Entradas',
            data: historicalData.map(d => parseFloat(d.entries || 0)),
            borderColor: 'rgb(34, 197, 94)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          },
          {
            label: 'Saídas',
            data: historicalData.map(d => parseFloat(d.exits || 0)),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          },
          {
            label: 'Saldo',
            data: historicalData.map(d => parseFloat(d.balance || 0)),
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 15,
              font: { size: 12, weight: 'bold' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            cornerRadius: 12,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: false,
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }
  <% } %>

  <% if (typeof analytics !== 'undefined' && analytics.categoryData && analytics.categoryData.exits && analytics.categoryData.exits.length > 0) { %>
  // Gráfico de Categorias
  const categoryCtx = document.getElementById('categoryChart');
  if (categoryCtx) {
    const categoryData = <%- JSON.stringify(analytics.categoryData.exits) %>;
    const categoryLabelsMap = <%- JSON.stringify(typeof categoryLabels !== 'undefined' ? categoryLabels : {}) %>;
    
    const colors = [
      'rgba(239, 68, 68, 0.8)',
      'rgba(59, 130, 246, 0.8)',
      'rgba(139, 92, 246, 0.8)',
      'rgba(251, 191, 36, 0.8)',
      'rgba(34, 197, 94, 0.8)',
      'rgba(236, 72, 153, 0.8)',
      'rgba(20, 184, 166, 0.8)',
      'rgba(245, 158, 11, 0.8)'
    ];

    new Chart(categoryCtx, {
      type: 'doughnut',
      data: {
        labels: categoryData.map(d => categoryLabelsMap[d.category] || d.category || 'Outras'),
        datasets: [{
          label: 'Gastos por Categoria',
          data: categoryData.map(d => parseFloat(d.total || 0)),
          backgroundColor: categoryData.map((d, i) => colors[i % colors.length]),
          borderWidth: 3,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              padding: 15,
              font: { size: 11, weight: 'bold' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            cornerRadius: 12,
            callbacks: {
              label: function(context) {
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percent = ((context.parsed / total) * 100).toFixed(1);
                return context.label + ': R$ ' + context.parsed.toLocaleString('pt-BR', {minimumFractionDigits: 2}) + ' (' + percent + '%)';
              }
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }
  <% } %>
</script>

<%- include('../partials/footer') %>
