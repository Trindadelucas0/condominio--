            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900">Assembleias</h3>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Agendadas</span>
            <span class="font-bold text-blue-700"><%= assembliesStats.agendadas || 0 %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Em Andamento</span>
            <span class="font-bold text-yellow-700"><%= assembliesStats.em_andamento || 0 %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Concluídas</span>
            <span class="font-bold text-green-700"><%= assembliesStats.concluidas || 0 %></span>
          </div>
          <div class="pt-2 border-t border-gray-300">
            <div class="flex justify-between">
              <span class="text-sm font-semibold text-gray-700">Total</span>
              <span class="text-sm font-bold text-gray-900"><%= assembliesStats.total || 0 %></span>
            </div>
          </div>
        </div>
      </div>

