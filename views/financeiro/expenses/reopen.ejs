<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Reabrir Despesa Rejeitada</h1>
    <p class="text-gray-600 mt-2">Criar nova despesa baseada na rejeitada</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/financeiro/despesas/<%= rejectedExpenseId %>/reabrir">
      <div class="mb-4">
        <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">
          Motivo da Reabertura <span class="text-red-500">*</span>
        </label>
        <textarea id="reason" name="reason" required rows="4"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="Explique por que esta despesa deve ser reaberta..."></textarea>
      </div>

      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Nova Descrição
        </label>
        <input type="text" id="description" name="description"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div class="mb-4">
        <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">
          Novo Valor (R$)
        </label>
        <input type="number" id="amount" name="amount" step="0.01" min="0"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div class="flex justify-end space-x-4">
        <a href="/financeiro/saidas" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
          Cancelar
        </a>
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
          Reabrir Despesa
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
