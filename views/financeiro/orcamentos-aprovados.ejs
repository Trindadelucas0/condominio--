<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Orçamentos Aprovados</h1>
  <p class="text-gray-600 mb-6">Conferir e liberar orçamentos aprovados pelo síndico</p>

  <% if (typeof req !== 'undefined' && req.query.success === 'released') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Orçamento liberado para o operacional!
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.success === 'returned') { %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
      Orçamento retornado para o síndico revisar.
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <% if (budgets && budgets.length > 0) { %>
    <div class="space-y-4">
      <% budgets.forEach(budget => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-800"><%= budget.title %></h3>
              <p class="text-gray-600 mt-2"><%= budget.description %></p>
              <div class="mt-2 text-sm text-gray-500">
                <p>Criado por: <%= budget.requested_by_name %></p>
                <% if (budget.estimated_value) { %>
                  <p>Valor solicitado: R$ <%= parseFloat(budget.estimated_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                <% } %>
                <% if (budget.budget_approved_amount) { %>
                  <p class="font-semibold text-green-600">Valor aprovado: R$ <%= parseFloat(budget.budget_approved_amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                <% } %>
                <% if (budget.sindico_notes) { %>
                  <div class="mt-2 bg-blue-50 border border-blue-200 rounded p-2">
                    <p class="text-xs font-semibold text-blue-800">Observações do Síndico:</p>
                    <p class="text-xs text-blue-700"><%= budget.sindico_notes %></p>
                  </div>
                <% } %>
                <% if (budget.financeiro_notes) { %>
                  <div class="mt-2 bg-gray-50 border border-gray-200 rounded p-2">
                    <p class="text-xs font-semibold text-gray-800">Observações do Financeiro:</p>
                    <p class="text-xs text-gray-700"><%= budget.financeiro_notes %></p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="border-t pt-4 flex space-x-4">
            <form method="POST" action="/financeiro/orcamentos/<%= budget.id %>/liberar" class="flex-1">
              <div class="mb-2">
                <label class="block text-sm text-gray-700 mb-1">Observações Adicionais (opcional)</label>
                <textarea name="financeiroNotes" rows="2" class="w-full border rounded px-3 py-2 text-sm"></textarea>
              </div>
              <button type="submit" class="w-full bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                Liberar para Operacional
              </button>
            </form>
            <form method="POST" action="/financeiro/orcamentos/<%= budget.id %>/retornar" class="flex-1">
              <div class="mb-2">
                <label class="block text-sm text-gray-700 mb-1">Motivo do Retorno *</label>
                <textarea name="financeiroNotes" rows="2" required class="w-full border rounded px-3 py-2 text-sm"></textarea>
              </div>
              <button type="submit" class="w-full bg-yellow-600 text-white px-6 py-2 rounded hover:bg-yellow-700">
                Retornar para Síndico
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <p class="text-gray-500 text-lg">Nenhum orçamento aprovado aguardando liberação</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
