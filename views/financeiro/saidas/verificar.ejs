<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-indigo-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Verificar e completar saída'; %>
    <% var resumo = ['Complete os dados da saída gerada a partir do orçamento aprovado.', 'Informe conta, centro de custo e anexe comprovante se necessário.', 'Após verificar, a saída segue para pagamento.']; %>
    <% var helpModalContent = '<p>Saídas criadas a partir de orçamentos aprovados precisam ser verificadas: complete conta, centro de custo e comprovante. Depois seguem para o fluxo de pagamento.</p>'; %>
    <div class="max-w-3xl mx-auto">
      <!-- Cabeçalho Moderno -->
      <div class="mb-8 animate-slide-in">
        <div class="flex flex-wrap items-center gap-3 mb-2">
          <div class="flex items-center space-x-3">
            <div class="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl p-3 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-gray-900 bg-clip-text text-transparent">
                Verificar e Completar Saída
              </h1>
            <p class="text-gray-600 mt-1">Confirme os dados e complete as informações da saída</p>
          </div>
          <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
        </div>
      </div>
      <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

      <!-- Informações do Orçamento -->
      <% if (budgetRequest) { %>
        <div class="mb-6 bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4">
          <h3 class="font-semibold text-blue-800 mb-2">Orçamento Relacionado</h3>
          <p class="text-blue-700"><%= budgetRequest.title %></p>
          <% if (budgetRequest.quotes && budgetRequest.quotes.length > 0) { %>
            <% const approvedQuote = budgetRequest.quotes.find(q => q.status === 'APPROVED'); %>
            <% if (approvedQuote) { %>
              <p class="text-sm text-blue-600 mt-2">Fornecedor aprovado: <strong><%= approvedQuote.supplier_name %></strong></p>
            <% } %>
          <% } %>
        </div>
      <% } %>

      <!-- Mensagem de erro -->
      <% if (typeof req !== 'undefined' && req.query.error) { %>
        <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <%= decodeURIComponent(req.query.error) %>
        </div>
      <% } %>

      <!-- Formulário Moderno -->
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="/financeiro/saidas/<%= exit.id %>/verificar" class="space-y-6">
          <!-- Descrição -->
          <div>
            <label for="description" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Descrição <span class="text-red-500 ml-1">*</span>
            </label>
            <input
              type="text"
              id="description"
              name="description"
              required
              value="<%= exit.description %>"
              class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
            />
          </div>

          <!-- Valor e Data em Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Valor -->
            <div>
              <label for="amount" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Valor (R$) <span class="text-red-500 ml-1">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 font-semibold">R$</span>
                <input
                  type="number"
                  id="amount"
                  name="amount"
                  step="0.01"
                  min="0"
                  required
                  value="<%= exit.amount %>"
                  class="input-focus w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                />
              </div>
            </div>

            <!-- Data -->
            <div>
              <label for="exitDate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Data <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="date"
                id="exitDate"
                name="exitDate"
                required
                value="<%= exit.exit_date %>"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>
          </div>

          <!-- Centro de Custo e Categoria -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Centro de Custo -->
            <div>
              <label for="costCenterId" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Centro de Custo
              </label>
              <select
                id="costCenterId"
                name="costCenterId"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="">Selecione...</option>
                <% if (costCenters && costCenters.length > 0) { %>
                  <% costCenters.forEach(cc => { %>
                    <option
                      value="<%= cc.id %>"
                      <%= exit.cost_center_id == cc.id ? 'selected' : '' %>
                    >
                      <%= cc.name %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Categoria -->
            <div>
              <label for="category" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Categoria
              </label>
              <select
                id="category"
                name="category"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <% (despesaCategories || []).forEach(cat => { %>
                  <option value="<%= cat.code %>" <%= (exit.categoryForSelect || exit.category) === cat.code ? 'selected' : '' %>><%= cat.label %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Botões -->
          <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
            <a
              href="/financeiro/saidas-verificacao"
              class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span>Cancelar</span>
            </a>
            <button
              type="submit"
              class="group relative overflow-hidden bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
            >
              <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
              <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="relative z-10">Confirmar Verificação</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
