<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Saídas Aguardando Aprovação</h1>

  <% if (typeof req !== 'undefined' && req.query.success === 'approved') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Saída aprovada com sucesso!
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.success === 'rejected') { %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
      Saída rejeitada. O financeiro foi notificado.
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <% if (exits && exits.length > 0) { %>
    <div class="space-y-4">
      <% exits.forEach(exit => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-800"><%= exit.description %></h3>
              <p class="text-sm text-gray-500">
                Criada em: <%= new Date(exit.created_at).toLocaleString('pt-BR') %>
                <% if (exit.created_by_name) { %>
                  por <%= exit.created_by_name %>
                <% } %>
              </p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-red-600">
                R$ <%= parseFloat(exit.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </p>
              <p class="text-sm text-gray-500">Data: <%= new Date(exit.exit_date).toLocaleDateString('pt-BR') %></p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
            <div>
              <span class="text-gray-600">Categoria:</span>
              <span class="font-medium"><%= exit.category || '-' %></span>
            </div>
            <% if (exit.cost_center_name) { %>
            <div>
              <span class="text-gray-600">Centro de Custo:</span>
              <span class="font-medium"><%= exit.cost_center_name %></span>
            </div>
            <% } %>
            <% if (exit.bill_name) { %>
            <div>
              <span class="text-gray-600">Conta:</span>
              <span class="font-medium"><%= exit.bill_name %></span>
            </div>
            <% } %>
            <% if (exit.approval_limit) { %>
            <div>
              <span class="text-gray-600">Limite de Aprovação:</span>
              <span class="font-medium">R$ <%= parseFloat(exit.approval_limit).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
            </div>
            <% } %>
          </div>

          <div class="border-t pt-4">
            <form method="POST" action="/sindico/saidas/<%= exit.id %>/aprovar" class="inline-block mr-2">
              <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                Aprovar
              </button>
            </form>
            <form method="POST" action="/sindico/saidas/<%= exit.id %>/rejeitar" class="inline-block">
              <div class="mb-2">
                <label class="block text-sm text-gray-700 mb-1">Motivo da Rejeição *</label>
                <textarea name="rejectionReason" rows="2" required class="w-full border rounded px-3 py-2 text-sm"></textarea>
              </div>
              <button type="submit" class="bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700">
                Rejeitar
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <p class="text-gray-500 text-lg">Nenhuma saída aguardando aprovação</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
