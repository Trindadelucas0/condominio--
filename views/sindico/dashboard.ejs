<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Síndico</h1>
    <p class="text-gray-600 mt-2">Visão executiva do condomínio</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Aprovações Pendentes -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Aprovações Pendentes</p>
          <p class="text-3xl font-bold text-orange-600 mt-2"><%= stats.pendingApprovals %></p>
        </div>
        <div class="bg-orange-100 rounded-full p-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/aprovacoes" class="text-orange-600 text-sm mt-4 inline-block hover:underline">
        Ver todas →
      </a>
    </div>

    <!-- Alertas Críticos -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Alertas Críticos</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.criticalAlerts %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/alertas?severity=CRITICAL" class="text-red-600 text-sm mt-4 inline-block hover:underline">
        Ver todos →
      </a>
    </div>

    <!-- Alertas de Aviso -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Alertas de Aviso</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.warningAlerts %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/alertas?severity=WARNING" class="text-yellow-600 text-sm mt-4 inline-block hover:underline">
        Ver todos →
      </a>
    </div>

    <!-- Despesas Pendentes -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Despesas Pendentes</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.pendingExpenses %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/sindico/aprovacoes" class="bg-orange-600 text-white px-6 py-3 rounded-lg hover:bg-orange-700 transition text-center">
        Revisar Aprovações
      </a>
      <a href="/sindico/alertas" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition text-center">
        Ver Alertas
      </a>
      <a href="/sindico/logs" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition text-center">
        Logs de Auditoria
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
