<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="page-title">Dashboard Síndico</h1>
    <p class="page-subtitle">Visão executiva do condomínio</p>
  </div>

  <!-- Cards de estatísticas principais -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Aprovações Pendentes -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Aprovações Pendentes</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.pendingApprovals %></p>
          <% if (stats.pendingAmount > 0) { %>
            <p class="text-xs text-gray-500 mt-1">R$ <%= stats.pendingAmount.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
          <% } %>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/aprovacoes" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas →
      </a>
    </div>

    <!-- Alertas Críticos -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Alertas Críticos</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.criticalAlerts %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/alertas?severity=CRITICAL" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todos →
      </a>
    </div>

    <!-- Alertas de Aviso -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Alertas de Aviso</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.warningAlerts %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/alertas?severity=WARNING" class="text-yellow-600 text-sm mt-4 inline-block hover:underline">
        Ver todos →
      </a>
    </div>

    <!-- Saldo Financeiro -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Saldo Atual</p>
          <% if (stats.balance >= 0) { %>
            <p class="text-3xl font-bold text-green-600 mt-2">
              R$ <%= stats.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
            </p>
          <% } else { %>
            <p class="text-3xl font-bold text-red-600 mt-2">
              R$ <%= stats.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
            </p>
          <% } %>
        </div>
        <% if (stats.balance >= 0) { %>
          <div class="bg-green-100 rounded-full p-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        <% } else { %>
          <div class="bg-red-100 rounded-full p-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Segunda linha de cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Despesas Pendentes -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Despesas Pendentes</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.pendingExpenses || 0 %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/saidas-pendentes" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver saídas pendentes →
      </a>
    </div>

    <!-- Tarefas Atrasadas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Tarefas Atrasadas</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.overdueTasks %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/tarefas" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas as tarefas →
      </a>
    </div>

    <!-- Ocorrências Abertas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Ocorrências Abertas</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.openOccurrences %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/ocorrencias" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas as ocorrências →
      </a>
    </div>

    <!-- Orçamentos Aguardando Aprovação -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Orçamentos Pendentes</p>
          <p class="text-3xl font-bold text-primary-600 mt-2"><%= stats.pendingBudgets || 0 %></p>
        </div>
        <div class="bg-primary-100 rounded-full p-4">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/sindico/orcamentos-pendentes" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver orçamentos →
      </a>
    </div>

    <!-- Resumo Financeiro -->
    <div class="card">
      <div>
        <p class="text-gray-600 text-sm mb-3">Resumo Financeiro</p>
        <div class="space-y-2">
          <div class="flex justify-between">
            <span class="text-gray-600 text-sm">Entradas:</span>
            <span class="text-green-600 font-semibold">R$ <%= stats.totalEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600 text-sm">Saídas Pagas:</span>
            <span class="text-red-600 font-semibold">R$ <%= stats.totalExitsPaid.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
          </div>
          <div class="border-t pt-2 mt-2">
            <div class="flex justify-between">
              <span class="text-gray-700 font-semibold">Saldo:</span>
              <span class="<%= stats.balance >= 0 ? 'text-green-600' : 'text-red-600' %> font-bold">
                R$ <%= stats.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <a href="/sindico/tarefas" class="btn-primary text-center">
        Ver Tarefas
      </a>
      <a href="/sindico/ocorrencias" class="btn-primary text-center bg-blue-600 hover:bg-blue-700 focus:ring-blue-500">
        Ver Ocorrências
      </a>
      <a href="/sindico/aprovacoes" class="btn-primary text-center bg-yellow-600 hover:bg-yellow-700 focus:ring-yellow-500">
        Revisar Aprovações
      </a>
      <a href="/sindico/alertas" class="btn-danger text-center">
        Ver Alertas
      </a>
      <a href="/sindico/logs" class="btn-secondary text-center">
        Logs de Auditoria
      </a>
      <a href="/sindico/entradas-pendentes" class="btn-primary text-center bg-yellow-600 hover:bg-yellow-700 focus:ring-yellow-500">
        Analisar Entradas<% if (stats.pendingEntries !== undefined && stats.pendingEntries > 0) { %> (<%= stats.pendingEntries %>)<% } %>
      </a>
      <a href="/sindico/saidas-pendentes" class="btn-danger text-center">
        Aprovar Saídas<% if (stats.pendingExpenses !== undefined && stats.pendingExpenses > 0) { %> (<%= stats.pendingExpenses %>)<% } %>
      </a>
      <% if (stats.pendingOccurrencesApproval !== undefined && stats.pendingOccurrencesApproval > 0) { %>
      <a href="/sindico/ocorrencias-pendentes-aprovacao" class="btn-primary text-center bg-blue-600 hover:bg-blue-700 focus:ring-blue-500">
        Aprovar Ocorrências (<%= stats.pendingOccurrencesApproval %>)
      </a>
      <% } %>
      <a href="/sindico/manutencoes" class="btn-primary text-center">
        Manutenções
      </a>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
