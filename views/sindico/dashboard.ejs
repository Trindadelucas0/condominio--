        <% if (stats.pendingOccurrencesApproval !== undefined && stats.pendingOccurrencesApproval > 0) { %>
        <a href="/sindico/ocorrencias-pendentes-aprovacao" class="group relative overflow-hidden bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="relative z-10">Aprovar Ocorrências (<%= stats.pendingOccurrencesApproval %>)</span>
        </a>
        <% } %>
        
        <a href="/sindico/manutencoes" class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-indigo-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="relative z-10">Manutenções</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  <% if (typeof analytics !== 'undefined' && analytics.historical && analytics.historical.length > 0) { %>
  // Gráfico de Evolução Histórica
  const historicalCtx = document.getElementById('historicalChart');
  if (historicalCtx) {
    const historicalData = <%- JSON.stringify(analytics.historical) %>;
    
    new Chart(historicalCtx, {
      type: 'line',
      data: {
        labels: historicalData.map(d => d.label),
        datasets: [
          {
            label: 'Entradas',
            data: historicalData.map(d => parseFloat(d.entries || 0)),
            borderColor: 'rgb(34, 197, 94)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          },
          {
            label: 'Saídas',
            data: historicalData.map(d => parseFloat(d.exits || 0)),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          },
          {
            label: 'Saldo',
            data: historicalData.map(d => parseFloat(d.balance || 0)),
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 15,
              font: { size: 12, weight: 'bold' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            cornerRadius: 12,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: false,
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }
  <% } %>

  <% if (typeof analytics !== 'undefined' && analytics.categoryData && analytics.categoryData.exits.length > 0) { %>
  // Gráfico de Categorias
  const categoryCtx = document.getElementById('categoryChart');
  if (categoryCtx) {
    const categoryData = <%- JSON.stringify(analytics.categoryData.exits) %>;
    
    const colors = [
      'rgba(239, 68, 68, 0.8)',
      'rgba(59, 130, 246, 0.8)',
      'rgba(139, 92, 246, 0.8)',
      'rgba(251, 191, 36, 0.8)',
      'rgba(34, 197, 94, 0.8)',
      'rgba(236, 72, 153, 0.8)'
    ];

    new Chart(categoryCtx, {
      type: 'doughnut',
      data: {
        labels: categoryData.map(d => d.category),
        datasets: [{
          label: 'Gastos por Categoria',
          data: categoryData.map(d => parseFloat(d.total || 0)),
          backgroundColor: categoryData.map((d, i) => colors[i % colors.length]),
          borderWidth: 3,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              padding: 15,
              font: { size: 11, weight: 'bold' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            cornerRadius: 12,
            callbacks: {
              label: function(context) {
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percent = ((context.parsed / total) * 100).toFixed(1);
                return context.label + ': R$ ' + context.parsed.toLocaleString('pt-BR', {minimumFractionDigits: 2}) + ' (' + percent + '%)';
              }
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }
  <% } %>

  // Modal de Personalização do Dashboard
  function openDashboardConfig() {
    // Criar modal dinamicamente
    const modal = document.createElement('div');
    modal.id = 'dashboard-config-modal';
    modal.className = 'fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4';
    
    // Obter configuração atual do servidor (disponível via EJS)
    // dashboardConfig já é o array de widgets
    const currentConfig = typeof dashboardConfig !== 'undefined' && Array.isArray(dashboardConfig) ? dashboardConfig : [];
    
    // Widgets padrão caso não tenha configuração (completo)
    const defaultWidgets = [
      { key: 'pending_approvals', title: 'Aprovações Pendentes', visible: true },
      { key: 'critical_alerts', title: 'Alertas Críticos', visible: true },
      { key: 'warning_alerts', title: 'Alertas de Aviso', visible: true },
      { key: 'balance', title: 'Saldo total do condomínio', visible: true },
      { key: 'saldo_periodo', title: 'Saldo do período', visible: true },
      { key: 'current_month_expenses', title: 'Gastos do período', visible: true },
      { key: 'delinquency_rate', title: 'Inadimplência', visible: true },
      { key: 'pending_expenses', title: 'Despesas Pendentes', visible: true },
      { key: 'overdue_tasks', title: 'Tarefas Atrasadas', visible: true },
      { key: 'open_occurrences', title: 'Ocorrências Abertas', visible: true },
      { key: 'pending_budgets', title: 'Orçamentos Pendentes', visible: true },
      { key: 'pending_entries', title: 'Entradas Pendentes', visible: true },
      { key: 'completed_maintenances', title: 'Manutenções Concluídas', visible: false },
      { key: 'pending_occurrences_approval', title: 'Ocorrências Aguardando Aprovação', visible: false },
    ];
    
    // Criar mapa de configuração atual por key
    const configMap = {};
    if (currentConfig.length > 0) {
      currentConfig.forEach(w => {
        configMap[w.key] = w;
      });
    }
    
    // Mesclar padrão com configuração atual
    const widgets = defaultWidgets.map(function(w, i) {
      const saved = configMap[w.key];
      return {
        key: w.key,
        title: w.title,
        visible: saved ? (saved.visible !== false) : w.visible,
        position: saved ? (saved.position || i + 1) : (i + 1),
        id: w.key
      };
    }).sort(function(a, b) {
      return a.position - b.position;
    });
    
    // Gerar HTML dos widgets
    let widgetsHTML = '';
    widgets.forEach(function(widget, index) {
      const widgetId = widget.id || widget.key || index;
      const widgetTitle = widget.title || widget.name || 'Widget ' + (index + 1);
      const isVisible = widget.visible !== false;
      const position = widget.position !== undefined ? widget.position : index + 1;
      
      widgetsHTML += `
        <div class="flex items-center justify-between p-4 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-move" draggable="true" data-widget-id="${widgetId}" data-widget-key="${widget.key || widgetId}">
          <div class="flex items-center space-x-3 flex-1">
            <svg class="w-5 h-5 text-gray-400 cursor-move" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
            </svg>
            <input type="checkbox" ${isVisible ? 'checked' : ''} onchange="toggleWidget('${widgetId}', this.checked)" class="w-5 h-5 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
            <span class="font-semibold text-gray-900">${widgetTitle}</span>
          </div>
          <span class="text-sm text-gray-500 ml-4">Posição ${position}</span>
        </div>
      `;
    });
    
    modal.innerHTML = `
      <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-300">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-gray-900">⚙️ Personalizar Dashboard</h2>
            <button onclick="closeDashboardConfig()" class="text-gray-400 hover:text-gray-600 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="p-6">
          <p class="text-gray-600 mb-6">
            <strong>📋 Como usar:</strong><br>
            • Marque/desmarque os widgets para mostrar ou ocultar no dashboard<br>
            • Arraste os widgets para reorganizar a ordem de exibição<br>
            • Clique em "Salvar Configuração" para aplicar as mudanças
          </p>
          <div id="widget-list" class="space-y-3">
            ${widgetsHTML || '<p class="text-gray-500 text-center py-8">Nenhum widget configurável encontrado.</p>'}
          </div>
        </div>
        <div class="p-6 border-t border-gray-300 flex justify-end space-x-3">
          <button onclick="closeDashboardConfig()" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 font-semibold hover:bg-gray-50 transition-colors">
            Cancelar
          </button>
          <button onclick="saveDashboardConfig()" class="px-6 py-2 bg-purple-600 text-white rounded-lg font-semibold hover:bg-purple-700 transition-colors">
            💾 Salvar Configuração
          </button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    
    // Adicionar funcionalidade de drag and drop
    const widgetList = document.getElementById('widget-list');
    if (widgetList) {
      let draggedElement = null;
      widgetList.addEventListener('dragstart', (e) => {
        if (e.target.draggable) {
          draggedElement = e.target;
          e.target.style.opacity = '0.5';
        }
      });
      widgetList.addEventListener('dragend', (e) => {
        if (e.target.draggable) {
          e.target.style.opacity = '1';
        }
      });
      widgetList.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (draggedElement) {
          const afterElement = getDragAfterElement(widgetList, e.clientY);
          if (afterElement == null) {
            widgetList.appendChild(draggedElement);
          } else {
            widgetList.insertBefore(draggedElement, afterElement);
          }
        }
      });
    }
  }

  function closeDashboardConfig() {
    const modal = document.getElementById('dashboard-config-modal');
    if (modal) {
      modal.remove();
    }
  }

  function toggleWidget(widgetId, visible) {
    // Atualizar estado local (será salvo quando o usuário clicar em Salvar)
    const widget = document.querySelector(`[data-widget-id="${widgetId}"]`);
    if (widget) {
      widget.style.opacity = visible ? '1' : '0.6';
    }
  }

  function saveDashboardConfig() {
    const widgetList = document.getElementById('widget-list');
    if (!widgetList) {
      if (typeof showNotification !== 'undefined') {
        showNotification('Lista de widgets não encontrada', 'error');
      } else {
        alert('❌ Erro: Lista de widgets não encontrada');
      }
      return;
    }
    
    const widgetElements = Array.from(widgetList.children).filter(function(item) {
      return item.draggable && (item.dataset.widgetKey || item.dataset.widgetId);
    });
    
    if (widgetElements.length === 0) {
      if (typeof showNotification !== 'undefined') {
        showNotification('Nenhum widget encontrado para salvar', 'warning');
      } else {
        alert('❌ Erro: Nenhum widget encontrado');
      }
      return;
    }
    
    const widgets = widgetElements.map(function(item, index) {
      const checkbox = item.querySelector('input[type="checkbox"]');
      const widgetKey = item.dataset.widgetKey || item.dataset.widgetId;
      const titleElement = item.querySelector('span.font-semibold');
      const widgetTitle = titleElement ? titleElement.textContent.trim() : 'Widget';
      
      return {
        key: widgetKey,
        title: widgetTitle,
        visible: checkbox ? checkbox.checked : true,
        position: index + 1
      };
    });

    console.log('Salvando configuração:', widgets);

    // Enviar para o servidor
    fetch('/sindico/dashboard/config', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ widgets })
    })
    .then(response => {
      if (!response.ok) {
        return response.json().then(err => { throw err; });
      }
      return response.json();
    })
    .then(function(data) {
      if (data.success) {
        if (typeof showNotification !== 'undefined') {
          showNotification('Configuração salva com sucesso! A página será recarregada.', 'success', 2000);
          setTimeout(function() {
            window.location.reload();
          }, 2000);
        } else {
          alert('✅ Configuração salva com sucesso! A página será recarregada.');
          window.location.reload();
        }
      } else {
        const errorMsg = data.message || 'Erro desconhecido';
        if (typeof showNotification !== 'undefined') {
          showNotification('Erro ao salvar configuração: ' + errorMsg, 'error', 7000);
        } else {
          alert('❌ Erro ao salvar configuração: ' + errorMsg);
        }
      }
    })
    .catch(function(error) {
      console.error('Erro:', error);
      const errorMsg = error.message || 'Erro desconhecido';
      if (typeof showNotification !== 'undefined') {
        showNotification('Erro ao salvar configuração: ' + errorMsg, 'error', 7000);
      } else {
        alert('❌ Erro ao salvar configuração: ' + errorMsg);
      }
    });
  }

  function getDragAfterElement(container, y) {
    const draggableElements = [...container.querySelectorAll('[draggable="true"]')]
      .filter(el => el.style.opacity !== '0.5');
    return draggableElements.reduce((closest, child) => {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      if (offset < 0 && offset > closest.offset) {
        return { offset: offset, element: child };
      } else {
        return closest;
      }
    }, { offset: Number.NEGATIVE_INFINITY }).element;
  }
</script>

<%- include('../partials/footer') %>
