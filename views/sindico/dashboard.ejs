<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }
  
  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }
  
  .card-elevate {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-elevate:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .stat-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%);
    backdrop-filter: blur(10px);
  }
  
  .pulse-animation {
    animation: pulse 2s ease-in-out infinite;
  }
  
  .shimmer-effect {
    background: linear-gradient(90deg, #f0f0f0 0%, #e0e0e0 50%, #f0f0f0 100%);
    background-size: 2000px 100%;
    animation: shimmer 2s infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-purple-50/30 to-pink-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Síndico'; %>
    <% var resumo = ['Visão executiva: aprovações pendentes, alertas, ocorrências e orçamentos.', 'Use os widgets e atalhos para aprovar, ver alertas e pendências. Personalize os widgets se quiser.', 'Itens críticos aparecem na tabela; use OK para marcar como visualizado.', 'Aprovações acima do limite do financeiro chegam aqui para o síndico.']; %>
    <% var helpModalContent = '<p><strong>Dashboard Síndico</strong> é a tela inicial do síndico. Mostra aprovações pendentes, alertas, ocorrências e orçamentos. Use os atalhos para aprovar e resolver. Itens críticos podem ser marcados como visualizados com OK. Você pode personalizar os widgets.</p>'; %>
    <!-- Cabeçalho Moderno (responsivo) -->
    <div class="mb-6 sm:mb-8 animate-fade-in-up">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-3 min-w-0">
          <div class="flex items-center gap-3 sm:space-x-4 min-w-0">
            <div class="flex-shrink-0 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl p-3 sm:p-4 shadow-lg">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold bg-gradient-to-r from-gray-900 via-purple-900 to-gray-900 bg-clip-text text-transparent truncate">
                Dashboard Síndico
              </h1>
              <p class="text-gray-600 mt-1 text-sm sm:text-base">Visão executiva do condomínio</p>
            </div>
          </div>
          <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
        </div>
        <button type="button" onclick="openDashboardConfig()" class="touch-target-min w-full sm:w-auto bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 sm:px-6 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 inline-flex items-center justify-center space-x-2">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>⚙️ Personalizar</span>
        </button>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <% var periodo = typeof periodo !== 'undefined' && periodo ? periodo : null; %>
    <div class="mb-6 p-4 bg-white rounded-2xl border border-purple-300 shadow-sm flex flex-wrap items-end gap-4 animate-fade-in-up">
      <form method="get" action="/sindico/dashboard" class="flex flex-wrap items-end gap-3">
        <div>
          <label for="sindico-dash-data-inicio" class="block text-xs font-medium text-gray-600 mb-1">Data início</label>
          <input id="sindico-dash-data-inicio" type="date" name="dataInicio" value="<%= periodo ? periodo.dataInicio : '' %>" class="border border-gray-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
        </div>
        <div>
          <label for="sindico-dash-data-fim" class="block text-xs font-medium text-gray-600 mb-1">Data fim</label>
          <input id="sindico-dash-data-fim" type="date" name="dataFim" value="<%= periodo ? periodo.dataFim : '' %>" class="border border-gray-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
        </div>
        <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow">Aplicar período</button>
        <a href="/sindico/dashboard" class="text-sm font-medium text-gray-600 hover:text-purple-700 py-2">Mês atual (padrão)</a>
      </form>
      <% if (periodo && periodo.label) { %>
        <p class="text-sm text-gray-600 w-full sm:w-auto sm:ml-auto"><span class="font-semibold text-gray-800">Período dos KPIs financeiros:</span> <%= periodo.label %></p>
      <% } %>
    </div>

    <!-- Tabela de itens críticos (com "OK" para marcar como visualizado) -->
    <%- include('../partials/critical-items-table', { criticalItems: typeof criticalItems !== 'undefined' ? criticalItems : [], condominiumId: typeof condominiumId !== 'undefined' ? condominiumId : null }) %>

    <% if (typeof showGettingStarted !== 'undefined' && showGettingStarted) { %>
    <!-- Comece por aqui (há aprovações pendentes ou primeiro uso) -->
    <div class="mb-6 p-6 bg-gradient-to-r from-purple-50 to-pink-50 border-2 border-purple-300 rounded-2xl shadow-lg animate-fade-in-up">
      <h2 class="text-xl font-bold text-gray-900 mb-2 flex items-center">
        <span class="text-2xl mr-2">👋</span>
        Comece por aqui
      </h2>
      <p class="text-gray-700 mb-4">
        <% if (typeof stats !== 'undefined' && stats.pendingApprovals > 0) { %>
          Você tem <strong><%= stats.pendingApprovals %></strong> aprovação(ões) pendente(s). Resolva primeiro em Aprovações.
        <% } else { %>
          Não sabe por onde começar? Acesse as aprovações pendentes, configure os modelos de checklist ou leia como o sistema funciona.
        <% } %>
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/sindico/aprovacoes" class="inline-flex items-center px-5 py-2.5 bg-purple-600 text-white rounded-xl font-semibold hover:bg-purple-700 transition shadow-md">Ver aprovações pendentes</a>
        <a href="/sindico/checklist-modelos" class="inline-flex items-center px-5 py-2.5 bg-white border-2 border-purple-600 text-purple-700 rounded-xl font-semibold hover:bg-purple-50 transition">Configurar modelos de checklist</a>
        <a href="/sindico/como-funciona" class="inline-flex items-center px-5 py-2.5 text-gray-700 hover:text-purple-700 font-medium">Como funciona o sistema →</a>
      </div>
    </div>
    <% } %>

    <%- include('../partials/dashboard-resumo-financeiro', { stats: stats, periodo: typeof periodo !== 'undefined' ? periodo : null, analytics: typeof analytics !== 'undefined' ? analytics : null }) %>

    <!-- Widgets Dinâmicos baseados na Configuração do Usuário -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6" id="dashboard-widgets">
      <%- include('dashboard-widgets-partial') %>
    </div>

    <!-- Gráficos Avançados -->
    <% if (typeof analytics !== 'undefined' && analytics.historical && analytics.historical.length > 0) { %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Gráfico de Evolução Histórica (12 meses) -->
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.1s">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">Evolução Financeira (12 meses)</h2>
          <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">Histórico</span>
        </div>
        <div class="chart-container" style="position: relative; height: 300px;">
          <canvas id="historicalChart"></canvas>
        </div>
      </div>

      <!-- Gráfico de Categorias -->
      <% if (typeof analytics.categoryData !== 'undefined' && analytics.categoryData.exits.length > 0) { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.2s">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">Gastos por Categoria</h2>
          <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">Últimos 6 meses</span>
        </div>
        <div class="chart-container" style="position: relative; height: 300px;">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Previsões e Comparações -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Previsões para Próximos 3 Meses -->
      <% if (typeof analytics.projections !== 'undefined' && analytics.projections.length > 0) { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.3s">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">Previsões Financeiras</h2>
          <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">Próximos 3 meses</span>
        </div>
        <div class="space-y-4">
          <% analytics.projections.forEach((proj, index) => { %>
          <div class="border border-l-2 p-4 rounded-lg <%= proj.projectedBalance >= 0 ? 'border-green-300 border-l-green-500 bg-green-50' : 'border-red-300 border-l-red-500 bg-red-50' %>">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-semibold text-gray-900"><%= proj.label %></h3>
              <span class="text-sm font-bold <%= proj.projectedBalance >= 0 ? 'text-green-700' : 'text-red-700' %>">
                R$ <%= proj.projectedBalance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <span class="text-gray-600">Entradas:</span>
                <span class="font-semibold text-green-700 ml-1">R$ <%= proj.projectedEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
              </div>
              <div>
                <span class="text-gray-600">Saídas:</span>
                <span class="font-semibold text-red-700 ml-1">R$ <%= proj.projectedExits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Comparação com Mês Anterior -->
      <% if (typeof analytics.comparison !== 'undefined') { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up border border-gray-300" style="animation-delay: 1.4s">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">Comparação Mensal</h2>
          <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">Mês atual vs anterior</span>
        </div>
        <div class="space-y-4">
          <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-4 border border-green-300 border-l-2 border-l-green-500">
            <p class="text-sm font-semibold text-gray-700 mb-2">Entradas</p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-green-700">
                R$ <%= analytics.comparison.period2.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </span>
              <span class="text-xs px-2 py-1 rounded-full <%= analytics.comparison.variations.entries >= 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= analytics.comparison.variations.entries >= 0 ? '↑' : '↓' %> <%= Math.abs(analytics.comparison.variations.entries).toFixed(1) %>%
              </span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Mês anterior: R$ <%= analytics.comparison.period1.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
          </div>
          
          <div class="bg-gradient-to-r from-red-50 to-rose-50 rounded-lg p-4 border border-red-300 border-l-2 border-l-red-500">
            <p class="text-sm font-semibold text-gray-700 mb-2">Saídas</p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-red-700">
                R$ <%= analytics.comparison.period2.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </span>
              <span class="text-xs px-2 py-1 rounded-full <%= analytics.comparison.variations.exits >= 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
                <%= analytics.comparison.variations.exits >= 0 ? '↑' : '↓' %> <%= Math.abs(analytics.comparison.variations.exits).toFixed(1) %>%
              </span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Mês anterior: R$ <%= analytics.comparison.period1.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
          </div>

          <div class="bg-gradient-to-r <%= analytics.comparison.period2.balance >= 0 ? 'from-green-50 to-emerald-50 border-green-300 border-l-green-500' : 'from-red-50 to-rose-50 border-red-300 border-l-red-500' %> rounded-lg p-4 border border-l-2">
            <p class="text-sm font-semibold text-gray-700 mb-2">Saldo</p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold <%= analytics.comparison.period2.balance >= 0 ? 'text-green-700' : 'text-red-700' %>">
                R$ <%= analytics.comparison.period2.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </span>
              <span class="text-xs px-2 py-1 rounded-full <%= analytics.comparison.variations.balance >= 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= analytics.comparison.variations.balance >= 0 ? '↑' : '↓' %> <%= Math.abs(analytics.comparison.variations.balance).toFixed(1) %>%
              </span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Mês anterior: R$ <%= analytics.comparison.period1.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Ações Rápidas -->
    <div class="bg-white rounded-2xl shadow-xl p-8 animate-fade-in-up border border-purple-300" style="animation-delay: 1s">
      <div class="flex items-center space-x-3 mb-6">
        <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-lg p-2">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-900">Ações Rápidas</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <a href="/sindico/tarefas" class="group relative overflow-hidden bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <span class="relative z-10">Ver Tarefas</span>
        </a>
        
        <a href="/sindico/ocorrencias" class="group relative overflow-hidden bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="relative z-10">Ver Ocorrências</span>
        </a>
        
        <a href="/sindico/aprovacoes" class="group relative overflow-hidden bg-gradient-to-r from-yellow-600 to-amber-600 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="relative z-10">
            Revisar Aprovações
            <% if (typeof stats.pendingApprovals !== 'undefined' && stats.pendingApprovals > 0) { %>
              (<%= stats.pendingApprovals %>)
            <% } %>
          </span>
        </a>
        
        <a href="/sindico/alertas" class="group relative overflow-hidden bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="relative z-10">Ver Alertas</span>
        </a>
        
        <a href="/sindico/logs" class="group relative overflow-hidden bg-gradient-to-r from-gray-600 to-gray-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="relative z-10">Logs de Auditoria</span>
        </a>
        
        <a href="/sindico/entradas-pendentes" class="group relative overflow-hidden bg-gradient-to-r from-yellow-600 to-amber-600 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="relative z-10">Analisar Entradas<% if (stats.pendingEntries !== undefined && stats.pendingEntries > 0) { %> (<%= stats.pendingEntries %>)<% } %></span>
        </a>
        
        <a href="/sindico/saidas-pendentes" class="group relative overflow-hidden bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="relative z-10">Aprovar Saídas<% if (stats.pendingExpenses !== undefined && stats.pendingExpenses > 0) { %> (<%= stats.pendingExpenses %>)<% } %></span>
        </a>

        <a href="/sindico/aprovacoes?tipo=FINANCIAL_EXIT_UNPAY" class="group relative overflow-hidden bg-gradient-to-r from-amber-500 to-yellow-500 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m2 5H8a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0115 3.586L19.414 8A2 2 0 0120 9.414V18a2 2 0 01-2 2z"></path>
