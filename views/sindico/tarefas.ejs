<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .pulse-animation {
    animation: pulse 2s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.02);
    }
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-purple-50/30 to-pink-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Tarefas (Síndico)'; %>
    <% var resumo = ['Visão de todas as tarefas do condomínio para o síndico.', 'Use filtros e busca. Exporte para Excel se precisar.', 'Tarefas são criadas no módulo Administrativo; aqui o síndico acompanha.', 'Clique em uma tarefa para ver detalhes e status.']; %>
    <% var helpModalContent = '<p><strong>Tarefas (Síndico)</strong> mostra todas as tarefas. Filtros e busca; exportação para Excel. A criação e execução são no Administrativo; aqui o síndico acompanha e vê detalhes.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-purple-900 to-gray-900 bg-clip-text text-transparent">
              Tarefas do Condomínio
            </h1>
            <p class="text-gray-600 mt-1">Visualize todas as tarefas (abertas e concluídas)</p>
          </div>
        </div>
        <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Filtros e Ações -->
    <div class="bg-white rounded-2xl shadow-xl p-6 mb-6 animate-slide-in">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-800">Filtros e Busca</h2>
        <div class="flex gap-2">
          <a href="/sindico/tarefas/relatorio" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg font-semibold transition-all duration-200 inline-flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>📊 Exportar Excel</span>
          </a>
        </div>
      </div>
      <form method="GET" action="/sindico/tarefas" class="flex flex-wrap items-end gap-4">
        <!-- Busca por texto -->
        <div class="flex-1 min-w-[300px]">
          <label for="search" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Buscar por texto
          </label>
          <input
            type="text"
            id="search"
            name="search"
            value="<%= filters.search || '' %>"
            placeholder="Buscar por título, descrição, criador..."
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200"
          />
        </div>
        <!-- Status -->
        <div class="min-w-[200px]">
          <label for="status" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            Status
          </label>
          <select
            id="status"
            name="status"
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200"
          >
            <option value="">Todas</option>
            <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pendentes</option>
            <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>Em Progresso</option>
            <option value="COMPLETED" <%= filters.status === 'COMPLETED' ? 'selected' : '' %>>Concluídas</option>
            <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Canceladas</option>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
            <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
            <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            <span class="relative z-10">Filtrar</span>
          </button>
          <a href="/sindico/tarefas" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Limpar</span>
          </a>
        </div>
      </form>
    </div>

    <!-- Lista de Tarefas -->
    <div class="space-y-4">
      <% 
        // Compatibilidade: tasks pode vir diretamente ou como result.tasks
        const taskList = tasks && Array.isArray(tasks) ? tasks : (typeof tasks !== 'undefined' && tasks.tasks ? tasks.tasks : []);
        const paginationData = tasks && tasks.pagination ? tasks.pagination : pagination;
      %>
      <% if (taskList.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center animate-slide-in">
          <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-full p-6 w-24 h-24 mx-auto mb-4 flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <p class="text-xl font-semibold text-gray-700">Nenhuma tarefa encontrada.</p>
          <p class="text-gray-500 mt-2">Tente ajustar os filtros para encontrar mais resultados</p>
        </div>
      <% } else { %>
        <% taskList.forEach((task, index) => { %>
          <div class="bg-white rounded-2xl shadow-xl p-6 card-hover-effect animate-slide-in <%= task.due_date && new Date(task.due_date) < new Date() && task.status !== 'COMPLETED' ? 'border-l-4 border-red-500' : '' %>" style="animation-delay: <%= index * 0.05 %>s">
            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <h3 class="text-xl font-bold text-gray-900">
                    <a href="/sindico/tarefas/<%= task.id %>" class="hover:text-purple-600 transition-colors">
                      <%= task.title %>
                    </a>
                  </h3>
                  <% 
                    let statusColor = 'from-gray-400 to-gray-500';
                    let statusText = task.status;
                    if (task.status === 'COMPLETED') {
                      statusColor = 'from-green-500 to-emerald-500';
                      statusText = 'Concluída';
                    } else if (task.status === 'IN_PROGRESS') {
                      statusColor = 'from-cyan-500 to-blue-500';
                      statusText = 'Em Progresso';
                    } else if (task.status === 'CANCELLED') {
                      statusColor = 'from-gray-400 to-gray-500';
                      statusText = 'Cancelada';
                    } else {
                      statusColor = 'from-yellow-500 to-amber-500';
                      statusText = 'Pendente';
                    }
                  %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r <%= statusColor %> text-white shadow-md">
                    <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                    <%= statusText %>
                  </span>
                  <% 
                    let priorityColor = 'from-gray-400 to-gray-500';
                    if (task.priority === 'URGENTE') priorityColor = 'from-red-500 to-red-600';
                    else if (task.priority === 'ALTA') priorityColor = 'from-orange-500 to-amber-500';
                    else if (task.priority === 'NORMAL') priorityColor = 'from-blue-500 to-blue-600';
                    else priorityColor = 'from-gray-400 to-gray-500';
                  %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r <%= priorityColor %> text-white shadow-md">
                    <%= task.priority %>
                  </span>
                  <% if (task.due_date && new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-red-500 to-red-600 text-white shadow-md pulse-animation">
                      <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                      </svg>
                      ATRASADA
                    </span>
                  <% } %>
                </div>
                
                <% if (task.description) { %>
                  <p class="text-gray-700 mb-4 leading-relaxed"><%= task.description %></p>
                <% } %>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                  <div class="flex items-center text-sm text-gray-600">
                    <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span><strong>Criada por:</strong> <%= task.created_by_name || 'N/A' %></span>
                  </div>
                  <div class="flex items-center text-sm text-gray-600">
                    <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    <span><strong>Responsável:</strong> <%= task.assigned_to_name || 'N/A' %></span>
                  </div>
                  <div class="flex items-center text-sm text-gray-600">
                    <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span><strong>Prazo:</strong> <%= new Date(task.due_date).toLocaleDateString('pt-BR') %></span>
                  </div>
                  <% if (task.completed_at) { %>
                    <div class="flex items-center text-sm text-gray-600">
                      <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span><strong>Concluída:</strong> <%= new Date(task.completed_at).toLocaleDateString('pt-BR') %></span>
                    </div>
                  <% } %>
                </div>
                
                <% if (task.checklists_count > 0) { %>
                  <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-3 mb-4 border-l-4 border-purple-500">
                    <p class="text-sm font-semibold text-gray-700">
                      <svg class="w-4 h-4 inline mr-1 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      </svg>
                      Checklist: <span class="text-purple-700"><%= task.checklists_done %>/<%= task.checklists_count %></span> itens concluídos
                    </p>
                  </div>
                <% } %>
                
                <!-- Informações de Conclusão -->
                <% if (task.status === 'COMPLETED') { %>
                  <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-xl p-4 mt-4">
                    <div class="flex items-center space-x-2 mb-3">
                      <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <h4 class="text-sm font-bold text-green-800">Informações de Conclusão</h4>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      <% if (task.completion_success !== null) { %>
                        <div class="bg-white rounded-lg p-3 border border-green-200">
                          <p class="text-xs font-semibold text-gray-600 mb-1">Conclusão bem sucedida</p>
                          <p class="text-sm font-bold <%= task.completion_success ? 'text-green-700' : 'text-red-700' %>">
                            <%= task.completion_success ? '✅ Sim' : '❌ Não' %>
                          </p>
                        </div>
                      <% } %>
                      <% if (task.completion_time_minutes) { %>
                        <div class="bg-white rounded-lg p-3 border border-green-200">
                          <p class="text-xs font-semibold text-gray-600 mb-1">Tempo gasto</p>
                          <p class="text-sm font-bold text-gray-900"><%= task.completion_time_minutes %> minutos</p>
                        </div>
                      <% } %>
                      <% if (task.completion_quality) { %>
                        <div class="bg-white rounded-lg p-3 border border-green-200">
                          <p class="text-xs font-semibold text-gray-600 mb-1">Qualidade</p>
                          <p class="text-sm font-bold text-gray-900"><%= task.completion_quality %></p>
                        </div>
                      <% } %>
                    </div>
                    <% if (task.completion_notes) { %>
                      <div class="mt-3 bg-white rounded-lg p-3 border border-green-200">
                        <p class="text-xs font-semibold text-gray-600 mb-1">Observações</p>
                        <p class="text-sm text-gray-700"><%= task.completion_notes %></p>
                      </div>
                    <% } %>
                    <% if (task.had_issues) { %>
                      <div class="mt-3 bg-gradient-to-r from-orange-50 to-amber-50 border-l-4 border-orange-500 rounded-lg p-3">
                        <div class="flex items-center space-x-2 mb-1">
                          <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                          </svg>
                          <p class="text-sm font-bold text-orange-800">Contratempos</p>
                        </div>
                        <p class="text-sm text-orange-700"><%= task.issues_description || 'Sim' %></p>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Paginação -->
    <% if (paginationData && paginationData.totalPages > 1) { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 mt-6 animate-slide-in">
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-600">
            Mostrando <strong><%= ((paginationData.currentPage - 1) * paginationData.perPage) + 1 %></strong> até 
            <strong><%= Math.min(paginationData.currentPage * paginationData.perPage, paginationData.totalRecords) %></strong> 
            de <strong><%= paginationData.totalRecords %></strong> tarefas
            <span class="text-gray-400">(Página <%= paginationData.currentPage %> de <%= paginationData.totalPages %>)</span>
          </div>
          <div class="flex items-center space-x-2">
            <% 
              // Construir query string preservando filtros
              const queryParams = new URLSearchParams();
              if (filters.search) queryParams.set('search', filters.search);
              if (filters.status) queryParams.set('status', filters.status);
              const queryString = queryParams.toString();
            %>
            <% if (paginationData.hasPrev) { %>
              <a href="/sindico/tarefas?page=<%= paginationData.currentPage - 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                <span>Anterior</span>
              </a>
            <% } %>
            <% if (paginationData.hasNext) { %>
              <a href="/sindico/tarefas?page=<%= paginationData.currentPage + 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <span>Próxima</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
