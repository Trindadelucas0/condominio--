<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Tarefas do Condomínio</h1>
    <p class="text-gray-600 mt-2">Visualize todas as tarefas (abertas e concluídas)</p>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/sindico/tarefas" class="flex gap-4 items-end">
      <div class="flex-1">
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Filtrar por Status</label>
        <select
          id="status"
          name="status"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Todas</option>
          <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pendentes</option>
          <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>Em Progresso</option>
          <option value="COMPLETED" <%= filters.status === 'COMPLETED' ? 'selected' : '' %>>Concluídas</option>
          <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Canceladas</option>
        </select>
      </div>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
        Filtrar
      </button>
      <a href="/sindico/tarefas" class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400 transition">
        Limpar
      </a>
    </form>
  </div>

  <!-- Lista de Tarefas -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (tasks.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma tarefa encontrada.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% tasks.forEach(task => { %>
          <div class="p-6 hover:bg-gray-50 transition">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-lg font-bold text-gray-900">
                    <a href="/sindico/tarefas/<%= task.id %>" class="hover:text-blue-600">
                      <%= task.title %>
                    </a>
                  </h3>
                  <span class="px-3 py-1 text-xs font-semibold rounded
                    <%= task.status === 'COMPLETED' ? 'bg-green-100 text-green-800' : 
                        task.status === 'IN_PROGRESS' ? 'bg-blue-100 text-blue-800' : 
                        task.status === 'CANCELLED' ? 'bg-gray-100 text-gray-800' : 
                        'bg-yellow-100 text-yellow-800' %>">
                    <%= task.status %>
                  </span>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                    <%= task.priority %>
                  </span>
                  <% if (task.due_date && new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-red-100 text-red-800">
                      ATRASADA
                    </span>
                  <% } %>
                </div>
                <% if (task.description) { %>
                  <p class="text-gray-700 mb-2"><%= task.description %></p>
                <% } %>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-2">
                  <p><strong>Criada por:</strong> <%= task.created_by_name || 'N/A' %></p>
                  <p><strong>Responsável:</strong> <%= task.assigned_to_name || 'N/A' %></p>
                  <p><strong>Prazo:</strong> <%= new Date(task.due_date).toLocaleDateString('pt-BR') %></p>
                  <% if (task.completed_at) { %>
                    <p><strong>Concluída em:</strong> <%= new Date(task.completed_at).toLocaleString('pt-BR') %></p>
                  <% } %>
                </div>
                <% if (task.checklists_count > 0) { %>
                  <p class="text-sm text-gray-600">
                    <strong>Checklist:</strong> <%= task.checklists_done %>/<%= task.checklists_count %> itens concluídos
                  </p>
                <% } %>
                <!-- Informações de conclusão estruturada -->
                <% if (task.status === 'COMPLETED') { %>
                  <div class="bg-green-50 border border-green-200 rounded p-3 mt-3">
                    <% if (task.completion_success !== null) { %>
                      <p class="text-sm text-gray-700">
                        <span class="font-semibold">Conclusão bem sucedida:</span> 
                        <%= task.completion_success ? '✅ Sim' : '❌ Não' %>
                      </p>
                    <% } %>
                    <% if (task.completion_notes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Observações:</span> <%= task.completion_notes %>
                      </p>
                    <% } %>
                    <% if (task.had_issues) { %>
                      <p class="text-sm text-orange-700 mt-1">
                        <span class="font-semibold">⚠ Contratempos:</span> <%= task.issues_description || 'Sim' %>
                      </p>
                    <% } %>
                    <% if (task.completion_quality) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Qualidade:</span> <%= task.completion_quality %>
                      </p>
                    <% } %>
                    <% if (task.completion_time_minutes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Tempo gasto:</span> <%= task.completion_time_minutes %> minutos
                      </p>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
