<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Orçamentos Aguardando Aprovação</h1>
  <p class="text-gray-600 mb-6">Revise e aprove ou rejeite os orçamentos enviados pelo financeiro</p>

  <% if (typeof req !== 'undefined' && req.query.success === 'approved') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Orçamento aprovado com sucesso!
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.success === 'rejected') { %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
      Orçamento rejeitado.
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <% if (budgets && budgets.length > 0) { %>
    <div class="space-y-4">
      <% budgets.forEach(budget => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-800"><%= budget.title %></h3>
              <p class="text-gray-600 mt-2"><%= budget.description %></p>
              
              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="text-gray-500">Criado em:</p>
                  <p class="font-medium"><%= new Date(budget.created_at).toLocaleString('pt-BR') %></p>
                </div>
                <div>
                  <p class="text-gray-500">Solicitado por:</p>
                  <p class="font-medium"><%= budget.requested_by_name || 'N/A' %></p>
                </div>
                <% if (budget.estimated_value) { %>
                  <div>
                    <p class="text-gray-500">Valor estimado:</p>
                    <p class="font-semibold text-blue-600">R$ <%= parseFloat(budget.estimated_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                  </div>
                <% } %>
                <% if (budget.financeiro_notes) { %>
                  <div>
                    <p class="text-gray-500">Observações do Financeiro:</p>
                    <p class="font-medium"><%= budget.financeiro_notes %></p>
                  </div>
                <% } %>
                <% if (budget.priority) { %>
                  <div>
                    <p class="text-gray-500">Prioridade:</p>
                    <span class="px-2 py-1 rounded text-xs font-semibold <%= budget.priority === 'URGENTE' ? 'bg-red-100 text-red-800' : budget.priority === 'ALTA' ? 'bg-orange-100 text-orange-800' : 'bg-gray-100 text-gray-800' %>">
                      <%= budget.priority %>
                    </span>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Formulário de Aprovação -->
          <div class="border-t pt-4 mt-4">
            <form method="POST" action="/sindico/orcamentos/<%= budget.id %>/aprovar" class="mb-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Valor Aprovado (R$) <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="number"
                    name="budgetApprovedAmount"
                    step="0.01"
                    min="0"
                    required
                    value="<%= budget.estimated_value || '' %>"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="0.00"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Observações (opcional)
                  </label>
                  <textarea
                    name="approvalNotes"
                    rows="3"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="Adicione observações sobre a aprovação..."
                  ></textarea>
                </div>
              </div>
              <button
                type="submit"
                class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition"
              >
                ✓ Aprovar Orçamento
              </button>
            </form>

            <!-- Formulário de Rejeição -->
            <form method="POST" action="/sindico/orcamentos/<%= budget.id %>/rejeitar" class="border-t pt-4">
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Motivo da Rejeição <span class="text-red-500">*</span>
                </label>
                <textarea
                  name="rejectionReason"
                  rows="3"
                  required
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                  placeholder="Explique o motivo da rejeição..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700 transition"
              >
                ✗ Rejeitar Orçamento
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <p class="text-gray-500 text-lg">Nenhum orçamento aguardando aprovação</p>
      <p class="text-gray-400 text-sm mt-2">Todos os orçamentos foram processados</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
