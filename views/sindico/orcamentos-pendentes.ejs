<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Orçamentos Aguardando Aprovação</h1>
  <p class="text-gray-600 mb-6">Revise e aprove ou rejeite os orçamentos enviados pelo financeiro</p>

  <% if (typeof req !== 'undefined' && req.query.success === 'approved') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Orçamento aprovado com sucesso!
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.success === 'rejected') { %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4">
      Orçamento rejeitado.
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <% if (budgets && budgets.length > 0) { %>
    <div class="space-y-4">
      <% budgets.forEach(budget => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-800"><%= budget.title %></h3>
              <p class="text-gray-600 mt-2"><%= budget.description %></p>
              
              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="text-gray-500">Criado em:</p>
                  <p class="font-medium"><%= new Date(budget.created_at).toLocaleString('pt-BR') %></p>
                </div>
                <div>
                  <p class="text-gray-500">Solicitado por:</p>
                  <p class="font-medium"><%= budget.requested_by_name || 'N/A' %></p>
                </div>
                <% if (budget.estimated_value) { %>
                  <div>
                    <p class="text-gray-500">Valor estimado:</p>
                    <p class="font-semibold text-blue-600">R$ <%= parseFloat(budget.estimated_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                  </div>
                <% } %>
                <% if (budget.financeiro_notes) { %>
                  <div>
                    <p class="text-gray-500">Observações do Financeiro:</p>
                    <p class="font-medium"><%= budget.financeiro_notes %></p>
                  </div>
                <% } %>
                <% if (budget.priority) { %>
                  <div>
                    <p class="text-gray-500">Prioridade:</p>
                    <span class="px-2 py-1 rounded text-xs font-semibold <%= budget.priority === 'URGENTE' ? 'bg-red-100 text-red-800' : budget.priority === 'ALTA' ? 'bg-orange-100 text-orange-800' : 'bg-gray-100 text-gray-800' %>">
                      <%= budget.priority %>
                    </span>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Lista de Orçamentos (Quotes) -->
          <% if (budget.quotes && budget.quotes.length > 0) { %>
            <div class="border-t pt-4 mt-4">
              <h4 class="text-md font-semibold text-gray-800 mb-4">Orçamentos Recebidos:</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                <% budget.quotes.forEach((quote, index) => { %>
                  <div class="border-2 <%= quote.status === 'APPROVED' ? 'border-green-500 bg-green-50' : quote.status === 'REJECTED' ? 'border-red-300 bg-red-50' : 'border-gray-300' %> rounded-lg p-4">
                    <div class="flex items-start justify-between mb-2">
                      <div class="flex-1">
                        <h5 class="font-semibold text-gray-800"><%= quote.supplier_name %></h5>
                        <% if (quote.supplier_contact) { %>
                          <p class="text-xs text-gray-600 mt-1"><%= quote.supplier_contact %></p>
                        <% } %>
                      </div>
                      <% if (quote.status === 'APPROVED') { %>
                        <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded">Aprovado</span>
                      <% } else if (quote.status === 'REJECTED') { %>
                        <span class="px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded">Rejeitado</span>
                      <% } %>
                    </div>
                    <div class="mt-3">
                      <p class="text-2xl font-bold text-blue-600">R$ <%= parseFloat(quote.quote_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                      <% if (quote.quote_description) { %>
                        <p class="text-sm text-gray-600 mt-2"><%= quote.quote_description %></p>
                      <% } %>
                      <% if (quote.quote_validity_date) { %>
                        <p class="text-xs text-gray-500 mt-2">Válido até: <%= new Date(quote.quote_validity_date).toLocaleDateString('pt-BR') %></p>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Formulário de Aprovação -->
          <div class="border-t pt-4 mt-4">
            <% 
              // Define pendingQuotes no escopo do budget para usar no botão
              let pendingQuotes = [];
              if (budget.quotes && budget.quotes.length > 0) {
                // Filtra apenas quotes pendentes para exibição
                // Um quote está pendente se NÃO for APPROVED ou REJECTED
                pendingQuotes = budget.quotes.filter(q => {
                  const status = (q.status || '').toString().toUpperCase().trim();
                  return status !== 'APPROVED' && status !== 'REJECTED';
                });
              }
            %>
            <form method="POST" action="/sindico/orcamentos/<%= budget.id %>/aprovar" class="mb-4">
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Selecione o Orçamento para Aprovar <span class="text-red-500">*</span>
                </label>
                <% if (budget.quotes && budget.quotes.length > 0) { %>
                  <% if (pendingQuotes.length > 0) { %>
                    <div class="space-y-2">
                      <% pendingQuotes.forEach((quote) => { %>
                        <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition-all">
                          <input
                            type="radio"
                            name="approvedQuoteId"
                            value="<%= quote.id %>"
                            required
                            class="mr-3 text-blue-600 focus:ring-blue-500"
                            onchange="updateApprovedValue(<%= quote.quote_value %>)"
                          />
                          <div class="flex-1">
                            <div class="flex items-center justify-between">
                              <span class="font-semibold text-gray-800"><%= quote.supplier_name %></span>
                              <span class="text-lg font-bold text-blue-600">R$ <%= parseFloat(quote.quote_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
                            </div>
                            <% if (quote.quote_description) { %>
                              <p class="text-xs text-gray-600 mt-1"><%= quote.quote_description %></p>
                            <% } %>
                            <% if (quote.quote_validity_date) { %>
                              <p class="text-xs text-gray-500 mt-1">Válido até: <%= new Date(quote.quote_validity_date).toLocaleDateString('pt-BR') %></p>
                            <% } %>
                          </div>
                        </label>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <div class="text-sm text-yellow-600 bg-yellow-50 p-3 rounded border-2 border-yellow-300">
                      <p class="font-semibold mb-2">⚠️ Nenhum orçamento disponível para seleção</p>
                      <p class="text-xs text-gray-700 mt-2 mb-2">
                        <strong>Total de orçamentos:</strong> <%= budget.quotes.length %>
                      </p>
                      <details class="mt-2">
                        <summary class="cursor-pointer text-xs font-semibold text-gray-700 hover:text-gray-900">
                          Ver detalhes dos status (clique para expandir)
                        </summary>
                        <div class="mt-2 p-2 bg-white rounded border border-yellow-200">
                          <% budget.quotes.forEach((q, idx) => { %>
                            <div class="text-xs py-1 border-b border-gray-100">
                              <strong><%= q.supplier_name %></strong> (ID: <%= q.id %>): 
                              <span class="<%= q.status === 'APPROVED' ? 'text-green-600' : q.status === 'REJECTED' ? 'text-red-600' : 'text-gray-600' %>">
                                <strong><%= q.status || 'NULL/UNDEFINED' %></strong>
                              </span>
                              <span class="text-gray-400 ml-2">(tipo: <%= typeof q.status %>)</span>
                            </div>
                          <% }); %>
                        </div>
                      </details>
                    </div>
                  <% } %>
                <% } else { %>
                  <p class="text-sm text-gray-500">Nenhum orçamento disponível para aprovação</p>
                <% } %>
              </div>
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Observações (opcional)
                </label>
                <textarea
                  name="approvalNotes"
                  rows="3"
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="Adicione observações sobre a aprovação..."
                ></textarea>
              </div>
              <button
                type="submit"
                id="approveBtn<%= budget.id %>"
                class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition font-semibold <%= pendingQuotes.length === 0 ? 'opacity-50 cursor-not-allowed' : '' %>"
                <%= pendingQuotes.length === 0 ? 'disabled' : '' %>
              >
                ✓ Aprovar Orçamento Selecionado
              </button>
            </form>
            

            <!-- Formulário de Rejeição -->
            <form method="POST" action="/sindico/orcamentos/<%= budget.id %>/rejeitar" class="border-t pt-4">
              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Motivo da Rejeição <span class="text-red-500">*</span>
                </label>
                <textarea
                  name="rejectionReason"
                  rows="3"
                  required
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                  placeholder="Explique o motivo da rejeição..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700 transition"
              >
                ✗ Rejeitar Orçamento
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <p class="text-gray-500 text-lg">Nenhum orçamento aguardando aprovação</p>
      <p class="text-gray-400 text-sm mt-2">Todos os orçamentos foram processados</p>
    </div>
  <% } %>
</div>

<script>
  function updateApprovedValue(value) {
    // Esta função pode ser usada para atualizar algum campo se necessário
    // Por enquanto, o valor será pego do orçamento selecionado no backend
  }
  
  // Validação de todos os formulários de aprovação
  document.addEventListener('DOMContentLoaded', function() {
    const approveForms = document.querySelectorAll('form[action*="/orcamentos/"][action*="/aprovar"]');
    
    approveForms.forEach(function(form) {
      form.addEventListener('submit', function(e) {
        const selectedQuote = form.querySelector('input[name="approvedQuoteId"]:checked');
        
        if (!selectedQuote) {
          e.preventDefault();
          alert('Por favor, selecione um orçamento para aprovar.');
          return false;
        }
        
        // Confirmação antes de enviar
        if (!confirm('Tem certeza que deseja aprovar este orçamento? Uma saída financeira será criada automaticamente.')) {
          e.preventDefault();
          return false;
        }
        
        return true;
      });
    });
  });
</script>

<%- include('../partials/footer') %>
