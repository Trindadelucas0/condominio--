<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Ocorrências do Condomínio</h1>
    <p class="text-gray-600 mt-2">Visualize todas as ocorrências (abertas e resolvidas)</p>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/sindico/ocorrencias" class="flex gap-4 items-end">
      <div class="flex-1">
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Filtrar por Status</label>
        <select
          id="status"
          name="status"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Todas</option>
          <option value="ABERTA" <%= filters.status === 'ABERTA' ? 'selected' : '' %>>Abertas</option>
          <option value="EM_ATENDIMENTO" <%= filters.status === 'EM_ATENDIMENTO' ? 'selected' : '' %>>Em Atendimento</option>
          <option value="AGUARDANDO_TERCEIRO" <%= filters.status === 'AGUARDANDO_TERCEIRO' ? 'selected' : '' %>>Aguardando Terceiro</option>
          <option value="RESOLVIDA" <%= filters.status === 'RESOLVIDA' ? 'selected' : '' %>>Resolvidas</option>
          <option value="ENCERRADA" <%= filters.status === 'ENCERRADA' ? 'selected' : '' %>>Encerradas</option>
        </select>
      </div>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
        Filtrar
      </button>
      <a href="/sindico/ocorrencias" class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400 transition">
        Limpar
      </a>
    </form>
  </div>

  <!-- Lista de Ocorrências -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (occurrences.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma ocorrência encontrada.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% occurrences.forEach(occurrence => { %>
          <div class="p-6 hover:bg-gray-50 transition">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-lg font-bold text-gray-900">
                    <a href="/sindico/ocorrencias/<%= occurrence.id %>" class="hover:text-blue-600">
                      <%= occurrence.title %>
                    </a>
                  </h3>
                  <span class="px-3 py-1 text-xs font-semibold rounded
                    <%= occurrence.status === 'RESOLVIDA' || occurrence.status === 'ENCERRADA' ? 'bg-green-100 text-green-800' : 
                        occurrence.status === 'EM_ATENDIMENTO' ? 'bg-blue-100 text-blue-800' : 
                        occurrence.status === 'AGUARDANDO_TERCEIRO' ? 'bg-yellow-100 text-yellow-800' : 
                        'bg-red-100 text-red-800' %>">
                    <%= occurrence.status %>
                  </span>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                    <%= occurrence.priority %>
                  </span>
                </div>
                <p class="text-gray-700 mb-2"><%= occurrence.description %></p>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-2">
                  <p><strong>Reportada por:</strong> <%= occurrence.reported_by_name || 'N/A' %></p>
                  <% if (occurrence.location) { %>
                    <p><strong>Local:</strong> <%= occurrence.location %></p>
                  <% } %>
                  <p><strong>Criada em:</strong> <%= new Date(occurrence.created_at).toLocaleString('pt-BR') %></p>
                  <% if (occurrence.resolved_at) { %>
                    <p><strong>Resolvida em:</strong> <%= new Date(occurrence.resolved_at).toLocaleString('pt-BR') %></p>
                  <% } %>
                  <% if (occurrence.assigned_to_name) { %>
                    <p><strong>Atribuída a:</strong> <%= occurrence.assigned_to_name %></p>
                  <% } %>
                </div>
                <!-- Informações de resolução estruturada -->
                <% if (occurrence.status === 'RESOLVIDA' || occurrence.status === 'ENCERRADA') { %>
                  <div class="bg-green-50 border border-green-200 rounded p-3 mt-3">
                    <% if (occurrence.resolution_success !== null) { %>
                      <p class="text-sm text-gray-700">
                        <span class="font-semibold">Resolução bem sucedida:</span> 
                        <%= occurrence.resolution_success ? '✅ Sim' : '❌ Não' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_notes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Notas:</span> <%= occurrence.resolution_notes %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_method) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Método:</span> <%= occurrence.resolution_method %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_cost) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Custo:</span> R$ <%= parseFloat(occurrence.resolution_cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                      </p>
                    <% } %>
                    <% if (occurrence.had_complications) { %>
                      <p class="text-sm text-orange-700 mt-1">
                        <span class="font-semibold">⚠ Complicações:</span> <%= occurrence.complications_description || 'Sim' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_time_minutes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Tempo gasto:</span> <%= occurrence.resolution_time_minutes %> minutos
                      </p>
                    <% } %>
                    <% if (occurrence.preventive_measures) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Medidas preventivas:</span> <%= occurrence.preventive_measures %>
                      </p>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
