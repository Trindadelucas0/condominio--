<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Acompanhar Checklists</h1>
    <p class="text-gray-600 mt-2">Acompanhe os checklists do dia, veja o que foi feito ou não e questione itens não realizados.</p>
  </div>

  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/sindico/checklists-acompanhamento" class="flex items-end gap-4">
      <div class="flex-1">
        <label for="date" class="block text-sm font-medium text-gray-700 mb-2">Data</label>
        <input type="date" id="date" name="date" value="<%= date %>"
          class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Filtrar</button>
      <% if (typeof isToday !== 'undefined' && !isToday) { %>
        <a href="/sindico/checklists-acompanhamento" class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400">Hoje</a>
      <% } %>
    </form>
  </div>

  <% if (!checklists || checklists.length === 0) { %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <p class="text-gray-500 text-lg mb-2">Nenhum checklist nesta data.</p>
      <p class="text-sm text-gray-400">Altere a data ou confira se há modelos ativos que geram checklists neste dia.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% checklists.forEach(checklist => { %>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h3 class="text-lg font-semibold text-white"><%= checklist.model_name || 'Checklist' %></h3>
            <p class="text-blue-100 text-sm mt-1">
              <%= new Date(checklist.scheduled_date).toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
            <p class="text-blue-100 text-sm">Responsável: <%= checklist.assigned_to_name || '—' %></p>
          </div>
          <div class="p-6">
            <div class="mb-4">
              <% if (checklist.status === 'PENDING') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pendente</span>
              <% } else if (checklist.status === 'IN_PROGRESS') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Em Execução</span>
              <% } else if (checklist.status === 'COMPLETED') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Concluído</span>
              <% } else if (checklist.status === 'LATE') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Atrasado</span>
              <% } %>
            </div>
            <div class="mb-4">
              <div class="flex justify-between text-sm text-gray-600 mb-2">
                <span>Progresso</span>
                <span><%= checklist.items_done || 0 %> feitos / <%= checklist.items_not_done || 0 %> não feitos · <%= checklist.items_total || 0 %> total</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <% const pct = checklist.items_total > 0 ? ((checklist.items_done || 0) / checklist.items_total) * 100 : 0; %>
                <div class="bg-blue-600 h-2 rounded-full transition-all" style="width: <%= pct %>%"></div>
              </div>
            </div>
            <a href="/sindico/checklists-acompanhamento/<%= checklist.id %><%= date && date !== '' ? '?date=' + date : '' %>"
              class="block w-full bg-primary-600 text-white px-4 py-2 rounded hover:bg-primary-700 text-center font-medium">
              Ver completo e questionar itens não feitos
            </a>
            <% if (checklist.completed_at) { %>
              <p class="text-xs text-gray-500 mt-3 text-center">Finalizado em <%= new Date(checklist.completed_at).toLocaleString('pt-BR') %></p>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
