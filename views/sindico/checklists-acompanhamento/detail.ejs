<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>
<%
  const totalEvidences = checklist.evidences ? checklist.evidences.length : 0;
  const progressPct = checklist.items_total > 0 ? ((checklist.items_done || 0) / checklist.items_total) * 100 : 0;
  const canQuestion = user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'));
%>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <a href="/sindico/checklists-acompanhamento<%= typeof query !== 'undefined' && query && query.date ? '?date=' + encodeURIComponent(query.date) : '' %>" class="text-blue-600 hover:text-blue-800 mb-2 inline-block">← Voltar para lista</a>
    <h1 class="text-3xl font-bold text-gray-800"><%= checklist.model_name || 'Checklist' %></h1>
    <p class="text-gray-600 mt-2">
      <%= new Date(checklist.scheduled_date).toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </p>
    <p class="text-sm text-gray-500">Responsável: <strong><%= checklist.assigned_to_name || '—' %></strong></p>
    <% if (checklist.model_description) { %>
      <p class="text-sm text-gray-500 mt-1"><%= checklist.model_description %></p>
    <% } %>
  </div>

  <% if (typeof query !== 'undefined' && query.success === 'questionar') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Questionamento registrado.
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= typeof query.error === 'string' ? decodeURIComponent(query.error) : query.error %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div>
        <% if (checklist.status === 'PENDING') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">⏳ Pendente</span>
        <% } else if (checklist.status === 'IN_PROGRESS') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">🔄 Em Execução</span>
        <% } else if (checklist.status === 'COMPLETED') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">✅ Concluído</span>
          <p class="text-sm text-gray-600 mt-2">Finalizado em <%= new Date(checklist.completed_at).toLocaleString('pt-BR') %></p>
        <% } else if (checklist.status === 'LATE') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">⚠️ Atrasado</span>
        <% } %>
      </div>
      <div class="text-right">
        <div class="text-sm text-gray-600 mb-1">Progresso</div>
        <div class="text-2xl font-bold text-blue-600"><%= checklist.items_done || 0 %> feitos · <%= checklist.items_not_done || 0 %> não feitos / <%= checklist.items_total || 0 %></div>
        <div class="w-48 bg-gray-200 rounded-full h-2 mt-2">
          <div class="bg-blue-600 h-2 rounded-full" style="width: <%= progressPct %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Itens do checklist</h2>
    <% if (!checklist.items || checklist.items.length === 0) { %>
      <p class="text-gray-500">Nenhum item.</p>
    <% } else { %>
      <div class="space-y-4">
        <% checklist.items.forEach((item, index) => {
          const rowBg = item.status === 'DONE' ? 'bg-green-50' : item.status === 'NOT_DONE' ? 'bg-red-50' : 'bg-white';
        %>
          <div class="border border-gray-300 rounded-lg p-4 <%= rowBg %>">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-sm font-medium text-gray-500">#<%= index + 1 %></span>
              <h3 class="text-lg font-semibold text-gray-800"><%= item.item_name %></h3>
              <% if (item.status === 'PENDING') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Pendente</span>
              <% } else if (item.status === 'DONE') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">✓ Feito</span>
              <% } else { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">✗ Não Feito</span>
              <% } %>
            </div>

            <% if (item.comment) { %>
              <div class="bg-gray-100 rounded p-3 mb-3">
                <p class="text-sm text-gray-700"><strong>Observação do responsável:</strong> <%= item.comment %></p>
              </div>
            <% } %>

            <% if (item.sindico_question) { %>
              <div class="bg-amber-50 border border-amber-200 rounded p-3 mb-3">
                <% if (item.sindico_exige_resposta) { %>
                  <p class="text-sm font-medium text-amber-900 mb-1">📋 Seu questionamento — <span class="text-amber-800">Solicita resposta</span></p>
                  <p class="text-xs text-amber-800 mb-1">Você solicitou que o responsável responda.</p>
                <% } else { %>
                  <p class="text-sm font-medium text-amber-900 mb-1">💬 Seu comentário — <span class="text-gray-600">Só para ciência</span></p>
                  <p class="text-xs text-gray-600 mb-1">Apenas comentário (não exige resposta).</p>
                <% } %>
                <p class="text-sm text-gray-800 mt-2"><%= item.sindico_question %></p>
                <% if (item.sindico_question_at) { %>
                  <p class="text-xs text-gray-500 mt-1"><%= new Date(item.sindico_question_at).toLocaleString('pt-BR') %></p>
                <% } %>
                <% if (item.resposta_questionamento) { %>
                  <div class="mt-3 pt-3 border-t border-amber-200">
                    <p class="text-sm font-medium text-gray-700 mb-1">Resposta do responsável:</p>
                    <p class="text-sm text-gray-800"><%= item.resposta_questionamento %></p>
                    <% if (item.resposta_questionamento_at) { %>
                      <p class="text-xs text-gray-500 mt-1"><%= new Date(item.resposta_questionamento_at).toLocaleString('pt-BR') %></p>
                    <% } %>
                  </div>
                <% } else if (item.sindico_exige_resposta) { %>
                  <p class="text-xs text-amber-700 mt-2 italic">Aguardando resposta do responsável.</p>
                <% } %>
              </div>
            <% } %>

            <% if (canQuestion) { %>
              <div class="mt-3 pt-3 border-t border-gray-200">
                <% 
                  const formTitle = item.status === 'NOT_DONE' ? 'Questionar / comentário (item não feito)' : 
                    item.status === 'DONE' ? 'Comentário do síndico (item feito)' : 'Comentário do síndico (item pendente)';
                %>
                <p class="text-sm font-medium text-gray-700 mb-2"><%= formTitle %></p>
                <form method="POST" action="/sindico/checklists-acompanhamento/items/<%= item.id %>/questionar" class="space-y-3">
                  <% if (typeof query !== 'undefined' && query && query.date) { %>
                    <input type="hidden" name="date" value="<%= query.date %>">
                  <% } %>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-2">O que você deseja?</label>
                    <div class="flex flex-wrap gap-4">
                      <label class="inline-flex items-center">
                        <input type="radio" name="exigeResposta" value="1" class="rounded-full border-gray-300 text-amber-600 focus:ring-amber-500" <%= item.sindico_exige_resposta ? 'checked' : '' %>>
                        <span class="ml-2 text-sm text-gray-700">Solicitar resposta</span>
                      </label>
                      <label class="inline-flex items-center">
                        <input type="radio" name="exigeResposta" value="0" class="rounded-full border-gray-300 text-amber-600 focus:ring-amber-500" <%= !item.sindico_exige_resposta ? 'checked' : '' %>>
                        <span class="ml-2 text-sm text-gray-700">Só comentário</span>
                      </label>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Solicitar resposta = o responsável deve responder. Só comentário = apenas mostrar para ciência.</p>
                  </div>
                  <div class="flex gap-2 flex-wrap items-end">
                    <textarea name="question" rows="2" placeholder="<%= item.status === 'NOT_DONE' ? 'Ex: Por que não foi realizado? Solicito justificativa.' : 'Ex: Comentário ou observação sobre este item.' %>"
                      class="flex-1 min-w-0 border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"><%= item.sindico_question || '' %></textarea>
                    <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded font-medium whitespace-nowrap">
                      <%= item.sindico_question ? 'Atualizar' : 'Enviar' %>
                    </button>
                  </div>
                </form>
              </div>
            <% } %>

            <% if (checklist.evidences && checklist.evidences.length > 0) {
              const itemEvs = checklist.evidences.filter(e => e.checklist_item_id === item.id);
              if (itemEvs.length > 0) { %>
                <div class="mt-3">
                  <p class="text-sm font-medium text-gray-700 mb-2">Fotos</p>
                  <div class="flex gap-2 flex-wrap">
                    <% itemEvs.forEach(evidence => {
                      const fp = (evidence.file_path || '').replace(/\\/g, '/');
                      const href = fp.startsWith('uploads') ? '/' + fp : ('/uploads/checklists/' + (evidence.file_name || fp.split('/').pop() || ''));
                    %>
                      <a href="<%= href %>" target="_blank" class="block">
                        <img src="<%= href %>" alt="Evidência" class="w-24 h-24 object-cover rounded border border-gray-300 hover:border-blue-500">
                      </a>
                    <% }); %>
                  </div>
                </div>
              <% }
            } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <% if (checklist.evidences && checklist.evidences.length > 0) { %>
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Imagens (<%= totalEvidences %>)</h2>
      <div class="flex gap-4 flex-wrap">
        <% checklist.evidences.forEach(evidence => {
          const fp = (evidence.file_path || '').replace(/\\/g, '/');
          const href = fp.startsWith('uploads') ? '/' + fp : ('/uploads/checklists/' + (evidence.file_name || fp.split('/').pop() || ''));
        %>
          <a href="<%= href %>" target="_blank" class="block">
            <img src="<%= href %>" alt="Evidência" class="w-32 h-32 object-cover rounded border border-gray-300 hover:border-blue-500">
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
