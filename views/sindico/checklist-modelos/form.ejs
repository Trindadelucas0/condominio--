<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800"><%= model && model.id ? 'Editar Modelo' : 'Novo Modelo de Checklist' %></h1>
      <p class="text-gray-600 mt-2"><%= model && model.id ? 'Atualize as informações do modelo' : 'Crie uma regra que será usada para gerar checklists automaticamente' %></p>
    </div>

    <!-- Mensagem de erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        <p><%= error %></p>
      </div>
    <% } %>

    <!-- Formulário -->
    <div class="bg-white rounded-lg shadow p-6">
      <form method="POST" action="<%= model && model.id ? '/sindico/checklist-modelos/' + model.id : '/sindico/checklist-modelos' %>">
        
        <!-- Informações Básicas -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Informações Básicas</h2>
          
          <!-- Nome -->
          <div class="mb-4">
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Nome do Modelo <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              value="<%= model ? model.name || '' : '' %>"
              placeholder="Ex: Inspeção Zeladoria - Semanal"
              class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <!-- Descrição -->
          <div class="mb-4">
            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
              Descrição
            </label>
            <textarea
              id="description"
              name="description"
              rows="3"
              placeholder="Descreva o propósito deste modelo..."
              class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
            ><%= model ? model.description || '' : '' %></textarea>
          </div>

          <!-- Departamento -->
          <div class="mb-4">
            <label for="department" class="block text-sm font-medium text-gray-700 mb-2">
              Departamento <span class="text-red-500">*</span>
            </label>
            <select
              id="department"
              name="department"
              required
              class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
            >
              <option value="">Selecione...</option>
              <option value="ZELADORIA" <%= model && model.department === 'ZELADORIA' ? 'selected' : '' %>>Zeladoria</option>
              <option value="LIMPEZA" <%= model && model.department === 'LIMPEZA' ? 'selected' : '' %>>Limpeza</option>
            </select>
          </div>

          <!-- Status Ativo -->
          <div class="mb-4">
            <label class="flex items-center">
              <input
                type="checkbox"
                name="isActive"
                value="true"
                <%= !model || model.is_active ? 'checked' : '' %>
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-700">Modelo ativo (gera checklists automaticamente)</span>
            </label>
          </div>
        </div>

        <!-- Dias da Semana -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Dias da Semana <span class="text-red-500">*</span></h2>
          <p class="text-sm text-gray-600 mb-4">Selecione os dias em que os checklists devem ser gerados automaticamente</p>
          
          <div class="grid grid-cols-7 gap-2">
            <% 
              const days = [
                { value: 'sunday', label: 'Dom', dayNum: 0 },
                { value: 'monday', label: 'Seg', dayNum: 1 },
                { value: 'tuesday', label: 'Ter', dayNum: 2 },
                { value: 'wednesday', label: 'Qua', dayNum: 3 },
                { value: 'thursday', label: 'Qui', dayNum: 4 },
                { value: 'friday', label: 'Sex', dayNum: 5 },
                { value: 'saturday', label: 'Sáb', dayNum: 6 }
              ];
              const modelDays = model && model.days_of_week ? model.days_of_week : [];
            %>
            <% days.forEach(day => { %>
              <label class="flex flex-col items-center p-3 border-2 rounded-lg cursor-pointer hover:bg-gray-50 <%= modelDays.includes(day.dayNum) ? 'border-blue-500 bg-blue-50' : 'border-gray-300' %>">
                <input
                  type="checkbox"
                  name="<%= day.value %>"
                  <%= modelDays.includes(day.dayNum) ? 'checked' : '' %>
                  class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mb-2"
                />
                <span class="text-sm font-medium text-gray-700"><%= day.label %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <!-- Configurações -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Configurações</h2>
          
          <div class="space-y-4">
            <label class="flex items-center">
              <input
                type="checkbox"
                name="requiresPhoto"
                value="true"
                <%= !model || model.requires_photo ? 'checked' : '' %>
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-700">Requer foto obrigatória para finalizar checklist</span>
            </label>

            <label class="flex items-center">
              <input
                type="checkbox"
                name="requiresJustification"
                value="true"
                <%= !model || model.requires_justification ? 'checked' : '' %>
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-700">Requer justificativa quando item não foi feito</span>
            </label>

            <div class="pt-4 border-t border-gray-200">
              <h3 class="text-sm font-semibold text-gray-800 mb-2">Atribuição por setor</h3>
              <p class="text-sm text-gray-600 mb-3">Ao selecionar o <strong>Departamento</strong> acima, as pessoas do setor aparecem abaixo. Escolha como atribuir:</p>
              <div class="space-y-4">
                <label class="flex items-center p-3 rounded-lg border-2 border-gray-200 hover:border-blue-300 cursor-pointer transition assign-option" data-mode="todos">
                  <input type="radio" name="assignMode" value="todos" class="rounded-full border-gray-300 text-blue-600 focus:ring-blue-500 assign-mode-radio" <%= allAssigned ? 'checked' : '' %>>
                  <span class="ml-3">
                    <strong class="text-gray-800">Atribuir a todos do setor</strong>
                    <span class="block text-sm text-gray-500">Todos do departamento selecionado recebem este checklist.</span>
                  </span>
                </label>
                <label class="flex items-center p-3 rounded-lg border-2 border-gray-200 hover:border-blue-300 cursor-pointer transition assign-option" data-mode="especificas">
                  <input type="radio" name="assignMode" value="especificas" class="rounded-full border-gray-300 text-blue-600 focus:ring-blue-500 assign-mode-radio" <%= !allAssigned ? 'checked' : '' %>>
                  <span class="ml-3">
                    <strong class="text-gray-800">Atribuir a pessoas específicas</strong>
                    <span class="block text-sm text-gray-500">Escolha quem deve receber. Com 10 no operacional, vincule só para quem quiser.</span>
                  </span>
                </label>
              </div>
              <input type="hidden" name="assignAllSetor" id="assignAllSetor" value="<%= allAssigned ? '1' : '0' %>">
              <% 
                const usersOp = typeof usersOperacional !== 'undefined' ? usersOperacional : [];
                const usersLp = typeof usersLimpeza !== 'undefined' ? usersLimpeza : [];
                const dep = model && model.department ? model.department : 'ZELADORIA';
                const ids = model && model.assigned_user_ids ? model.assigned_user_ids : [];
                const usersDept = dep === 'LIMPEZA' ? usersLp : usersOp;
                const allAssigned = usersDept.length > 0 && ids.length === usersDept.length && usersDept.every(u => ids.includes(u.id));
              %>
              <div id="assign-container" class="mt-4 pt-4 border-t border-gray-200">
                <p class="text-sm font-medium text-gray-700 mb-2">Pessoas do setor <span id="assign-setor-label"><%= dep === 'ZELADORIA' ? 'Zeladoria (Operacional)' : 'Limpeza' %></span>:</p>
                <div id="assign-zeladoria" class="<%= dep === 'ZELADORIA' ? '' : 'hidden' %>">
                  <% if (usersOp.length === 0) { %>
                    <p class="text-sm text-amber-600">Nenhum usuário operacional cadastrado no condomínio.</p>
                  <% } else { %>
                    <div class="flex flex-wrap gap-3" id="assign-checkboxes-zeladoria">
                      <% usersOp.forEach(u => { %>
                        <label class="assign-person-label inline-flex items-center">
                          <input type="checkbox" name="assignedUserIdsZeladoria" value="<%= u.id %>" class="assign-person-cb rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-dept="zeladoria" <%= ids.includes(u.id) && !allAssigned ? 'checked' : (allAssigned ? 'checked' : '') %>>
                          <span class="ml-2 text-sm text-gray-700"><%= u.full_name %></span>
                        </label>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
                <div id="assign-limpeza" class="<%= dep === 'LIMPEZA' ? '' : 'hidden' %>">
                  <% if (usersLp.length === 0) { %>
                    <p class="text-sm text-amber-600">Nenhum usuário de limpeza cadastrado no condomínio.</p>
                  <% } else { %>
                    <div class="flex flex-wrap gap-3" id="assign-checkboxes-limpeza">
                      <% usersLp.forEach(u => { %>
                        <label class="assign-person-label inline-flex items-center">
                          <input type="checkbox" name="assignedUserIdsLimpeza" value="<%= u.id %>" class="assign-person-cb rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-dept="limpeza" <%= ids.includes(u.id) && !allAssigned ? 'checked' : (allAssigned ? 'checked' : '') %>>
                          <span class="ml-2 text-sm text-gray-700"><%= u.full_name %></span>
                        </label>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Itens do Checklist -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Itens do Checklist <span class="text-red-500">*</span></h2>
          <p class="text-sm text-gray-600 mb-4">Adicione os itens que devem ser verificados em cada checklist gerado</p>
          
          <div id="items-container" class="space-y-3">
            <% 
              const items = model && model.items ? model.items : [{ name: '', order: 0, requiresPhoto: false }];
              items.forEach((item, index) => { %>
                <div class="flex gap-3 items-start p-4 border border-gray-300 rounded-lg item-row">
                  <div class="flex-1">
                    <input
                      type="text"
                      name="items[<%= index %>][name]"
                      placeholder="Ex: Verificar lâmpadas"
                      value="<%= item.name || '' %>"
                      required
                      class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                  <div>
                    <input
                      type="number"
                      name="items[<%= index %>][order]"
                      value="<%= item.item_order || index %>"
                      min="0"
                      placeholder="Ordem"
                      class="w-20 border border-gray-300 rounded-md px-2 py-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                  <label class="flex items-center mt-2">
                    <input
                      type="checkbox"
                      name="items[<%= index %>][requiresPhoto]"
                      value="true"
                      <%= item.requires_photo ? 'checked' : '' %>
                      class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                    />
                    <span class="ml-2 text-xs text-gray-600">Foto</span>
                  </label>
                  <button type="button" onclick="removeItem(this)" class="text-red-600 hover:text-red-800 mt-2 <%= items.length === 1 ? 'hidden' : '' %>">
                    ✕
                  </button>
                </div>
              <% }); 
            %>
          </div>
          
          <button type="button" onclick="addItem()" class="mt-3 bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300 transition">
            + Adicionar Item
          </button>
        </div>

        <!-- Botões -->
        <div class="flex justify-end gap-4 pt-4 border-t">
          <a href="/sindico/checklist-modelos" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg font-semibold transition">
            Cancelar
          </a>
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg font-semibold transition">
            <%= model && model.id ? 'Atualizar Modelo' : 'Criar Modelo' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
let itemIndex = <%= model && model.items ? model.items.length : 1 %>;

function addItem() {
  const container = document.getElementById('items-container');
  const newItem = document.createElement('div');
  newItem.className = 'flex gap-3 items-start p-4 border border-gray-300 rounded-lg item-row';
  newItem.innerHTML = `
    <div class="flex-1">
      <input
        type="text"
        name="items[${itemIndex}][name]"
        placeholder="Ex: Verificar lâmpadas"
        required
        class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
      />
    </div>
    <div>
      <input
        type="number"
        name="items[${itemIndex}][order]"
        value="${itemIndex}"
        min="0"
        placeholder="Ordem"
        class="w-20 border border-gray-300 rounded-md px-2 py-2 focus:ring-blue-500 focus:border-blue-500"
      />
    </div>
    <label class="flex items-center mt-2">
      <input
        type="checkbox"
        name="items[${itemIndex}][requiresPhoto]"
        value="true"
        class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
      />
      <span class="ml-2 text-xs text-gray-600">Foto</span>
    </label>
    <button type="button" onclick="removeItem(this)" class="text-red-600 hover:text-red-800 mt-2">
      ✕
    </button>
  `;
  container.appendChild(newItem);
  itemIndex++;
  updateRemoveButtons();
}

function removeItem(button) {
  button.closest('.item-row').remove();
  updateRemoveButtons();
}

function updateRemoveButtons() {
  const rows = document.querySelectorAll('.item-row');
  rows.forEach(row => {
    const removeBtn = row.querySelector('button[onclick*="removeItem"]');
    if (removeBtn) {
      removeBtn.style.display = rows.length === 1 ? 'none' : 'block';
    }
  });
}

(function() {
  const dept = document.getElementById('department');
  const zel = document.getElementById('assign-zeladoria');
  const lp = document.getElementById('assign-limpeza');
  const label = document.getElementById('assign-setor-label');
  const assignAllInput = document.getElementById('assignAllSetor');
  const radTodos = document.querySelector('input[name="assignMode"][value="todos"]');
  const radEspecificas = document.querySelector('input[name="assignMode"][value="especificas"]');

  function getVisibleCheckboxes() {
    if (!zel || !lp) return [];
    const isZel = !zel.classList.contains('hidden');
    const container = isZel ? zel : lp;
    return [].slice.call(container.querySelectorAll('input.assign-person-cb'));
  }

  function applyAssignMode() {
    const isTodos = radTodos && radTodos.checked;
    const cbs = getVisibleCheckboxes();
    if (assignAllInput) assignAllInput.value = isTodos ? '1' : '0';
    cbs.forEach(function(cb) {
      cb.disabled = isTodos;
      if (isTodos) cb.checked = true;
    });
  }

  function toggleDept() {
    const v = (dept && dept.value) || 'ZELADORIA';
    if (label) label.textContent = v === 'LIMPEZA' ? 'Limpeza' : 'Zeladoria (Operacional)';
    if (zel && lp) {
      if (v === 'LIMPEZA') {
        zel.classList.add('hidden');
        lp.classList.remove('hidden');
        zel.querySelectorAll('input.assign-person-cb').forEach(function(c) { c.disabled = true; });
        lp.querySelectorAll('input.assign-person-cb').forEach(function(c) { c.disabled = false; });
      } else {
        zel.classList.remove('hidden');
        lp.classList.add('hidden');
        lp.querySelectorAll('input.assign-person-cb').forEach(function(c) { c.disabled = true; });
        zel.querySelectorAll('input.assign-person-cb').forEach(function(c) { c.disabled = false; });
      }
    }
    applyAssignMode();
  }

  if (dept) dept.addEventListener('change', toggleDept);
  if (radTodos) radTodos.addEventListener('change', applyAssignMode);
  if (radEspecificas) radEspecificas.addEventListener('change', applyAssignMode);

  toggleDept();
  applyAssignMode();
})();
</script>

<%- include('../../partials/footer') %>
