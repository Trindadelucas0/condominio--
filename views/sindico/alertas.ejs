<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Alertas</h1>
      <p class="text-gray-600 mt-2">Alertas e notificações do sistema</p>
    </div>
    <div class="flex space-x-2">
      <a href="/sindico/alertas?resolved=false" class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
        Não Resolvidos
      </a>
      <a href="/sindico/alertas" class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
        Todos
      </a>
    </div>
  </div>

  <!-- Busca e Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/sindico/alertas" class="flex gap-4 items-end">
      <div class="flex-1">
        <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
        <input 
          type="text" 
          id="search" 
          name="search" 
          value="<%= filters.search || '' %>"
          placeholder="Buscar por título, mensagem..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
        />
      </div>
      <div class="w-48">
        <label for="severity" class="block text-sm font-medium text-gray-700 mb-1">Severidade</label>
        <select 
          id="severity" 
          name="severity" 
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
        >
          <option value="">Todas</option>
          <option value="CRITICAL" <%= filters.severity === 'CRITICAL' ? 'selected' : '' %>>Crítico</option>
          <option value="WARNING" <%= filters.severity === 'WARNING' ? 'selected' : '' %>>Aviso</option>
          <option value="INFO" <%= filters.severity === 'INFO' ? 'selected' : '' %>>Info</option>
        </select>
      </div>
      <div class="w-48">
        <label for="resolved" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select 
          id="resolved" 
          name="resolved" 
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
        >
          <option value="">Todos</option>
          <option value="false" <%= filters.resolved === false ? 'selected' : '' %>>Não Resolvidos</option>
          <option value="true" <%= filters.resolved === true ? 'selected' : '' %>>Resolvidos</option>
        </select>
      </div>
      <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
        🔍 Buscar
      </button>
      <a href="/sindico/alertas" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
        Limpar
      </a>
    </form>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'resolved') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Alerta resolvido com sucesso!
    </div>
  <% } %>

  <!-- Lista de alertas -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% 
      // Compatibilidade: alerts pode vir diretamente ou como result.alerts
      const alertList = alerts && Array.isArray(alerts) ? alerts : (typeof alerts !== 'undefined' && alerts.alerts ? alerts.alerts : []);
      const alertPagination = alerts && alerts.pagination ? alerts.pagination : pagination;
    %>
    <% if (alertList.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhum alerta encontrado.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% alertList.forEach(alert => { %>
          <div class="p-6">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <% if (alert.severity === 'CRITICAL') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-red-100 text-red-800">
                      CRÍTICO
                    </span>
                  <% } else if (alert.severity === 'WARNING') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800">
                      AVISO
                    </span>
                  <% } else { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                      INFO
                    </span>
                  <% } %>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                    <%= alert.alert_type %>
                  </span>
                  <% if (alert.resolved) { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-green-100 text-green-800">
                      RESOLVIDO
                    </span>
                  <% } %>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= alert.title %></h3>
                <p class="text-gray-700 mb-2"><%= alert.message %></p>
                <p class="text-sm text-gray-500">
                  Criado em <%= new Date(alert.created_at).toLocaleString('pt-BR') %>
                  <% if (alert.resolved && alert.resolved_by_name) { %>
                    • Resolvido por <strong><%= alert.resolved_by_name %></strong> em 
                    <%= new Date(alert.resolved_at).toLocaleString('pt-BR') %>
                  <% } %>
                </p>
              </div>
              <% if (!alert.resolved) { %>
                <form method="POST" action="/sindico/alertas/<%= alert.id %>/resolver" class="ml-4">
                  <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition">
                    Marcar como Resolvido
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Paginação -->
  <% if (alertPagination && alertPagination.totalPages > 1) { %>
    <div class="bg-white rounded-lg shadow p-4 mt-6">
      <div class="flex items-center justify-between">
        <div class="text-sm text-gray-600">
          Mostrando <strong><%= ((alertPagination.currentPage - 1) * alertPagination.perPage) + 1 %></strong> até 
          <strong><%= Math.min(alertPagination.currentPage * alertPagination.perPage, alertPagination.totalRecords) %></strong> 
          de <strong><%= alertPagination.totalRecords %></strong> alertas
        </div>
        <div class="flex items-center space-x-2">
          <% 
            const queryParams = new URLSearchParams();
            if (filters.search) queryParams.set('search', filters.search);
            if (filters.severity) queryParams.set('severity', filters.severity);
            if (filters.resolved !== undefined) queryParams.set('resolved', filters.resolved);
            const queryString = queryParams.toString();
          %>
          <% if (alertPagination.hasPrev) { %>
            <a href="/sindico/alertas?page=<%= alertPagination.currentPage - 1 %><%= queryString ? '&' + queryString : '' %>" 
               class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
              ← Anterior
            </a>
          <% } %>
          <% if (alertPagination.hasNext) { %>
            <a href="/sindico/alertas?page=<%= alertPagination.currentPage + 1 %><%= queryString ? '&' + queryString : '' %>" 
               class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
              Próxima →
            </a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
