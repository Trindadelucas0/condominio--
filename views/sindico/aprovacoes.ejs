<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.02);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .pulse-animation {
    animation: pulse 2s ease-in-out infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-purple-50/30 to-pink-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Aprovações Pendentes (Síndico)'; %>
    <% var resumo = ['Aqui aparecem solicitações que precisam da sua aprovação: despesas acima do limite, orçamentos, etc.', 'Aprove ou rejeite cada item. Aprovado segue o fluxo; rejeitado volta para quem enviou.', 'Use busca e filtros. Relatórios em Excel e PDF estão disponíveis.', 'Despesas aprovadas pelo síndico podem ser pagas em Despesas pelo financeiro.']; %>
    <% var helpModalContent = '<p><strong>Aprovações Pendentes</strong> são itens que exigem OK do síndico: despesas acima do limite do financeiro, orçamentos, entradas quando aplicável. Aprove ou rejeite; aprovado segue; rejeitado volta para correção. Você pode exportar relatórios em Excel e PDF.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-purple-900 to-gray-900 bg-clip-text text-transparent">
              Aprovações Pendentes
            </h1>
            <p class="text-gray-600 mt-1">Revisar e aprovar solicitações</p>
          </div>
        </div>
        <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Busca e Ações -->
    <div class="bg-white rounded-2xl shadow-xl p-6 mb-6 animate-slide-in">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-800">Busca e Relatórios</h2>
        <div class="flex gap-2">
          <a href="/sindico/aprovacoes/relatorio?format=excel" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg font-semibold transition-all duration-200 inline-flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>📊 Excel</span>
          </a>
          <a href="/sindico/aprovacoes/relatorio?format=pdf" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-semibold transition-all duration-200 inline-flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            <span>📄 PDF</span>
          </a>
        </div>
      </div>
      <form method="GET" action="/sindico/aprovacoes" class="flex flex-wrap items-end gap-4">
        <div class="flex-1 min-w-[300px]">
          <label for="search" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Buscar
          </label>
          <input
            type="text"
            id="search"
            name="search"
            value="<%= filters.search || '' %>"
            placeholder="Buscar por tipo, descrição, valor..."
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all duration-200"
          />
        </div>
        <button type="submit" class="px-6 py-3 bg-purple-600 text-white rounded-xl font-semibold hover:bg-purple-700 transition-colors">
          🔍 Buscar
        </button>
        <a href="/sindico/aprovacoes" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-colors">
          Limpar
        </a>
      </form>
    </div>

    <!-- Mensagens -->
    <% if (typeof query !== 'undefined' && query.success === 'processed') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Aprovação processada com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.error) { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-red-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-red-800">Erro</p>
            <p class="text-sm text-red-600"><%= decodeURIComponent(query.error) %></p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Lista de Aprovações -->
    <div class="space-y-4">
      <% 
        // Compatibilidade: approvals pode vir diretamente ou como result.approvals
        const approvalList = approvals && Array.isArray(approvals) ? approvals : (typeof approvals !== 'undefined' && approvals.approvals ? approvals.approvals : []);
        const approvalPagination = pagination || (approvals && approvals.pagination ? approvals.pagination : null);
      %>
      <% if (approvalList.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center animate-slide-in">
          <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-full p-6 w-24 h-24 mx-auto mb-4 flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <p class="text-xl font-semibold text-gray-700">Nenhuma aprovação pendente no momento.</p>
          <p class="text-gray-500 mt-2">Todas as solicitações foram processadas!</p>
        </div>
      <% } else { %>
        <% approvalList.forEach((approval, index) => { %>
          <div class="bg-white rounded-2xl shadow-xl p-6 card-hover-effect animate-slide-in border-l-4 border-yellow-500" style="animation-delay: <%= index * 0.05 %>s">
            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-gradient-to-r from-yellow-500 to-amber-600 text-white shadow-md">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <%= approval.approval_type %>
                  </span>
                  <% if (approval.requested_amount) { %>
                    <span class="text-2xl font-bold bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
                      R$ <%= parseFloat(approval.requested_amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                    </span>
                  <% } %>
                </div>
                
                <p class="text-gray-700 mb-4 leading-relaxed"><%= approval.description %></p>
                
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span>Solicitado por: <strong class="text-gray-900"><%= approval.requested_by_name || 'Sistema' %></strong></span>
                  </div>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span>Em <%= new Date(approval.created_at).toLocaleDateString('pt-BR') %></span>
                  </div>
                </div>
              </div>
              
              <div class="flex flex-col sm:flex-row gap-3 md:ml-4">
                <form method="POST" action="/sindico/aprovacoes/<%= approval.id %>/processar" class="inline">
                  <input type="hidden" name="action" value="APPROVE">
                  <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2 w-full sm:w-auto">
                    <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                    <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="relative z-10">Aprovar</span>
                  </button>
                </form>
                <button 
                  onclick="showRejectModal(<%= approval.id %>)"
                  class="group relative overflow-hidden bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2 w-full sm:w-auto"
                >
                  <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                  <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                  <span class="relative z-10">Rejeitar</span>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal de Rejeição Moderno -->
<div id="rejectModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full animate-slide-in">
    <div class="flex items-center space-x-3 mb-6">
      <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-lg p-2">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-gray-900">Rejeitar Aprovação</h3>
    </div>
    <form method="POST" id="rejectForm" action="">
      <input type="hidden" name="action" value="REJECT">
      <div class="mb-6">
        <label for="reason" class="flex items-center text-sm font-bold text-gray-700 mb-2">
          <svg class="w-4 h-4 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
          </svg>
          Motivo da rejeição <span class="text-red-500 ml-1">*</span>
        </label>
        <textarea
          id="reason"
          name="reason"
          rows="4"
          required
          class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 resize-none"
          placeholder="Informe o motivo da rejeição..."
        ></textarea>
      </div>
      <div class="flex justify-end space-x-3">
        <button
          type="button"
          onclick="hideRejectModal()"
          class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span>Cancelar</span>
        </button>
        <button
          type="submit"
          class="group relative overflow-hidden bg-gradient-to-r from-red-600 to-red-700 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
        >
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span class="relative z-10">Rejeitar</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function showRejectModal(approvalId) {
  document.getElementById('rejectForm').action = '/sindico/aprovacoes/' + approvalId + '/processar';
  document.getElementById('rejectModal').classList.remove('hidden');
}

function hideRejectModal() {
  document.getElementById('rejectModal').classList.add('hidden');
  document.getElementById('reason').value = '';
}
</script>

<%- include('../partials/footer') %>
