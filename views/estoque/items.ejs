<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Itens de estoque'; %>
  <% var resumo = ['Lista de itens; cadastre, edite e defina quantidade mínima.', 'Controle entradas e saídas para manter o estoque atualizado.', 'Itens abaixo do mínimo aparecem em alertas no dashboard.']; %>
  <% var helpModalContent = '<p>Gerencie os itens do estoque: cadastre novos, edite quantidades e mínimo. Use entradas e saídas para registrar movimentações. Itens abaixo do mínimo são destacados.</p>'; %>
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Itens de Estoque</h1>
        <p class="text-gray-600 mt-2">Gerencie todos os itens do estoque</p>
      </div>
      <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <a href="/estoque/items/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
      Novo Item
    </a>
  </div>
  <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Categoria</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantidade</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mínimo</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (items && items.length > 0) { %>
          <% items.forEach(item => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= item.name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-gray-500"><%= item.category || '-' %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-semibold <%= item.current_quantity < (item.minimum_quantity || 0) ? 'text-red-600' : 'text-gray-900' %>">
                  <%= item.current_quantity || 0 %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-gray-500"><%= item.minimum_quantity || '-' %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <a href="/estoque/items/<%= item.id %>" class="text-blue-600 hover:text-blue-900 mr-3">Ver</a>
                <a href="/estoque/items/<%= item.id %>/editar" class="text-green-600 hover:text-green-900">Editar</a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-4 text-center text-gray-500">
              Nenhum item cadastrado
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
