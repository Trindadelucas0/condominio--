<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= item ? 'Editar Item' : 'Novo Item de Estoque' %></h1>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="<%= item ? '/estoque/items/' + item.id : '/estoque/items' %>">
      <div class="mb-4">
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
          Nome <span class="text-red-500">*</span>
        </label>
        <input type="text" id="name" name="name" required value="<%= item ? item.name : '' %>" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div class="mb-4">
        <label for="category" class="block text-sm font-medium text-gray-700 mb-1">
          Categoria
        </label>
        <input type="text" id="category" name="category" value="<%= item ? item.category : '' %>" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label for="currentQuantity" class="block text-sm font-medium text-gray-700 mb-1">
            Quantidade Atual
          </label>
          <input type="number" id="currentQuantity" name="currentQuantity" min="0" 
                 value="<%= item ? item.current_quantity : 0 %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label for="minimumQuantity" class="block text-sm font-medium text-gray-700 mb-1">
            Estoque Mínimo
          </label>
          <input type="number" id="minimumQuantity" name="minimumQuantity" min="0" 
                 value="<%= item ? item.minimum_quantity : 0 %>" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>

      <div class="mb-4">
        <label for="unit" class="block text-sm font-medium text-gray-700 mb-1">
          Unidade de Medida
        </label>
        <input type="text" id="unit" name="unit" value="<%= item ? item.unit : 'un' %>" 
               placeholder="Ex: un, kg, litros" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>

      <div class="flex justify-end space-x-4">
        <a href="/estoque/items" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition">
          Cancelar
        </a>
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition">
          <%= item ? 'Atualizar' : 'Criar' %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
