<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Estoque e insumos'; %>
  <% var resumo = ['Visão do estoque: totais e itens abaixo do mínimo.', 'Cadastre itens em Ver Todos; controle entradas e saídas.', 'Alertas mostram itens que precisam de reposição.']; %>
  <% var helpModalContent = '<p>O dashboard mostra totais e itens abaixo do mínimo. Cadastre itens e controle entradas/saídas em Ver Todos. Use os alertas para repor estoque.</p>'; %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="page-title">Estoque e Insumos</h1>
      <p class="page-subtitle">Gestão de estoque do condomínio</p>
    </div>
    <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Alertas de estoque baixo -->
  <% if (itemsBelowMinimum && itemsBelowMinimum.length > 0) { %>
    <div class="alert-warning">
      <strong>Atenção:</strong> <%= itemsBelowMinimum.length %> item(ns) abaixo do estoque mínimo
      <a href="/estoque/items?belowMinimum=true" class="underline ml-2 hover:text-yellow-800 transition-colors duration-200">Ver itens</a>
    </div>
  <% } %>

  <!-- Estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="card card-hover">
      <p class="text-gray-600 text-sm font-medium">Total de Itens</p>
      <p class="text-3xl font-bold text-primary-600 mt-2"><%= items ? items.length : 0 %></p>
    </div>
    <div class="card card-hover">
      <p class="text-gray-600 text-sm font-medium">Itens Abaixo do Mínimo</p>
      <p class="text-3xl font-bold text-yellow-600 mt-2"><%= itemsBelowMinimum ? itemsBelowMinimum.length : 0 %></p>
    </div>
    <div class="card card-hover">
      <p class="text-gray-600 text-sm font-medium">Ações Rápidas</p>
      <a href="/estoque/items/novo" class="text-primary-600 text-sm mt-2 inline-block hover:text-primary-700 transition-colors duration-200">
        Novo Item →
      </a>
    </div>
  </div>

  <!-- Lista de itens -->
  <div class="card">
    <div class="p-6 border-b">
      <div class="flex justify-between items-center">
        <h2 class="text-xl font-bold text-gray-800">Itens de Estoque</h2>
        <a href="/estoque/items" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
          Ver Todos
        </a>
      </div>
    </div>
    <div class="p-6">
      <% if (items && items.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% items.slice(0, 6).forEach(item => { %>
            <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-all duration-200">
              <h3 class="font-semibold text-gray-800"><%= item.name %></h3>
              <p class="text-sm text-gray-600 mt-1">Quantidade: <%= item.current_quantity || 0 %></p>
              <% if (item.minimum_quantity && item.current_quantity < item.minimum_quantity) { %>
                <span class="badge-warning mt-1 block">Abaixo do mínimo!</span>
              <% } %>
              <a href="/estoque/items/<%= item.id %>" class="text-primary-600 text-sm mt-2 inline-block hover:text-primary-700 transition-colors duration-200">
                Ver detalhes →
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-gray-500 text-center py-8">Nenhum item cadastrado</p>
      <% } %>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
