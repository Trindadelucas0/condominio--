<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= usuario ? 'Editar Usuário' : 'Novo Usuário' %></h1>
    <p class="text-gray-600 mt-2"><%= usuario ? 'Atualize as informações do usuário' : 'Preencha os dados para criar um novo usuário' %></p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <% 
      // Usa formData se disponível (após erro), senão usa usuario
      const data = typeof formData !== 'undefined' && formData ? formData : (usuario || {});
      const isEdit = usuario && usuario.id;
    %>
    <form method="POST" action="<%= isEdit ? '/master/usuarios/' + usuario.id : '/master/usuarios' %>">
      <!-- Nome Completo -->
      <div class="mb-4">
        <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">
          Nome Completo <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          value="<%= data.fullName || (usuario ? usuario.full_name : '') %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: João da Silva"
        />
      </div>

      <!-- Username -->
      <div class="mb-4">
        <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
          Usuário <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="username"
          name="username"
          required
          value="<%= data.username || (usuario ? usuario.username : '') %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: joao.silva"
        />
      </div>

      <!-- Email -->
      <div class="mb-4">
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          value="<%= usuario ? usuario.email : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: joao@email.com"
        />
      </div>

      <!-- Senha (apenas na criação) -->
      <% if (!usuario) { %>
        <div class="mb-4">
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
            Senha <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Mínimo 6 caracteres"
          />
        </div>
      <% } %>

      <!-- Condomínio -->
      <div class="mb-4">
        <label for="condominiumId" class="block text-sm font-medium text-gray-700 mb-1">
          Condomínio
        </label>
        <select
          id="condominiumId"
          name="condominiumId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Nenhum (Super Master)</option>
          <% condominios.forEach(cond => { %>
          <option
            value="<%= cond.id %>"
            <%= (data.condominiumId == cond.id) || (usuario && usuario.condominium_id == cond.id) ? 'selected' : '' %>
          >
            <%= cond.name %>
          </option>
          <% }); %>
        </select>
      </div>

      <!-- Perfis -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Perfis <span class="text-red-500">*</span>
        </label>
        <div class="space-y-2 border border-gray-300 rounded-md p-3 max-h-48 overflow-y-auto">
          <% 
            // Prepara array de roleIds selecionados
            let selectedRoleIds = [];
            if (typeof formData !== 'undefined' && formData && formData.roleIds) {
              selectedRoleIds = Array.isArray(formData.roleIds) ? formData.roleIds.map(id => parseInt(id)) : [parseInt(formData.roleIds)];
            } else if (usuario && usuario.roles) {
              selectedRoleIds = usuario.roles.map(r => typeof r === 'object' ? r.id : r);
            }
          %>
          <% roles.forEach(role => { %>
            <label class="flex items-center">
              <input
                type="checkbox"
                name="roleIds"
                value="<%= role.id %>"
                <%= selectedRoleIds.includes(role.id) ? 'checked' : '' %>
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
              />
              <span class="ml-2 text-sm text-gray-700">
                <strong><%= role.name %></strong>
                <% if (role.description) { %>
                  - <%= role.description %>
                <% } %>
              </span>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Status (apenas na edição) -->
      <% if (usuario) { %>
        <div class="mb-4">
          <label class="flex items-center">
            <input
              type="checkbox"
              name="active"
              value="true"
              <%= usuario.active ? 'checked' : '' %>
              class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            />
            <span class="ml-2 text-sm text-gray-700">Usuário ativo</span>
          </label>
        </div>
      <% } %>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/master/usuarios"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
        >
          <%= usuario ? 'Atualizar' : 'Criar' %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
