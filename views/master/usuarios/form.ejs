<%- include('../../partials/header', { title: title }) %>
    <%- include('../../partials/navbar', { user: user }) %>

        <main class="flex-grow">
        <div class="container mx-auto px-4 py-8">
            <% var helpModalId = 'modalComoFunciona'; %>
            <% var helpTitle = 'Usuário'; %>
            <% var resumo = ['Preencha nome, usuário, e-mail e senha; associe ao condomínio.', 'Atribua um ou mais perfis (síndico, administrativo, operacional, etc.).', 'Alterações de perfil exigem novo login para o usuário.']; %>
            <% var helpModalContent = '<p>Cadastre ou edite o usuário: dados de acesso e condomínio. Os perfis definem o que ele pode acessar. Após salvar, o usuário pode fazer login.</p>'; %>
            <!-- Cabeçalho -->
            <div class="mb-6 flex flex-wrap items-center gap-3">
                <div>
                    <h1 class="page-title">
                        <%= usuario ? 'Editar Usuário' : 'Novo Usuário' %>
                    </h1>
                    <p class="page-subtitle">
                        <%= usuario ? 'Atualize as informações do usuário' : 'Preencha os dados para criar um novo usuário' %>
                    </p>
                </div>
                <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
            </div>
            <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

            <!-- Mensagem de erro -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-error">
                    <%= error %>
                </div>
            <% } %>

                    <!-- Formulário -->
                    <div class="card max-w-2xl w-full">
                        <% 
                            // Usa formData se disponível (após erro), senão usa usuario
                            const data = typeof formData !== 'undefined' && formData ? formData : (usuario || {});
                            const isEdit = usuario && usuario.id;
                        %>
                            <form method="POST"
                                action="<%= isEdit ? '/master/usuarios/' + usuario.id : '/master/usuarios' %>">
                                <!-- Nome Completo -->
                                <div class="mb-4">
                                    <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">
                                        Nome Completo <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="fullName" name="fullName" required
                                        value="<%= data.fullName || (usuario ? usuario.full_name : '') %>"
                                        class="input-field"
                                        placeholder="Ex: João da Silva" />
                                </div>

                                <!-- Username -->
                                <div class="mb-4">
                                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
                                        Usuário <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="username" name="username" required
                                        value="<%= data.username || (usuario ? usuario.username : '') %>"
                                        class="input-field"
                                        placeholder="Ex: joao.silva" />
                                </div>

                                <!-- Email -->
                                <div class="mb-4">
                                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                                        Email <span class="text-red-500">*</span>
                                    </label>
                                    <input type="email" id="email" name="email" required
                                        value="<%= usuario ? usuario.email : '' %>"
                                        class="input-field"
                                        placeholder="Ex: joao@email.com" />
                                </div>

                                <!-- Senha (apenas na criação) -->
                                <% if (!usuario) { %>
                                    <div class="mb-4">
                                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                                            Senha <span class="text-red-500">*</span>
                                        </label>
                                        <input type="password" id="password" name="password" required
                                            class="input-field"
                                            placeholder="Mínimo 6 caracteres" />
                                    </div>
                                    <% } %>

                                        <!-- Condomínio -->
                                        <div class="mb-4">
                                            <label for="condominiumId"
                                                class="block text-sm font-medium text-gray-700 mb-1">
                                                Condomínio
                                            </label>
                                            <select id="condominiumId" name="condominiumId"
                                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                <option value="">Nenhum (Super Master)</option>
                                                <% condominios.forEach(cond => { %>
                                                    <option value="<%= cond.id %>" 
                                                        <%=(data.condominiumId == cond.id) || (usuario && usuario.condominium_id == cond.id) ? 'selected' : '' %>>
                                                        <%= cond.name %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <!-- Perfis -->
                                        <div class="mb-4">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                                Perfis <span class="text-red-500">*</span>
                                            </label>
                                            <div
                                                class="space-y-2 border border-gray-300 rounded-md p-3 max-h-48 overflow-y-auto">
                                                <% 
                                                    // Prepara array de roleIds selecionados
                                                    let selectedRoleIds = [];
                                                    if (typeof formData !== 'undefined' && formData && formData.roleIds) {
                                                        selectedRoleIds = Array.isArray(formData.roleIds) 
                                                            ? formData.roleIds.map(id => parseInt(id)) 
                                                            : [parseInt(formData.roleIds)];
                                                    } else if (usuario && usuario.roles) {
                                                        selectedRoleIds = usuario.roles.map(r => typeof r === 'object' ? r.id : r);
                                                    }
                                                %>
                                                <% roles.forEach(role => { %>
                                                    <label class="flex items-center">
                                                        <input type="checkbox" name="roleIds" value="<%= role.id %>"
                                                            <%= selectedRoleIds.includes(role.id) ? 'checked' : '' %>
                                                            class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                                                        <span class="ml-2 text-sm text-gray-700">
                                                            <strong><%= role.name %></strong>
                                                            <% if (role.description) { %>
                                                                - <%= role.description %>
                                                            <% } %>
                                                        </span>
                                                    </label>
                                                <% }); %>
                                            </div>
                                        </div>

                                        <!-- Status (apenas na edição) -->
                                        <% if (usuario) { %>
                                            <div class="mb-4">
                                                <label class="flex items-center">
                                                    <input type="checkbox" name="active" value="true" 
                                                        <%= usuario.active ? 'checked' : '' %>
                                                        class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                                                    <span class="ml-2 text-sm text-gray-700">Usuário ativo</span>
                                                </label>
                                            </div>
                                        <% } %>

                                                <!-- Botões -->
                                                <div class="flex flex-col sm:flex-row justify-end gap-3 sm:gap-4 pt-4 border-t border-gray-200">
                                                    <a href="/master/usuarios"
                                                        class="btn-secondary text-center order-2 sm:order-1">
                                                        Cancelar
                                                    </a>
                                                    <button type="submit"
                                                        class="btn-primary text-center order-1 sm:order-2">
                                                        <%= usuario ? 'Atualizar' : 'Criar' %>
                                                    </button>
                                                </div>
                            </form>
                    </div>
        </div>

        <%- include('../../partials/footer') %>