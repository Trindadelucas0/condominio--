<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Usuários'; %>
  <% var resumo = ['Lista de usuários; cadastre ou edite e atribua condomínio e perfis.', 'Perfis definem o que cada usuário pode acessar.', 'Alterações de perfil exigem novo login para o usuário.']; %>
  <% var helpModalContent = '<p>Gerencie usuários: crie, edite, associe ao condomínio e defina perfis (síndico, administrativo, operacional, etc.). Cada perfil tem suas telas e permissões.</p>'; %>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Usuários</h1>
        <p class="text-gray-600 mt-2">Gerencie todos os usuários do sistema</p>
      </div>
      <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <a href="/master/usuarios/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
      Novo Usuário
    </a>
  </div>
  <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagem de sucesso -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <strong>✅ Usuário criado com sucesso!</strong>
      <p class="text-sm mt-1">Os perfis foram atribuídos automaticamente. O usuário já pode fazer login e acessar as funcionalidades do seu perfil.</p>
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <strong>✅ Usuário atualizado com sucesso!</strong>
      <p class="text-sm mt-1">Os perfis foram atualizados automaticamente. Se o usuário estiver logado, ele precisará fazer logout e login novamente para que as novas permissões sejam aplicadas.</p>
    </div>
  <% } %>

  <!-- Tabela de usuários -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuário</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Condomínio</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Perfis</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (usuarios.length === 0) { %>
          <tr>
            <td colspan="7" class="px-6 py-4 text-center text-gray-500">
              Nenhum usuário cadastrado ainda.
            </td>
          </tr>
        <% } else { %>
          <% usuarios.forEach(usuario => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= usuario.full_name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500"><%= usuario.username %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500"><%= usuario.email %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500"><%= usuario.condominium_name || '-' %></div>
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-wrap gap-1">
                  <% usuario.roles.forEach(role => { %>
                    <span class="px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                      <%= role %>
                    </span>
                  <% }); %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (usuario.active) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Inativo
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <a href="/master/usuarios/<%= usuario.id %>/editar" class="text-blue-600 hover:text-blue-900">
                  Editar
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
