<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Central IA Relatórios</h1>
      <p class="text-gray-600 mt-2">Controle de IA e envio de relatórios por condomínio (somente Master)</p>
    </div>
    <a
      href="/master/ia-relatorios<%= includeInactive ? '' : '?includeInactive=true' %>"
      class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition <%= includeInactive ? 'bg-gray-100' : '' %>"
    >
      <%= includeInactive ? 'Mostrar Apenas Ativos' : 'Mostrar Todos' %>
    </a>
  </div>

  <% if (query && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= query.error %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Condomínio</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (!condominios || condominios.length === 0) { %>
            <tr>
              <td colspan="3" class="px-6 py-4 text-center text-gray-500">Nenhum condomínio encontrado.</td>
            </tr>
          <% } else { %>
            <% condominios.forEach((condominio) => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= condominio.name %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (condominio.active) { %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Ativo</span>
                  <% } else { %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Inativo</span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <a href="/master/condominios/<%= condominio.id %>/relatorios" class="text-indigo-600 hover:text-indigo-900">
                    Configurar IA
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <a href="/master/dashboard" class="text-blue-600 hover:text-blue-800">Voltar para Dashboard Master</a>
  </div>
</div>

<%- include('../../partials/footer') %>
