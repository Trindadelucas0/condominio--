<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Condomínios'; %>
  <% var resumo = ['Lista de todos os condomínios cadastrados no sistema.', 'Crie ou edite condomínios; filtre por ativos/inativos.', 'Cada condomínio tem seus próprios usuários e dados.']; %>
  <% var helpModalContent = '<p>Gerencie os condomínios do sistema. Cadastre novos ou edite existentes. Cada condomínio tem dados e usuários independentes.</p>'; %>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Condomínios</h1>
        <p class="text-gray-600 mt-2">Gerencie todos os condomínios do sistema</p>
      </div>
      <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <div class="flex items-center space-x-4">
      <!-- Filtro Ativos/Inativos -->
      <div class="flex items-center space-x-2">
        <a 
          href="/master/condominios<%= includeInactive ? '' : '?includeInactive=true' %>" 
          class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition <%= includeInactive ? 'bg-gray-100' : '' %>"
        >
          <%= includeInactive ? 'Mostrar Apenas Ativos' : 'Mostrar Todos' %>
        </a>
      </div>
      <a href="/master/condominios/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
        Novo Condomínio
      </a>
    </div>
  </div>
  <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagem de sucesso -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Condomínio criado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Condomínio atualizado com sucesso!
    </div>
  <% } %>

  <!-- Tabela de condomínios -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Endereço</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CNPJ</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Criado em</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (condominios.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhum condomínio cadastrado ainda.
            </td>
          </tr>
        <% } else { %>
          <% condominios.forEach(condominio => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= condominio.name %></div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-500"><%= condominio.address || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500"><%= condominio.cnpj || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (condominio.active) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Inativo
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(condominio.created_at).toLocaleDateString('pt-BR') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <a href="/master/condominios/<%= condominio.id %>/editar" class="text-blue-600 hover:text-blue-900 mr-4">
                  Editar
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
