<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Título da página -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Master</h1>
    <p class="text-gray-600 mt-2">Visão geral do sistema</p>
  </div>

  <!-- Cards de estatísticas principais -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total de Condomínios -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Condomínios Ativos</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.totalCondominios %></p>
          <% if (stats.totalCondominiosInativos > 0) { %>
            <p class="text-xs text-gray-500 mt-1"><%= stats.totalCondominiosInativos %> inativos</p>
          <% } %>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Total de Usuários -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Usuários Ativos</p>
          <p class="text-3xl font-bold text-green-600 mt-2"><%= stats.totalUsuarios %></p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Logs 24h -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Logs (24h)</p>
          <p class="text-3xl font-bold text-purple-600 mt-2"><%= stats.logs24h %></p>
          <p class="text-xs text-gray-500 mt-1"><%= stats.logs7d %> nos últimos 7 dias</p>
        </div>
        <div class="bg-purple-100 rounded-full p-4">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Aprovações Pendentes -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Aprovações Pendentes</p>
          <p class="text-3xl font-bold text-orange-600 mt-2"><%= stats.aprovaçõesPendentes %></p>
        </div>
        <div class="bg-orange-100 rounded-full p-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Segunda linha de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Usuários por Perfil -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Usuários por Perfil</h2>
      <div class="space-y-3">
        <% if (stats.usuariosPorPerfil && stats.usuariosPorPerfil.length > 0) { %>
          <% stats.usuariosPorPerfil.forEach(perfil => { %>
            <div class="flex items-center justify-between">
              <span class="text-gray-700"><%= perfil.name %></span>
              <span class="text-blue-600 font-bold text-lg"><%= perfil.total || 0 %></span>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-gray-500 text-sm">Nenhum usuário cadastrado</p>
        <% } %>
      </div>
    </div>

    <!-- Alertas Críticos -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Alertas do Sistema</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-gray-700">Alertas Críticos</span>
          <span class="text-red-600 font-bold text-lg"><%= stats.alertasCriticos %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/master/condominios/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition text-center">
        Criar Novo Condomínio
      </a>
      <a href="/master/usuarios/novo" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition text-center">
        Criar Novo Usuário
      </a>
      <a href="/master/condominios" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition text-center">
        Gerenciar Condomínios
      </a>
      <a href="/master/usuarios" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition text-center">
        Gerenciar Usuários
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
