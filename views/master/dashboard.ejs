<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.5s ease-out;
  }
  
  .stat-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .card-elevate {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-elevate:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-primary-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Master'; %>
    <% var resumo = ['Visão geral: condomínios, usuários e uso do sistema.', 'Gerencie condomínios e usuários pelos atalhos.', 'Acesso restrito ao perfil master.']; %>
    <% var helpModalContent = '<p>O Dashboard Master mostra totais de condomínios e usuários. Use os atalhos para gerenciar condomínios e usuários. Acesso restrito ao perfil master.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-primary-900 to-gray-900 bg-clip-text text-transparent">
              Dashboard Master
            </h1>
            <p class="text-gray-600 mt-1">Visão geral do sistema</p>
          </div>
        </div>
        <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <% var footnoteResumoMaster = (helpTitle && helpModalContent) ? 'Quer o passo a passo completo? Clique em <strong>Dúvidas? Como funciona</strong> ao lado do título.' : ''; %>
    <% var resumoIaTeaserMaster = (typeof resumo !== 'undefined' && resumo && resumo.length) ? resumo.slice(0, 2).join(' ') : ''; %>
    <% var dicaBodyMaster = (typeof resumo !== 'undefined' && resumo && resumo.length) ? resumo.map(function (r) { return '<p>' + String(r).replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>'; }).join('') : ''; %>
    <div class="mb-6 grid grid-cols-1 lg:grid-cols-[minmax(0,40%)_minmax(0,60%)] gap-4 lg:gap-5 items-start animate-fade-in-up">
      <div class="min-w-0 w-full lg:max-w-xl">
        <%- include('../partials/help-resumo-rapido-card', { resumo: resumo, footnoteHtml: footnoteResumoMaster, resumoIaTeaser: resumoIaTeaserMaster }) %>
      </div>
      <div class="min-w-0 flex w-full">
        <%- include('../partials/dashboard-dica-sidebar-card', { dicaSidebarTitle: 'O que você faz aqui', dicaSidebarSubtitle: 'Visão geral do sistema e atalhos para gestão.', dicaSidebarBody: dicaBodyMaster }) %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId, omitResumo: true }) %>

    <!-- Cards de Estatísticas Principais -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total de Condomínios -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border border-primary-300 border-l-2 border-l-primary-500 animate-fade-in-up" style="animation-delay: 0.1s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Condomínios Ativos</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-primary-600 to-primary-700 bg-clip-text text-transparent">
              <%= stats.totalCondominios %>
            </p>
            <% if (stats.totalCondominiosInativos > 0) { %>
              <p class="text-xs text-gray-500 mt-2 flex items-center space-x-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><%= stats.totalCondominiosInativos %> inativos</span>
              </p>
            <% } %>
          </div>
          <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Total de Usuários -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border border-green-300 border-l-2 border-l-green-500 animate-fade-in-up" style="animation-delay: 0.2s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Usuários Ativos</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
              <%= stats.totalUsuarios %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Logs 24h -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border border-blue-300 border-l-2 border-l-blue-500 animate-fade-in-up" style="animation-delay: 0.3s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Logs (24h)</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent">
              <%= stats.logs24h %>
            </p>
            <p class="text-xs text-gray-500 mt-2 flex items-center space-x-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span><%= stats.logs7d %> nos últimos 7 dias</span>
            </p>
          </div>
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Aprovações Pendentes -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border border-yellow-300 border-l-2 border-l-yellow-500 animate-fade-in-up" style="animation-delay: 0.4s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Aprovações Pendentes</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-yellow-600 to-amber-600 bg-clip-text text-transparent">
              <%= stats.aprovaçõesPendentes %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-yellow-500 to-amber-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Segunda Linha de Estatísticas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Usuários por Perfil -->
      <div class="bg-white rounded-2xl shadow-xl p-6 card-elevate animate-fade-in-up border border-gray-300" style="animation-delay: 0.5s">
        <div class="flex items-center space-x-3 mb-6">
          <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl p-3 shadow-md">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Usuários por Perfil</h2>
        </div>
        <div class="space-y-3">
          <% if (stats.usuariosPorPerfil && stats.usuariosPorPerfil.length > 0) { %>
            <% stats.usuariosPorPerfil.forEach(perfil => { %>
              <div class="flex items-center justify-between py-3 px-4 rounded-xl hover:bg-gray-50 transition-colors duration-200 border border-gray-100">
                <span class="text-gray-700 font-semibold"><%= perfil.name %></span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-gradient-to-r from-primary-500 to-primary-600 text-white shadow-md">
                  <%= perfil.total || 0 %>
                </span>
              </div>
            <% }); %>
          <% } else { %>
            <div class="text-center py-8">
              <div class="bg-gray-100 rounded-full p-4 w-16 h-16 mx-auto mb-3 flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <p class="text-gray-500 text-sm">Nenhum usuário cadastrado</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Alertas Críticos -->
      <div class="bg-white rounded-2xl shadow-xl p-6 card-elevate animate-fade-in-up border border-gray-300" style="animation-delay: 0.6s">
        <div class="flex items-center space-x-3 mb-6">
          <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-xl p-3 shadow-md">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Alertas do Sistema</h2>
        </div>
        <div class="space-y-3">
          <div class="flex items-center justify-between py-4 px-4 rounded-xl bg-gradient-to-r from-red-50 to-rose-50 border-2 border-red-300">
            <div class="flex items-center space-x-3">
              <div class="bg-red-500 rounded-full p-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
              </div>
              <span class="text-gray-800 font-semibold">Alertas Críticos</span>
            </div>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-lg font-bold bg-gradient-to-r from-red-500 to-red-600 text-white shadow-md">
              <%= stats.alertasCriticos %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="animate-fade-in-up" style="animation-delay: 0.7s">
      <div class="mb-6">
        <div class="flex items-center space-x-3 mb-2">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <h2 class="text-3xl font-bold text-gray-900">Ações Rápidas</h2>
        </div>
        <p class="text-gray-500 text-sm ml-9">Acesso rápido às principais funcionalidades</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Criar Condomínio -->
        <a href="/master/condominios/novo" class="group relative bg-white rounded-2xl p-6 border-2 border-gray-300 hover:border-primary-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="absolute inset-0 bg-gradient-to-br from-primary-50/0 to-primary-100/0 group-hover:from-primary-50/50 group-hover:to-primary-100/30 rounded-2xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-primary-700 transition-colors duration-300">Criar Condomínio</h3>
            <p class="text-sm text-gray-500">Adicionar novo condomínio</p>
          </div>
        </a>

        <!-- Criar Usuário -->
        <a href="/master/usuarios/novo" class="group relative bg-white rounded-2xl p-6 border-2 border-gray-300 hover:border-green-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="absolute inset-0 bg-gradient-to-br from-green-50/0 to-green-100/0 group-hover:from-green-50/50 group-hover:to-green-100/30 rounded-2xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-green-700 transition-colors duration-300">Criar Usuário</h3>
            <p class="text-sm text-gray-500">Registrar novo usuário</p>
          </div>
        </a>

        <!-- Gerenciar Condomínios -->
        <a href="/master/condominios" class="group relative bg-white rounded-2xl p-6 border-2 border-gray-300 hover:border-blue-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-50/0 to-blue-100/0 group-hover:from-blue-50/50 group-hover:to-blue-100/30 rounded-2xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">Gerenciar Condomínios</h3>
            <p class="text-sm text-gray-500">Visualizar e editar</p>
          </div>
        </a>

        <!-- Gerenciar Usuários -->
        <a href="/master/usuarios" class="group relative bg-white rounded-2xl p-6 border-2 border-gray-300 hover:border-purple-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-50/0 to-purple-100/0 group-hover:from-purple-50/50 group-hover:to-purple-100/30 rounded-2xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-purple-700 transition-colors duration-300">Gerenciar Usuários</h3>
            <p class="text-sm text-gray-500">Visualizar e editar</p>
          </div>
        </a>

        <!-- Central IA Relatórios -->
        <a href="/master/ia-relatorios" class="group relative bg-white rounded-2xl p-6 border-2 border-gray-300 hover:border-indigo-300 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/0 to-indigo-100/0 group-hover:from-indigo-50/50 group-hover:to-indigo-100/30 rounded-2xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3v2.25M14.25 3v2.25M4.5 8.25h15m-14.25 0A2.25 2.25 0 003 10.5v7.5A2.25 2.25 0 005.25 20.25h13.5A2.25 2.25 0 0021 18v-7.5a2.25 2.25 0 00-2.25-2.25m-13.5 0h13.5M8.25 12h.008v.008H8.25V12zm0 3h.008v.008H8.25V15zm3-3h.008v.008h-.008V12zm0 3h.008v.008h-.008V15zm3-3h.008v.008h-.008V12zm0 3h.008v.008h-.008V15z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-indigo-700 transition-colors duration-300">Central IA Relatórios</h3>
            <p class="text-sm text-gray-500">Controle de IA por condomínio</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
