<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Administrativo</h1>
    <p class="text-gray-600 mt-2">Gestão administrativa do condomínio</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Tarefas Ativas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Tarefas Ativas</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.activeTasks %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/tarefas" class="text-blue-600 text-sm mt-4 inline-block hover:underline">
        Ver todas →
      </a>
    </div>

    <!-- Documentos Próximos do Vencimento -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Documentos Vencendo (30 dias)</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.expiringDocuments %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/documentos?status=ACTIVE" class="text-yellow-600 text-sm mt-4 inline-block hover:underline">
        Ver documentos →
      </a>
    </div>

    <!-- Documentos Vencidos -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Documentos Vencidos</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.expiredDocuments %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/documentos?status=ACTIVE" class="text-red-600 text-sm mt-4 inline-block hover:underline">
        Ver documentos →
      </a>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/administrativo/tarefas/nova" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition text-center">
        Criar Nova Tarefa
      </a>
      <a href="/administrativo/documentos/novo" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition text-center">
        Adicionar Documento
      </a>
      <a href="/administrativo/tarefas" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition text-center">
        Gerenciar Tarefas
      </a>
      <a href="/administrativo/documentos" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition text-center">
        Gerenciar Documentos
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
