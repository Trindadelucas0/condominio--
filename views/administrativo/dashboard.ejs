<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.02);
    }
  }
  
  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .stat-card {
    position: relative;
    overflow: hidden;
  }
  
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
  }
  
  .stat-card:hover::before {
    left: 100%;
  }
  
  .badge-pulse {
    animation: pulse 2s ease-in-out infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Administrativo'; %>
    <% var resumo = ['Visão geral: tarefas ativas, documentos vencendo, ocorrências e orçamentos pendentes.', 'Use os cards para ir direto a cada módulo. Resolva itens que precisam de atenção.', 'O financeiro tem seu próprio dashboard em Financeiro no menu.', 'Alertas e aprovações aparecem aqui ou em suas telas específicas.']; %>
    <% var helpModalContent = '<p><strong>Dashboard Administrativo</strong> é a tela inicial da gestão. Os cards mostram quantidades (tarefas ativas, documentos vencendo, ocorrências, orçamentos). Clique nos links para ir a cada área. Use para não perder prazos e pendências.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="flex items-center space-x-4">
          <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-4 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
              Dashboard Administrativo
            </h1>
            <p class="text-gray-600 mt-1">Gestão administrativa do condomínio</p>
          </div>
        </div>
        <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Cards de Estatísticas Principais -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Tarefas Ativas -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-indigo-300 border-l-2 border-l-indigo-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-indigo-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Tarefas Ativas</p>
        <p class="text-3xl font-bold text-gray-900 mb-2"><%= stats.activeTasks || 0 %></p>
        <a href="/administrativo/tarefas" class="text-indigo-600 text-sm font-semibold hover:text-indigo-700 transition-colors inline-flex items-center gap-1 group">
          Ver todas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Documentos Vencendo -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-yellow-300 border-l-2 border-l-yellow-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-yellow-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Vencendo (30 dias)</p>
        <p class="text-3xl font-bold text-yellow-600 mb-2"><%= stats.expiringDocuments || 0 %></p>
        <a href="/administrativo/documentos?status=ACTIVE" class="text-yellow-600 text-sm font-semibold hover:text-yellow-700 transition-colors inline-flex items-center gap-1 group">
          Ver documentos
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Documentos Vencidos -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-red-300 border-l-2 border-l-red-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-red-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Documentos Vencidos</p>
        <p class="text-3xl font-bold text-red-600 mb-2"><%= stats.expiredDocuments || 0 %></p>
        <a href="/administrativo/documentos?status=ACTIVE" class="text-red-600 text-sm font-semibold hover:text-red-700 transition-colors inline-flex items-center gap-1 group">
          Ver documentos
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Ocorrências Abertas -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-blue-300 border-l-2 border-l-blue-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-blue-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Ocorrências Abertas</p>
        <p class="text-3xl font-bold text-blue-600 mb-2"><%= stats.openOccurrences || 0 %></p>
        <a href="/administrativo/ocorrencias" class="text-blue-600 text-sm font-semibold hover:text-blue-700 transition-colors inline-flex items-center gap-1 group">
          Ver ocorrências
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Cards Secundários -->
    <% if (stats.untriagedOccurrences !== undefined || stats.slaAlerts !== undefined || stats.pendingBudgetRequests !== undefined) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <% if (stats.untriagedOccurrences !== undefined) { %>
      <!-- Ocorrências Não Triadas -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-orange-300 border-l-2 border-l-orange-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.5s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-orange-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Não Triadas</p>
        <p class="text-3xl font-bold text-orange-600 mb-2"><%= stats.untriagedOccurrences || 0 %></p>
        <a href="/administrativo/ocorrencias" class="text-orange-600 text-sm font-semibold hover:text-orange-700 transition-colors inline-flex items-center gap-1 group">
          Ver ocorrências
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <% } %>

      <% if (stats.slaAlerts !== undefined) { %>
      <!-- Alertas SLA -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-purple-300 border-l-2 border-l-purple-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.6s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-purple-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Alertas SLA</p>
        <p class="text-3xl font-bold text-purple-600 mb-2"><%= stats.slaAlerts || 0 %></p>
        <a href="/administrativo/alertas" class="text-purple-600 text-sm font-semibold hover:text-purple-700 transition-colors inline-flex items-center gap-1 group">
          Ver alertas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <% } %>

      <% if (stats.pendingBudgetRequests !== undefined) { %>
      <!-- Orçamentos Pendentes -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-green-300 border-l-2 border-l-green-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.7s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Orçamentos Pendentes</p>
        <p class="text-3xl font-bold text-green-600 mb-2"><%= stats.pendingBudgetRequests || 0 %></p>
        <a href="/administrativo/orcamentos" class="text-green-600 text-sm font-semibold hover:text-green-700 transition-colors inline-flex items-center gap-1 group">
          Ver orçamentos
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Ações Rápidas -->
    <div class="animate-fade-in-up" style="animation-delay: 0.8s;">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Ações Rápidas</h2>
        <p class="text-gray-600">Acesso rápido às principais funcionalidades</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Criar Tarefa -->
        <a href="/administrativo/tarefas/nova" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-indigo-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/0 to-indigo-100/0 group-hover:from-indigo-50/50 group-hover:to-indigo-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-indigo-700 transition-colors duration-300 text-lg">Criar Tarefa</h3>
            <p class="text-sm text-gray-500">Nova tarefa para equipe</p>
          </div>
        </a>

        <!-- Adicionar Documento -->
        <a href="/administrativo/documentos/novo" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-green-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-green-50/0 to-green-100/0 group-hover:from-green-50/50 group-hover:to-green-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-green-700 transition-colors duration-300 text-lg">Adicionar Documento</h3>
            <p class="text-sm text-gray-500">Registrar novo documento</p>
          </div>
        </a>

        <!-- Gerenciar Tarefas -->
        <a href="/administrativo/tarefas" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-blue-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-50/0 to-blue-100/0 group-hover:from-blue-50/50 group-hover:to-blue-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-blue-700 transition-colors duration-300 text-lg">Gerenciar Tarefas</h3>
            <p class="text-sm text-gray-500">Visualizar e editar</p>
          </div>
        </a>

        <!-- Gerenciar Documentos -->
        <a href="/administrativo/documentos" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-purple-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-50/0 to-purple-100/0 group-hover:from-purple-50/50 group-hover:to-purple-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-purple-700 transition-colors duration-300 text-lg">Gerenciar Documentos</h3>
            <p class="text-sm text-gray-500">Visualizar e editar</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
