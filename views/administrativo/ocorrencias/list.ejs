<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Ocorrências</h1>
      <p class="text-gray-600 mt-2">Gerencie e trie ocorrências do condomínio</p>
    </div>
  </div>

  <!-- Mensagens de sucesso/erro -->
  <% if (typeof query !== 'undefined' && query.success === 'triaged') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Ocorrência triada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'triaged_and_task_created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Ocorrência triada e tarefa criada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(query.error) %>
    </div>
  <% } %>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" class="flex flex-wrap gap-4">
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select
          id="status"
          name="status"
          class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Todos</option>
          <option value="ABERTA" <%= filters.status === 'ABERTA' ? 'selected' : '' %>>Aberta</option>
          <option value="EM_ATENDIMENTO" <%= filters.status === 'EM_ATENDIMENTO' ? 'selected' : '' %>>Em Atendimento</option>
          <option value="RESOLVIDA" <%= filters.status === 'RESOLVIDA' ? 'selected' : '' %>>Resolvida</option>
          <option value="ENCERRADA" <%= filters.status === 'ENCERRADA' ? 'selected' : '' %>>Encerrada</option>
        </select>
      </div>
      <div>
        <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">Prioridade</label>
        <select
          id="priority"
          name="priority"
          class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Todas</option>
          <option value="BAIXA" <%= filters.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
          <option value="NORMAL" <%= filters.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
          <option value="ALTA" <%= filters.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
          <option value="URGENTE" <%= filters.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
        </select>
      </div>
      <div>
        <label for="triaged" class="block text-sm font-medium text-gray-700 mb-1">Triagem</label>
        <select
          id="triaged"
          name="triaged"
          class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Todas</option>
          <option value="true" <%= filters.triaged === true ? 'selected' : '' %>>Triadas</option>
          <option value="false" <%= filters.triaged === false ? 'selected' : '' %>>Não Triadas</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
          Filtrar
        </button>
        <a href="/administrativo/ocorrencias" class="ml-2 px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
          Limpar
        </a>
      </div>
    </form>
  </div>

  <!-- Lista de ocorrências -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (!occurrences || occurrences.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma ocorrência encontrada.</p>
      </div>
    <% } else { %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Prioridade</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Triada</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criada em</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% occurrences.forEach(occurrence => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= occurrence.title %></div>
                <div class="text-sm text-gray-500"><%= occurrence.description ? (occurrence.description.length > 50 ? occurrence.description.substring(0, 50) + '...' : occurrence.description) : '' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded <%= occurrence.status === 'ABERTA' ? 'bg-yellow-100 text-yellow-800' : occurrence.status === 'EM_ATENDIMENTO' ? 'bg-blue-100 text-blue-800' : occurrence.status === 'RESOLVIDA' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= occurrence.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded <%= occurrence.priority === 'URGENTE' ? 'bg-red-100 text-red-800' : occurrence.priority === 'ALTA' ? 'bg-orange-100 text-orange-800' : occurrence.priority === 'NORMAL' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= occurrence.priority || 'NORMAL' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (occurrence.triaged) { %>
                  <span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 text-green-800">Sim</span>
                <% } else { %>
                  <span class="px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800">Não</span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(occurrence.created_at).toLocaleDateString('pt-BR') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <a href="/administrativo/ocorrencias/<%= occurrence.id %>/triar" class="text-green-600 hover:text-green-900">
                  Triar
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../../partials/footer') %>
