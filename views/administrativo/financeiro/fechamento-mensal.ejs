<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <% var breadcrumbItems = [{ label: 'Financeiro', url: '/financeiro/dashboard' }, { label: 'Fechamento Mensal', url: '' }]; %>
    <%- include('../../partials/breadcrumb', { items: breadcrumbItems }) %>

    <div class="mb-8 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Fechamento Mensal</h1>
        <p class="text-gray-600 mt-1">Registre o fechamento do mês para bloquear edições e conciliar o financeiro.</p>
      </div>
      <button type="button" onclick="document.getElementById('modalComoFunciona').classList.remove('hidden')" class="flex-shrink-0 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border-2 border-blue-200 bg-blue-50 text-blue-700 font-semibold hover:bg-blue-100 transition-colors" aria-label="Abrir explicação de como funciona">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Dúvidas? Como funciona
      </button>
    </div>

    <!-- Resumo rápido para o leigo -->
    <% var resumoFechamento = [
      '<strong>Fechar o mês</strong> = você “trava” o mês: ninguém altera mais receitas e despesas daquele mês. Use quando tiver fechado as contas no papel.',
      '<strong>Comanda</strong> = cada registro de fechamento. O mesmo mês pode ter mais de uma comanda (ex.: fechamento normal e depois uma revisão).',
      '<strong>Abrir mês</strong> = se fechou por engano ou precisa corrigir algo, você reabre; aí pode editar de novo. O motivo é obrigatório.',
      '<strong>Meses reabertos (anteriores)</strong> = meses antigos que foram reabertos para correção. Quando terminar, use “Fechar novamente” neles.'
    ]; %>
    <div class="mb-6">
      <%- include('../../partials/help-resumo-rapido-card', { resumo: resumoFechamento, footnoteHtml: 'Quer o passo a passo completo? Clique em <strong>Dúvidas? Como funciona</strong> acima.' }) %>
    </div>

    <% if (typeof req !== 'undefined' && req.query && req.query.success) { %>
      <div class="mb-6 p-4 rounded-xl border-l-4 border-green-500 bg-green-50 text-green-800 shadow-sm">
        <% if (req.query.success === 'closed') { %>
          <p class="font-semibold">Mês fechado com sucesso.</p>
          <p class="text-sm mt-1">As edições neste mês ficam bloqueadas até que um síndico ou financeiro reabra, se necessário.</p>
        <% } else if (req.query.success === 'reopened') { %>
          <p class="font-semibold">Mês reaberto com sucesso.</p>
          <p class="text-sm mt-1">É possível novamente lançar e editar registros neste mês.</p>
        <% } %>
      </div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error) { %>
      <div class="mb-6 p-4 rounded-xl border-l-4 border-red-500 bg-red-50 text-red-800 shadow-sm">
        <p class="font-semibold">Erro</p>
        <p class="text-sm mt-1"><%= decodeURIComponent(req.query.error) %></p>
      </div>
    <% } %>

    <!-- 1. Resumo do mês atual -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-800">Resumo do mês atual</h2>
        <p class="text-sm text-gray-500 mt-0.5"><%= new Date(currentYear, currentMonth - 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div class="md:col-span-1">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Status do mês</p>
            <% if (currentMonthClosures && currentMonthClosures.length > 0) { %>
              <% const closedCount = currentMonthClosures.filter(c => c.status === 'CLOSED').length; %>
              <% if (closedCount > 0) { %>
                <div class="mt-1 flex items-center gap-2">
                  <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-green-100 text-green-800">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <%= closedCount %> comanda(s) fechada(s)
                  </span>
                </div>
              <% } else if (currentMonthClosures.some(c => c.status === 'REOPENED')) { %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-amber-100 text-amber-800">
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                  Reaberto
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800">Aberto</span>
              <% } %>
            <% } else { %>
              <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-blue-100 text-blue-800">Aberto</span>
            <% } %>
          </div>
          <div class="bg-blue-50 rounded-lg p-4">
            <p class="text-xs font-medium text-blue-600 uppercase tracking-wide">Entradas</p>
            <p class="text-xl font-bold text-blue-700 mt-1">R$ <%= (totals.totalEntries || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
          </div>
          <div class="bg-red-50 rounded-lg p-4">
            <p class="text-xs font-medium text-red-600 uppercase tracking-wide">Saídas</p>
            <p class="text-xl font-bold text-red-700 mt-1">R$ <%= (totals.totalExits || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
          </div>
          <div class="bg-emerald-50 rounded-lg p-4">
            <p class="text-xs font-medium text-emerald-600 uppercase tracking-wide">Saldo do mês</p>
            <p class="text-xl font-bold mt-1 <%= (totals.balance || 0) >= 0 ? 'text-emerald-700' : 'text-red-700' %>">R$ <%= (totals.balance || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
          </div>
        </div>

        <% if (validation.issues && validation.issues.length > 0) { %>
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
            <p class="text-sm font-semibold text-amber-800 mb-2">Pendências</p>
            <ul class="list-disc list-inside space-y-1 text-sm text-amber-800">
              <% validation.issues.forEach(function(issue) { %>
                <li><%= issue %></li>
              <% }); %>
            </ul>
            <p class="text-xs text-amber-700 mt-2">Resolva as pendências que bloqueiam o fechamento antes de usar &quot;Fechar mês&quot;. Itens com &quot;Aviso&quot; não impedem o fechamento.</p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- 2. Comandas do mês atual -->
    <% if (currentMonthClosures && currentMonthClosures.length > 0) { %>
      <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
          <h2 class="text-lg font-bold text-gray-800">Comandas deste mês</h2>
          <p class="text-sm text-gray-500 mt-0.5">Cada comanda representa um fechamento registrado. Você pode reabrir uma comanda fechada se precisar ajustar o mês.</p>
        </div>
        <div class="p-6 space-y-4">
          <% currentMonthClosures.forEach(closure => { %>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-lg border border-gray-100 bg-gray-50/50 hover:bg-gray-50 transition-colors">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="font-semibold text-gray-900">Comanda #<%= closure.id %></span>
                  <span class="px-2.5 py-1 rounded-lg text-xs font-semibold <%= closure.status === 'CLOSED' ? 'bg-green-100 text-green-800' : closure.status === 'REOPENED' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                    <% if (closure.status === 'CLOSED') { %>Fechado<% } else if (closure.status === 'REOPENED') { %>Reaberto<% } else { %>Aberto<% } %>
                  </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-1 text-sm text-gray-600">
                  <span><strong>Fechado por:</strong> <%= closure.closed_by_name || '—' %></span>
                  <span><strong>Data:</strong> <%= closure.closed_at ? new Date(closure.closed_at).toLocaleString('pt-BR') : '—' %></span>
                  <span><strong>Saldo:</strong> <span class="font-semibold <%= parseFloat(closure.balance) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">R$ <%= parseFloat(closure.balance).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span></span>
                </div>
              </div>
              <% if (closure.status === 'CLOSED' && user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO') || user.roles.includes('FINANCEIRO'))) { %>
                <button type="button" onclick="document.getElementById('reopenModal<%= closure.id %>').classList.remove('hidden')" class="flex-shrink-0 inline-flex items-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg font-semibold text-sm transition-colors shadow-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
                  Abrir mês
                </button>
              <% } %>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- 2b. Meses reabertos (anteriores ao atual) -->
    <% if (reopenedOldMonths && reopenedOldMonths.length > 0) { %>
      <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
        <div class="px-6 py-4 bg-amber-50 border-b border-amber-100">
          <h2 class="text-lg font-bold text-gray-800">Meses reabertos (anteriores ao atual)</h2>
          <p class="text-sm text-gray-600 mt-0.5">Estes meses foram reabertos para correção. Quando terminar, use &quot;Fechar novamente&quot; para bloquear edições nesse mês.</p>
        </div>
        <div class="p-6">
          <ul class="space-y-3">
            <% reopenedOldMonths.forEach(function(item) { %>
              <li class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-lg border border-amber-100 bg-amber-50/50">
                <span class="font-medium text-gray-900"><%= new Date(item.year, item.month - 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></span>
                <form method="POST" action="/financeiro/fechamento-mensal/fechar" class="inline-flex items-center gap-2">
                  <input type="hidden" name="month" value="<%= item.month %>">
                  <input type="hidden" name="year" value="<%= item.year %>">
                  <input type="hidden" name="action" value="close">
                  <input type="hidden" name="createNewClosure" value="false">
                  <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-semibold text-sm transition-colors">Fechar novamente</button>
                </form>
              </li>
            <% }); %>
          </ul>
        </div>
      </section>
    <% } %>

    <!-- 3. Formulário de fechamento -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-800">Registrar fechamento</h2>
        <p class="text-sm text-gray-500 mt-0.5">Observações e valor para fundo de reserva são opcionais.</p>
      </div>
      <div class="p-6">
        <form method="POST" action="/financeiro/fechamento-mensal/fechar" class="space-y-4">
          <input type="hidden" name="month" value="<%= currentMonth %>">
          <input type="hidden" name="year" value="<%= currentYear %>">
          <input type="hidden" name="createNewClosure" id="createNewClosure" value="false">

          <div>
            <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Observações (opcional)</label>
            <textarea id="notes" name="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Ex.: Fechamento aprovado em reunião..."></textarea>
          </div>
          <div>
            <label for="reserveFundAmount" class="block text-sm font-medium text-gray-700 mb-1">Valor para fundo de reserva (R$) — opcional</label>
            <input type="number" step="0.01" min="0" id="reserveFundAmount" name="reserveFundAmount" class="w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="0,00">
            <p class="text-xs text-gray-500 mt-1">Será creditado ao fundo de reserva ao confirmar o fechamento.</p>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <% if (!currentClosure || currentClosure.status !== 'CLOSED') { %>
              <button type="submit" name="action" value="close" class="submit-close inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" <%= !validation.canClose ? 'disabled' : '' %>>
                Fechar mês
              </button>
            <% } %>
            <button type="submit" name="action" value="new" class="submit-new inline-flex items-center gap-2 px-6 py-2.5 bg-emerald-600 text-white rounded-lg font-semibold hover:bg-emerald-700 transition-colors">
              Nova comanda
            </button>
          </div>
          <div class="text-sm text-gray-500 border-t border-gray-100 pt-3 mt-3">
            <p><strong>Fechar mês</strong> — Registra o fechamento e bloqueia edições no mês. Só aparece quando o mês ainda não tem comanda fechada (ou a última comanda foi reaberta).</p>
            <p class="mt-1"><strong>Nova comanda</strong> — Cria outro fechamento para o mesmo mês (ex.: revisão ou segundo fechamento). Sempre disponível.</p>
          </div>
        </form>
      </div>
    </section>

    <script>
      document.querySelectorAll('form[action*="fechamento-mensal/fechar"] button[type="submit"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var el = document.getElementById('createNewClosure');
          if (el) el.value = this.getAttribute('value') === 'new' ? 'true' : 'false';
        });
      });
    </script>

    <!-- 4. Histórico -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-gray-800">Histórico de fechamentos</h2>
          <p class="text-sm text-gray-500 mt-0.5">Últimos fechamentos; use o filtro para ver um ano específico.</p>
        </div>
        <% if (availableYears && availableYears.length > 0) { %>
          <form method="GET" action="/financeiro/fechamento-mensal" class="flex items-center gap-2">
            <label for="year" class="text-sm font-medium text-gray-600">Ano:</label>
            <select name="year" id="year" onchange="this.form.submit()" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm">
              <option value="">Todos</option>
              <% availableYears.forEach(function(y) { %>
                <option value="<%= y %>" <%= filterYear === y ? 'selected' : '' %>><%= y %></option>
              <% }); %>
            </select>
          </form>
        <% } %>
      </div>
      <div class="overflow-x-auto">
        <% if (!closures || closures.length === 0) { %>
          <%- include('../../partials/empty-state', { title: 'Nenhum fechamento registrado', description: 'Quando você fechar um mês pela primeira vez, ele aparecerá aqui.', icon: 'document' }) %>
        <% } else { %>
          <table class="min-w-full divide-y divide-gray-200" role="table">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Mês/Ano</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Comanda</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Status</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Entradas</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Saídas</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Saldo</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Fechado por</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Data</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Ação</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% closures.forEach(function(closure) { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-sm font-medium text-gray-900 whitespace-nowrap"><%= new Date(closure.year, closure.month - 1).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }) %></td>
                  <td class="px-4 py-3 text-sm text-gray-600">#<%= closure.id %></td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="px-2 py-1 text-xs font-semibold rounded-lg <%= closure.status === 'CLOSED' ? 'bg-green-100 text-green-800' : closure.status === 'REOPENED' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>"><%= closure.status === 'CLOSED' ? 'Fechado' : closure.status === 'REOPENED' ? 'Reaberto' : 'Aberto' %></span>
                  </td>
                  <td class="px-4 py-3 text-sm text-right text-gray-900">R$ <%= parseFloat(closure.total_entries).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td class="px-4 py-3 text-sm text-right text-gray-900">R$ <%= parseFloat(closure.total_exits).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td class="px-4 py-3 text-sm text-right font-semibold <%= parseFloat(closure.balance) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">R$ <%= parseFloat(closure.balance).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td class="px-4 py-3 text-sm text-gray-600"><%= closure.closed_by_name || '—' %></td>
                  <td class="px-4 py-3 text-sm text-gray-600 whitespace-nowrap"><%= closure.closed_at ? new Date(closure.closed_at).toLocaleDateString('pt-BR') : '—' %></td>
                  <td class="px-4 py-3 text-right">
                    <% if (closure.status === 'CLOSED' && user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO') || user.roles.includes('FINANCEIRO'))) { %>
                      <button type="button" onclick="document.getElementById('reopenModal<%= closure.id %>').classList.remove('hidden')" class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg font-semibold text-xs transition-colors">Abrir mês</button>
                    <% } else if (closure.status === 'REOPENED') { %>
                      <span class="text-xs text-amber-700 font-medium">Reaberto</span>
                    <% } else { %>
                      <span class="text-xs text-gray-400">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </div>
</div>

<!-- Modais de reabertura (um por comanda fechada reabrível) -->
<% if (reopenableClosures && reopenableClosures.length > 0) { %>
  <% reopenableClosures.forEach(closure => { %>
    <div id="reopenModal<%= closure.id %>" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" aria-modal="true" role="dialog" aria-labelledby="reopenTitle<%= closure.id %>">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-auto" onclick="event.stopPropagation()">
        <div class="p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
            </div>
            <h3 id="reopenTitle<%= closure.id %>" class="text-lg font-bold text-gray-900">Abrir mês — Comanda #<%= closure.id %></h3>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4">
            <p class="text-sm font-semibold text-amber-800 mb-2">O que acontece ao abrir o mês</p>
            <ul class="text-xs text-amber-800 space-y-1 list-disc list-inside">
              <li>Edições e novos lançamentos no mês voltam a ser permitidos</li>
              <li>A ação fica registrada em auditoria</li>
              <li>O motivo da reabertura é obrigatório</li>
            </ul>
          </div>
          <form method="POST" action="/financeiro/fechamento-mensal/<%= closure.id %>/reabrir" onsubmit="return (function(f){ var r = f.querySelector('textarea[name=reason]'); if(!r || !r.value.trim()){ alert('Informe o motivo da reabertura.'); r && r.focus(); return false; } if(r.value.trim().length < 10){ alert('O motivo deve ter pelo menos 10 caracteres.'); r.focus(); return false; } return true; })(this);">
            <label for="reason<%= closure.id %>" class="block text-sm font-medium text-gray-700 mb-1">Motivo da abertura <span class="text-red-500">*</span></label>
            <textarea id="reason<%= closure.id %>" name="reason" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Ex.: Corrigir lançamento de entrada..."></textarea>
            <div class="flex justify-end gap-3 mt-4">
              <button type="button" onclick="document.getElementById('reopenModal<%= closure.id %>').classList.add('hidden')" class="px-4 py-2 rounded-lg font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors">Cancelar</button>
              <button type="submit" class="px-4 py-2 rounded-lg font-semibold text-white bg-amber-600 hover:bg-amber-700 transition-colors">Confirmar abertura</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
  <script>
    document.querySelectorAll('[id^="reopenModal"]').forEach(function(modal) {
      modal.addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
    });
  </script>
<% } %>

<!-- Modal: Como funciona (para leigo) -->
<div id="modalComoFunciona" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" aria-modal="true" role="dialog" aria-labelledby="modalComoFuncionaTitle">
  <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col" onclick="event.stopPropagation()">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between bg-blue-50">
      <h2 id="modalComoFuncionaTitle" class="text-xl font-bold text-gray-900">Como funciona o Fechamento Mensal</h2>
      <button type="button" onclick="document.getElementById('modalComoFunciona').classList.add('hidden')" class="p-2 rounded-lg hover:bg-gray-200 transition-colors" aria-label="Fechar">
        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="p-6 overflow-y-auto flex-1 text-gray-700 text-sm leading-relaxed space-y-4">
      <p><strong>O que é fechar o mês?</strong> É quando você “trava” as contas daquele mês: depois disso, ninguém pode mais alterar receitas e despesas daquele período. Use quando já tiver fechado as contas no papel ou na planilha e quiser deixar o sistema igual.</p>

      <p><strong>O que é uma comanda?</strong> Cada vez que você registra um fechamento, o sistema cria uma “comanda”. O mesmo mês pode ter várias comandas: por exemplo, uma do fechamento normal e outra de uma revisão depois. Cada uma fica registrada com data e quem fechou.</p>

      <p><strong>Quando uso “Fechar mês” e quando “Nova comanda”?</strong><br>
      • <strong>Fechar mês</strong> — use para registrar o fechamento do mês atual (ou para “fechar de novo” um mês que estava reaberto). Esse botão some quando o mês já tem uma comanda fechada.<br>
      • <strong>Nova comanda</strong> — use quando quiser criar outro fechamento para o mesmo mês (ex.: fechamento de revisão). Sempre aparece.</p>

      <p><strong>O que é “Abrir mês”?</strong> Se você fechou o mês por engano ou precisa corrigir um lançamento, pode reabrir. Aí as receitas e despesas daquele mês voltam a poder ser alteradas. O sistema pede um motivo (obrigatório) e registra quem reabriu e quando.</p>

      <p><strong>O que é “Meses reabertos (anteriores ao atual)”?</strong> São meses antigos que foram reabertos para correção. Eles aparecem numa lista separada para você não confundir com o mês atual. Quando terminar de corrigir, use <strong>Fechar novamente</strong> naquele mês para “travar” de novo.</p>

      <p><strong>O que são as pendências?</strong> Antes de fechar, o sistema verifica se há algo em aberto (ex.: entradas pendentes de análise, despesas aguardando aprovação). Se houver, ele avisa. Alguns itens são só “aviso” e não impedem o fechamento; outros bloqueiam até você resolver.</p>

      <p><strong>Resumindo em 3 passos:</strong></p>
      <ol class="list-decimal list-inside space-y-1 ml-2">
        <li>Confira o resumo do mês (entradas, saídas, saldo) e resolva as pendências se houver.</li>
        <li>Clique em <strong>Fechar mês</strong> (ou em <strong>Nova comanda</strong> se for um segundo fechamento do mesmo mês).</li>
        <li>Se precisar corrigir depois, use <strong>Abrir mês</strong> na comanda; quando terminar, feche novamente.</li>
      </ol>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <button type="button" onclick="document.getElementById('modalComoFunciona').classList.add('hidden')" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition-colors">Entendi</button>
    </div>
  </div>
</div>
<script>
  document.getElementById('modalComoFunciona')?.addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
</script>

