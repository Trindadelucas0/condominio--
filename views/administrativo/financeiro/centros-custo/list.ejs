<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funcionam os Centros de Custo'; %>
  <% var resumo = ['Centro de custo é a categoria da despesa: Água, Limpeza, Manutenção, etc.', 'Ao lançar uma despesa você escolhe o centro de custo; isso permite relatórios por tipo de gasto.', 'Cadastre os que seu condomínio usa; depois não precisa criar despesa sem categoria.', 'Você pode editar nome e descrição a qualquer momento.']; %>
  <% var helpModalContent = '<p><strong>O que é Centro de Custo?</strong> É uma categoria para classificar despesas. Exemplos: Água, Luz, Limpeza, Manutenção.</p><p><strong>Para que serve?</strong> Ao registrar uma despesa você escolhe o centro de custo. Nos relatórios você vê quanto foi gasto em cada categoria.</p><p><strong>Cadastro:</strong> crie os centros que fazem sentido para o seu condomínio. Depois, ao cadastrar despesas, selecione um deles.</p><p><strong>Dica:</strong> Use nomes claros para facilitar a leitura dos relatórios.</p>'; %>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Centros de Custo</h1>
        <p class="text-gray-600 mt-2">Organizar despesas por centro de custo</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <a href="/financeiro/centros-custo/novo" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
      Novo Centro de Custo
    </a>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Centro de custo criado com sucesso!
    </div>
  <% } %>

  <!-- Lista de centros de custo -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (!costCenters || costCenters.length === 0) { %>
      <%- include('../../../partials/empty-state', {
        title: 'Nenhum centro de custo cadastrado',
        description: 'Centro de custo é o tipo da despesa (ex.: Água, Limpeza, Manutenção). O primeiro passo é cadastrar um para organizar suas saídas.',
        buttonText: 'Cadastrar primeiro centro de custo',
        buttonHref: '/financeiro/centros-custo/novo',
        icon: 'list'
      }) %>
    <% } else { %>
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criado em</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
          <% costCenters.forEach(cc => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= cc.name %></div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-500"><%= cc.description || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(cc.created_at).toLocaleDateString('pt-BR') %>
              </td>
            </tr>
          <% }); %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../../../partials/footer') %>
