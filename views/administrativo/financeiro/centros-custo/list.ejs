<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Centros de Custo</h1>
      <p class="text-gray-600 mt-2">Organizar despesas por centro de custo</p>
    </div>
    <a href="/administrativo/financeiro/centros-custo/novo" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
      Novo Centro de Custo
    </a>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Centro de custo criado com sucesso!
    </div>
  <% } %>

  <!-- Lista de centros de custo -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criado em</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (costCenters.length === 0) { %>
          <tr>
            <td colspan="3" class="px-6 py-4 text-center text-gray-500">
              Nenhum centro de custo cadastrado.
            </td>
          </tr>
        <% } else { %>
          <% costCenters.forEach(cc => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= cc.name %></div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-500"><%= cc.description || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(cc.created_at).toLocaleDateString('pt-BR') %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../../partials/footer') %>
