<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funciona o Consumo Mensal de Contas'; %>
  <% var resumo = ['Aqui você registra o consumo e o valor da conta de água, luz, gás etc. por mês.', 'Selecione a conta (fornecedor), mês/ano, consumo (se aplicável) e valor; isso ajuda a comparar gastos ao longo do tempo.', 'Use os filtros por intervalo de datas (como no dashboard), ano/mês ou tipo de conta.', 'Útil para acompanhar se as contas subiram ou desceram e para planejamento.']; %>
  <% var helpModalContent = '<p><strong>O que é Consumo Mensal?</strong> É o registro do valor (e, se quiser, do consumo) das contas de água, luz, gás etc. por mês. Não substitui o pagamento em Despesas/Boletos; serve para histórico e análise.</p><p><strong>Filtros:</strong> Você pode usar <strong>data início / data fim</strong> (alinhado ao dashboard), ou o modo clássico por ano e mês, mais conta e tipo.</p><p><strong>Dica:</strong> Use <strong>Ver no dashboard</strong> com os mesmos filtros para ver gráficos e KPIs.</p>'; %>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Consumo Mensal de Contas</h1>
        <p class="text-gray-600 mt-2">Registro de consumo e valores de água, energia, gás, etc.</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <% if (typeof dashboardConsumoUrl !== 'undefined' && dashboardConsumoUrl) { %>
        <a href="<%= dashboardConsumoUrl %>" class="text-indigo-700 border border-indigo-200 bg-indigo-50 px-4 py-3 rounded-lg hover:bg-indigo-100 transition text-sm font-medium">
          Ver no dashboard
        </a>
      <% } %>
      <a href="/financeiro/consumo/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
        Registrar Consumo
      </a>
    </div>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Consumo registrado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Consumo atualizado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'deleted') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Registro de consumo excluído.
    </div>
  <% } %>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/financeiro/consumo" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label for="dataInicio" class="block text-sm font-medium text-gray-700 mb-2">Data início (intervalo)</label>
          <input
            type="date"
            id="dataInicio"
            name="dataInicio"
            value="<%= typeof filters !== 'undefined' && filters.dataInicio ? filters.dataInicio : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div>
          <label for="dataFim" class="block text-sm font-medium text-gray-700 mb-2">Data fim (intervalo)</label>
          <input
            type="date"
            id="dataFim"
            name="dataFim"
            value="<%= typeof filters !== 'undefined' && filters.dataFim ? filters.dataFim : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div>
          <label for="consumoBillType" class="block text-sm font-medium text-gray-700 mb-2">Tipo de conta</label>
          <select
            id="consumoBillType"
            name="consumoBillType"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Todos</option>
            <option value="AGUA" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'AGUA') ? 'selected' : '' %>>Água</option>
            <option value="LUZ" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'LUZ') ? 'selected' : '' %>>Energia</option>
            <option value="GAS" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'GAS') ? 'selected' : '' %>>Gás</option>
            <option value="TELEFONE" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'TELEFONE') ? 'selected' : '' %>>Telefone</option>
            <option value="INTERNET" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'INTERNET') ? 'selected' : '' %>>Internet</option>
            <option value="OUTRA" <%= (typeof filters !== 'undefined' && filters.consumoBillType === 'OUTRA') ? 'selected' : '' %>>Outra</option>
          </select>
        </div>
        <div>
          <label for="billId" class="block text-sm font-medium text-gray-700 mb-2">Conta</label>
          <select
            id="billId"
            name="billId"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Todas</option>
            <% if (typeof bills !== 'undefined' && bills) { %>
              <% bills.forEach(bill => { %>
                <option value="<%= bill.id %>" <%= (typeof filters !== 'undefined' && filters.billId == bill.id) ? 'selected' : '' %>>
                  <%= bill.name %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>
      <p class="text-xs text-gray-500">Com <strong>data início e fim</strong> preenchidas, o filtro por intervalo tem prioridade sobre ano/mês abaixo.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end border-t border-gray-100 pt-4">
        <div>
          <label for="year" class="block text-sm font-medium text-gray-700 mb-2">Ano (modo clássico)</label>
          <input
            type="number"
            id="year"
            name="year"
            min="2020"
            max="2099"
            value="<%= typeof filters !== 'undefined' && filters.year ? filters.year : new Date().getFullYear() %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div>
          <label for="month" class="block text-sm font-medium text-gray-700 mb-2">Mês</label>
          <select
            id="month"
            name="month"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Todos</option>
            <% const monthNames = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro']; %>
            <% for (let i = 1; i <= 12; i++) { %>
              <option value="<%= i %>" <%= (typeof filters !== 'undefined' && filters.month == i) ? 'selected' : '' %>><%= monthNames[i - 1] %></option>
            <% } %>
          </select>
        </div>
        <div>
          <button
            type="submit"
            class="w-full bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition"
          >
            Filtrar
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Lista de consumo -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Conta</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mês/Ano</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Consumo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vencimento</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (typeof consumption === 'undefined' || !consumption || consumption.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
              Nenhum consumo registrado. <a href="/financeiro/consumo/novo" class="text-blue-600 hover:underline">Registre o primeiro consumo</a>
            </td>
          </tr>
        <% } else { %>
          <% consumption.forEach(cons => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= cons.bill_name %></div>
                <div class="text-sm text-gray-500"><%= cons.bill_type %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= cons.month %>/<%= cons.year %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= cons.consumption_value ? cons.consumption_value.toLocaleString('pt-BR', {minimumFractionDigits: 2}) + ' ' + cons.consumption_unit : '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-gray-900">
                  R$ <%= parseFloat(cons.bill_amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= cons.due_date ? new Date(cons.due_date).toLocaleDateString('pt-BR') : '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <a href="/financeiro/consumo/<%= cons.id %>/editar" class="text-indigo-600 hover:text-indigo-800 font-medium mr-3">Editar</a>
                <form method="POST" action="/financeiro/consumo/<%= cons.id %>/excluir" class="inline" onsubmit="return confirm('Excluir este registro de consumo?');">
                  <button type="submit" class="text-red-600 hover:text-red-800 font-medium">Excluir</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
