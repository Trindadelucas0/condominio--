<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Registrar Consumo Mensal</h1>
    <p class="text-gray-600 mt-2">Registre o consumo e valor das contas (água, energia, gás, etc.)</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <form method="POST" action="/financeiro/consumo">
      <!-- Conta -->
      <div class="mb-4">
        <label for="billId" class="block text-sm font-medium text-gray-700 mb-2">
          Conta <span class="text-red-500">*</span>
        </label>
        <select
          id="billId"
          name="billId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          required
        >
          <option value="">Selecione uma conta...</option>
          <% bills.forEach(bill => { %>
            <option value="<%= bill.id %>" <%= consumo && consumo.billId == bill.id ? 'selected' : '' %>>
              <%= bill.name %> (<%= bill.bill_type %>)
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Mês e Ano -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label for="month" class="block text-sm font-medium text-gray-700 mb-2">
            Mês <span class="text-red-500">*</span>
          </label>
          <select
            id="month"
            name="month"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            required
          >
            <option value="">Selecione...</option>
            <% const monthNames = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro']; %>
            <% for (let i = 1; i <= 12; i++) { %>
              <option value="<%= i %>" <%= (consumo && consumo.month == i) || (typeof currentMonth !== 'undefined' && currentMonth == i) ? 'selected' : '' %>>
                <%= monthNames[i - 1] %>
              </option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="year" class="block text-sm font-medium text-gray-700 mb-2">
            Ano <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="year"
            name="year"
            min="2020"
            max="2099"
            value="<%= consumo && consumo.year ? consumo.year : (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            required
          />
        </div>
      </div>

      <!-- Consumo (opcional) -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label for="consumptionValue" class="block text-sm font-medium text-gray-700 mb-2">
            Valor do Consumo (Opcional)
          </label>
          <input
            type="number"
            id="consumptionValue"
            name="consumptionValue"
            step="0.01"
            min="0"
            value="<%= consumo && consumo.consumptionValue ? consumo.consumptionValue : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 150.50"
          />
        </div>
        <div>
          <label for="consumptionUnit" class="block text-sm font-medium text-gray-700 mb-2">
            Unidade
          </label>
          <select
            id="consumptionUnit"
            name="consumptionUnit"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="M3" <%= consumo && consumo.consumptionUnit === 'M3' ? 'selected' : '' %>>m³ (Água/Gás)</option>
            <option value="KWH" <%= consumo && consumo.consumptionUnit === 'KWH' ? 'selected' : '' %>>kWh (Energia)</option>
            <option value="UNIDADE" <%= consumo && consumo.consumptionUnit === 'UNIDADE' ? 'selected' : '' %>>Unidade</option>
          </select>
        </div>
      </div>

      <!-- Valor da Conta -->
      <div class="mb-4">
        <label for="billAmount" class="block text-sm font-medium text-gray-700 mb-2">
          Valor da Conta (R$) <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          id="billAmount"
          name="billAmount"
          step="0.01"
          min="0"
          value="<%= consumo && consumo.billAmount ? consumo.billAmount : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="0.00"
          required
        />
      </div>

      <!-- Data de Vencimento -->
      <div class="mb-6">
        <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-2">
          Data de Vencimento (Opcional)
        </label>
        <input
          type="date"
          id="dueDate"
          name="dueDate"
          value="<%= consumo && consumo.dueDate ? consumo.dueDate : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/financeiro/dashboard"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
        >
          Registrar Consumo
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
