<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Nova taxa mensal'; %>
  <% var resumo = ['Crie taxa por apartamento: valor, vencimento, mês e ano.', 'Depois marque como paga na lista de Taxas quando o condômino pagar.']; %>
  <% var helpModalContent = '<p>Preencha apartamento, valor, vencimento e mês/ano. Quando o condômino pagar, use Marcar como paga na lista de Taxas.</p>'; %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Nova Taxa Mensal</h1>
      <p class="text-gray-600">Lance uma nova taxa de condomínio</p>
    </div>
    <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <div class="bg-white rounded-lg shadow-lg p-6 max-w-2xl">
    <form method="POST" action="/financeiro/taxas">
      <div class="space-y-4">
        <div>
          <label for="apartmentId" class="block text-sm font-medium text-gray-700 mb-2">
            Apartamento <span class="text-red-500">*</span>
          </label>
          <select
            id="apartmentId"
            name="apartmentId"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Selecione...</option>
            <% if (apartments && apartments.length > 0) { %>
              <% apartments.forEach(function(apt) { %>
                <option value="<%= apt.id %>">
                  <%= apt.number %><%= apt.block ? ' - Bloco ' + apt.block : '' %><%= apt.owner_name ? ' (' + apt.owner_name + ')' : '' %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="month" class="block text-sm font-medium text-gray-700 mb-2">
              Mês <span class="text-red-500">*</span>
            </label>
            <select
              id="month"
              name="month"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <% for (let i = 1; i <= 12; i++) { %>
                <option value="<%= i %>" <%= i === new Date().getMonth() + 1 ? 'selected' : '' %>>
                  <%= new Date(2000, i - 1).toLocaleDateString('pt-BR', { month: 'long' }) %>
                </option>
              <% } %>
            </select>
          </div>

          <div>
            <label for="year" class="block text-sm font-medium text-gray-700 mb-2">
              Ano <span class="text-red-500">*</span>
            </label>
            <select
              id="year"
              name="year"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <% for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 1; y--) { %>
                <option value="<%= y %>" <%= y === new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div>
          <label for="amount" class="block text-sm font-medium text-gray-700 mb-2">
            Valor Base (R$) <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            step="0.01"
            id="amount"
            name="amount"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 500.00"
          />
          <p class="text-xs text-gray-500 mt-1">Valor base da taxa (sem multas e juros)</p>
        </div>

        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-yellow-800 mb-3">Multa e Juros (Opcional)</h3>
          <p class="text-xs text-yellow-700 mb-3">
            Se não informar, o sistema calculará automaticamente com base nas taxas em atraso.
            Se informar manualmente, os valores informados serão usados.
          </p>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="manualLateFee" class="block text-sm font-medium text-gray-700 mb-2">
                Multa (R$)
              </label>
              <input
                type="number"
                step="0.01"
                id="manualLateFee"
                name="manualLateFee"
                min="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500"
                placeholder="Ex: 10.00"
              />
              <p class="text-xs text-gray-500 mt-1">Deixe vazio para cálculo automático</p>
            </div>

            <div>
              <label for="manualInterest" class="block text-sm font-medium text-gray-700 mb-2">
                Juros (R$)
              </label>
              <input
                type="number"
                step="0.01"
                id="manualInterest"
                name="manualInterest"
                min="0"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500"
                placeholder="Ex: 5.00"
              />
              <p class="text-xs text-gray-500 mt-1">Deixe vazio para cálculo automático</p>
            </div>
          </div>
        </div>

        <div>
          <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-2">
            Data de Vencimento <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="dueDate"
            name="dueDate"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div class="flex gap-4">
          <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Salvar
          </button>
          <a href="/financeiro/taxas" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
