<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Marcar Taxa como Paga</h1>
    <p class="text-gray-600">Registre o pagamento da taxa</p>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-6 max-w-2xl">
    <div class="mb-6 p-4 bg-gray-50 rounded-lg">
      <p class="text-sm text-gray-600 mb-1">Apartamento</p>
      <p class="text-lg font-semibold"><%= fee.apartment_number %><%= fee.block ? ' - ' + fee.block : '' %></p>
      <p class="text-sm text-gray-600 mb-1 mt-2">Valor Original</p>
      <p class="text-lg font-semibold">R$ <%= parseFloat(fee.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
      <% if (fee.late_fee > 0 || fee.interest > 0) { %>
        <p class="text-sm text-gray-600 mb-1 mt-2">Multa</p>
        <p class="text-sm">R$ <%= parseFloat(fee.late_fee || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
        <p class="text-sm text-gray-600 mb-1 mt-2">Juros</p>
        <p class="text-sm">R$ <%= parseFloat(fee.interest || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
        <p class="text-sm text-gray-600 mb-1 mt-2">Total a Pagar</p>
        <p class="text-xl font-bold text-red-600">
          R$ <%= (parseFloat(fee.amount) + parseFloat(fee.late_fee || 0) + parseFloat(fee.interest || 0)).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      <% } %>
    </div>

    <form method="POST" action="/financeiro/taxas/<%= fee.id %>/pagar" enctype="multipart/form-data">
      <div class="space-y-4">
        <div>
          <label for="paymentMethod" class="block text-sm font-medium text-gray-700 mb-2">
            Método de Pagamento <span class="text-red-500">*</span>
          </label>
          <select
            id="paymentMethod"
            name="paymentMethod"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Selecione...</option>
            <option value="PIX">PIX</option>
            <option value="BOLETO">Boleto</option>
            <option value="TRANSFERENCIA">Transferência Bancária</option>
            <option value="DINHEIRO">Dinheiro</option>
            <option value="CHEQUE">Cheque</option>
            <option value="OUTRA">Outra</option>
          </select>
        </div>

        <div>
          <label for="paymentReceiptPdf" class="block text-sm font-medium text-gray-700 mb-2">
            Comprovante (PDF)
          </label>
          <input
            type="file"
            id="paymentReceiptPdf"
            name="paymentReceiptPdf"
            accept="application/pdf"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <p class="text-xs text-gray-500 mt-1">Apenas arquivos PDF são permitidos (máximo 10MB)</p>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
            Marcar como Paga
          </button>
          <a href="/financeiro/taxas" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
