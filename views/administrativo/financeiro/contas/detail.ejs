<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Detalhe da conta'; %>
    <% var resumo = ['Visão da conta (fornecedor) e dos vencimentos/boletos vinculados.', 'Use Novo boleto para adicionar vencimento; pague em Boletos a pagar.', 'Editar conta altera dados do fornecedor.']; %>
    <% var helpModalContent = '<p>Esta tela mostra os dados da conta e os vencimentos. Adicione boletos com Novo boleto; para pagar, vá em Boletos a pagar e use Pagar na linha desejada.</p>'; %>
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <div>
          <a href="/financeiro/contas" class="text-sm text-blue-600 hover:underline mb-2 inline-block">← Voltar para Contas</a>
          <h1 class="text-3xl font-bold text-gray-900"><%= account.name %></h1>
          <% if (account.provider) { %><p class="text-gray-600 mt-1"><%= account.provider %></p><% } %>
        </div>
        <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/financeiro/contas/<%= account.id %>/editar"
          class="inline-flex items-center px-5 py-3 bg-amber-50 text-amber-800 border border-amber-200 rounded-lg font-semibold hover:bg-amber-100 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536M4 20h4l9.268-9.268a2 2 0 000-2.828l-1.172-1.172a2 2 0 00-2.828 0L4 16v4z"/>
          </svg>
          Editar conta
        </a>
        <a href="/financeiro/contas/<%= account.id %>/novo-boleto" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Adicionar novo boleto
        </a>
      </div>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <% if (query.success === 'boleto_added') { %>
      <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg">Boleto/vencimento adicionado. Ele aparece em <a href="/financeiro/contas-a-pagar" class="underline font-medium">Contas a pagar</a> para pagar e, se quiser, anexar comprovante.</div>
    <% } %>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
      <h2 class="text-lg font-bold text-gray-800 mb-4">Dados do fornecedor</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div><span class="text-gray-500">Tipo:</span> <%= account.bill_type %></div>
        <div><span class="text-gray-500">Número da conta:</span> <%= account.account_number || '-' %></div>
        <div><span class="text-gray-500">Centro de custo:</span> <%= account.cost_center_name || '-' %></div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-800">Vencimentos deste fornecedor</h2>
        <p class="text-sm text-gray-500 mt-1">Clique em &quot;Pagar&quot; em Contas a pagar para gerar a saída e anexar comprovante se desejar.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Vencimento</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Valor</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Ação</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if (!items || items.length === 0) { %>
              <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                  Nenhum vencimento cadastrado. Clique em &quot;Adicionar novo boleto&quot; para registrar data e valor.
                </td>
              </tr>
            <% } else {
              const statusConfig = { PAID: { label: 'Pago', class: 'bg-green-100 text-green-800' }, OVERDUE: { label: 'Vencida', class: 'bg-red-100 text-red-800' }, DUE_TODAY: { label: 'Vence hoje', class: 'bg-amber-100 text-amber-800' }, UPCOMING: { label: 'A vencer', class: 'bg-blue-100 text-blue-800' } };
              items.forEach(function(it) {
                const sc = statusConfig[it.displayStatus] || statusConfig.UPCOMING;
            %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-gray-900"><%= it.due_date ? new Date(it.due_date).toLocaleDateString('pt-BR') : '-' %></td>
                <td class="px-6 py-4 font-semibold">R$ <%= parseFloat(it.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                <td class="px-6 py-4"><span class="px-2 py-1 rounded-full text-xs font-medium <%= sc.class %>"><%= sc.label %></span></td>
                <td class="px-6 py-4">
                  <% if (it.status === 'PAID') { %>
                    <span class="text-sm text-gray-500">Pago</span>
                  <% } else { %>
                    <a href="/financeiro/contas-a-pagar/<%= it.id %>/pagar" class="text-blue-600 hover:underline font-medium">Pagar</a>
                  <% } %>
                </td>
              </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
