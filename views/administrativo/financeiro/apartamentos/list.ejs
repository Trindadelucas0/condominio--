<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funcionam os Apartamentos'; %>
  <% var resumo = ['Cadastre cada unidade (número, bloco, proprietário) para taxas e inadimplência.', 'Taxas são geradas por apartamento; Ativo/Inativo define se recebe cobrança.', 'Use para relatórios de inadimplência e para saber quem está em dia.', 'Edite ou desative unidades vendidas ou não utilizadas.']; %>
  <% var helpModalContent = '<p><strong>Apartamentos</strong> é o cadastro de unidades do condomínio. Ao gerar taxas mensais, o sistema usa os apartamentos ativos. Inadimplência e valores em aberto são por unidade. Ativo = recebe cobrança; Inativo = não. Mantenha proprietário e documento atualizados.</p>'; %>
  <div class="mb-6">
    <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold text-gray-800">Apartamentos</h1>
        <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
      <a href="/financeiro/apartamentos/novo" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        + Novo Apartamento
      </a>
    </div>
    <p class="text-gray-600">Cadastro de apartamentos para controle de inadimplência</p>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <% if (typeof req.query.success !== 'undefined') { %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      Apartamento cadastrado com sucesso!
    </div>
  <% } %>

  <% if (typeof req.query.error !== 'undefined') { %>
    <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Número</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bloco</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Proprietário</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Documento</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (apartments && apartments.length > 0) { %>
          <% apartments.forEach(function(apt) { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= apt.number %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= apt.block || '-' %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= apt.owner_name || '-' %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= apt.owner_document || '-' %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded-full <%= apt.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= apt.active ? 'Ativo' : 'Inativo' %>
                </span>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
              Nenhum apartamento cadastrado ainda.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
