<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Novo apartamento'; %>
  <% var resumo = ['Cadastre número, bloco, proprietário e documento.', 'Apartamentos ativos recebem cobrança de taxas; inativos não.', 'Use para controle de inadimplência e relatórios.']; %>
  <% var helpModalContent = '<p>Preencha número, bloco, proprietário e documento. Unidades ativas entram na geração de taxas; inativas não. Mantenha dados atualizados para cobrança.</p>'; %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Novo Apartamento</h1>
      <p class="text-gray-600">Cadastre um novo apartamento</p>
    </div>
    <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <div class="bg-white rounded-lg shadow-lg p-6 max-w-2xl">
    <form method="POST" action="/financeiro/apartamentos">
      <div class="space-y-4">
        <div>
          <label for="number" class="block text-sm font-medium text-gray-700 mb-2">
            Número do Apartamento <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="number"
            name="number"
            required
            value="<%= apartment ? apartment.number : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 101"
          />
        </div>

        <div>
          <label for="block" class="block text-sm font-medium text-gray-700 mb-2">
            Bloco
          </label>
          <input
            type="text"
            id="block"
            name="block"
            value="<%= apartment ? apartment.block : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: A"
          />
        </div>

        <div>
          <label for="ownerName" class="block text-sm font-medium text-gray-700 mb-2">
            Nome do Proprietário
          </label>
          <input
            type="text"
            id="ownerName"
            name="ownerName"
            value="<%= apartment ? apartment.owner_name : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="ownerDocument" class="block text-sm font-medium text-gray-700 mb-2">
            CPF/CNPJ
          </label>
          <input
            type="text"
            id="ownerDocument"
            name="ownerDocument"
            value="<%= apartment ? apartment.owner_document : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="ownerPhone" class="block text-sm font-medium text-gray-700 mb-2">
            Telefone
          </label>
          <input
            type="text"
            id="ownerPhone"
            name="ownerPhone"
            value="<%= apartment ? apartment.owner_phone : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label for="ownerEmail" class="block text-sm font-medium text-gray-700 mb-2">
            Email
          </label>
          <input
            type="email"
            id="ownerEmail"
            name="ownerEmail"
            value="<%= apartment ? apartment.owner_email : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Fração Ideal removida - não é mais necessária -->

        <div class="flex gap-4">
          <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Salvar
          </button>
          <a href="/financeiro/apartamentos" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
