<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funcionam os Relatórios'; %>
  <% var resumo = ['Aqui você gera o relatório mensal em PDF com receitas, despesas e saldo do mês escolhido.', 'Selecione mês e ano e clique em "Gerar PDF"; o arquivo é salvo e aparece na lista abaixo.', 'Você pode baixar ou excluir relatórios já gerados. Use para prestação de contas e arquivo.', 'O relatório reflete os lançamentos do sistema na data da geração.']; %>
  <% var helpModalContent = '<p><strong>O que são os Relatórios?</strong> São documentos em PDF que consolidam a situação financeira do condomínio em um mês: receitas, despesas e saldo.</p><p><strong>Gerar:</strong> Escolha o mês e o ano e clique em "Gerar PDF". O sistema gera o arquivo e ele aparece na lista "Relatórios Gerados". Você pode baixar ou excluir.</p><p><strong>Uso:</strong> Use para prestação de contas em assembleia, para enviar aos condôminos ou para arquivo. O conteúdo reflete o que estava lançado no sistema no momento da geração.</p><p><strong>Dica:</strong> Gere o relatório após fechar o mês (Fechamento Mensal) para ter o resumo definitivo daquele período.</p>'; %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Relatórios</h1>
      <p class="text-gray-600">Gere e baixe relatórios em PDF</p>
    </div>
    <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Gerar Relatório Mensal -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Gerar Relatório Mensal</h2>
    <form method="POST" action="/financeiro/relatorios/mensal/gerar" class="flex gap-4">
      <select name="month" required class="px-3 py-2 border border-gray-300 rounded-md">
        <% for (let i = 1; i <= 12; i++) { %>
          <option value="<%= i %>" <%= i === new Date().getMonth() + 1 ? 'selected' : '' %>>
            <%= new Date(2000, i - 1).toLocaleDateString('pt-BR', { month: 'long' }) %>
          </option>
        <% } %>
      </select>
      <select name="year" required class="px-3 py-2 border border-gray-300 rounded-md">
        <% for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 2; y--) { %>
          <option value="<%= y %>" <%= y === new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
      <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        Gerar PDF
      </button>
    </form>
  </div>

  <!-- Mensagens de sucesso/erro -->
  <% if (req.query.success === 'generated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Relatório gerado com sucesso!
    </div>
  <% } %>
  <% if (req.query.success === 'deleted') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Relatório excluído com sucesso!
    </div>
  <% } %>
  <% if (req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      Erro: <%= req.query.error %>
    </div>
  <% } %>

  <!-- Histórico de Relatórios -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Relatórios Gerados</h2>
    
    <% if (reports && reports.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome do Arquivo</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mês/Ano</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tamanho</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data de Criação</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% reports.forEach(function(report) { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900">
                  <%= report.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <span class="px-2 py-1 text-xs font-semibold rounded-full <%= report.type === 'PDF' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                    <%= report.type %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if (report.month && report.year) { %>
                    <%= new Date(report.year, report.month - 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% 
                    const sizeInMB = (report.size / (1024 * 1024)).toFixed(2);
                    const sizeInKB = (report.size / 1024).toFixed(2);
                    const displaySize = report.size > 1024 * 1024 ? sizeInMB + ' MB' : sizeInKB + ' KB';
                  %>
                  <%= displaySize %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(report.createdAt).toLocaleString('pt-BR') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <div class="flex gap-2">
                    <% if (report.type === 'PDF') { %>
                      <a 
                        href="/financeiro/relatorios/visualizar?file=<%= encodeURIComponent(report.name) %>" 
                        target="_blank"
                        class="inline-flex items-center px-3 py-1.5 bg-blue-600 text-white text-xs font-semibold rounded hover:bg-blue-700 transition-colors"
                        title="Visualizar PDF"
                      >
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        Visualizar
                      </a>
                    <% } %>
                    <a 
                      href="/financeiro/relatorios/download?file=<%= encodeURIComponent(report.name) %>" 
                      class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white text-xs font-semibold rounded hover:bg-green-700 transition-colors"
                      title="Baixar arquivo"
                    >
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                      </svg>
                      Baixar
                    </a>
                    <form 
                      method="POST" 
                      action="/financeiro/relatorios/excluir" 
                      class="inline"
                      onsubmit="return confirm('Tem certeza que deseja excluir este relatório? Esta ação não pode ser desfeita.');"
                    >
                      <input type="hidden" name="fileName" value="<%= report.name %>">
                      <button 
                        type="submit"
                        class="inline-flex items-center px-3 py-1.5 bg-red-600 text-white text-xs font-semibold rounded hover:bg-red-700 transition-colors"
                        title="Excluir relatório"
                      >
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        Excluir
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-gray-500 text-center py-8">Nenhum relatório gerado ainda.</p>
    <% } %>
  </div>
</div>

<%- include('../../../partials/footer') %>
