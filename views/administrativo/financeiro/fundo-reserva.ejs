<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funciona o Fundo de Reserva'; %>
  <% var resumo = ['O fundo de reserva é uma reserva financeira para emergências e obras; a lei exige percentual mínimo.', 'Configure a meta (valor ou percentual) e o sistema mostra o saldo atual e o progresso em relação à meta.', 'O saldo do fundo pode ser alimentado por transferências do caixa; acompanhe pelo gráfico.', 'Se ainda não estiver configurado, use o formulário abaixo para definir meta e saldo inicial.']; %>
  <% var helpModalContent = '<p><strong>O que é o Fundo de Reserva?</strong> É uma reserva que o condomínio mantém para emergências, obras e imprevistos. A lei exige um percentual mínimo (geralmente 5% das receitas).</p><p><strong>Configuração:</strong> Defina a meta (valor que o fundo deve ter) e, se já houver valor reservado, o saldo atual. O sistema calcula o percentual da meta e mostra um gráfico de progresso.</p><p><strong>Acompanhamento:</strong> O saldo atual reflete transferências e uso do fundo. Alimente o fundo com transferências do caixa quando houver superávit; use conforme aprovação para obras ou emergências.</p><p><strong>Dica:</strong> Manter o fundo em dia evita surpresas em reformas e reparos urgentes.</p>'; %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Fundo de Reserva</h1>
      <p class="text-gray-600">Configure e acompanhe o fundo de reserva do condomínio</p>
    </div>
    <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <% if (typeof req.query.success !== 'undefined') { %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      Fundo de reserva atualizado com sucesso!
    </div>
  <% } %>

  <!-- Status Atual -->
  <% if (fund) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">Saldo Atual</p>
        <p class="text-3xl font-bold text-blue-600">
          R$ <%= parseFloat(fund.current_balance || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      </div>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">Meta</p>
        <p class="text-3xl font-bold text-gray-800">
          R$ <%= parseFloat(fund.target_balance || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      </div>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">% da Meta</p>
        <p class="text-3xl font-bold <%= fund.target_percent >= 100 ? 'text-green-600' : fund.target_percent >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
          <%= fund.target_percent.toFixed(1) %>%
        </p>
      </div>
    </div>

    <!-- Gráfico de Progresso -->
    <% if (fund.target_balance > 0) { %>
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Progresso em Direção à Meta</h2>
      <div class="relative" style="height: 300px;">
        <canvas id="progressChart"></canvas>
      </div>
    </div>
    <% } %>
  <% } else { %>
    <div class="bg-yellow-50 border border-yellow-400 text-yellow-700 px-4 py-3 rounded-lg mb-6">
      <p class="font-semibold">Fundo de Reserva não configurado</p>
      <p class="text-sm mt-1">Configure o fundo de reserva abaixo para começar a acompanhar o progresso.</p>
    </div>
  <% } %>

  <!-- Atualizar Meta -->
  <% if (fund) { %>
  <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Atualizar Meta do Fundo de Reserva</h2>
    <form method="POST" action="/financeiro/fundo-reserva" class="max-w-md">
      <div class="mb-4">
        <label for="targetBalance" class="block text-sm font-medium text-gray-700 mb-2">
          Nova Meta do Fundo (R$)
        </label>
        <input
          type="number"
          step="0.01"
          min="0"
          id="targetBalance"
          name="targetBalance"
          value="<%= fund.target_balance || '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: 50000.00"
          required
        />
        <p class="text-xs text-gray-500 mt-1">Atualize apenas o valor da meta. O saldo atual não será alterado.</p>
      </div>
      <div class="mb-4">
        <input type="hidden" name="updateOnlyTarget" value="true" />
        <input type="hidden" name="contributionMethod" value="<%= fund.contribution_method || 'PERCENT' %>" />
        <input type="hidden" name="monthlyContributionPercent" value="<%= fund.monthly_contribution_percent || '' %>" />
        <input type="hidden" name="monthlyContributionAmount" value="<%= fund.monthly_contribution_amount || '' %>" />
      </div>
      <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        Atualizar Meta
      </button>
    </form>
  </div>
  <% } %>

  <!-- Configuração Completa (se necessário) -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Configuração Completa do Fundo de Reserva</h2>
    <form method="POST" action="/financeiro/fundo-reserva">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="targetBalanceFull" class="block text-sm font-medium text-gray-700 mb-2">
            Meta do Fundo (R$)
          </label>
          <input
            type="number"
            step="0.01"
            id="targetBalanceFull"
            name="targetBalance"
            value="<%= fund ? fund.target_balance : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 50000.00"
          />
        </div>
        <div>
          <label for="contributionMethod" class="block text-sm font-medium text-gray-700 mb-2">
            Método de Contribuição
          </label>
          <select
            id="contributionMethod"
            name="contributionMethod"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="PERCENT" <%= fund && fund.contribution_method === 'PERCENT' ? 'selected' : '' %>>Percentual</option>
            <option value="FIXED" <%= fund && fund.contribution_method === 'FIXED' ? 'selected' : '' %>>Valor Fixo</option>
          </select>
        </div>
        <div id="percentField" style="<%= fund && fund.contribution_method === 'FIXED' ? 'display: none;' : '' %>">
          <label for="monthlyContributionPercent" class="block text-sm font-medium text-gray-700 mb-2">
            % de Contribuição Mensal
          </label>
          <input
            type="number"
            step="0.01"
            id="monthlyContributionPercent"
            name="monthlyContributionPercent"
            value="<%= fund ? fund.monthly_contribution_percent : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 10.00"
          />
        </div>
        <div id="fixedField" style="<%= fund && fund.contribution_method === 'PERCENT' ? 'display: none;' : '' %>">
          <label for="monthlyContributionAmount" class="block text-sm font-medium text-gray-700 mb-2">
            Valor Fixo Mensal (R$)
          </label>
          <input
            type="number"
            step="0.01"
            id="monthlyContributionAmount"
            name="monthlyContributionAmount"
            value="<%= fund ? fund.monthly_contribution_amount : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 5000.00"
          />
        </div>
      </div>
      <div class="mt-6">
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          Salvar Configuração
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Gráfico de progresso
  <% if (fund && fund.target_balance > 0) { %>
  const ctx = document.getElementById('progressChart');
  if (ctx) {
    const currentBalance = <%= parseFloat(fund.current_balance || 0) %>;
    const targetBalance = <%= parseFloat(fund.target_balance || 0) %>;
    const progressPercent = Math.min(100, (currentBalance / targetBalance) * 100);
    
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Alcançado', 'Faltante'],
        datasets: [{
          data: [currentBalance, Math.max(0, targetBalance - currentBalance)],
          backgroundColor: [
            progressPercent >= 100 ? '#10b981' : progressPercent >= 50 ? '#f59e0b' : '#ef4444',
            '#e5e7eb'
          ],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        plugins: {
          legend: {
            position: 'bottom',
            display: true,
            labels: {
              padding: 20,
              font: {
                size: 14
              }
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                return label + ': R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        }
      },
      plugins: [{
        id: 'centerText',
        beforeDraw: function(chart) {
          const ctx = chart.ctx;
          const centerX = chart.chartArea.left + (chart.chartArea.right - chart.chartArea.left) / 2;
          const centerY = chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2;
          
          ctx.save();
          ctx.font = 'bold 24px Arial';
          ctx.fillStyle = progressPercent >= 100 ? '#10b981' : progressPercent >= 50 ? '#f59e0b' : '#ef4444';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(progressPercent.toFixed(1) + '%', centerX, centerY - 10);
          
          ctx.font = '14px Arial';
          ctx.fillStyle = '#6b7280';
          ctx.fillText('da Meta', centerX, centerY + 15);
          ctx.restore();
        }
      }]
    });
  }
  <% } %>

  // Toggle campos de contribuição
  const contributionMethodEl = document.getElementById('contributionMethod');
  if (contributionMethodEl) {
    contributionMethodEl.addEventListener('change', function() {
      const method = this.value;
      document.getElementById('percentField').style.display = method === 'PERCENT' ? 'block' : 'none';
      document.getElementById('fixedField').style.display = method === 'FIXED' ? 'block' : 'none';
    });
  }
</script>

<%- include('../../partials/footer') %>
