<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Fundo de Reserva</h1>
    <p class="text-gray-600">Configure e acompanhe o fundo de reserva do condomínio</p>
  </div>

  <% if (typeof req.query.success !== 'undefined') { %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      Fundo de reserva atualizado com sucesso!
    </div>
  <% } %>

  <!-- Status Atual -->
  <% if (fund) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">Saldo Atual</p>
        <p class="text-3xl font-bold text-blue-600">
          R$ <%= parseFloat(fund.current_balance || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      </div>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">Meta</p>
        <p class="text-3xl font-bold text-gray-800">
          R$ <%= parseFloat(fund.target_balance || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      </div>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <p class="text-sm text-gray-600 mb-1">% da Meta</p>
        <p class="text-3xl font-bold <%= fund.target_percent >= 100 ? 'text-green-600' : fund.target_percent >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
          <%= fund.target_percent.toFixed(1) %>%
        </p>
      </div>
    </div>
  <% } %>

  <!-- Configuração -->
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Configuração do Fundo de Reserva</h2>
    <form method="POST" action="/financeiro/fundo-reserva">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="targetBalance" class="block text-sm font-medium text-gray-700 mb-2">
            Meta do Fundo (R$)
          </label>
          <input
            type="number"
            step="0.01"
            id="targetBalance"
            name="targetBalance"
            value="<%= fund ? fund.target_balance : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 50000.00"
          />
        </div>
        <div>
          <label for="contributionMethod" class="block text-sm font-medium text-gray-700 mb-2">
            Método de Contribuição
          </label>
          <select
            id="contributionMethod"
            name="contributionMethod"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="PERCENT" <%= fund && fund.contribution_method === 'PERCENT' ? 'selected' : '' %>>Percentual</option>
            <option value="FIXED" <%= fund && fund.contribution_method === 'FIXED' ? 'selected' : '' %>>Valor Fixo</option>
          </select>
        </div>
        <div id="percentField" style="<%= fund && fund.contribution_method === 'FIXED' ? 'display: none;' : '' %>">
          <label for="monthlyContributionPercent" class="block text-sm font-medium text-gray-700 mb-2">
            % de Contribuição Mensal
          </label>
          <input
            type="number"
            step="0.01"
            id="monthlyContributionPercent"
            name="monthlyContributionPercent"
            value="<%= fund ? fund.monthly_contribution_percent : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 10.00"
          />
        </div>
        <div id="fixedField" style="<%= fund && fund.contribution_method === 'PERCENT' ? 'display: none;' : '' %>">
          <label for="monthlyContributionAmount" class="block text-sm font-medium text-gray-700 mb-2">
            Valor Fixo Mensal (R$)
          </label>
          <input
            type="number"
            step="0.01"
            id="monthlyContributionAmount"
            name="monthlyContributionAmount"
            value="<%= fund ? fund.monthly_contribution_amount : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 5000.00"
          />
        </div>
      </div>
      <div class="mt-6">
        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          Salvar Configuração
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('contributionMethod').addEventListener('change', function() {
    const method = this.value;
    document.getElementById('percentField').style.display = method === 'PERCENT' ? 'block' : 'none';
    document.getElementById('fixedField').style.display = method === 'FIXED' ? 'block' : 'none';
  });
</script>

<%- include('../../partials/footer') %>
