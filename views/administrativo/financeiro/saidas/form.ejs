<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Nova Saída Financeira</h1>
    <p class="text-gray-600 mt-2">Registre uma despesa</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/financeiro/saidas">
      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="description"
          name="description"
          required
          value="<%= saida ? saida.description : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
          placeholder="Ex: Manutenção do elevador"
        />
      </div>

      <!-- Valor -->
      <div class="mb-4">
        <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">
          Valor (R$) <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          id="amount"
          name="amount"
          step="0.01"
          min="0"
          required
          value="<%= saida ? saida.amount : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
          placeholder="0.00"
        />
      </div>

      <!-- Data -->
      <div class="mb-4">
        <label for="exitDate" class="block text-sm font-medium text-gray-700 mb-1">
          Data <span class="text-red-500">*</span>
        </label>
        <input
          type="date"
          id="exitDate"
          name="exitDate"
          required
          value="<%= saida ? saida.exitDate : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>

      <!-- Conta (Bill) -->
      <div class="mb-4">
        <label for="billId" class="block text-sm font-medium text-gray-700 mb-1">
          Conta (Opcional)
        </label>
        <select
          id="billId"
          name="billId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="">Sem conta vinculada</option>
          <% bills.forEach(bill => { %>
            <option
              value="<%= bill.id %>"
              <%= saida && saida.billId == bill.id ? 'selected' : '' %>
            >
              <%= bill.name %> (<%= bill.bill_type %>)
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Centro de Custo -->
      <div class="mb-4">
        <label for="costCenterId" class="block text-sm font-medium text-gray-700 mb-1">
          Centro de Custo
        </label>
        <select
          id="costCenterId"
          name="costCenterId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="">Sem centro de custo</option>
          <% costCenters.forEach(cc => { %>
            <option
              value="<%= cc.id %>"
              <%= saida && saida.costCenterId == cc.id ? 'selected' : '' %>
            >
              <%= cc.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Categoria -->
      <div class="mb-4">
        <label for="category" class="block text-sm font-medium text-gray-700 mb-1">
          Categoria
        </label>
        <select
          id="category"
          name="category"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="MANUTENCAO" <%= !saida || saida.category === 'MANUTENCAO' ? 'selected' : '' %>>Manutenção</option>
          <option value="CONTA" <%= saida && saida.category === 'CONTA' ? 'selected' : '' %>>Conta</option>
          <option value="CONTRATO" <%= saida && saida.category === 'CONTRATO' ? 'selected' : '' %>>Contrato</option>
          <option value="OUTRA" <%= saida && saida.category === 'OUTRA' ? 'selected' : '' %>>Outra</option>
        </select>
      </div>

      <!-- Requer Aprovação -->
      <div class="mb-4">
        <label class="flex items-center">
          <input
            type="checkbox"
            name="requiresApproval"
            value="true"
            <%= saida && saida.requiresApproval ? 'checked' : '' %>
            class="rounded border-gray-300 text-red-600 focus:ring-red-500"
          />
          <span class="ml-2 text-sm text-gray-700">Requer aprovação do síndico (se valor acima do limite)</span>
        </label>
      </div>

      <!-- Limite de Aprovação -->
      <div class="mb-4">
        <label for="approvalLimit" class="block text-sm font-medium text-gray-700 mb-1">
          Limite de Aprovação (R$)
        </label>
        <input
          type="number"
          id="approvalLimit"
          name="approvalLimit"
          step="0.01"
          min="0"
          value="<%= saida ? saida.approvalLimit : '1000.00' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
          placeholder="1000.00"
        />
        <p class="text-xs text-gray-500 mt-1">Valores acima deste limite precisam de aprovação do síndico</p>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/financeiro/saidas"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition"
        >
          Criar Saída
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleRecurrenceFields() {
  const isRecurring = document.getElementById('isRecurring').checked;
  const recurrenceFields = document.getElementById('recurrenceFields');
  const recurrenceType = document.getElementById('recurrenceType');
  
  if (isRecurring) {
    recurrenceFields.style.display = 'block';
    recurrenceType.value = 'MONTHLY'; // Default para mensal
  } else {
    recurrenceFields.style.display = 'none';
    recurrenceType.value = 'UNIQUE';
  }
}

// Toggle campo de valor médio quando variável
document.getElementById('isVariable')?.addEventListener('change', function() {
  const averageAmountField = document.getElementById('averageAmountField');
  if (this.checked) {
    averageAmountField.style.display = 'block';
  } else {
    averageAmountField.style.display = 'none';
  }
});
</script>

<%- include('../../../partials/footer') %>
