<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Saídas Financeiras</h1>
      <p class="text-gray-600 mt-2">Despesas do condomínio</p>
    </div>
    <a href="/administrativo/financeiro/saidas/nova" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition">
      Nova Saída
    </a>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Saída criada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'paid') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Saída marcada como paga!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(query.error) %>
    </div>
  <% } %>

  <!-- Lista de saídas -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Centro de Custo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (exits.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhuma saída registrada.
            </td>
          </tr>
        <% } else { %>
          <% exits.forEach(exit => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= exit.description %></div>
                <div class="text-sm text-gray-500"><%= exit.category %></div>
                <% if (exit.bill_name) { %>
                  <div class="text-xs text-blue-600">Conta: <%= exit.bill_name %></div>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-red-600">
                  R$ <%= parseFloat(exit.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(exit.exit_date).toLocaleDateString('pt-BR') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= exit.cost_center_name || '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (exit.payment_status === 'PAID') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Paga
                  </span>
                <% } else if (exit.payment_status === 'APPROVED') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    Aprovada
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    Pendente
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <% if (exit.payment_status === 'APPROVED' && exit.payment_status !== 'PAID') { %>
                  <form method="POST" action="/administrativo/financeiro/saidas/<%= exit.id %>/pagar" class="inline">
                    <button type="submit" class="text-green-600 hover:text-green-900">
                      Marcar como Paga
                    </button>
                  </form>
                <% } else if (exit.payment_status === 'PAID') { %>
                  <span class="text-gray-400">Paga em <%= new Date(exit.paid_at).toLocaleDateString('pt-BR') %></span>
                <% } else { %>
                  <span class="text-gray-400">Aguardando aprovação</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
