<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }
  
  .icon-bounce:hover {
    animation: bounce 0.5s;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-green-50/30 to-emerald-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Nova receita – como preencher'; %>
    <% var resumo = ['Preencha valor, descrição, categoria e centro de custo.', 'Se exigir aprovação, a receita vai para Aprovações. Depois use Receber na lista e anexe comprovante.', 'Categorias e centros de custo ajudam nos relatórios.']; %>
    <% var helpModalContent = '<p>Preencha os campos obrigatórios. Se houver aprovação, a receita vai para Aprovações. Quando o valor entrar, use Receber na lista de Receitas e anexe o comprovante.</p>'; %>
    <%- include('../../../partials/breadcrumb', { items: [ { label: 'Início', url: '/financeiro/dashboard' }, { label: 'Receitas', url: '/financeiro/entradas' }, { label: entrada && entrada.id ? 'Editar receita' : 'Nova receita', url: '' } ] }) %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
        <a href="/financeiro/entradas" class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors w-fit">
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Voltar para Receitas
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="flex items-center space-x-4">
          <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl p-4 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 bg-clip-text text-transparent">
              <%= entrada && entrada.id ? 'Editar receita' : 'Nova receita' %>
            </h1>
            <p class="text-gray-600 mt-1"><%= entrada && entrada.id ? 'Corrija os dados da receita rejeitada' : 'Registre o dinheiro que entrou no condomínio (taxa, multa, outro)' %></p>
          </div>
        </div>
        <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Mensagem de erro moderna -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-red-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-red-800">Erro ao processar</p>
            <p class="text-sm text-red-600"><%= error %></p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Formulário Moderno -->
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="<%= entrada && entrada.id ? '/financeiro/entradas/' + entrada.id : '/financeiro/entradas' %>" class="space-y-6">
          <!-- Descrição -->
          <div>
            <label for="description" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Descrição
              <span class="text-red-500 ml-1">*</span>
            </label>
            <input
              type="text"
              id="description"
              name="description"
              required
              value="<%= entrada ? entrada.description : '' %>"
              class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 text-gray-900 placeholder-gray-400"
              placeholder="Ex.: Taxa condomínio jan/2025"
            />
          </div>

          <!-- Valor e Data em Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Valor -->
            <div>
              <label for="amount" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Valor (R$)
                <span class="text-red-500 ml-1">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 font-semibold">R$</span>
                <input
                  type="number"
                  id="amount"
                  name="amount"
                  step="0.01"
                  min="0"
                  required
                  value="<%= entrada ? entrada.amount : '' %>"
                  class="input-focus w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 text-gray-900 placeholder-gray-400"
                  placeholder="0,00"
                />
              </div>
            </div>

            <!-- Data -->
            <div>
              <label for="entryDate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Data
                <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="date"
                id="entryDate"
                name="entryDate"
                required
                value="<%= entrada ? (entrada.entry_date ? new Date(entrada.entry_date).toISOString().split('T')[0] : '') : '' %>"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 text-gray-900"
              />
              <div id="reopenedMonthWarning" class="hidden mt-2 p-3 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 text-sm" role="alert">
                <span id="reopenedMonthWarningText"></span>
              </div>
            </div>
          </div>

          <!-- Centro de Custo e Categoria em Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Centro de Custo -->
            <div>
              <label for="costCenterId" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Centro de Custo
                <%- include('../../../partials/field-help', { text: 'Tipo da receita para organizar relatórios (ex.: Taxa, Multa). Se não tiver, cadastre em Tipos de despesa no menu.' }) %>
              </label>
              <select
                id="costCenterId"
                name="costCenterId"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 text-gray-900 bg-white"
              >
                <option value="">Sem centro de custo</option>
                <% costCenters.forEach(cc => { %>
                  <option
                    value="<%= cc.id %>"
                    <%= entrada && (entrada.cost_center_id == cc.id || entrada.costCenterId == cc.id) ? 'selected' : '' %>
                  >
                    <%= cc.name %>
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Categoria -->
            <div>
              <label for="category" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Categoria
              </label>
              <select
                id="category"
                name="category"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 text-gray-900 bg-white"
              >
                <option value="TAXA" <%= !entrada || entrada.category === 'TAXA' ? 'selected' : '' %>>Taxa</option>
                <option value="RECEITA" <%= entrada && entrada.category === 'RECEITA' ? 'selected' : '' %>>Receita</option>
                <option value="OUTRA" <%= entrada && entrada.category === 'OUTRA' ? 'selected' : '' %>>Outra</option>
              </select>
            </div>
          </div>

          <!-- Botões Modernos -->
          <div class="flex flex-col sm:flex-row justify-end space-y-3 sm:space-y-0 sm:space-x-4 pt-6 border-t border-gray-200">
            <a
              href="<%= entrada && entrada.id ? '/financeiro/entradas-rejeitadas' : '/financeiro/entradas' %>"
              class="px-8 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 text-center icon-bounce"
            >
              Cancelar
            </a>
            <button
              type="submit"
              class="group relative overflow-hidden px-8 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center space-x-2"
            >
              <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
              <svg class="w-5 h-5 relative z-10 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="relative z-10"><%= entrada && entrada.id ? 'Atualizar e Reenviar' : 'Criar' %> Entrada</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function toggleRecurrenceFields() {
  const isRecurring = document.getElementById('isRecurring').checked;
  const recurrenceFields = document.getElementById('recurrenceFields');
  const recurrenceType = document.getElementById('recurrenceType');
  
  if (isRecurring) {
    recurrenceFields.style.display = 'block';
    recurrenceType.value = 'MONTHLY'; // Default para mensal
  } else {
    recurrenceFields.style.display = 'none';
    recurrenceType.value = 'UNIQUE';
  }
}

// Toggle campo de valor médio quando variável
document.getElementById('isVariable')?.addEventListener('change', function() {
  const averageAmountField = document.getElementById('averageAmountField');
  if (this.checked) {
    averageAmountField.style.display = 'block';
  } else {
    averageAmountField.style.display = 'none';
  }
});

// Aviso quando a data é de um mês reaberto (não atual)
(function() {
  var reopenedOldMonths = <%- JSON.stringify(typeof reopenedOldMonths !== 'undefined' ? reopenedOldMonths : []) %>;
  var dateInput = document.getElementById('entryDate');
  var warningEl = document.getElementById('reopenedMonthWarning');
  var warningText = document.getElementById('reopenedMonthWarningText');
  if (!dateInput || !warningEl || !reopenedOldMonths.length) return;
  function check() {
    var val = dateInput.value;
    if (!val) { warningEl.classList.add('hidden'); return; }
    var d = new Date(val + 'T12:00:00');
    var month = d.getMonth() + 1, year = d.getFullYear();
    var isReopened = reopenedOldMonths.some(function(m) { return m.month === month && m.year === year; });
    if (isReopened) {
      var monthName = d.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      warningText.textContent = 'Atenção: ' + monthName + ' é um mês reaberto (não é o mês atual). Confirme que o lançamento é neste mês.';
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }
  }
  dateInput.addEventListener('change', check);
  dateInput.addEventListener('input', check);
  check();
})();
</script>

<%- include('../../../partials/footer') %>
