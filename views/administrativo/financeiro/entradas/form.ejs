<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Nova Entrada Financeira</h1>
    <p class="text-gray-600 mt-2">Registre uma receita ou taxa</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/administrativo/financeiro/entradas">
      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="description"
          name="description"
          required
          value="<%= entrada ? entrada.description : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Ex: Taxa de condomínio - Janeiro/2024"
        />
      </div>

      <!-- Valor -->
      <div class="mb-4">
        <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">
          Valor (R$) <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          id="amount"
          name="amount"
          step="0.01"
          min="0"
          required
          value="<%= entrada ? entrada.amount : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="0.00"
        />
      </div>

      <!-- Data -->
      <div class="mb-4">
        <label for="entryDate" class="block text-sm font-medium text-gray-700 mb-1">
          Data <span class="text-red-500">*</span>
        </label>
        <input
          type="date"
          id="entryDate"
          name="entryDate"
          required
          value="<%= entrada ? entrada.entryDate : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        />
      </div>

      <!-- Centro de Custo -->
      <div class="mb-4">
        <label for="costCenterId" class="block text-sm font-medium text-gray-700 mb-1">
          Centro de Custo
        </label>
        <select
          id="costCenterId"
          name="costCenterId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Sem centro de custo</option>
          <% costCenters.forEach(cc => { %>
            <option
              value="<%= cc.id %>"
              <%= entrada && entrada.costCenterId == cc.id ? 'selected' : '' %>
            >
              <%= cc.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Categoria -->
      <div class="mb-4">
        <label for="category" class="block text-sm font-medium text-gray-700 mb-1">
          Categoria
        </label>
        <select
          id="category"
          name="category"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="TAXA" <%= !entrada || entrada.category === 'TAXA' ? 'selected' : '' %>>Taxa</option>
          <option value="RECEITA" <%= entrada && entrada.category === 'RECEITA' ? 'selected' : '' %>>Receita</option>
          <option value="OUTRA" <%= entrada && entrada.category === 'OUTRA' ? 'selected' : '' %>>Outra</option>
        </select>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/administrativo/financeiro/entradas"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition"
        >
          Criar Entrada
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
