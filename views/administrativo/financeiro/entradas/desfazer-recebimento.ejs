<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-amber-50/30 to-yellow-50/30">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href="/financeiro/entradas" class="text-sm text-amber-700 hover:underline mb-2 inline-block">← Voltar para Entradas</a>
      <h1 class="text-3xl font-bold text-gray-900">Desfazer recebimento da entrada</h1>
      <p class="text-gray-600 mt-1">Esta ação irá remover esta entrada do saldo recebido.</p>
    </div>

    <% if (error) { %>
      <div class="mb-6">
        <div class="bg-amber-50 border-l-4 border-amber-500 rounded-lg p-4 shadow-sm flex items-center space-x-3">
          <div class="bg-amber-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-amber-800">Não foi possível desfazer o recebimento</p>
            <p class="text-sm text-amber-700"><%= error %></p>
          </div>
        </div>
      </div>
    <% } %>

    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-xl p-8">
      <div class="mb-6 border-b border-gray-100 pb-4">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Resumo da entrada</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-gray-500">Descrição</dt>
            <dd class="text-gray-900 font-semibold"><%= entrada.description %></dd>
          </div>
          <div>
            <dt class="text-gray-500">Valor</dt>
            <dd class="text-green-700 font-semibold">
              R$ <%= parseFloat(entrada.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500">Data da entrada</dt>
            <dd class="text-gray-900">
              <%= entrada.entry_date ? new Date(entrada.entry_date).toLocaleDateString('pt-BR') : '-' %>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500">Recebida em</dt>
            <dd class="text-gray-900">
              <%= entrada.received_at ? new Date(entrada.received_at).toLocaleDateString('pt-BR') : '-' %>
            </dd>
          </div>
        </dl>
      </div>

      <form method="POST" action="/financeiro/entradas/<%= entrada.id %>/desfazer-recebimento" class="space-y-6">
        <div>
          <label for="reason" class="block text-sm font-semibold text-gray-800 mb-2">
            Motivo para desfazer o recebimento <span class="text-red-500">*</span>
          </label>
          <textarea
            id="reason"
            name="reason"
            required
            rows="4"
            class="w-full px-4 py-3 border-2 border-amber-200 rounded-xl focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 text-gray-900 placeholder-gray-400"
            placeholder="Explique por que o recebimento deve ser desfeito (ex: lançamento duplicado, erro de valor, etc.)"
          ><%= typeof formData !== 'undefined' && formData.reason ? formData.reason : '' %></textarea>
        </div>

        <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4 border-t border-gray-100">
          <a
            href="/financeiro/entradas"
            class="px-8 py-3 border-2 border-gray-200 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 text-center"
          >
            Cancelar
          </a>
          <button
            type="submit"
            class="px-8 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 text-white font-semibold shadow-lg hover:shadow-xl transition-all duration-200"
          >
            Confirmar desfazer recebimento
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>

