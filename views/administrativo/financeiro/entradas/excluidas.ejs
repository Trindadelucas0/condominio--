<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Entradas excluídas</h1>
        <p class="text-gray-600 mt-1">Entradas que foram excluídas podem ser restauradas aqui.</p>
      </div>
      <a href="/financeiro/entradas" class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium">
        ← Voltar para Entradas
      </a>
    </div>

    <% if (typeof query !== 'undefined' && query.error) { %>
      <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 rounded text-red-800">
        <%= query.error %>
      </div>
    <% } %>

    <% if (!entries || entries.length === 0) { %>
      <div class="bg-white rounded-xl shadow p-8 text-center">
        <p class="text-gray-600 mb-4">Nenhuma entrada excluída no momento.</p>
        <a href="/financeiro/entradas" class="text-green-600 hover:text-green-700 font-medium">Voltar para a lista de entradas</a>
      </div>
    <% } else { %>
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Descrição</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Valor</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Data entrada</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Excluída em</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Excluído por</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 uppercase">Ação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% entries.forEach((e) => { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-gray-900"><%= e.description || '-' %></td>
                  <td class="px-4 py-3 font-medium text-gray-900">R$ <%= parseFloat(e.amount || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= e.entry_date ? new Date(e.entry_date).toLocaleDateString('pt-BR') : '-' %></td>
                  <td class="px-4 py-3 text-gray-600"><%= e.deleted_at ? new Date(e.deleted_at).toLocaleString('pt-BR') : '-' %></td>
                  <td class="px-4 py-3 text-gray-600"><%= e.deleted_by_name || '-' %></td>
                  <td class="px-4 py-3 text-right">
                    <form action="/financeiro/entradas/<%= e.id %>/restaurar" method="POST" class="inline">
                      <button type="submit" class="px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded hover:bg-green-700">Restaurar</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../../../partials/footer') %>
