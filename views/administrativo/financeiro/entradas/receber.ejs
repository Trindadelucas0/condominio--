<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Marcar entrada como recebida'; %>
  <% var resumo = ['Clique em Confirmar para marcar como recebido. Todos os campos são opcionais.', 'Ao salvar, o valor entra no saldo e a receita fica com status Recebido.', 'Use quando o dinheiro tiver efetivamente entrado no caixa.']; %>
  <% var helpModalContent = '<p>Os campos método, detalhes e comprovante são opcionais. Basta clicar em Confirmar Recebimento para marcar a entrada como recebida. Ao salvar, o valor passa a constar no saldo.</p>'; %>
  <!-- Cabeçalho -->
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Marcar Entrada como Recebida</h1>
      <p class="text-gray-600 mt-2">Confirme o recebimento. Todos os campos são opcionais.</p>
    </div>
    <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Informações da entrada -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Informações da Entrada</h2>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-sm text-gray-500">Descrição</p>
        <p class="font-semibold text-gray-800"><%= entry.description %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Valor</p>
        <p class="font-bold text-green-600 text-lg">
          R$ <%= parseFloat(entry.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
        </p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Data da Entrada</p>
        <p class="font-semibold text-gray-800"><%= new Date(entry.entry_date).toLocaleDateString('pt-BR') %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Categoria</p>
        <p class="font-semibold text-gray-800"><%= (typeof categoryLabels !== 'undefined' && categoryLabels[entry.category]) ? categoryLabels[entry.category] : entry.category %></p>
      </div>
      <% if (entry.cost_center_name) { %>
        <div>
          <p class="text-sm text-gray-500">Centro de Custo</p>
          <p class="font-semibold text-gray-800"><%= entry.cost_center_name %></p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Formulário de recebimento -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Detalhes do Recebimento</h2>
    
    <form method="POST" action="/financeiro/entradas/<%= entry.id %>/receber" enctype="multipart/form-data">
      <!-- Método de Recebimento -->
      <div class="mb-4">
        <label for="receiptMethod" class="block text-sm font-medium text-gray-700 mb-2">
          Método de Recebimento <span class="text-gray-500 font-normal">(opcional)</span>
        </label>
        <select
          id="receiptMethod"
          name="receiptMethod"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Selecione...</option>
          <option value="PIX" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'PIX') ? 'selected' : '' %>>PIX</option>
          <option value="TRANSFERENCIA" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'TRANSFERENCIA') ? 'selected' : '' %>>Transferência Bancária</option>
          <option value="DINHEIRO" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'DINHEIRO') ? 'selected' : '' %>>Dinheiro</option>
          <option value="CHEQUE" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'CHEQUE') ? 'selected' : '' %>>Cheque</option>
          <option value="BOLETO" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'BOLETO') ? 'selected' : '' %>>Boleto</option>
          <option value="CARTAO" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'CARTAO') ? 'selected' : '' %>>Cartão de Débito/Crédito</option>
          <option value="OUTRA" <%= (typeof formData !== 'undefined' && formData.receiptMethod === 'OUTRA') ? 'selected' : '' %>>Outra</option>
        </select>
      </div>

      <!-- Upload de PDF (opcional; pode adicionar depois em "Ver Comprovante") -->
      <div class="mb-4">
        <label for="receiptPdf" class="block text-sm font-medium text-gray-700 mb-2">
          Comprovante em PDF <span class="text-gray-500 font-normal">(opcional)</span>
        </label>
        <input
          type="file"
          id="receiptPdf"
          name="receiptPdf"
          accept="application/pdf"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <p class="text-xs text-gray-500 mt-1">Apenas arquivos PDF (máximo 10MB). Você pode adicionar o comprovante depois pela lista de entradas.</p>
      </div>

      <!-- Detalhes do Recebimento -->
      <div class="mb-4">
        <label for="receiptDetails" class="block text-sm font-medium text-gray-700 mb-2">
          Detalhes do Recebimento <span class="text-gray-500 font-normal">(opcional)</span>
        </label>
        <textarea
          id="receiptDetails"
          name="receiptDetails"
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: Recebido via PIX, comprovante anexado. Valor confirmado na conta corrente do condomínio."
        ><%= typeof formData !== 'undefined' && formData.receiptDetails ? formData.receiptDetails : '' %></textarea>
        <p class="text-xs text-gray-500 mt-1">Descreva os detalhes do recebimento (método, conta, data, etc.)</p>
      </div>

      <!-- Observações Adicionais -->
      <div class="mb-6">
        <label for="receiptNotes" class="block text-sm font-medium text-gray-700 mb-2">
          Observações Adicionais (Opcional)
        </label>
        <textarea
          id="receiptNotes"
          name="receiptNotes"
          rows="3"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Informações adicionais sobre o recebimento..."
        ><%= typeof formData !== 'undefined' && formData.receiptNotes ? formData.receiptNotes : '' %></textarea>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/financeiro/entradas"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition"
        >
          Confirmar Recebimento
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
