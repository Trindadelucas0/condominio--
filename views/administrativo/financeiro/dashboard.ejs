<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Financeiro</h1>
    <p class="text-gray-600 mt-2">Controle financeiro do condomínio</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Saldo -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Saldo Atual</p>
          <p class="text-3xl font-bold <%= stats.balance >= 0 ? 'text-green-600' : 'text-red-600' %> mt-2">
            R$ <%= stats.balance.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
          </p>
        </div>
        <div class="bg-<%= stats.balance >= 0 ? 'green' : 'red' %>-100 rounded-full p-4">
          <svg class="w-8 h-8 text-<%= stats.balance >= 0 ? 'green' : 'red' %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Total Entradas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Total Entradas</p>
          <p class="text-3xl font-bold text-green-600 mt-2">
            R$ <%= stats.totalEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
          </p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/financeiro/entradas" class="text-green-600 text-sm mt-4 inline-block hover:underline">
        Ver entradas →
      </a>
    </div>

    <!-- Total Saídas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Total Saídas</p>
          <p class="text-3xl font-bold text-red-600 mt-2">
            R$ <%= stats.totalExits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
          </p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/financeiro/saidas" class="text-red-600 text-sm mt-4 inline-block hover:underline">
        Ver saídas →
      </a>
    </div>

    <!-- Aprovações Pendentes -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Aprovações Pendentes</p>
          <p class="text-3xl font-bold text-orange-600 mt-2"><%= stats.pendingApprovals %></p>
        </div>
        <div class="bg-orange-100 rounded-full p-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/administrativo/financeiro/entradas/nova" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition text-center">
        Nova Entrada
      </a>
      <a href="/administrativo/financeiro/saidas/nova" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition text-center">
        Nova Saída
      </a>
      <a href="/administrativo/financeiro/contas/nova" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition text-center">
        Nova Conta
      </a>
      <a href="/administrativo/financeiro/centros-custo/novo" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition text-center">
        Novo Centro de Custo
      </a>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
