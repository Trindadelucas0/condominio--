<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="page-title">Dashboard Financeiro</h1>
    <p class="page-subtitle">Visão geral e análise financeira do condomínio</p>
  </div>

  <!-- Cards de KPIs principais -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Saldo Atual -->
    <% 
      const balance = stats.balance !== undefined ? stats.balance : (stats.saldo !== undefined ? stats.saldo : 0);
      const balanceValue = typeof balance === 'number' ? balance : 0;
    %>
    <div class="card card-hover border-l-4 <%= balanceValue >= 0 ? 'border-green-500' : 'border-red-500' %>">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Saldo Atual</p>
          <p class="text-3xl font-bold <%= balanceValue >= 0 ? 'text-green-600' : 'text-red-600' %> mt-2">
            R$ <%= balanceValue.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
          </p>
        </div>
        <div class="bg-<%= balanceValue >= 0 ? 'green' : 'red' %>-100 rounded-full p-4">
          <svg class="w-8 h-8 text-<%= balanceValue >= 0 ? 'green' : 'red' %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Entradas do Mês -->
    <div class="card-tech card-hover border-l-4 border-green-500">
      <div class="flex items-center justify-between relative z-10">
        <div>
          <p class="text-gray-600 text-xs sm:text-sm font-medium uppercase tracking-wide">Entradas (Mês Atual)</p>
          <p class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-green-600 to-green-700 bg-clip-text text-transparent mt-2">
            R$ <%= typeof kpis !== 'undefined' && kpis.currentMonth ? kpis.currentMonth.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) : '0,00' %>
          </p>
          <% if (typeof kpis !== 'undefined' && kpis.variations && kpis.variations.entries !== 0) { %>
            <p class="text-xs mt-1 <%= kpis.variations.entries >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= kpis.variations.entries >= 0 ? '↑' : '↓' %> <%= Math.abs(kpis.variations.entries).toFixed(1) %>% vs mês anterior
            </p>
          <% } %>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Saídas do Mês -->
    <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-red-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Saídas (Mês Atual)</p>
          <p class="text-3xl font-bold text-red-600 mt-2">
            R$ <%= typeof kpis !== 'undefined' && kpis.currentMonth ? kpis.currentMonth.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) : '0,00' %>
          </p>
          <% if (typeof kpis !== 'undefined' && kpis.variations && kpis.variations.exits !== 0) { %>
            <p class="text-xs mt-1 <%= kpis.variations.exits >= 0 ? 'text-red-600' : 'text-green-600' %>">
              <%= kpis.variations.exits >= 0 ? '↑' : '↓' %> <%= Math.abs(kpis.variations.exits).toFixed(1) %>% vs mês anterior
            </p>
          <% } %>
        </div>
        <div class="icon-container bg-gradient-to-br from-red-100 to-red-200 rounded-xl p-4 shadow-lg">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Média Mensal -->
    <div class="card-tech card-hover border-l-4 border-blue-500">
      <div class="flex items-center justify-between relative z-10">
        <div>
          <p class="text-gray-600 text-xs sm:text-sm font-medium uppercase tracking-wide">Média Mensal (6 meses)</p>
          <p class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent mt-2">
            R$ <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2}) : '0,00' %>
          </p>
          <p class="text-xs text-gray-500 mt-1">Entradas / Saídas</p>
          <p class="text-2xl font-bold text-red-600">
            R$ <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2}) : '0,00' %>
          </p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Segunda linha - Novas funcionalidades -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
    <!-- Entradas Pendentes de Análise -->
    <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-blue-500">
      <div class="flex items-center justify-between relative z-10">
        <div>
          <p class="text-gray-600 text-xs sm:text-sm font-medium uppercase tracking-wide">Entradas Pendentes</p>
          <p class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent mt-2"><%= typeof stats !== 'undefined' && stats.pendingEntries !== undefined ? stats.pendingEntries : 0 %></p>
          <p class="text-xs text-gray-500 mt-1">Aguardando aprovação</p>
        </div>
        <div class="icon-container bg-gradient-to-br from-blue-100 to-blue-200 rounded-xl p-4 shadow-lg">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Entradas Rejeitadas -->
    <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
    <div class="card card-hover border-l-4 border-red-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Entradas Rejeitadas</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.rejectedEntries %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
      </div>
      <a href="/financeiro/entradas-rejeitadas" class="text-red-600 text-sm mt-4 inline-block hover:underline">
        Corrigir →
      </a>
    </div>
    <% } %>

    <!-- Orçamentos Aguardando Análise -->
    <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
    <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-yellow-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Orçamentos Aguardando</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.pendingBudgetFinanceiro %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/financeiro/orcamentos-pendentes" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Analisar →
      </a>
    </div>
    <% } %>

    <!-- Orçamentos Aprovados -->
    <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
    <div class="card card-hover border-l-4 border-green-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Orçamentos Aprovados</p>
          <p class="text-3xl font-bold text-green-600 mt-2"><%= stats.approvedBudgets %></p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/financeiro/orcamentos-aprovados" class="text-green-600 text-sm mt-4 inline-block hover:underline">
        Liberar →
      </a>
    </div>
    <% } %>

    <!-- Orçamentos Rejeitados -->
    <% if (typeof stats !== 'undefined' && stats.rejectedBudgets !== undefined && stats.rejectedBudgets > 0) { %>
    <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-orange-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Orçamentos Rejeitados</p>
          <p class="text-3xl font-bold text-orange-600 mt-2"><%= stats.rejectedBudgets %></p>
        </div>
        <div class="bg-orange-100 rounded-full p-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/administrativo/orcamentos?status=REJECTED" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ajustar →
      </a>
    </div>
    <% } %>
  </div>

  <!-- Gráficos -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-8">
    <!-- Gráfico de Evolução (Últimos 6 meses) -->
    <div class="card">
      <h2 class="text-lg sm:text-xl font-bold text-gray-800 mb-4">Evolução Financeira (6 meses)</h2>
      <div class="chart-container">
        <canvas id="evolutionChart"></canvas>
      </div>
    </div>

    <!-- Gráfico de Consumo de Contas -->
    <div class="card">
      <h2 class="text-lg sm:text-xl font-bold text-gray-800 mb-4">Consumo de Contas</h2>
      <div class="chart-container">
        <canvas id="consumptionChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Tabela de Consumo Mensal -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold text-gray-800">Consumo Mensal de Contas</h2>
      <a href="/financeiro/consumo/novo" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm">
        Registrar Consumo
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Conta</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mês/Ano</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Consumo</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (typeof kpis !== 'undefined' && kpis.consumption && kpis.consumption.length > 0) { %>
            <% kpis.consumption.forEach(cons => { %>
              <tr class="table-row">
                <td class="table-cell font-medium"><%= cons.billName %></td>
                <td class="table-cell text-gray-500">
                  <%= cons.month %>/<%= cons.year %>
                </td>
                <td class="table-cell text-gray-500">
                  <%= cons.consumptionValue ? cons.consumptionValue.toLocaleString('pt-BR', {minimumFractionDigits: 2}) + ' ' + cons.consumptionUnit : '-' %>
                </td>
                <td class="table-cell font-bold">
                  R$ <%= cons.billAmount.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </td>
                <td class="table-cell">
                  <span class="badge-success">
                    Registrado
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-gray-500">
                Nenhum consumo registrado ainda. <a href="/financeiro/consumo/novo" class="text-primary-600 hover:text-primary-700 transition-colors duration-200">Registre o primeiro consumo</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="card">
    <h2 class="text-lg sm:text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <a href="/financeiro/entradas/nova" class="btn-primary text-center bg-green-600 hover:bg-green-700 focus:ring-green-500">
        Nova Entrada
      </a>
      <a href="/financeiro/saidas/nova" class="btn-danger text-center">
        Nova Saída
      </a>
      <a href="/financeiro/contas/nova" class="btn-primary text-center">
        Nova Conta
      </a>
      <a href="/financeiro/consumo/novo" class="btn-primary text-center bg-blue-600 hover:bg-blue-700 focus:ring-blue-500">
        Registrar Consumo
      </a>
      <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
      <a href="/financeiro/entradas-rejeitadas" class="btn-danger text-center">
        Corrigir Entradas (<%= stats.rejectedEntries %>)
      </a>
      <% } %>
      <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
      <a href="/financeiro/orcamentos-pendentes" class="btn-primary text-center bg-yellow-600 hover:bg-yellow-700 focus:ring-yellow-500">
        Analisar Orçamentos (<%= stats.pendingBudgetFinanceiro %>)
      </a>
      <% } %>
      <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
      <a href="/financeiro/orcamentos-aprovados" class="btn-primary text-center bg-green-600 hover:bg-green-700 focus:ring-green-500">
        Liberar Orçamentos (<%= stats.approvedBudgets %>)
      </a>
      <% } %>
    </div>
  </div>
</div>
</main>

<script>
  // Dados para gráficos
  const last6MonthsData = <%- JSON.stringify(typeof kpis !== 'undefined' && kpis.last6Months ? kpis.last6Months : []) %>;
  const consumptionData = <%- JSON.stringify(typeof kpis !== 'undefined' && kpis.avgConsumption ? kpis.avgConsumption : []) %>;

  // Gráfico de Evolução
  const evolutionCtx = document.getElementById('evolutionChart');
  if (evolutionCtx && last6MonthsData.length > 0) {
    new Chart(evolutionCtx, {
      type: 'line',
      data: {
        labels: last6MonthsData.map(d => {
          const [year, month] = d.period.split('-');
          const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
          return `${monthNames[parseInt(month) - 1]}/${year}`;
        }),
        datasets: [
          {
            label: 'Entradas',
            data: last6MonthsData.map(d => d.entries),
            borderColor: '#2CB930',
            backgroundColor: 'rgba(44, 185, 48, 0.15)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7,
            pointBackgroundColor: '#2CB930',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2
          },
          {
            label: 'Saídas',
            data: last6MonthsData.map(d => d.exits),
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239, 68, 68, 0.15)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7,
            pointBackgroundColor: '#ef4444',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2
          },
          {
            label: 'Saldo',
            data: last6MonthsData.map(d => d.balance),
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.15)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 5,
            pointHoverRadius: 7,
            pointBackgroundColor: '#3b82f6',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        aspectRatio: 2,
        plugins: {
          legend: {
            position: 'top',
          },
          title: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            max: function(context) {
              const values = context.chart.data.datasets.flatMap(d => d.data);
              const max = Math.max(...values);
              return max > 0 ? max * 1.1 : 1000; // Adiciona 10% de margem ou mínimo de 1000
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        }
      }
    });
  }

  // Gráfico de Consumo
  const consumptionCtx = document.getElementById('consumptionChart');
  if (consumptionCtx && consumptionData.length > 0) {
    new Chart(consumptionCtx, {
      type: 'bar',
      data: {
        labels: consumptionData.map(d => {
          const types = {
            'AGUA': 'Água',
            'LUZ': 'Energia',
            'GAS': 'Gás',
            'TELEFONE': 'Telefone',
            'INTERNET': 'Internet',
            'OUTRA': 'Outra'
          };
          return types[d.billType] || d.billType;
        }),
        datasets: [
          {
            label: 'Média de Valor (R$)',
            data: consumptionData.map(d => d.avgAmount),
            backgroundColor: [
              '#2CB930',
              '#3b82f6',
              '#8b5cf6',
              '#f59e0b',
              '#ef4444',
              '#06b6d4'
            ],
            borderColor: '#ffffff',
            borderWidth: 2,
            borderRadius: 8,
            borderSkipped: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 12,
            titleFont: {
              size: 14,
              weight: 'bold'
            },
            bodyFont: {
              size: 13
            },
            borderColor: 'rgba(255, 255, 255, 0.1)',
            borderWidth: 1,
            cornerRadius: 8
          }
        },
        scales: {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                size: 11
              }
            }
          },
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            },
            max: function(context) {
              const values = context.chart.data.datasets.flatMap(d => d.data);
              const max = Math.max(...values);
              return max > 0 ? max * 1.1 : 1000;
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              },
              font: {
                size: 11
              }
            }
          }
        }
      }
    });
  }

  // Gráfico de Comparação de Consumo (Água e Energia)
  const consumptionComparisonCtx = document.getElementById('consumptionComparisonChart');
  if (consumptionComparisonCtx) {
    // Buscar dados de consumo para comparação
    fetch('/financeiro/api/consumption-comparison')
      .then(res => res.json())
      .then(data => {
        if (data && data.length > 0) {
          // Agrupa por período (mês/ano)
          const periodsMap = new Map();
          data.forEach(d => {
            const key = `${d.year}-${String(d.month).padStart(2, '0')}`;
            if (!periodsMap.has(key)) {
              periodsMap.set(key, { month: d.month, year: d.year, agua: null, energia: null });
            }
            const period = periodsMap.get(key);
            if (d.billType === 'AGUA') {
              period.agua = d.billAmount;
            } else if (d.billType === 'LUZ') {
              period.energia = d.billAmount;
            }
          });

          // Ordena por período
          const sortedPeriods = Array.from(periodsMap.values()).sort((a, b) => {
            if (a.year !== b.year) return b.year - a.year;
            return b.month - a.month;
          });

          const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
          const labels = sortedPeriods.map(p => `${monthNames[p.month - 1]}/${p.year}`);
          const aguaData = sortedPeriods.map(p => p.agua || 0);
          const energiaData = sortedPeriods.map(p => p.energia || 0);

          new Chart(consumptionComparisonCtx, {
            type: 'line',
            data: {
              labels: labels,
              datasets: [
                {
                  label: 'Água (R$)',
                  data: aguaData,
                  borderColor: 'rgb(59, 130, 246)',
                  backgroundColor: 'rgba(59, 130, 246, 0.1)',
                  tension: 0.4,
                  fill: true
                },
                {
                  label: 'Energia (R$)',
                  data: energiaData,
                  borderColor: 'rgb(251, 191, 36)',
                  backgroundColor: 'rgba(251, 191, 36, 0.1)',
                  tension: 0.4,
                  fill: true
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              aspectRatio: 2.5,
              plugins: {
                legend: {
                  position: 'top',
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  max: function(context) {
                    const values = context.chart.data.datasets.flatMap(d => d.data);
                    const max = Math.max(...values);
                    return max > 0 ? max * 1.1 : 1000;
                  },
                  ticks: {
                    callback: function(value) {
                      return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                    }
                  }
                }
              }
            }
          });
        } else {
          consumptionComparisonCtx.parentElement.innerHTML = '<p class="text-gray-500 text-center py-8">Nenhum dado de consumo disponível para comparação</p>';
        }
      })
      .catch(err => {
        console.error('Erro ao carregar dados de comparação:', err);
        consumptionComparisonCtx.parentElement.innerHTML = '<p class="text-gray-500">Erro ao carregar dados de comparação</p>';
      });
  }

  // Carregar projeções
  fetch('/financeiro/api/projections')
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('projectionsContainer');
      if (data && data.months && data.months.length > 0) {
        let html = '<div class="grid grid-cols-1 md:grid-cols-3 gap-4">';
        data.months.forEach(month => {
          html += `
            <div class="border border-gray-200 rounded-lg p-4">
              <h3 class="font-bold text-lg text-gray-800 mb-3">${month.label}</h3>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <span class="text-sm text-gray-600">Entradas Previstas:</span>
                  <span class="font-semibold text-green-600">R$ ${month.projectedEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-sm text-gray-600">Saídas Previstas:</span>
                  <span class="font-semibold text-red-600">R$ ${month.projectedExits.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</span>
                </div>
                <div class="flex justify-between border-t pt-2">
                  <span class="text-sm font-medium text-gray-800">Saldo Projetado:</span>
                  <span class="font-bold ${month.projectedBalance >= 0 ? 'text-green-600' : 'text-red-600'}">
                    R$ ${month.projectedBalance.toLocaleString('pt-BR', {minimumFractionDigits: 2})}
                  </span>
                </div>
              </div>
            </div>
          `;
        });
        html += '</div>';
        container.innerHTML = html;
      } else {
        container.innerHTML = '<p class="text-gray-500">Nenhuma projeção disponível. Configure entradas e saídas recorrentes para ver projeções.</p>';
      }
    })
    .catch(err => {
      console.error('Erro ao carregar projeções:', err);
      document.getElementById('projectionsContainer').innerHTML = '<p class="text-red-500">Erro ao carregar projeções</p>';
    });
</script>

<%- include('../../partials/footer') %>
