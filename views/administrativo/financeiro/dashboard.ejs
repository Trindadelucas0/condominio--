<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
  /* Animações personalizadas */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }

  @keyframes glow {
    0%, 100% {
      box-shadow: 0 0 5px rgba(59, 130, 246, 0.5);
    }
    50% {
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.8), 0 0 30px rgba(59, 130, 246, 0.6);
    }
  }

  /* Efeito glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
  }

  /* Card moderno com gradiente */
  .card-modern {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    overflow: hidden;
  }

  .card-modern::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    animation: pulse 3s ease-in-out infinite;
  }

  /* Card com efeito de brilho */
  .card-glow {
    position: relative;
    transition: all 0.3s ease;
  }

  .card-glow:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1), 0 0 30px rgba(59, 130, 246, 0.3);
  }

  /* Efeito de shimmer no hover */
  .shimmer-effect {
    position: relative;
    overflow: hidden;
  }

  .shimmer-effect::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s;
  }

  .shimmer-effect:hover::after {
    left: 100%;
  }

  /* Animação de entrada */
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }

  .animate-slide-in-right {
    animation: slideInRight 0.6s ease-out;
  }

  /* Delay para animações escalonadas */
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }
  .delay-400 { animation-delay: 0.4s; }

  /* Gradiente animado de fundo */
  .gradient-bg {
    background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Efeito de partículas de fundo */
  .particles-bg {
    position: relative;
  }

  .particles-bg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Botão moderno com efeito */
  .btn-modern {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .btn-modern::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .btn-modern:hover::before {
    width: 300px;
    height: 300px;
  }

  /* Ícone com rotação no hover */
  .icon-rotate:hover {
    animation: rotate 0.5s ease;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Efeito de neomorfismo suave */
  .neo-card {
    background: #f0f0f3;
    box-shadow: 
      10px 10px 20px #d0d0d3,
      -10px -10px 20px #ffffff;
    transition: all 0.3s ease;
  }

  .neo-card:hover {
    box-shadow: 
      5px 5px 10px #d0d0d3,
      -5px -5px 10px #ffffff;
  }

  /* Gráfico com fundo moderno */
  .chart-modern {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  /* Tabela moderna */
  .table-modern {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
  }

  .table-modern thead {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .table-modern tbody tr {
    transition: all 0.2s ease;
  }

  .table-modern tbody tr:hover {
    background: rgba(102, 126, 234, 0.1);
    transform: scale(1.01);
  }

  /* Scroll suave */
  html {
    scroll-behavior: smooth;
  }

  /* Efeito de brilho nos números grandes */
  .number-glow {
    text-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
  }

  /* Animação de contador (se necessário) */
  @keyframes countUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .count-animate {
    animation: countUp 0.6s ease-out;
  }

  /* Efeito de hover nos cards com elevação */
  .card-elevate {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-elevate:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 0 30px rgba(59, 130, 246, 0.2);
  }

  /* Gradiente de texto animado */
  .text-gradient-animated {
    background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #4facfe);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
  }

  /* Efeito de partículas flutuantes */
  .floating {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  /* Efeito de loading skeleton */
  .skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  /* Melhorias de acessibilidade */
  .focus-visible:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* Efeito de vidro mais pronunciado */
  .glass-strong {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
  }
</style>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Financeiro'; %>
    <% var resumo = ['Este é o painel principal do financeiro: você vê o saldo, totais do mês e itens que precisam de atenção.', 'Os números mostram receitas (entradas) e despesas (saídas) do condomínio.', 'Use os atalhos para ir a Receitas, Despesas, Boletos a pagar e Fechamento mensal.', '"Itens que precisam de atenção" mostra pendências (ex.: boletos vencidos); resolva e marque como visualizado.']; %>
    <% var helpModalContent = '<p><strong>O que é o Dashboard?</strong> É a tela inicial do módulo financeiro. Aqui você tem uma visão geral do dinheiro do condomínio: quanto entrou (receitas), quanto saiu (despesas) e o saldo.</p><p><strong>Os cards de números</strong> mostram o saldo total, o saldo do mês atual, do mês passado e a média. Use esses valores para acompanhar a saúde financeira.</p><p><strong>Itens que precisam de atenção:</strong> aparecem contas vencidas, documentos próximos do vencimento e alertas. Clique em "Ver detalhes" para ir à tela correta e resolver. Depois use "OK" para marcar como visualizado.</p><p><strong>Comece por aqui:</strong> se for a primeira vez, o sistema sugere cadastrar a primeira receita ou um fornecedor em Contas. O link "Como funciona" explica todo o fluxo.</p><p><strong>Em resumo:</strong> use o dashboard para monitorar; para lançar receitas e despesas, vá em Receitas ou Despesas no menu.</p>'; %>
    <!-- Cabeçalho Limpo -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">
            Dashboard Financeiro
          </h1>
          <p class="text-gray-600">Visão geral e análise financeira do condomínio</p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0">
          <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
          <div class="hidden md:flex items-center space-x-2 bg-green-50 px-4 py-2 rounded-lg">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm text-gray-700 font-medium">Sistema Online</span>
          </div>
        </div>
      </div>
    </div>
    <% var periodo = typeof periodo !== 'undefined' && periodo ? periodo : null; %>
    <% var cq = typeof consumoQuery !== 'undefined' && consumoQuery ? consumoQuery : { consumoBillId: '', consumoBillType: '' }; %>
    <% var billsCF = typeof billsForConsumptionFilter !== 'undefined' && billsForConsumptionFilter ? billsForConsumptionFilter : []; %>
    <% var footnoteResumoFin = (helpTitle && helpModalContent) ? 'Quer o passo a passo completo? Clique em <strong>Dúvidas? Como funciona</strong> ao lado do título.' : ''; %>
    <% var resumoIaTeaserFin = ''; %>
    <% if (periodo && periodo.label) { resumoIaTeaserFin = 'Os números e o gráfico de consumo seguem o período selecionado (' + periodo.label + ').'; } else if (typeof resumo !== 'undefined' && resumo && resumo.length) { resumoIaTeaserFin = resumo[0]; } %>
    <div class="mb-6 grid grid-cols-1 lg:grid-cols-[minmax(0,40%)_minmax(0,60%)] gap-4 lg:gap-5 items-start animate-fade-in-up">
      <div class="min-w-0 w-full lg:max-w-xl">
        <%- include('../../partials/help-resumo-rapido-card', { resumo: resumo, footnoteHtml: footnoteResumoFin, resumoIaTeaser: resumoIaTeaserFin }) %>
      </div>
      <div class="min-w-0 flex w-full">
        <div id="dash-financeiro-filtros" class="w-full rounded-xl border border-purple-200/90 bg-white shadow-md overflow-hidden flex flex-col ring-1 ring-purple-500/10">
          <div class="bg-gradient-to-r from-purple-600 via-purple-600 to-pink-600 px-4 py-3 sm:px-5">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/15">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <h3 id="financeiro-periodo-heading" class="text-base sm:text-lg font-bold text-white leading-snug">Período e filtros do painel</h3>
                <p class="text-xs sm:text-sm text-purple-100/95 leading-snug mt-0.5">Datas, consumo por tipo e por conta — os cards abaixo refletem o que você aplicar.</p>
              </div>
            </div>
          </div>
          <div class="p-4 sm:p-5 flex flex-col gap-4" aria-labelledby="financeiro-periodo-heading">
            <form method="get" action="/financeiro/dashboard" class="flex flex-col gap-4">
              <div class="flex flex-wrap items-end gap-3">
                <div>
                  <label for="dash-data-inicio" class="block text-xs font-medium text-gray-600 mb-1">Data início</label>
                  <input id="dash-data-inicio" type="date" name="dataInicio" value="<%= periodo ? periodo.dataInicio : '' %>" class="min-h-[44px] border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 bg-gray-50/80 focus:ring-2 focus:ring-purple-500/35 focus:border-purple-500" />
                </div>
                <div>
                  <label for="dash-data-fim" class="block text-xs font-medium text-gray-600 mb-1">Data fim</label>
                  <input id="dash-data-fim" type="date" name="dataFim" value="<%= periodo ? periodo.dataFim : '' %>" class="min-h-[44px] border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 bg-gray-50/80 focus:ring-2 focus:ring-purple-500/35 focus:border-purple-500" />
                </div>
                <div>
                  <label for="dash-consumo-tipo" class="block text-xs font-medium text-gray-600 mb-1">Consumo: tipo</label>
                  <select id="dash-consumo-tipo" name="consumoBillType" class="min-h-[44px] border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 bg-gray-50/80 focus:ring-2 focus:ring-purple-500/35 min-w-[140px]">
                    <option value="" <%= !cq.consumoBillType ? 'selected' : '' %>>Todos</option>
                    <option value="AGUA" <%= cq.consumoBillType === 'AGUA' ? 'selected' : '' %>>Água</option>
                    <option value="LUZ" <%= cq.consumoBillType === 'LUZ' ? 'selected' : '' %>>Energia</option>
                    <option value="GAS" <%= cq.consumoBillType === 'GAS' ? 'selected' : '' %>>Gás</option>
                    <option value="TELEFONE" <%= cq.consumoBillType === 'TELEFONE' ? 'selected' : '' %>>Telefone</option>
                    <option value="INTERNET" <%= cq.consumoBillType === 'INTERNET' ? 'selected' : '' %>>Internet</option>
                    <option value="OUTRA" <%= cq.consumoBillType === 'OUTRA' ? 'selected' : '' %>>Outra</option>
                  </select>
                </div>
                <div>
                  <label for="dash-consumo-conta" class="block text-xs font-medium text-gray-600 mb-1">Consumo: conta</label>
                  <select id="dash-consumo-conta" name="consumoBillId" class="min-h-[44px] border border-gray-200 rounded-xl px-3 py-2 text-sm text-gray-900 bg-gray-50/80 focus:ring-2 focus:ring-purple-500/35 min-w-[180px] max-w-[240px]">
                    <option value="" <%= !cq.consumoBillId ? 'selected' : '' %>>Todas</option>
                    <% billsCF.forEach(function(b) { %>
                      <option value="<%= b.id %>" <%= String(cq.consumoBillId) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <button type="submit" class="inline-flex items-center justify-center gap-2 min-h-[44px] px-5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 text-white text-sm font-semibold shadow-md hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:ring-offset-2 transition-all">Aplicar filtros</button>
                <a href="/financeiro/dashboard" class="text-sm font-medium text-gray-600 hover:text-purple-700 py-2">Mês atual (padrão)</a>
              </div>
            </form>
            <% if (periodo && periodo.label) { %>
            <div class="rounded-xl border border-purple-100 bg-gradient-to-br from-purple-50/95 to-pink-50/70 px-3 py-2.5 flex gap-3 items-start" role="status">
              <svg class="h-5 w-5 shrink-0 text-purple-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              <div class="min-w-0 leading-snug">
                <span class="text-sm font-semibold text-purple-900">Você está vendo:</span>
                <p class="text-sm sm:text-base font-medium text-gray-900 mt-1"><%= periodo.label %></p>
              </div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId, omitResumo: true }) %>

    <!-- Tabela de itens críticos (com "OK" para marcar como visualizado) -->
    <%- include('../../partials/critical-items-table', { criticalItems: typeof criticalItems !== 'undefined' ? criticalItems : [], condominiumId: typeof condominiumId !== 'undefined' ? condominiumId : null }) %>

    <% if (typeof showGettingStarted !== 'undefined' && showGettingStarted) { %>
    <!-- Comece por aqui (primeira vez) -->
    <div class="mb-8 p-6 bg-gradient-to-r from-green-50 to-emerald-50 border-2 border-green-300 rounded-2xl shadow-lg animate-fade-in-up">
      <h2 class="text-xl font-bold text-gray-900 mb-2 flex items-center">
        <span class="text-2xl mr-2">👋</span>
        Comece por aqui
      </h2>
      <p class="text-gray-700 mb-4">Parece que você ainda não tem receitas ou despesas cadastradas. Siga estes passos para começar:</p>
      <div class="flex flex-wrap gap-3">
        <a href="/financeiro/entradas/nova" class="inline-flex items-center px-5 py-2.5 bg-green-600 text-white rounded-xl font-semibold hover:bg-green-700 transition shadow-md">
          Cadastrar primeira receita
        </a>
        <a href="/financeiro/contas/nova" class="inline-flex items-center px-5 py-2.5 bg-white border-2 border-green-600 text-green-700 rounded-xl font-semibold hover:bg-green-50 transition">
          Cadastrar fornecedor (Contas)
        </a>
        <a href="/financeiro/como-funciona" class="inline-flex items-center px-5 py-2.5 text-gray-700 hover:text-green-700 font-medium">
          Como funciona o sistema →
        </a>
      </div>
    </div>
    <% } %>

    <%- include('../../partials/dashboard-resumo-financeiro', { stats: stats, periodo: periodo, analytics: typeof analytics !== 'undefined' ? analytics : null }) %>

    <!-- Cards principais: saldo total, mês atual, mês passado, média e fundo de reserva -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
      <% 
        const balance = stats.balance !== undefined ? stats.balance : (stats.saldo !== undefined ? stats.saldo : 0);
        const balanceValue = typeof balance === 'number' ? balance : 0;
        const saldoMesAtual = typeof stats.saldoMesAtual !== 'undefined' ? stats.saldoMesAtual : 0;
        const saldoMesPassado = typeof stats.saldoMesPassado !== 'undefined' ? stats.saldoMesPassado : 0;
      %>
      <!-- Saldo total do condomínio -->
      <div class="bg-white rounded-xl p-8 shadow-lg border <%= balanceValue >= 0 ? 'border-green-300 border-l-2 border-l-green-500' : 'border-red-300 border-l-2 border-l-red-500' %> hover:shadow-xl transition-all duration-300 animate-fade-in-up">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Saldo total do condomínio</p>
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 <%= balanceValue >= 0 ? 'bg-green-500' : 'bg-red-500' %> rounded-full"></div>
                <span class="text-xs font-semibold <%= balanceValue >= 0 ? 'text-green-600' : 'text-red-600' %> uppercase tracking-wide">
                  <%= balanceValue >= 0 ? 'Positivo' : 'Negativo' %>
                </span>
              </div>
            </div>
            <div class="<%= balanceValue >= 0 ? 'bg-green-100' : 'bg-red-100' %> rounded-lg p-3">
              <svg class="w-8 h-8 <%= balanceValue >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4">
            <p class="text-4xl font-bold <%= balanceValue >= 0 ? 'text-green-600' : 'text-red-600' %> leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= balanceValue.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
            </p>
            <p class="text-xs text-gray-500 mt-1">Todos os meses (incl. fechados)</p>
          </div>
        </div>
      </div>

      <!-- Saldo do período -->
      <div class="bg-white rounded-xl p-8 shadow-lg border <%= saldoMesAtual >= 0 ? 'border-green-300 border-l-2 border-l-green-500' : 'border-red-300 border-l-2 border-l-red-500' %> hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-100">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Saldo do período</p>
              <% if (typeof periodo !== 'undefined' && periodo && periodo.label) { %>
                <p class="text-xs text-gray-500"><%= periodo.label %></p>
              <% } %>
            </div>
            <div class="<%= saldoMesAtual >= 0 ? 'bg-green-100' : 'bg-red-100' %> rounded-lg p-3">
              <svg class="w-8 h-8 <%= saldoMesAtual >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4">
            <p class="text-4xl font-bold <%= saldoMesAtual >= 0 ? 'text-green-600' : 'text-red-600' %> leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= saldoMesAtual.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
            </p>
            <p class="text-xs text-gray-500 mt-1">Entradas recebidas − saídas (pagas ou aprovadas) no período</p>
          </div>
        </div>
      </div>

      <!-- Saldo do período anterior -->
      <div class="bg-white rounded-xl p-8 shadow-lg border <%= saldoMesPassado >= 0 ? 'border-green-300 border-l-2 border-l-green-500' : 'border-red-300 border-l-2 border-l-red-500' %> hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-200">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Período anterior (comparação)</p>
              <% if (typeof periodo !== 'undefined' && periodo && periodo.labelAnterior) { %>
                <p class="text-xs text-gray-500"><%= periodo.labelAnterior %></p>
              <% } %>
            </div>
            <div class="<%= saldoMesPassado >= 0 ? 'bg-green-100' : 'bg-red-100' %> rounded-lg p-3">
              <svg class="w-8 h-8 <%= saldoMesPassado >= 0 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4">
            <p class="text-4xl font-bold <%= saldoMesPassado >= 0 ? 'text-green-600' : 'text-red-600' %> leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= saldoMesPassado.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
            </p>
            <p class="text-xs text-gray-500 mt-1">Mesma base do período selecionado, período imediatamente anterior</p>
          </div>
        </div>
      </div>

      <!-- Média Mensal - Card Melhorado -->
      <div class="bg-white rounded-xl p-8 shadow-lg border border-blue-300 border-l-2 border-l-blue-500 hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-300">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Média Mensal</p>
              <p class="text-xs text-gray-400">Últimos 6 meses</p>
            </div>
            <div class="bg-blue-100 rounded-lg p-3">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4 space-y-4">
            <div>
              <p class="text-xs text-gray-500 mb-1 font-medium">Entradas</p>
              <p class="text-2xl font-bold text-blue-600 leading-tight">
                <span class="text-lg font-semibold text-gray-500 mr-1">R$</span>
                <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
              </p>
            </div>
            <div>
              <p class="text-xs text-gray-500 mb-1 font-medium">Saídas</p>
              <p class="text-2xl font-bold text-red-600 leading-tight">
                <span class="text-lg font-semibold text-gray-500 mr-1">R$</span>
                <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Fundo de Reserva -->
      <div class="bg-white rounded-xl p-8 shadow-lg border border-amber-300 border-l-2 border-l-amber-500 hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-300">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Fundo de Reserva</p>
              <a href="/financeiro/fundo-reserva" class="text-xs text-amber-600 hover:text-amber-700 font-medium">Ver detalhes</a>
            </div>
            <div class="bg-amber-100 rounded-lg p-3">
              <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4">
            <% if (typeof reserveFund !== 'undefined' && reserveFund) { %>
              <p class="text-4xl font-bold text-amber-600 leading-tight">
                <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
                <%= parseFloat(reserveFund.current_balance || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
              </p>
              <p class="text-xs text-gray-500 mt-1"><%= typeof reserveFund.target_percent !== 'undefined' ? reserveFund.target_percent.toFixed(1) : 0 %>% da meta</p>
              <% if (reserveFund.target_balance > 0) { %>
                <div class="mt-2 h-2 bg-amber-200 rounded-full overflow-hidden">
                  <div class="h-full bg-amber-500 rounded-full transition-all" style="width: <%= Math.min(100, Math.max(0, reserveFund.target_percent || 0)) %>%"></div>
                </div>
              <% } %>
            <% } else { %>
              <p class="text-xl font-bold text-amber-800">Não configurado</p>
              <p class="text-xs text-gray-500 mt-1">Configure em Fundo de Reserva</p>
              <a href="/financeiro/fundo-reserva" class="inline-block mt-2 text-sm font-medium text-amber-600 hover:text-amber-700">Configurar →</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Alerta Contas a Pagar (vencidas / vencendo hoje) -->
    <% if (typeof stats !== 'undefined' && (stats.payableOverdueCount > 0 || stats.payableDueTodayCount > 0)) { %>
    <a href="/financeiro/contas-a-pagar" class="block mb-8">
      <div class="bg-red-50 border-2 border-red-500 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 animate-fade-in-up">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="bg-red-500 rounded-xl p-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold text-red-800 uppercase tracking-wide">Contas a pagar</h2>
              <% if (stats.payableOverdueCount > 0) { %>
                <p class="text-red-700 font-semibold mt-1"><%= stats.payableOverdueCount %> conta(s) <strong>vencida(s)</strong></p>
              <% } %>
              <% if (stats.payableDueTodayCount > 0) { %>
                <p class="text-amber-700 font-semibold"><%= stats.payableDueTodayCount %> conta(s) <strong>vence(m) hoje</strong></p>
              <% } %>
            </div>
          </div>
          <span class="text-red-600 font-bold flex items-center">Ver e pagar <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></span>
        </div>
      </div>
    </a>
    <% } %>

    <!-- Segunda linha - Cards de Status Modernos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
      <!-- Entradas Pendentes de Análise -->
      <a href="/sindico/entradas-pendentes" class="bg-white rounded-xl p-6 shadow-lg border border-blue-300 border-l-2 border-l-blue-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-100 block">
        <div class="flex items-center justify-between">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Entradas Pendentes</p>
            <p class="text-3xl font-bold text-blue-600 mb-1">
              <%= typeof stats !== 'undefined' && stats.pendingEntries !== undefined ? stats.pendingEntries : 0 %>
            </p>
            <p class="text-xs text-gray-500 flex items-center mt-2">
              <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-2"></span>
              Aguardando aprovação
            </p>
          </div>
          <div class="bg-blue-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Entradas Rejeitadas -->
      <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
      <a href="/financeiro/entradas-rejeitadas" class="bg-white rounded-xl p-6 shadow-lg border border-red-300 border-l-2 border-l-red-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-200 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Entradas Rejeitadas</p>
            <p class="text-3xl font-bold text-red-600 mb-1">
              <%= stats.rejectedEntries %>
            </p>
          </div>
          <div class="bg-red-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-red-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Corrigir</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Aguardando Análise -->
      <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
      <a href="/financeiro/orcamentos-pendentes" class="bg-white rounded-xl p-6 shadow-lg border border-yellow-300 border-l-2 border-l-yellow-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-300 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Aguardando</p>
            <p class="text-3xl font-bold text-yellow-600 mb-1">
              <%= stats.pendingBudgetFinanceiro %>
            </p>
          </div>
          <div class="bg-yellow-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-yellow-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Analisar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Aprovados -->
      <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
      <a href="/financeiro/orcamentos-aprovados" class="bg-white rounded-xl p-6 shadow-lg border border-green-300 border-l-2 border-l-green-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-400 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Aprovados</p>
            <p class="text-3xl font-bold text-green-600 mb-1">
              <%= stats.approvedBudgets %>
            </p>
          </div>
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-green-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Liberar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Rejeitados -->
      <% if (typeof stats !== 'undefined' && stats.rejectedBudgets !== undefined && stats.rejectedBudgets > 0) { %>
      <a href="/financeiro/orcamentos-rejeitados" class="bg-white rounded-xl p-6 shadow-lg border border-orange-300 border-l-2 border-l-orange-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-400 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Rejeitados</p>
            <p class="text-3xl font-bold text-orange-600 mb-1">
              <%= stats.rejectedBudgets %>
            </p>
          </div>
          <div class="bg-orange-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-orange-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Ajustar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>
    </div>

    <!-- Evolução financeira -->
    <div class="grid grid-cols-1 gap-6 mb-8">
      <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-300 animate-fade-in-up delay-200">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">
            Evolução Financeira
          </h2>
          <span class="text-xs text-gray-500 bg-gray-100 border border-gray-300 px-3 py-1 rounded-full font-medium">6 meses</span>
        </div>
        <div class="chart-container" style="position: relative; height: 300px;">
          <canvas id="evolutionChart"></canvas>
        </div>
      </div>
    </div>

    <% var ca = typeof consumptionAnalytics !== 'undefined' && consumptionAnalytics ? consumptionAnalytics : null; %>
    <!-- Análise de consumo de contas (período e filtros no topo) -->
    <div class="bg-white rounded-xl p-6 shadow-lg mb-8 animate-fade-in-up delay-300 border border-indigo-300">
      <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-gray-900">Consumo de contas</h2>
          <p class="text-sm text-gray-600 mt-1">
            Valor das faturas registradas em <strong>Consumo mensal</strong>, no período dos filtros acima.
            <% if (ca && ca.periodo && ca.periodo.label) { %>
              <span class="text-gray-500">(<%= ca.periodo.label %>)</span>
            <% } %>
          </p>
        </div>
        <a href="/financeiro/consumo/novo" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-indigo-700 transition-colors duration-200 flex items-center text-sm shrink-0">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Registrar consumo
        </a>
      </div>

      <% if (ca) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="rounded-xl bg-indigo-50 border border-indigo-100 p-4">
          <p class="text-xs font-medium text-indigo-800 uppercase tracking-wide">Total no período</p>
          <p class="text-2xl font-bold text-indigo-900 mt-1">R$ <%= ca.totalAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
        </div>
        <div class="rounded-xl bg-slate-50 border border-slate-300 p-4">
          <p class="text-xs font-medium text-slate-600 uppercase tracking-wide">Média mensal (R$)</p>
          <p class="text-2xl font-bold text-slate-900 mt-1">R$ <%= ca.avgMonthlyAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
          <p class="text-xs text-slate-500 mt-1"><%= ca.monthsInPeriod %> mês(es) no intervalo</p>
        </div>
        <div class="rounded-xl bg-amber-50 border border-amber-100 p-4">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <p class="text-xs font-medium text-amber-900 uppercase tracking-wide">vs. período anterior</p>
            <% if (Math.abs(ca.variationPct) >= 5) { %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= ca.variationPct > 0 ? 'bg-amber-200 text-amber-900' : 'bg-emerald-200 text-emerald-900' %>" title="Variação igual ou acima de 5% em relação ao período anterior">
                <%= ca.variationPct > 0 ? 'Atenção: alta' : 'Queda relevante' %>
              </span>
            <% } %>
          </div>
          <p class="text-2xl font-bold <%= ca.variationPct >= 0 ? 'text-amber-800' : 'text-green-700' %> mt-1">
            <%= ca.variationPct >= 0 ? '+' : '' %><%= ca.variationPct.toLocaleString('pt-BR', { minimumFractionDigits: 1 }) %>%
          </p>
          <p class="text-xs text-amber-800/80 mt-1">Anterior: R$ <%= ca.prevTotalAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
        </div>
        <div class="rounded-xl bg-emerald-50 border border-emerald-100 p-4">
          <p class="text-xs font-medium text-emerald-800 uppercase tracking-wide">Registros / último mês c/ dado</p>
          <p class="text-2xl font-bold text-emerald-900 mt-1"><%= ca.countRecords %></p>
          <p class="text-xs text-emerald-700 mt-1"><%= ca.lastMonthLabel ? ca.lastMonthLabel : '—' %></p>
        </div>
      </div>

      <p class="sr-only" id="consumption-chart-summary">
        <% if (ca) { %>
          Resumo consumo: total R$ <%= ca.totalAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %> no período.
          Variação versus período anterior: <%= ca.variationPct >= 0 ? '+' : '' %><%= ca.variationPct.toLocaleString('pt-BR', { minimumFractionDigits: 1 }) %> por cento.
        <% } %>
      </p>
      <% if (ca.seriesPorConta && ca.seriesPorConta.length > 12) { %>
        <p class="text-sm text-gray-600 mb-2" aria-live="polite">Mostrando <%= ca.seriesPorConta.length %> contas no gráfico — use a legenda com rolagem ou filtre por conta/tipo.</p>
      <% } %>
      <div class="chart-container mb-8" style="position: relative; height: 380px;">
        <canvas id="consumptionTimeSeriesChart" aria-describedby="consumption-chart-summary" role="img"></canvas>
      </div>
      <% } %>

      <h3 class="text-lg font-semibold text-gray-900 mb-3">Registros no período</h3>
      <div class="overflow-x-auto max-h-[min(60vh,28rem)] overflow-y-auto rounded-lg border border-gray-300">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Conta</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Tipo</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Mês/Ano</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Consumo</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Valor (R$)</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-700 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if (ca && ca.recentRecords && ca.recentRecords.length > 0) { %>
              <% ca.recentRecords.forEach(function(row) { %>
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                  <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900"><%= row.billName %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600 text-sm"><%= row.billType %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= row.month %>/<%= row.year %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600">
                    <%= row.consumptionValue != null ? row.consumptionValue.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + ' ' + (row.consumptionUnit || '') : '—' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900">
                    R$ <%= row.billAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <% if (row.id) { %>
                      <a href="/financeiro/consumo/<%= row.id %>/editar" class="text-indigo-600 font-medium hover:underline text-sm">Editar</a>
                    <% } else { %>
                      <span class="text-gray-400 text-sm">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                  Nenhum registro de consumo neste período e filtros. <a href="/financeiro/consumo/novo" class="text-indigo-600 font-medium hover:underline">Registrar consumo</a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Ações Rápidas - Botões Limpos -->
    <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-300 animate-fade-in-up delay-500">
      <h2 class="text-xl font-bold text-gray-900 mb-6">
        Ações Rápidas
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/financeiro/entradas/nova" class="bg-green-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Nova Entrada
        </a>
        
        <a href="/financeiro/saidas/nova" class="bg-red-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-red-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
          </svg>
          Nova Saída
        </a>
        
        <a href="/financeiro/contas/nova" class="bg-blue-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Nova Conta
        </a>
        
        <a href="/financeiro/consumo/novo" class="bg-purple-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          Registrar Consumo
        </a>
        
        <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
        <a href="/financeiro/entradas-rejeitadas" class="bg-orange-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-orange-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Corrigir Entradas (<%= stats.rejectedEntries %>)
        </a>
        <% } %>
        
        <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
        <a href="/financeiro/orcamentos-pendentes" class="bg-yellow-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-yellow-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
          Analisar Orçamentos (<%= stats.pendingBudgetFinanceiro %>)
        </a>
        <% } %>
        
        <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
        <a href="/financeiro/orcamentos-aprovados" class="bg-green-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Liberar Orçamentos (<%= stats.approvedBudgets %>)
        </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // Dados para gráficos
  const last6MonthsData = <%- JSON.stringify(typeof kpis !== 'undefined' && kpis.last6Months ? kpis.last6Months : []) %>;
  const consumptionSeries = <%- JSON.stringify((typeof consumptionAnalytics !== 'undefined' && consumptionAnalytics && consumptionAnalytics.series) ? consumptionAnalytics.series : []) %>;
  const consumptionSeriesPorConta = <%- JSON.stringify((typeof consumptionAnalytics !== 'undefined' && consumptionAnalytics && consumptionAnalytics.seriesPorConta) ? consumptionAnalytics.seriesPorConta : []) %>;
  const consumptionSeriesPhysical = <%- JSON.stringify((typeof consumptionAnalytics !== 'undefined' && consumptionAnalytics && consumptionAnalytics.seriesConsumption) ? consumptionAnalytics.seriesConsumption : null) %>;
  const consumptionUnitLabel = <%- JSON.stringify((typeof consumptionAnalytics !== 'undefined' && consumptionAnalytics && consumptionAnalytics.consumptionUnitLabel) ? consumptionAnalytics.consumptionUnitLabel : null) %>;

  // Gráfico de Evolução - Design Moderno
  const evolutionCtx = document.getElementById('evolutionChart');
  if (evolutionCtx && last6MonthsData.length > 0) {
    new Chart(evolutionCtx, {
      type: 'line',
      data: {
        labels: last6MonthsData.map(d => {
          const [year, month] = d.period.split('-');
          const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
          return `${monthNames[parseInt(month) - 1]}/${year}`;
        }),
        datasets: [
          {
            label: 'Entradas',
            data: last6MonthsData.map(d => d.entries),
            borderColor: 'rgb(34, 197, 94)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#22c55e',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#16a34a',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(34, 197, 94, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          },
          {
            label: 'Saídas',
            data: last6MonthsData.map(d => d.exits),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#ef4444',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#dc2626',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(239, 68, 68, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          },
          {
            label: 'Saldo',
            data: last6MonthsData.map(d => d.balance),
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#3b82f6',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#2563eb',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(59, 130, 246, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: 'index'
        },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 15,
              font: {
                size: 12,
                weight: 'bold'
              },
              color: '#374151'
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            titleFont: {
              size: 14,
              weight: 'bold'
            },
            bodyFont: {
              size: 13
            },
            borderColor: 'rgba(255, 255, 255, 0.1)',
            borderWidth: 1,
            cornerRadius: 12,
            displayColors: true,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          },
          y: {
            beginAtZero: true,
            max: function(context) {
              const values = context.chart.data.datasets.flatMap(d => d.data);
              const max = Math.max(...values);
              return max > 0 ? max * 1.1 : 1000;
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)',
              drawBorder: false
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              },
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }

  const consumptionTimeCtx = document.getElementById('consumptionTimeSeriesChart');
  if (consumptionTimeCtx && consumptionSeries.length > 0) {
    const hasAnyR = consumptionSeries.some(function (p) { return p.totalAmount > 0; });
    const hasAnyMulti = Array.isArray(consumptionSeriesPorConta) && consumptionSeriesPorConta.some(function (s) {
      return s.points && s.points.some(function (p) { return p.totalAmount > 0; });
    });
    const hasAny = hasAnyR || hasAnyMulti;
    if (hasAny) {
      const palette = [
        'rgb(79, 70, 229)', 'rgb(16, 185, 129)', 'rgb(245, 158, 11)', 'rgb(236, 72, 153)',
        'rgb(59, 130, 246)', 'rgb(139, 92, 246)', 'rgb(239, 68, 68)', 'rgb(20, 184, 166)',
        'rgb(234, 179, 8)', 'rgb(168, 85, 247)', 'rgb(14, 165, 233)', 'rgb(217, 119, 6)'
      ];
      var labels = consumptionSeries.map(function (d) { return d.label; });
      var datasets = [];
      if (consumptionSeriesPorConta && consumptionSeriesPorConta.length > 0) {
        consumptionSeriesPorConta.forEach(function (bill, idx) {
          var pts = bill.points || [];
          if (!labels.length && pts.length) labels = pts.map(function (p) { return p.label; });
          datasets.push({
            label: bill.billName || ('Conta ' + bill.billId),
            data: pts.map(function (p) { return p.totalAmount; }),
            borderColor: palette[idx % palette.length],
            backgroundColor: 'transparent',
            borderWidth: 2,
            tension: 0.35,
            fill: false,
            pointRadius: 3,
            pointHoverRadius: 5,
            yAxisID: 'y'
          });
        });
      } else {
        datasets.push({
          label: 'Valor da conta (R$)',
          data: consumptionSeries.map(function (d) { return d.totalAmount; }),
          borderColor: 'rgb(79, 70, 229)',
          backgroundColor: 'rgba(79, 70, 229, 0.12)',
          borderWidth: 2,
          tension: 0.35,
          fill: true,
          pointRadius: 4,
          pointHoverRadius: 6,
          yAxisID: 'y'
        });
      }
      var scales = {
        x: {
          grid: { display: false },
          ticks: { font: { size: 11 }, color: '#6b7280' }
        },
        y: {
          id: 'y',
          position: 'left',
          beginAtZero: true,
          grid: { color: 'rgba(0, 0, 0, 0.05)' },
          ticks: {
            callback: function (value) {
              return 'R$ ' + value.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
            }
          }
        }
      };
      if (consumptionSeriesPhysical && consumptionSeriesPhysical.length && consumptionUnitLabel) {
        datasets.push({
          label: 'Consumo (' + consumptionUnitLabel + ')',
          data: consumptionSeriesPhysical.map(function (d) { return d.totalConsumption; }),
          borderColor: 'rgb(100, 116, 139)',
          backgroundColor: 'rgba(100, 116, 139, 0.08)',
          borderWidth: 2,
          tension: 0.35,
          fill: false,
          pointRadius: 3,
          yAxisID: 'y1'
        });
        scales.y1 = {
          id: 'y1',
          position: 'right',
          beginAtZero: true,
          grid: { drawOnChartArea: false },
          ticks: {
            callback: function (value) {
              return value.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + ' ' + consumptionUnitLabel;
            }
          }
        };
      }
      new Chart(consumptionTimeCtx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: 'index' },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              maxHeight: consumptionSeriesPorConta && consumptionSeriesPorConta.length > 8 ? 120 : undefined
            },
            tooltip: {
              callbacks: {
                label: function (context) {
                  var v = context.parsed.y;
                  if (context.dataset.yAxisID === 'y1') {
                    return (context.dataset.label || 'Consumo') + ': ' + (v != null ? v.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '0');
                  }
                  return (context.dataset.label ? context.dataset.label + ': ' : '') + 'R$ ' + (v != null ? v.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '0');
                }
              }
            }
          },
          scales: scales
        }
      });
    } else {
      consumptionTimeCtx.parentElement.innerHTML = '<p class="text-gray-500 text-center py-8">Nenhum valor de consumo registrado neste período (filtros acima).</p>';
    }
  }
</script>

<%- include('../../partials/footer') %>
