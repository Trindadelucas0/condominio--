<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
  /* Animações personalizadas */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }

  @keyframes glow {
    0%, 100% {
      box-shadow: 0 0 5px rgba(59, 130, 246, 0.5);
    }
    50% {
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.8), 0 0 30px rgba(59, 130, 246, 0.6);
    }
  }

  /* Efeito glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
  }

  /* Card moderno com gradiente */
  .card-modern {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    overflow: hidden;
  }

  .card-modern::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    animation: pulse 3s ease-in-out infinite;
  }

  /* Card com efeito de brilho */
  .card-glow {
    position: relative;
    transition: all 0.3s ease;
  }

  .card-glow:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1), 0 0 30px rgba(59, 130, 246, 0.3);
  }

  /* Efeito de shimmer no hover */
  .shimmer-effect {
    position: relative;
    overflow: hidden;
  }

  .shimmer-effect::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s;
  }

  .shimmer-effect:hover::after {
    left: 100%;
  }

  /* Animação de entrada */
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }

  .animate-slide-in-right {
    animation: slideInRight 0.6s ease-out;
  }

  /* Delay para animações escalonadas */
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }
  .delay-400 { animation-delay: 0.4s; }

  /* Gradiente animado de fundo */
  .gradient-bg {
    background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Efeito de partículas de fundo */
  .particles-bg {
    position: relative;
  }

  .particles-bg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Botão moderno com efeito */
  .btn-modern {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .btn-modern::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .btn-modern:hover::before {
    width: 300px;
    height: 300px;
  }

  /* Ícone com rotação no hover */
  .icon-rotate:hover {
    animation: rotate 0.5s ease;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Efeito de neomorfismo suave */
  .neo-card {
    background: #f0f0f3;
    box-shadow: 
      10px 10px 20px #d0d0d3,
      -10px -10px 20px #ffffff;
    transition: all 0.3s ease;
  }

  .neo-card:hover {
    box-shadow: 
      5px 5px 10px #d0d0d3,
      -5px -5px 10px #ffffff;
  }

  /* Gráfico com fundo moderno */
  .chart-modern {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  /* Tabela moderna */
  .table-modern {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
  }

  .table-modern thead {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .table-modern tbody tr {
    transition: all 0.2s ease;
  }

  .table-modern tbody tr:hover {
    background: rgba(102, 126, 234, 0.1);
    transform: scale(1.01);
  }

  /* Scroll suave */
  html {
    scroll-behavior: smooth;
  }

  /* Efeito de brilho nos números grandes */
  .number-glow {
    text-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
  }

  /* Animação de contador (se necessário) */
  @keyframes countUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .count-animate {
    animation: countUp 0.6s ease-out;
  }

  /* Efeito de hover nos cards com elevação */
  .card-elevate {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-elevate:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 0 30px rgba(59, 130, 246, 0.2);
  }

  /* Gradiente de texto animado */
  .text-gradient-animated {
    background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #4facfe);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
  }

  /* Efeito de partículas flutuantes */
  .floating {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  /* Efeito de loading skeleton */
  .skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  /* Melhorias de acessibilidade */
  .focus-visible:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* Efeito de vidro mais pronunciado */
  .glass-strong {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
  }
</style>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Limpo -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">
            Dashboard Financeiro
          </h1>
          <p class="text-gray-600">Visão geral e análise financeira do condomínio</p>
        </div>
        <div class="hidden md:flex items-center space-x-2 bg-green-50 px-4 py-2 rounded-lg">
          <div class="w-2 h-2 bg-green-500 rounded-full"></div>
          <span class="text-sm text-gray-700 font-medium">Sistema Online</span>
        </div>
      </div>
    </div>

    <!-- Cards de KPIs principais - Design Moderno -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Saldo Atual - Card Melhorado para Legibilidade -->
      <% 
        const balance = stats.balance !== undefined ? stats.balance : (stats.saldo !== undefined ? stats.saldo : 0);
        const balanceValue = typeof balance === 'number' ? balance : 0;
        const isPositive = balanceValue >= 0;
        const formattedBalance = balanceValue.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
      %>
      <div class="bg-white rounded-xl p-8 shadow-lg border-l-4 <%= isPositive ? 'border-green-500' : 'border-red-500' %> hover:shadow-xl transition-all duration-300 animate-fade-in-up">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Saldo Atual</p>
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 <%= isPositive ? 'bg-green-500' : 'bg-red-500' %> rounded-full"></div>
                <span class="text-xs font-semibold <%= isPositive ? 'text-green-600' : 'text-red-600' %> uppercase tracking-wide">
                  <%= isPositive ? 'Positivo' : 'Negativo' %>
                </span>
              </div>
            </div>
            <div class="<%= isPositive ? 'bg-green-100' : 'bg-red-100' %> rounded-lg p-3">
              <svg class="w-8 h-8 <%= isPositive ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4">
            <p class="text-4xl font-bold <%= isPositive ? 'text-green-600' : 'text-red-600' %> leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= formattedBalance %>
            </p>
          </div>
        </div>
      </div>

      <!-- Entradas do Mês - Card Melhorado -->
      <div class="bg-white rounded-xl p-8 shadow-lg border-l-4 border-green-500 hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-100">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Entradas</p>
              <p class="text-xs text-gray-400">Mês Atual</p>
            </div>
            <div class="bg-green-100 rounded-lg p-3">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4 mb-3">
            <p class="text-4xl font-bold text-green-600 leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= typeof kpis !== 'undefined' && kpis.currentMonth ? kpis.currentMonth.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
            </p>
          </div>
          <% if (typeof kpis !== 'undefined' && kpis.variations && kpis.variations.entries !== 0) { %>
            <div class="flex items-center space-x-2 pt-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold <%= kpis.variations.entries >= 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <span class="mr-1"><%= kpis.variations.entries >= 0 ? '↑' : '↓' %></span>
                <%= Math.abs(kpis.variations.entries).toFixed(1) %>%
              </span>
              <span class="text-xs text-gray-500">vs mês anterior</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Saídas do Mês - Card Melhorado -->
      <div class="bg-white rounded-xl p-8 shadow-lg border-l-4 border-red-500 hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-200">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Saídas</p>
              <p class="text-xs text-gray-400">Mês Atual</p>
            </div>
            <div class="bg-red-100 rounded-lg p-3">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4 mb-3">
            <p class="text-4xl font-bold text-red-600 leading-tight">
              <span class="text-2xl font-semibold text-gray-500 mr-1">R$</span>
              <%= typeof kpis !== 'undefined' && kpis.currentMonth ? kpis.currentMonth.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
            </p>
          </div>
          <% if (typeof kpis !== 'undefined' && kpis.variations && kpis.variations.exits !== 0) { %>
            <div class="flex items-center space-x-2 pt-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold <%= kpis.variations.exits >= 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
                <span class="mr-1"><%= kpis.variations.exits >= 0 ? '↑' : '↓' %></span>
                <%= Math.abs(kpis.variations.exits).toFixed(1) %>%
              </span>
              <span class="text-xs text-gray-500">vs mês anterior</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Média Mensal - Card Melhorado -->
      <div class="bg-white rounded-xl p-8 shadow-lg border-l-4 border-blue-500 hover:shadow-xl transition-all duration-300 animate-fade-in-up delay-300">
        <div class="flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-gray-500 text-sm font-medium mb-1">Média Mensal</p>
              <p class="text-xs text-gray-400">Últimos 6 meses</p>
            </div>
            <div class="bg-blue-100 rounded-lg p-3">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
          <div class="border-t border-gray-100 pt-4 space-y-4">
            <div>
              <p class="text-xs text-gray-500 mb-1 font-medium">Entradas</p>
              <p class="text-2xl font-bold text-blue-600 leading-tight">
                <span class="text-lg font-semibold text-gray-500 mr-1">R$</span>
                <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.entries.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
              </p>
            </div>
            <div>
              <p class="text-xs text-gray-500 mb-1 font-medium">Saídas</p>
              <p class="text-2xl font-bold text-red-600 leading-tight">
                <span class="text-lg font-semibold text-gray-500 mr-1">R$</span>
                <%= typeof kpis !== 'undefined' && kpis.averages ? kpis.averages.exits.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0,00' %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Segunda linha - Cards de Status Modernos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
      <!-- Entradas Pendentes de Análise -->
      <a href="/sindico/entradas-pendentes" class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-blue-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-100 block">
        <div class="flex items-center justify-between">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Entradas Pendentes</p>
            <p class="text-3xl font-bold text-blue-600 mb-1">
              <%= typeof stats !== 'undefined' && stats.pendingEntries !== undefined ? stats.pendingEntries : 0 %>
            </p>
            <p class="text-xs text-gray-500 flex items-center mt-2">
              <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-2"></span>
              Aguardando aprovação
            </p>
          </div>
          <div class="bg-blue-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Entradas Rejeitadas -->
      <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
      <a href="/financeiro/entradas-rejeitadas" class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-red-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-200 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Entradas Rejeitadas</p>
            <p class="text-3xl font-bold text-red-600 mb-1">
              <%= stats.rejectedEntries %>
            </p>
          </div>
          <div class="bg-red-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-red-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Corrigir</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Aguardando Análise -->
      <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
      <a href="/financeiro/orcamentos-pendentes" class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-yellow-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-300 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Aguardando</p>
            <p class="text-3xl font-bold text-yellow-600 mb-1">
              <%= stats.pendingBudgetFinanceiro %>
            </p>
          </div>
          <div class="bg-yellow-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-yellow-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Analisar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Aprovados -->
      <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
      <a href="/financeiro/orcamentos-aprovados" class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-green-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-400 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Aprovados</p>
            <p class="text-3xl font-bold text-green-600 mb-1">
              <%= stats.approvedBudgets %>
            </p>
          </div>
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-green-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Liberar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>

      <!-- Orçamentos Rejeitados -->
      <% if (typeof stats !== 'undefined' && stats.rejectedBudgets !== undefined && stats.rejectedBudgets > 0) { %>
      <a href="/administrativo/orcamentos?status=REJECTED" class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-orange-500 hover:shadow-xl transition-all duration-300 animate-slide-in-right delay-400 block">
        <div class="flex items-center justify-between mb-3">
          <div class="flex-1">
            <p class="text-gray-500 text-sm font-medium mb-2">Orçamentos Rejeitados</p>
            <p class="text-3xl font-bold text-orange-600 mb-1">
              <%= stats.rejectedBudgets %>
            </p>
          </div>
          <div class="bg-orange-100 rounded-lg p-3">
            <svg class="w-7 h-7 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex items-center text-orange-600 text-sm font-semibold pt-2 border-t border-gray-100">
          <span>Ajustar</span>
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <% } %>
    </div>

    <!-- Gráficos Limpos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <!-- Gráfico de Evolução (Últimos 6 meses) -->
      <div class="bg-white rounded-xl p-6 shadow-lg animate-fade-in-up delay-200">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">
            Evolução Financeira
          </h2>
          <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full font-medium">6 meses</span>
        </div>
        <div class="chart-container" style="position: relative; height: 300px;">
          <canvas id="evolutionChart"></canvas>
        </div>
      </div>

      <!-- Gráfico de Consumo de Contas -->
      <div class="bg-white rounded-xl p-6 shadow-lg animate-fade-in-up delay-300">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900">
            Consumo de Contas
          </h2>
          <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full font-medium">Média</span>
        </div>
        <div class="chart-container" style="position: relative; height: 300px;">
          <canvas id="consumptionChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Tabela de Consumo Mensal Limpa -->
    <div class="bg-white rounded-xl p-6 shadow-lg mb-8 animate-fade-in-up delay-400">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">
          Consumo Mensal de Contas
        </h2>
        <a href="/financeiro/consumo/novo" class="bg-blue-600 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-blue-700 transition-colors duration-200 flex items-center text-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Registrar Consumo
        </a>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Conta</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Mês/Ano</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Consumo</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Valor</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if (typeof kpis !== 'undefined' && kpis.consumption && kpis.consumption.length > 0) { %>
              <% kpis.consumption.forEach((cons, index) => { %>
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="font-medium text-gray-900"><%= cons.billName %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600">
                    <%= cons.month %>/<%= cons.year %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600">
                    <%= cons.consumptionValue ? cons.consumptionValue.toLocaleString('pt-BR', {minimumFractionDigits: 2}) + ' ' + cons.consumptionUnit : '-' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="font-semibold text-gray-900">
                      R$ <%= cons.billAmount.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Registrado
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center">
                  <div class="flex flex-col items-center">
                    <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <p class="text-gray-500 mb-2">Nenhum consumo registrado ainda.</p>
                    <a href="/financeiro/consumo/novo" class="text-blue-600 hover:text-blue-700 font-medium transition-colors duration-200 flex items-center text-sm">
                      <span>Registre o primeiro consumo</span>
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Ações Rápidas - Botões Limpos -->
    <div class="bg-white rounded-xl p-6 shadow-lg animate-fade-in-up delay-500">
      <h2 class="text-xl font-bold text-gray-900 mb-6">
        Ações Rápidas
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/financeiro/entradas/nova" class="bg-green-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Nova Entrada
        </a>
        
        <a href="/financeiro/saidas/nova" class="bg-red-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-red-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
          </svg>
          Nova Saída
        </a>
        
        <a href="/financeiro/contas/nova" class="bg-blue-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Nova Conta
        </a>
        
        <a href="/financeiro/consumo/novo" class="bg-purple-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          Registrar Consumo
        </a>
        
        <% if (typeof stats !== 'undefined' && stats.rejectedEntries !== undefined && stats.rejectedEntries > 0) { %>
        <a href="/financeiro/entradas-rejeitadas" class="bg-orange-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-orange-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Corrigir Entradas (<%= stats.rejectedEntries %>)
        </a>
        <% } %>
        
        <% if (typeof stats !== 'undefined' && stats.pendingBudgetFinanceiro !== undefined && stats.pendingBudgetFinanceiro > 0) { %>
        <a href="/financeiro/orcamentos-pendentes" class="bg-yellow-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-yellow-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
          Analisar Orçamentos (<%= stats.pendingBudgetFinanceiro %>)
        </a>
        <% } %>
        
        <% if (typeof stats !== 'undefined' && stats.approvedBudgets !== undefined && stats.approvedBudgets > 0) { %>
        <a href="/financeiro/orcamentos-aprovados" class="bg-green-600 text-white px-5 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors duration-200 text-center flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Liberar Orçamentos (<%= stats.approvedBudgets %>)
        </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // Dados para gráficos
  const last6MonthsData = <%- JSON.stringify(typeof kpis !== 'undefined' && kpis.last6Months ? kpis.last6Months : []) %>;
  const consumptionData = <%- JSON.stringify(typeof kpis !== 'undefined' && kpis.avgConsumption ? kpis.avgConsumption : []) %>;

  // Gráfico de Evolução - Design Moderno
  const evolutionCtx = document.getElementById('evolutionChart');
  if (evolutionCtx && last6MonthsData.length > 0) {
    new Chart(evolutionCtx, {
      type: 'line',
      data: {
        labels: last6MonthsData.map(d => {
          const [year, month] = d.period.split('-');
          const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
          return `${monthNames[parseInt(month) - 1]}/${year}`;
        }),
        datasets: [
          {
            label: 'Entradas',
            data: last6MonthsData.map(d => d.entries),
            borderColor: 'rgb(34, 197, 94)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#22c55e',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#16a34a',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(34, 197, 94, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          },
          {
            label: 'Saídas',
            data: last6MonthsData.map(d => d.exits),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#ef4444',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#dc2626',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(239, 68, 68, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          },
          {
            label: 'Saldo',
            data: last6MonthsData.map(d => d.balance),
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            borderWidth: 3,
            tension: 0.5,
            fill: true,
            pointRadius: 6,
            pointHoverRadius: 8,
            pointBackgroundColor: '#3b82f6',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#2563eb',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            shadowColor: 'rgba(59, 130, 246, 0.3)',
            shadowBlur: 10,
            shadowOffsetY: 5
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: 'index'
        },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 15,
              font: {
                size: 12,
                weight: 'bold'
              },
              color: '#374151'
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 15,
            titleFont: {
              size: 14,
              weight: 'bold'
            },
            bodyFont: {
              size: 13
            },
            borderColor: 'rgba(255, 255, 255, 0.1)',
            borderWidth: 1,
            cornerRadius: 12,
            displayColors: true,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          },
          y: {
            beginAtZero: true,
            max: function(context) {
              const values = context.chart.data.datasets.flatMap(d => d.data);
              const max = Math.max(...values);
              return max > 0 ? max * 1.1 : 1000;
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)',
              drawBorder: false
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              },
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }

  // Gráfico de Consumo - Design Moderno com Gradientes
  const consumptionCtx = document.getElementById('consumptionChart');
  if (consumptionCtx && consumptionData.length > 0) {
    const gradients = [
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400),
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400),
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400),
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400),
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400),
      consumptionCtx.getContext('2d').createLinearGradient(0, 0, 0, 400)
    ];

    const colors = [
      { start: '#22c55e', end: '#16a34a' },
      { start: '#3b82f6', end: '#2563eb' },
      { start: '#8b5cf6', end: '#7c3aed' },
      { start: '#f59e0b', end: '#d97706' },
      { start: '#ef4444', end: '#dc2626' },
      { start: '#06b6d4', end: '#0891b2' }
    ];

    colors.forEach((color, index) => {
      gradients[index].addColorStop(0, color.start);
      gradients[index].addColorStop(1, color.end);
    });

    new Chart(consumptionCtx, {
      type: 'bar',
      data: {
        labels: consumptionData.map(d => {
          const types = {
            'AGUA': 'Água',
            'LUZ': 'Energia',
            'GAS': 'Gás',
            'TELEFONE': 'Telefone',
            'INTERNET': 'Internet',
            'OUTRA': 'Outra'
          };
          return types[d.billType] || d.billType;
        }),
        datasets: [
          {
            label: 'Média de Valor (R$)',
            data: consumptionData.map(d => d.avgAmount),
            backgroundColor: consumptionData.map((d, i) => gradients[i % gradients.length]),
            borderColor: '#ffffff',
            borderWidth: 3,
            borderRadius: 12,
            borderSkipped: false,
            maxBarThickness: 60
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: 'index'
        },
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.85)',
            padding: 15,
            titleFont: {
              size: 14,
              weight: 'bold'
            },
            bodyFont: {
              size: 13
            },
            borderColor: 'rgba(255, 255, 255, 0.1)',
            borderWidth: 1,
            cornerRadius: 12,
            callbacks: {
              label: function(context) {
                return 'Média: R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          },
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(0, 0, 0, 0.05)',
              drawBorder: false
            },
            max: function(context) {
              const values = context.chart.data.datasets.flatMap(d => d.data);
              const max = Math.max(...values);
              return max > 0 ? max * 1.1 : 1000;
            },
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
              },
              font: {
                size: 11,
                weight: 'bold'
              },
              color: '#6b7280'
            }
          }
        },
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        }
      }
    });
  }

  // Gráfico de Comparação de Consumo (Água e Energia)
  const consumptionComparisonCtx = document.getElementById('consumptionComparisonChart');
  if (consumptionComparisonCtx) {
    // Buscar dados de consumo para comparação
    fetch('/financeiro/api/consumption-comparison')
      .then(res => res.json())
      .then(data => {
        if (data && data.length > 0) {
          // Agrupa por período (mês/ano)
          const periodsMap = new Map();
          data.forEach(d => {
            const key = `${d.year}-${String(d.month).padStart(2, '0')}`;
            if (!periodsMap.has(key)) {
              periodsMap.set(key, { month: d.month, year: d.year, agua: null, energia: null });
            }
            const period = periodsMap.get(key);
            if (d.billType === 'AGUA') {
              period.agua = d.billAmount;
            } else if (d.billType === 'LUZ') {
              period.energia = d.billAmount;
            }
          });

          // Ordena por período
          const sortedPeriods = Array.from(periodsMap.values()).sort((a, b) => {
            if (a.year !== b.year) return b.year - a.year;
            return b.month - a.month;
          });

          const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
          const labels = sortedPeriods.map(p => `${monthNames[p.month - 1]}/${p.year}`);
          const aguaData = sortedPeriods.map(p => p.agua || 0);
          const energiaData = sortedPeriods.map(p => p.energia || 0);

          new Chart(consumptionComparisonCtx, {
            type: 'line',
            data: {
              labels: labels,
              datasets: [
                {
                  label: 'Água (R$)',
                  data: aguaData,
                  borderColor: 'rgb(59, 130, 246)',
                  backgroundColor: 'rgba(59, 130, 246, 0.1)',
                  tension: 0.4,
                  fill: true
                },
                {
                  label: 'Energia (R$)',
                  data: energiaData,
                  borderColor: 'rgb(251, 191, 36)',
                  backgroundColor: 'rgba(251, 191, 36, 0.1)',
                  tension: 0.4,
                  fill: true
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              aspectRatio: 2.5,
              plugins: {
                legend: {
                  position: 'top',
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  max: function(context) {
                    const values = context.chart.data.datasets.flatMap(d => d.data);
                    const max = Math.max(...values);
                    return max > 0 ? max * 1.1 : 1000;
                  },
                  ticks: {
                    callback: function(value) {
                      return 'R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                    }
                  }
                }
              }
            }
          });
        } else {
          consumptionComparisonCtx.parentElement.innerHTML = '<p class="text-gray-500 text-center py-8">Nenhum dado de consumo disponível para comparação</p>';
        }
      })
      .catch(err => {
        console.error('Erro ao carregar dados de comparação:', err);
        consumptionComparisonCtx.parentElement.innerHTML = '<p class="text-gray-500">Erro ao carregar dados de comparação</p>';
      });
  }

  // Carregar projeções
  fetch('/financeiro/api/projections')
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('projectionsContainer');
      if (data && data.months && data.months.length > 0) {
        let html = '<div class="grid grid-cols-1 md:grid-cols-3 gap-4">';
        data.months.forEach(month => {
          html += `
            <div class="border border-gray-200 rounded-lg p-4">
              <h3 class="font-bold text-lg text-gray-800 mb-3">${month.label}</h3>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <span class="text-sm text-gray-600">Entradas Previstas:</span>
                  <span class="font-semibold text-green-600">R$ ${month.projectedEntries.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-sm text-gray-600">Saídas Previstas:</span>
                  <span class="font-semibold text-red-600">R$ ${month.projectedExits.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</span>
                </div>
                <div class="flex justify-between border-t pt-2">
                  <span class="text-sm font-medium text-gray-800">Saldo Projetado:</span>
                  <span class="font-bold ${month.projectedBalance >= 0 ? 'text-green-600' : 'text-red-600'}">
                    R$ ${month.projectedBalance.toLocaleString('pt-BR', {minimumFractionDigits: 2})}
                  </span>
                </div>
              </div>
            </div>
          `;
        });
        html += '</div>';
        container.innerHTML = html;
      } else {
        container.innerHTML = '<p class="text-gray-500">Nenhuma projeção disponível. Configure entradas e saídas recorrentes para ver projeções.</p>';
      }
    })
    .catch(err => {
      console.error('Erro ao carregar projeções:', err);
      document.getElementById('projectionsContainer').innerHTML = '<p class="text-red-500">Erro ao carregar projeções</p>';
    });
</script>

