<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Como funcionam os Boletos a pagar'; %>
    <% var resumo = ['Aqui aparecem todos os boletos e compromissos a vencer: vindos de Contas (fornecedores) ou lançamentos avulsos.', 'Cadastre um boleto em "Nova Conta a Pagar" ou adicione boletos em cada Conta (fornecedor).', 'Quando pagar, use "Pagar": informe a data e anexe o comprovante; a despesa é gerada em Despesas.', 'Status: Vencida, Vence hoje, A vencer ou Pago.']; %>
    <% var helpModalContent = '<p><strong>O que é Boletos a pagar?</strong> É a lista unificada de tudo que o condomínio precisa pagar: boletos de fornecedores cadastrados em Contas e itens avulsos.</p><p><strong>De onde vêm os itens?</strong> (1) Contas: em cada fornecedor você adiciona boletos; eles aparecem aqui. (2) Avulso: use "Nova Conta a Pagar" para um boleto avulso.</p><p><strong>Pagar:</strong> ao clicar em "Pagar", informe a data e anexe o comprovante. O sistema gera uma despesa em Despesas e marca o boleto como Pago.</p><p><strong>Status:</strong> Vencida, Vence hoje, A vencer ou Pago.</p>'; %>
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Boletos a pagar</h1>
          <p class="text-gray-600 mt-1">Lista de boletos e compromissos a vencer; pague e anexe o comprovante</p>
        </div>
        <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
      <a href="/financeiro/contas-a-pagar/novo" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nova Conta a Pagar
      </a>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <% if (query.success === 'created') { %>
      <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-lg">
        <p class="font-semibold">Boleto cadastrado!</p>
        <p class="text-sm mt-1">Ele aparece na lista abaixo. Quando for pagar, clique em <strong>Pagar</strong>, informe a data e anexe o comprovante; a despesa será registrada em Despesas.</p>
      </div>
    <% } %>
    <% if (query.success === 'paid') { %>
      <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-800 rounded-lg">
        <p class="font-semibold">Pagamento registrado!</p>
        <p class="text-sm mt-1">A despesa foi gerada em Despesas. Pode seguir para o próximo boleto.</p>
      </div>
    <% } %>
    <% if (query.error === 'already_paid') { %>
      <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg">Este item já foi pago.</div>
    <% } %>
    <% if (query.error && query.error !== 'already_paid') { %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg"><%= query.error %></div>
    <% } %>

    <div id="modalCreatedAsCopy" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" aria-modal="true" role="dialog" aria-labelledby="modalCreatedAsCopyTitle">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6" onclick="event.stopPropagation()">
        <h2 id="modalCreatedAsCopyTitle" class="text-xl font-bold text-gray-900 mb-2">Item salvo como outro vencimento</h2>
        <p class="text-gray-700 mb-4">
          Já existia um vencimento para esta conta nesta data. O item foi salvo como <strong id="modalCreatedAsCopyLabel">2º vencimento</strong> e identificado na descrição. Você pode localizá-lo na lista abaixo.
        </p>
        <button type="button" id="modalCreatedAsCopyBtn" class="w-full px-4 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">Entendi</button>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">
      <% if (!items || items.length === 0) { %>
        <%- include('../../../partials/empty-state', {
          title: 'Nenhum boleto a pagar',
          description: 'Os boletos aparecem aqui quando você cadastra em Contas (fornecedores fixos) ou lança um item avulso. O primeiro passo é cadastrar um fornecedor em Contas e adicionar o boleto, ou registrar um item avulso.',
          buttonText: 'Adicionar boleto ou conta a pagar',
          buttonHref: '/financeiro/contas-a-pagar/novo',
          icon: 'currency'
        }) %>
      <% } else {
              const statusConfig = {
                PAID: { label: 'Pago', class: 'bg-green-100 text-green-800' },
                OVERDUE: { label: 'Vencida', class: 'bg-red-100 text-red-800' },
                DUE_TODAY: { label: 'Vence hoje', class: 'bg-amber-100 text-amber-800' },
                UPCOMING: { label: 'A vencer', class: 'bg-blue-100 text-blue-800' }
              };
      %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Descrição / Conta</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Vencimento</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Valor</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase">Ação</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
              <% items.forEach(function(it) {
                const sc = statusConfig[it.displayStatus] || statusConfig.UPCOMING;
                const dueStr = it.due_date ? new Date(it.due_date).toLocaleDateString('pt-BR') : '-';
            %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4">
                  <div class="font-medium text-gray-900"><%= it.description || it.bill_name || 'Conta a pagar' %></div>
                  <% if (it.bill_name && it.description) { %><div class="text-xs text-gray-500"><%= it.bill_name %></div><% } %>
                </td>
                <td class="px-6 py-4 text-gray-600"><%= dueStr %></td>
                <td class="px-6 py-4 font-semibold text-gray-900">R$ <%= parseFloat(it.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 rounded-full text-xs font-medium <%= sc.class %>"><%= sc.label %></span>
                </td>
                <td class="px-6 py-4">
                  <% if (it.status === 'PAID') { %>
                    <span class="text-sm text-gray-500">Pago</span>
                  <% } else { %>
                    <a href="/financeiro/contas-a-pagar/<%= it.id %>/pagar" class="text-blue-600 hover:underline font-medium">Pagar</a>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script>
(function() {
  var q = <%= JSON.stringify(query || {}) %>;
  if (q.success === 'created_as_copy' && q.copyLabel) {
    var modal = document.getElementById('modalCreatedAsCopy');
    var labelEl = document.getElementById('modalCreatedAsCopyLabel');
    var btn = document.getElementById('modalCreatedAsCopyBtn');
    if (labelEl) labelEl.textContent = q.copyLabel;
    if (modal) modal.classList.remove('hidden');
    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }
    if (btn) btn.addEventListener('click', closeModal);
    modal && modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  }
})();
</script>

<%- include('../../../partials/footer') %>
