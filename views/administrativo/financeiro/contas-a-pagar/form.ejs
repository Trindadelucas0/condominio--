<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8 max-w-2xl">
    <%- include('../../../partials/breadcrumb', { items: [ { label: 'Início', url: '/financeiro/dashboard' }, { label: 'Boletos a pagar', url: '/financeiro/contas-a-pagar' }, { label: 'Novo boleto', url: '' } ] }) %>
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Nova conta a pagar – como preencher'; %>
    <% var resumo = ['Escolha a conta (fornecedor) se for boleto de uma conta cadastrada, ou deixe avulso.', 'Informe vencimento e valor. Ao salvar o item aparece em Boletos a pagar.', 'Quando pagar, use Pagar na lista e anexe o comprovante se quiser; a despesa é gerada em Despesas.']; %>
    <% var helpModalContent = '<p>Conta opcional: vincule a um fornecedor em Contas ou deixe avulso. Preencha vencimento e valor. O item aparece em Boletos a pagar. Ao pagar, use a tela Boletos a pagar e clique em Pagar para registrar e anexar comprovante se desejar.</p>'; %>
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div>
        <a href="/financeiro/contas-a-pagar" class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors mb-2 w-fit">
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Voltar para Boletos a pagar
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Nova Conta a Pagar</h1>
        <p class="text-gray-600 mt-1">Registre um vencimento (conta variável ou avulsa)</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg"><%= error %></div>
    <% } %>

    <div class="bg-white rounded-xl shadow p-6">
      <form method="POST" action="/financeiro/contas-a-pagar" class="space-y-4">
        <div>
          <label for="billId" class="block text-sm font-medium text-gray-700 mb-1">Conta (opcional)</label>
          <select id="billId" name="billId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">Nenhuma (avulso)</option>
            <% (bills || []).forEach(function(b) { %>
              <option value="<%= b.id %>" <%= (item && item.billId == b.id) ? 'selected' : '' %>><%= b.name %> (<%= b.bill_type %>)</option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-1">Data de vencimento <span class="text-red-500">*</span></label>
          <input type="date" id="dueDate" name="dueDate" required value="<%= item && item.dueDate ? item.dueDate : '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">Valor (R$) <span class="text-red-500">*</span></label>
          <input type="number" id="amount" name="amount" required step="0.01" min="0.01" value="<%= item && item.amount ? item.amount : '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="0,00" />
        </div>
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Descrição (opcional)</label>
          <input type="text" id="description" name="description" value="<%= item && item.description ? item.description : '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Ex: Conta de luz março" />
        </div>
        <div>
          <label for="costCenterId" class="block text-sm font-medium text-gray-700 mb-1">Centro de custo (opcional) <%- include('../../../partials/field-help', { text: 'Tipo da despesa para relatórios (ex.: Água, Limpeza). Opcional.' }) %></label>
          <select id="costCenterId" name="costCenterId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">Nenhum</option>
            <% (costCenters || []).forEach(function(cc) { %>
              <option value="<%= cc.id %>" <%= (item && item.costCenterId == cc.id) ? 'selected' : '' %>><%= cc.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="flex gap-3 pt-4">
          <a href="/financeiro/contas-a-pagar" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancelar</a>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Salvar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
