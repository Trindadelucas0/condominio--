<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-8 max-w-2xl">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Pagar conta'; %>
    <% var resumo = ['Informe método de pagamento e, se tiver, anexe o comprovante em PDF.', 'Ao confirmar, uma despesa é criada e o boleto fica Pago.', 'O valor sai do saldo do condomínio.']; %>
    <% var helpModalContent = '<p>Preencha o método de pagamento e, se desejar, anexe o comprovante. Ao salvar, uma despesa é gerada em Despesas e o item fica como Pago; o valor é debitado do saldo.</p>'; %>
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Pagar Conta</h1>
        <p class="text-gray-600 mt-1">Registre o pagamento. O comprovante em PDF é opcional. Será criada uma saída financeira.</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg"><%= error %></div>
    <% } %>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
      <h2 class="text-lg font-bold text-gray-800 mb-4">Item</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-gray-500">Descrição</p>
          <p class="font-semibold text-gray-900"><%= item.description || item.bill_name || 'Conta a pagar' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Vencimento</p>
          <p class="font-semibold text-gray-900"><%= item.due_date ? new Date(item.due_date).toLocaleDateString('pt-BR') : '-' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Valor</p>
          <p class="font-bold text-red-600 text-lg">R$ <%= parseFloat(item.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow p-6">
      <h2 class="text-lg font-bold text-gray-800 mb-4">Detalhes do pagamento</h2>
      <form method="POST" action="/financeiro/contas-a-pagar/<%= item.id %>/pagar" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label for="paymentMethod" class="block text-sm font-medium text-gray-700 mb-1">Método de pagamento <span class="text-red-500">*</span></label>
          <select id="paymentMethod" name="paymentMethod" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">Selecione...</option>
            <option value="PIX">PIX</option>
            <option value="TRANSFERENCIA">Transferência</option>
            <option value="BOLETO">Boleto</option>
            <option value="DINHEIRO">Dinheiro</option>
            <option value="CHEQUE">Cheque</option>
            <option value="CARTAO">Cartão</option>
            <option value="OUTRA">Outra</option>
          </select>
        </div>
        <div>
          <label for="paymentReceiptPdf" class="block text-sm font-medium text-gray-700 mb-1">Comprovante PDF (Opcional)</label>
          <input type="file" id="paymentReceiptPdf" name="paymentReceiptPdf" accept="application/pdf" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
          <p class="text-xs text-gray-500 mt-1">Máximo 10MB</p>
        </div>
        <div>
          <label for="paymentDetails" class="block text-sm font-medium text-gray-700 mb-1">Detalhes <span class="text-red-500">*</span></label>
          <textarea id="paymentDetails" name="paymentDetails" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Ex: Pago via PIX em ..."><%= typeof formData !== 'undefined' && formData.paymentDetails ? formData.paymentDetails : '' %></textarea>
        </div>
        <div>
          <label for="paymentNotes" class="block text-sm font-medium text-gray-700 mb-1">Observações</label>
          <textarea id="paymentNotes" name="paymentNotes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"><%= typeof formData !== 'undefined' && formData.paymentNotes ? formData.paymentNotes : '' %></textarea>
        </div>
        <div class="flex gap-3 pt-4">
          <a href="/financeiro/contas-a-pagar" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancelar</a>
          <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium">Confirmar pagamento</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
