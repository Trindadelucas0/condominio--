<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Aprovações Financeiras'; %>
  <% var resumo = ['Aprove despesas até o limite; acima o síndico aprova.', 'Use Aprovar ou Rejeitar. Aprovada segue para pagamento em Despesas.', 'Rejeitada volta para quem criou.']; %>
  <% var helpModalContent = '<p>Aprovações Financeiras: despesas que precisam do OK do financeiro até certo valor. Aprove ou rejeite; aprovada pode ser paga em Despesas.</p>'; %>
  <!-- Cabeçalho -->
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Aprovações Financeiras</h1>
      <p class="text-gray-600 mt-2">Aprove saídas financeiras até o limite configurado (padrão: R$ 1.000,00)</p>
      <p class="text-sm text-gray-500 mt-1">Saídas acima do limite devem ser aprovadas pelo síndico</p>
    </div>
    <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'approved') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Saída aprovada com sucesso!
    </div>
  <% } %>

  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= query.error %>
    </div>
  <% } %>

  <!-- Lista de saídas pendentes -->
  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <% if (exits.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma saída pendente de aprovação no seu limite.</p>
        <p class="text-sm mt-2">Saídas acima do limite devem ser aprovadas pelo síndico.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Limite</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criado por</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% exits.forEach(exit => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= exit.description %></div>
                <% if (exit.category) { %>
                  <div class="text-sm text-gray-500"><%= exit.category %></div>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-gray-900">
                  R$ <%= parseFloat(exit.amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(exit.exit_date).toLocaleDateString('pt-BR') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                R$ <%= parseFloat(exit.approval_limit || 1000.00).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= exit.created_by_name || 'N/A' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <form method="POST" action="/administrativo/aprovacoes-financeiras/<%= exit.id %>/processar" class="inline">
                  <input type="hidden" name="action" value="APPROVE">
                  <button
                    type="submit"
                    class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition"
                    onclick="return confirm('Deseja aprovar esta saída financeira?')"
                  >
                    Aprovar
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../../partials/footer') %>
