<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus {
    transition: all 0.2s ease;
  }
  
  .input-focus:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .quote-card {
    border: 2px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .quote-card:hover {
    border-color: #6366f1;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Cabeçalho Moderno -->
      <div class="mb-8 animate-slide-in">
        <div class="flex items-center space-x-3 mb-2">
          <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
              Nova Solicitação de Orçamento
            </h1>
            <p class="text-gray-600 mt-1">Solicite orçamentos de múltiplos fornecedores para comparação</p>
          </div>
        </div>
      </div>

      <!-- Mensagem de Erro -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 animate-slide-in">
          <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
            <div class="bg-red-500 rounded-full p-2">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-red-800">Erro</p>
              <p class="text-sm text-red-600"><%= error %></p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Formulário Moderno -->
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="/administrativo/orcamentos" enctype="multipart/form-data" id="budgetForm">
          <div class="space-y-6">
            <!-- Título -->
            <div>
              <label for="title" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Título da Solicitação <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                required
                value="<%= request ? request.title : '' %>"
                placeholder="Ex: Reparo do elevador social"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Descrição -->
            <div>
              <label for="description" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
                Descrição <span class="text-red-500 ml-1">*</span>
              </label>
              <textarea
                id="description"
                name="description"
                required
                rows="4"
                placeholder="Descreva o que precisa ser orçado..."
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 resize-none"
              ><%= request ? request.description : '' %></textarea>
            </div>

            <!-- Prioridade e Vinculação -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Prioridade -->
              <div>
                <label for="priority" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  Prioridade
                </label>
                <select
                  id="priority"
                  name="priority"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="BAIXA" <%= request && request.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
                  <option value="NORMAL" <%= !request || request.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
                  <option value="ALTA" <%= request && request.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
                  <option value="URGENTE" <%= request && request.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
                </select>
              </div>

              <!-- Valor Estimado (Opcional) -->
              <div>
                <label for="estimatedValue" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Valor Estimado (Opcional)
                </label>
                <input
                  type="number"
                  id="estimatedValue"
                  name="estimatedValue"
                  step="0.01"
                  min="0"
                  value="<%= request ? request.estimatedValue : '' %>"
                  placeholder="0,00"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                />
              </div>
            </div>

            <!-- Vinculação (Opcional) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Ocorrência Relacionada -->
              <div>
                <label for="relatedOccurrenceId" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                  Ocorrência Relacionada (Opcional)
                </label>
                <select
                  id="relatedOccurrenceId"
                  name="relatedOccurrenceId"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="">Nenhuma</option>
                  <% if (occurrences && occurrences.length > 0) { %>
                    <% occurrences.forEach(occurrence => { %>
                      <option value="<%= occurrence.id %>" <%= request && request.relatedOccurrenceId == occurrence.id ? 'selected' : '' %>>
                        <%= occurrence.title %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>

              <!-- Tarefa Relacionada -->
              <div>
                <label for="relatedTaskId" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                  </svg>
                  Tarefa Relacionada (Opcional)
                </label>
                <select
                  id="relatedTaskId"
                  name="relatedTaskId"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="">Nenhuma</option>
                  <% if (tasks && tasks.length > 0) { %>
                    <% tasks.forEach(task => { %>
                      <option value="<%= task.id %>" <%= request && request.relatedTaskId == task.id ? 'selected' : '' %>>
                        <%= task.title %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
            </div>

            <!-- Seção de Orçamentos -->
            <div class="border-t-2 border-gray-200 pt-6">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-lg font-bold text-gray-800 flex items-center">
                    <svg class="w-6 h-6 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Orçamentos de Fornecedores
                  </h3>
                  <p class="text-sm text-gray-600 mt-1">Adicione pelo menos um orçamento para comparação</p>
                </div>
                <button
                  type="button"
                  onclick="addQuote()"
                  class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors flex items-center space-x-2"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                  <span>Adicionar Orçamento</span>
                </button>
              </div>

              <!-- Container de Orçamentos -->
              <div id="quotesContainer" class="space-y-4">
                <!-- Orçamentos serão adicionados aqui via JavaScript -->
              </div>
            </div>

            <!-- Anexos (Opcional) -->
            <div class="border-t-2 border-gray-200 pt-6">
              <label for="attachments" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.414a2 2 0 00-2.828-2.828L9 10.172 5.828 7l6.586-6.586a2 2 0 112.828 2.828L5.828 7l6.586 6.586z"></path>
                </svg>
                Anexos (Opcional)
              </label>
              <input
                type="file"
                id="attachments"
                name="attachments"
                multiple
                accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
              <p class="text-xs text-gray-500 mt-2">Você pode selecionar múltiplos arquivos. Formatos aceitos: PDF, DOC, DOCX, JPG, PNG.</p>
            </div>

            <!-- Botões -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
              <a href="/administrativo/orcamentos" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Cancelar</span>
              </a>
              <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-blue-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
                <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="relative z-10">Criar Solicitação</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let quoteCount = 0;

  function addQuote() {
    quoteCount++;
    const container = document.getElementById('quotesContainer');
    const quoteCard = document.createElement('div');
    quoteCard.className = 'quote-card bg-gray-50 rounded-xl p-6';
    quoteCard.id = `quote-${quoteCount}`;
    quoteCard.innerHTML = `
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-semibold text-gray-800 flex items-center">
          <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          Orçamento ${quoteCount}
        </h4>
        <button
          type="button"
          onclick="removeQuote(${quoteCount})"
          class="text-red-600 hover:text-red-800 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Nome do Fornecedor <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="quotes[${quoteCount}][supplierName]"
            required
            placeholder="Ex: Empresa XYZ"
            class="input-focus w-full px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Contato do Fornecedor
          </label>
          <input
            type="text"
            name="quotes[${quoteCount}][supplierContact]"
            placeholder="Telefone ou email"
            class="input-focus w-full px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Valor do Orçamento <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            name="quotes[${quoteCount}][quoteValue]"
            required
            step="0.01"
            min="0"
            placeholder="0,00"
            class="input-focus w-full px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Validade do Orçamento
          </label>
          <input
            type="date"
            name="quotes[${quoteCount}][quoteValidityDate]"
            class="input-focus w-full px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none"
          />
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Descrição do Orçamento
          </label>
          <textarea
            name="quotes[${quoteCount}][quoteDescription]"
            rows="3"
            placeholder="Detalhes do que está incluído no orçamento..."
            class="input-focus w-full px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none resize-none"
          ></textarea>
        </div>
      </div>
    `;
    container.appendChild(quoteCard);
  }

  function removeQuote(id) {
    const quoteCard = document.getElementById(`quote-${id}`);
    if (quoteCard) {
      quoteCard.remove();
    }
  }

  // Adiciona um orçamento ao carregar a página
  document.addEventListener('DOMContentLoaded', function() {
    addQuote();
  });

  // Validação antes de enviar
  document.getElementById('budgetForm').addEventListener('submit', function(e) {
    const quotes = document.querySelectorAll('[name^="quotes["]');
    if (quotes.length === 0) {
      e.preventDefault();
      alert('Por favor, adicione pelo menos um orçamento');
      return false;
    }
    
    // Valida que todos os orçamentos têm nome e valor
    let valid = true;
    for (let i = 1; i <= quoteCount; i++) {
      const quoteCard = document.getElementById(`quote-${i}`);
      if (quoteCard) {
        const supplierName = quoteCard.querySelector('[name*="[supplierName]"]');
        const quoteValue = quoteCard.querySelector('[name*="[quoteValue]"]');
        if (supplierName && quoteValue && (!supplierName.value || !quoteValue.value)) {
          valid = false;
          break;
        }
      }
    }
    
    if (!valid) {
      e.preventDefault();
      alert('Por favor, preencha pelo menos o nome do fornecedor e o valor em todos os orçamentos');
      return false;
    }
  });
</script>

<%- include('../../partials/footer') %>
