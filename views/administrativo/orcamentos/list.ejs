<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Solicitações de Orçamento</h1>
      <p class="text-gray-600 mt-2">Gerencie solicitações de orçamento</p>
    </div>
    <% if (typeof allowCreate === 'undefined' || allowCreate !== false) { %>
    <a href="/administrativo/orcamentos/novo" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition">
      Nova Solicitação
    </a>
    <% } %>
  </div>

  <% if (success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Solicitação de orçamento criada e enviada para aprovação com sucesso!
    </div>
  <% } %>
  <% if (success === 'draft') { %>
    <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
      Rascunho salvo com sucesso! Você pode editá-lo e enviar para aprovação quando estiver pronto.
    </div>
  <% } %>
  <% if (success === 'draft_updated') { %>
    <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
      Rascunho atualizado com sucesso!
    </div>
  <% } %>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="<%= typeof module !== 'undefined' && module === 'financeiro' ? '/financeiro/orcamentos-rejeitados' : '/administrativo/orcamentos' %>" class="flex gap-4">
      <select name="status" class="border rounded px-3 py-2">
        <option value="">Todos os status</option>
        <option value="DRAFT" <%= filters.status === 'DRAFT' ? 'selected' : '' %>>Rascunho</option>
        <option value="PENDING_FINANCEIRO" <%= filters.status === 'PENDING_FINANCEIRO' ? 'selected' : '' %>>Aguardando Financeiro</option>
        <option value="PENDING_SINDICO" <%= filters.status === 'PENDING_SINDICO' ? 'selected' : '' %>>Aguardando Síndico</option>
        <option value="APPROVED" <%= filters.status === 'APPROVED' ? 'selected' : '' %>>Aprovado</option>
        <option value="REJECTED" <%= filters.status === 'REJECTED' ? 'selected' : '' %>>Rejeitado</option>
        <option value="LIBERATED" <%= filters.status === 'LIBERATED' ? 'selected' : '' %>>Liberado</option>
      </select>
      <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">
        Filtrar
      </button>
    </form>
  </div>

  <% if (!requests || requests.length === 0) { %>
    <%- include('../../partials/empty-state', {
      title: 'Nenhuma solicitação de orçamento',
      description: 'Quando precisar de um serviço ou compra, crie uma solicitação de orçamento, anexe as cotações dos fornecedores e envie para o Financeiro e depois para o Síndico aprovar.',
      buttonText: 'Nova solicitação de orçamento',
      buttonHref: '/administrativo/orcamentos/novo',
      icon: 'list'
    }) %>
  <% } else if (requests && requests.length > 0) { %>
    <div class="space-y-4">
      <% requests.forEach(request => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-800"><%= request.title %></h3>
              <p class="text-gray-600 mt-2"><%= request.description %></p>
              <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div>
                  <p class="text-gray-500">Status:</p>
                  <span class="px-2 py-1 rounded text-xs font-semibold <%= 
                    request.status === 'DRAFT' ? 'bg-gray-100 text-gray-800' :
                    request.status === 'APPROVED' ? 'bg-green-100 text-green-800' :
                    request.status === 'REJECTED' ? 'bg-red-100 text-red-800' :
                    request.status === 'PENDING_SINDICO' ? 'bg-yellow-100 text-yellow-800' :
                    'bg-blue-100 text-blue-800'
                  %>">
                    <%= request.status === 'DRAFT' ? 'Rascunho' : request.status %>
                  </span>
                </div>
                <div>
                  <p class="text-gray-500">Criado em:</p>
                  <p class="font-medium"><%= new Date(request.created_at).toLocaleString('pt-BR') %></p>
                </div>
                <% if (request.budget_approved_amount) { %>
                  <div>
                    <p class="text-gray-500">Valor Aprovado:</p>
                    <p class="font-semibold text-green-600">R$ <%= parseFloat(request.budget_approved_amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Lista de Orçamentos -->
          <% if (request.quotes && request.quotes.length > 0) { %>
            <div class="border-t pt-4 mt-4">
              <h4 class="text-md font-semibold text-gray-800 mb-3">Orçamentos Recebidos:</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                <% request.quotes.forEach(quote => { %>
                  <div class="border-2 <%= quote.status === 'APPROVED' ? 'border-green-500 bg-green-50' : quote.status === 'REJECTED' ? 'border-red-300 bg-red-50' : 'border-gray-300' %> rounded-lg p-3">
                    <div class="flex items-start justify-between mb-2">
                      <h5 class="font-semibold text-gray-800 text-sm"><%= quote.supplier_name %></h5>
                      <% if (quote.status === 'APPROVED') { %>
                        <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded">Aprovado</span>
                      <% } else if (quote.status === 'REJECTED') { %>
                        <span class="px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded">Rejeitado</span>
                      <% } %>
                    </div>
                    <p class="text-xl font-bold text-blue-600">R$ <%= parseFloat(quote.quote_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
                    <% if (quote.quote_description) { %>
                      <p class="text-xs text-gray-600 mt-1"><%= quote.quote_description %></p>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div class="border-t pt-4 mt-4 flex gap-4">
            <% if (request.status === 'DRAFT' && (typeof module === 'undefined' || module !== 'financeiro')) { %>
              <a href="/administrativo/orcamentos/<%= request.id %>/editar" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">
                Editar →
              </a>
            <% } %>
            <a href="<%= typeof module !== 'undefined' && module === 'financeiro' ? '/financeiro/orcamentos-rejeitados/' + request.id : '/administrativo/orcamentos/' + request.id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">
              Ver Detalhes →
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
