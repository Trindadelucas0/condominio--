<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }
  
  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.5s ease-out;
  }
  
  .stat-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .card-elevate {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-elevate:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Patrimonial'; %>
    <% var resumo = ['Visão geral dos ativos do condomínio: total, valor, manutenções.', 'Cadastre ativos em Ativos; registre manutenções no detalhe de cada ativo.', 'Use para acompanhar o patrimônio e depreciação.']; %>
    <% var helpModalContent = '<p>O dashboard mostra totais e resumo do patrimônio. Cadastre ativos em Ativos; no detalhe de cada ativo você registra manutenções e depreciação.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
              Dashboard Patrimonial
            </h1>
            <p class="text-gray-600 mt-1">Gestão de ativos do condomínio</p>
          </div>
        </div>
        <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Cards de Estatísticas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total de Ativos -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border-l-4 border-indigo-500 animate-fade-in-up" style="animation-delay: 0.1s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Total de Ativos</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-indigo-600 to-indigo-700 bg-clip-text text-transparent">
              <%= stats.totalAssets %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
        </div>
        <a href="/patrimonio/ativos" class="inline-flex items-center space-x-2 text-indigo-600 hover:text-indigo-700 text-sm font-semibold transition-colors duration-200">
          <span>Ver ativos</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Valor Total de Aquisição -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border-l-4 border-blue-500 animate-fade-in-up" style="animation-delay: 0.2s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Valor Total de Aquisição</p>
            <p class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent">
              R$ <%= stats.totalAcquisitionValue.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Valor Atual (Depreciado) -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border-l-4 border-green-500 animate-fade-in-up" style="animation-delay: 0.3s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Valor Atual (Depreciado)</p>
            <p class="text-3xl font-bold bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
              R$ <%= stats.totalCurrentValue.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-2 flex items-center space-x-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>Depreciação: <strong class="text-gray-700">R$ <%= stats.totalDepreciation.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></strong></span>
        </p>
      </div>

      <!-- Ativos em Manutenção -->
      <div class="stat-card bg-white rounded-2xl shadow-lg p-6 border-l-4 border-yellow-500 animate-fade-in-up" style="animation-delay: 0.4s">
        <div class="flex items-center justify-between mb-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-gray-600 mb-1">Em Manutenção</p>
            <p class="text-4xl font-bold bg-gradient-to-r from-yellow-600 to-amber-600 bg-clip-text text-transparent">
              <%= stats.assetsInMaintenance %>
            </p>
          </div>
          <div class="bg-gradient-to-br from-yellow-500 to-amber-600 rounded-xl p-4 shadow-md">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="bg-white rounded-2xl shadow-xl p-6 animate-fade-in-up" style="animation-delay: 0.5s">
      <div class="flex items-center space-x-2 mb-6">
        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-800">Ações Rápidas</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/patrimonio/ativos/novo" class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-blue-600 text-white px-6 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="relative z-10">Novo Ativo</span>
        </a>
        <a href="/patrimonio/ativos" class="group relative overflow-hidden bg-white border-2 border-indigo-600 text-indigo-600 px-6 py-4 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2 hover:bg-indigo-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          <span>Ver Todos os Ativos</span>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
