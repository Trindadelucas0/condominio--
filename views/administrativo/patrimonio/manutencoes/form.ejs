<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Nova manutenção'; %>
  <% var resumo = ['Registre manutenção preventiva ou corretiva para o ativo.', 'Informe tipo, descrição, data e valor; o histórico fica no detalhe do ativo.', 'Use para controle de gastos e planejamento.']; %>
  <% var helpModalContent = '<p>Preencha tipo (preventiva/corretiva), descrição, data e valor. O registro fica no histórico do ativo para consulta e relatórios.</p>'; %>
  <!-- Cabeçalho -->
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Nova Manutenção</h1>
      <p class="text-gray-600 mt-2">Registrar manutenção para: <strong><%= asset.name %></strong></p>
    </div>
    <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/patrimonio/ativos/<%= asset.id %>/manutencao">
      <!-- Tipo -->
      <div class="mb-4">
        <label for="maintenanceType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de Manutenção <span class="text-red-500">*</span>
        </label>
        <select
          id="maintenanceType"
          name="maintenanceType"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="PREVENTIVA" <%= manutencao && manutencao.maintenanceType === 'PREVENTIVA' ? 'selected' : '' %>>Preventiva</option>
          <option value="CORRETIVA" <%= manutencao && manutencao.maintenanceType === 'CORRETIVA' ? 'selected' : '' %>>Corretiva</option>
        </select>
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição <span class="text-red-500">*</span>
        </label>
        <textarea
          id="description"
          name="description"
          required
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Descreva a manutenção realizada..."
        ><%= manutencao ? manutencao.description || '' : '' %></textarea>
      </div>

      <!-- Data e Custo -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="maintenanceDate" class="block text-sm font-medium text-gray-700 mb-1">
            Data da Manutenção <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="maintenanceDate"
            name="maintenanceDate"
            required
            value="<%= manutencao && manutencao.maintenanceDate ? new Date(manutencao.maintenanceDate).toISOString().split('T')[0] : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>
        <div>
          <label for="cost" class="block text-sm font-medium text-gray-700 mb-1">
            Custo (R$)
          </label>
          <input
            type="number"
            id="cost"
            name="cost"
            step="0.01"
            min="0"
            value="<%= manutencao && manutencao.cost ? manutencao.cost : '' %>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
            placeholder="0.00"
          />
        </div>
      </div>

      <!-- Próxima Manutenção (para preventivas) -->
      <div class="mb-4">
        <label for="nextMaintenanceDate" class="block text-sm font-medium text-gray-700 mb-1">
          Próxima Manutenção (Opcional)
        </label>
        <input
          type="date"
          id="nextMaintenanceDate"
          name="nextMaintenanceDate"
          value="<%= manutencao && manutencao.nextMaintenanceDate ? new Date(manutencao.nextMaintenanceDate).toISOString().split('T')[0] : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        />
        <p class="text-xs text-gray-500 mt-1">Recomendado para manutenções preventivas</p>
      </div>

      <!-- Realizada Por -->
      <div class="mb-4">
        <label for="performedBy" class="block text-sm font-medium text-gray-700 mb-1">
          Realizada Por
        </label>
        <input
          type="text"
          id="performedBy"
          name="performedBy"
          value="<%= manutencao ? manutencao.performedBy || '' : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Ex: Empresa XYZ, Funcionário João"
        />
      </div>

      <!-- Observações -->
      <div class="mb-4">
        <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">
          Observações
        </label>
        <textarea
          id="notes"
          name="notes"
          rows="3"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Observações adicionais..."
        ><%= manutencao ? manutencao.notes || '' : '' %></textarea>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/patrimonio/ativos/<%= asset.id %>"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition"
        >
          Registrar Manutenção
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../../partials/footer') %>
