<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Ativos (patrimônio)'; %>
  <% var resumo = ['Ativos são bens do condomínio: equipamentos, móveis, instalações.', 'Cadastre nome, tipo, valor; no detalhe registre manutenções e depreciação.', 'Use para controle do patrimônio e planejamento de manutenção.']; %>
  <% var helpModalContent = '<p>Ativos são os bens do condomínio. Cadastre cada um com nome, tipo e valor. No detalhe do ativo você registra manutenções (preventiva/corretiva) e depreciação.</p>'; %>
  <!-- Cabeçalho -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Ativos</h1>
        <p class="text-gray-600 mt-2">Gestão de patrimônio do condomínio</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <a href="/patrimonio/ativos/novo" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
      Novo Ativo
    </a>
  </div>
  <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Ativo criado com sucesso!
    </div>
  <% } %>

  <!-- Lista de ativos -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor Aquisição</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Valor Atual</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (assets.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhum ativo cadastrado.
            </td>
          </tr>
        <% } else { %>
          <% assets.forEach(asset => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= asset.name %></div>
                <% if (asset.location) { %>
                  <div class="text-sm text-gray-500"><%= asset.location %></div>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded bg-purple-100 text-purple-800">
                  <%= asset.asset_type %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <% if (asset.acquisition_cost) { %>
                    R$ <%= parseFloat(asset.acquisition_cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                  <% } else { %>
                    -
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-green-600">
                  <% if (asset.current_value !== undefined) { %>
                    R$ <%= parseFloat(asset.current_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                  <% } else { %>
                    -
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (asset.status === 'ACTIVE') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% } else if (asset.status === 'MAINTENANCE') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                    Manutenção
                  </span>
                <% } else if (asset.status === 'INACTIVE') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    Inativo
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    <%= asset.status %>
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <a href="/patrimonio/ativos/<%= asset.id %>" class="text-purple-600 hover:text-purple-900 mr-3">
                  Ver
                </a>
                <a href="/patrimonio/ativos/<%= asset.id %>/editar" class="text-blue-600 hover:text-blue-900">
                  Editar
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
