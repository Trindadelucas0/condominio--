<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Ativo atualizado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'maintenance_created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Manutenção registrada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'depreciation_calculated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Depreciação calculada com sucesso!
    </div>
  <% } %>

  <!-- Cabeçalho -->
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800"><%= asset.name %></h1>
      <p class="text-gray-600 mt-2">Detalhes do ativo</p>
    </div>
    <div class="flex space-x-3">
      <a href="/patrimonio/ativos/<%= asset.id %>/editar" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
        Editar
      </a>
      <a href="/patrimonio/ativos" class="bg-gray-600 text-white px-6 py-2 rounded-lg hover:bg-gray-700 transition">
        Voltar
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Informações principais -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Informações Básicas -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Informações Básicas</h2>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">Tipo</p>
            <p class="font-semibold text-gray-900"><%= asset.asset_type %></p>
          </div>
          <% if (asset.location) { %>
            <div>
              <p class="text-sm text-gray-500">Localização</p>
              <p class="font-semibold text-gray-900"><%= asset.location %></p>
            </div>
          <% } %>
          <% if (asset.manufacturer) { %>
            <div>
              <p class="text-sm text-gray-500">Fabricante</p>
              <p class="font-semibold text-gray-900"><%= asset.manufacturer %></p>
            </div>
          <% } %>
          <% if (asset.model) { %>
            <div>
              <p class="text-sm text-gray-500">Modelo</p>
              <p class="font-semibold text-gray-900"><%= asset.model %></p>
            </div>
          <% } %>
          <% if (asset.serial_number) { %>
            <div>
              <p class="text-sm text-gray-500">Número de Série</p>
              <p class="font-semibold text-gray-900"><%= asset.serial_number %></p>
            </div>
          <% } %>
          <div>
            <p class="text-sm text-gray-500">Status</p>
            <% if (asset.status === 'ACTIVE') { %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Ativo</span>
            <% } else if (asset.status === 'MAINTENANCE') { %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">Em Manutenção</span>
            <% } else if (asset.status === 'INACTIVE') { %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Inativo</span>
            <% } else { %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800"><%= asset.status %></span>
            <% } %>
          </div>
        </div>
        <% if (asset.description) { %>
          <div class="mt-4">
            <p class="text-sm text-gray-500">Descrição</p>
            <p class="text-gray-900"><%= asset.description %></p>
          </div>
        <% } %>
      </div>

      <!-- Informações Financeiras -->
      <% if (asset.acquisition_date || asset.acquisition_cost) { %>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-bold text-gray-800 mb-4">Informações Financeiras</h2>
          <div class="grid grid-cols-2 gap-4">
            <% if (asset.acquisition_date) { %>
              <div>
                <p class="text-sm text-gray-500">Data de Aquisição</p>
                <p class="font-semibold text-gray-900"><%= new Date(asset.acquisition_date).toLocaleDateString('pt-BR') %></p>
              </div>
            <% } %>
            <% if (asset.acquisition_cost) { %>
              <div>
                <p class="text-sm text-gray-500">Valor de Aquisição</p>
                <p class="font-semibold text-gray-900">
                  R$ <%= parseFloat(asset.acquisition_cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </p>
              </div>
            <% } %>
            <% if (asset.current_value !== undefined) { %>
              <div>
                <p class="text-sm text-gray-500">Valor Atual (Depreciado)</p>
                <p class="font-semibold text-green-600">
                  R$ <%= parseFloat(asset.current_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </p>
              </div>
            <% } %>
            <% if (asset.acquisition_cost && asset.current_value !== undefined) { %>
              <div>
                <p class="text-sm text-gray-500">Depreciação Total</p>
                <p class="font-semibold text-red-600">
                  R$ <%= (parseFloat(asset.acquisition_cost) - parseFloat(asset.current_value)).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </p>
              </div>
            <% } %>
            <div>
              <p class="text-sm text-gray-500">Taxa de Depreciação</p>
              <p class="font-semibold text-gray-900"><%= asset.depreciation_rate || '10.00' %>% ao ano</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Vida Útil</p>
              <p class="font-semibold text-gray-900"><%= asset.useful_life_years || '10' %> anos</p>
            </div>
          </div>
          <div class="mt-4">
            <form method="POST" action="/patrimonio/ativos/<%= asset.id %>/calcular-depreciacao" class="inline">
              <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition text-sm">
                Recalcular Depreciação
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Histórico de Manutenções -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">Histórico de Manutenções</h2>
          <a href="/patrimonio/ativos/<%= asset.id %>/manutencao/nova" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition text-sm">
            Nova Manutenção
          </a>
        </div>
        <% if (asset.maintenances && asset.maintenances.length > 0) { %>
          <div class="space-y-4">
            <% asset.maintenances.forEach(maint => { %>
              <div class="border-l-4 border-blue-500 pl-4 py-2">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <p class="font-semibold text-gray-900"><%= maint.description %></p>
                    <p class="text-sm text-gray-500">
                      <%= maint.maintenance_type === 'PREVENTIVA' ? 'Preventiva' : 'Corretiva' %> - 
                      <%= new Date(maint.maintenance_date).toLocaleDateString('pt-BR') %>
                    </p>
                    <% if (maint.cost) { %>
                      <p class="text-sm text-gray-600 font-semibold mt-1">
                        Custo: R$ <%= parseFloat(maint.cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                      </p>
                    <% } %>
                    <% if (maint.performed_by) { %>
                      <p class="text-sm text-gray-500">Realizada por: <%= maint.performed_by %></p>
                    <% } %>
                    <% if (maint.notes) { %>
                      <p class="text-sm text-gray-600 mt-1"><%= maint.notes %></p>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-gray-500 text-center py-4">Nenhuma manutenção registrada</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Ações Rápidas -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Ações Rápidas</h3>
        <div class="space-y-2">
          <a href="/patrimonio/ativos/<%= asset.id %>/manutencao/nova" class="block w-full bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition text-center text-sm">
            Registrar Manutenção
          </a>
          <% if (asset.acquisition_date && asset.acquisition_cost) { %>
            <form method="POST" action="/patrimonio/ativos/<%= asset.id %>/calcular-depreciacao">
              <button type="submit" class="w-full bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition text-sm">
                Recalcular Depreciação
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
