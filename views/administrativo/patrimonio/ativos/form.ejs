<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = ativo ? 'Editar ativo' : 'Novo ativo'; %>
    <% var resumo = ['Preencha nome, tipo e valor do ativo.', 'No detalhe você registra manutenções e depreciação.']; %>
    <% var helpModalContent = '<p>Cadastre ou edite o ativo. No detalhe do ativo registre manutenções e depreciação.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex items-center space-x-3 mb-2">
        <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
            <%= ativo ? 'Editar Ativo' : 'Novo Ativo' %>
          </h1>
          <p class="text-gray-600 mt-1"><%= ativo ? 'Atualize as informações do ativo' : 'Cadastre um novo ativo do patrimônio' %></p>
        </div>
        <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Mensagem de erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-red-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-red-800">Erro</p>
            <p class="text-sm text-red-600"><%= error %></p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Formulário -->
    <div class="bg-white rounded-2xl shadow-xl p-8 max-w-4xl animate-slide-in">
      <form method="POST" action="<%= ativo ? '/patrimonio/ativos/' + ativo.id : '/patrimonio/ativos' %>">
        <!-- Nome -->
        <div class="mb-6">
          <label for="name" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            Nome <span class="text-red-500 ml-1">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            value="<%= ativo ? ativo.name : '' %>"
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
            placeholder="Ex: Elevador A, Bomba d'água 1"
          />
        </div>

      <!-- Tipo -->
      <% const FIXED_TYPES = ['ELEVADOR', 'BOMBA', 'GERADOR', 'PORTARIA']; %>
      <% const existingTypes = Array.isArray(existingAssetTypes) ? existingAssetTypes : []; %>
      <% 
        let customTypes = existingTypes.filter(function(t) { return FIXED_TYPES.indexOf(t) === -1; });
        if (ativo && ativo.asset_type && FIXED_TYPES.indexOf(ativo.asset_type) === -1 && customTypes.indexOf(ativo.asset_type) === -1) {
          customTypes = customTypes.concat([ativo.asset_type]);
        }
      %>
      <div class="mb-4">
        <label for="assetType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo <span class="text-red-500">*</span>
        </label>
        <select
          id="assetType"
          name="assetType"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
        >
          <option value="ELEVADOR" <%= ativo && ativo.asset_type === 'ELEVADOR' ? 'selected' : '' %>>Elevador</option>
          <option value="BOMBA" <%= ativo && ativo.asset_type === 'BOMBA' ? 'selected' : '' %>>Bomba</option>
          <option value="GERADOR" <%= ativo && ativo.asset_type === 'GERADOR' ? 'selected' : '' %>>Gerador</option>
          <option value="PORTARIA" <%= ativo && ativo.asset_type === 'PORTARIA' ? 'selected' : '' %>>Portaria</option>
          <% customTypes.forEach(function(t) {
            const parts = (t || '').split(/[\s_]+/);
            const label = parts.map(function(p) { return p.charAt(0).toUpperCase() + (p.slice(1) || '').toLowerCase(); }).join(' ');
          %>
          <option value="<%= t %>" <%= ativo && ativo.asset_type === t ? 'selected' : '' %>><%= label %></option>
          <% }); %>
          <option value="OUTRO" <%= ativo && ativo.asset_type === 'OUTRO' ? 'selected' : '' %>>Outro</option>
          <option value="__NEW__">Criar novo tipo...</option>
        </select>
        <!-- Modal / painel para criar novo tipo (aparece abaixo do campo) -->
        <div id="modalNovoTipo" class="hidden mt-3 p-4 bg-gray-50 border border-gray-200 rounded-xl">
          <p class="text-sm font-semibold text-gray-800 mb-2">Novo tipo de ativo</p>
          <label for="novoTipoNome" class="block text-sm text-gray-600 mb-1">Nome do tipo</label>
          <input
            type="text"
            id="novoTipoNome"
            placeholder="Ex: Ar condicionado"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 mb-3"
          />
          <div class="flex gap-2">
            <button type="button" id="btnCancelarNovoTipo" class="px-4 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 transition">
              Cancelar
            </button>
            <button type="button" id="btnCriarNovoTipo" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition">
              Criar
            </button>
          </div>
          <p id="novoTipoErro" class="hidden text-sm text-red-600 mt-2"></p>
        </div>
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição
        </label>
        <textarea
          id="description"
          name="description"
          rows="3"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
          placeholder="Descreva o ativo..."
        ><%= ativo ? ativo.description || '' : '' %></textarea>
      </div>

        <!-- Fabricante e Modelo -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="manufacturer" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              Fabricante
            </label>
            <input
              type="text"
              id="manufacturer"
              name="manufacturer"
              value="<%= ativo ? ativo.manufacturer || '' : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="Ex: ThyssenKrupp"
            />
          </div>
          <div>
            <label for="model" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Modelo
            </label>
            <input
              type="text"
              id="model"
              name="model"
              value="<%= ativo ? ativo.model || '' : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="Ex: MRL 630"
            />
          </div>
        </div>

        <!-- Número de Série e Localização -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="serialNumber" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
              </svg>
              Número de Série
            </label>
            <input
              type="text"
              id="serialNumber"
              name="serialNumber"
              value="<%= ativo ? ativo.serial_number || '' : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="Ex: SN123456"
            />
          </div>
          <div>
            <label for="location" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Localização
            </label>
            <input
              type="text"
              id="location"
              name="location"
              value="<%= ativo ? ativo.location || '' : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="Ex: Torre A, Subsolo"
            />
          </div>
        </div>

        <!-- Data de Aquisição e Valor -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="acquisitionDate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              Data de Aquisição
            </label>
            <input
              type="date"
              id="acquisitionDate"
              name="acquisitionDate"
              value="<%= ativo && ativo.acquisition_date ? new Date(ativo.acquisition_date).toISOString().split('T')[0] : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
            />
          </div>
          <div>
            <label for="acquisitionCost" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Valor de Aquisição (R$)
            </label>
            <input
              type="number"
              id="acquisitionCost"
              name="acquisitionCost"
              step="0.01"
              min="0"
              value="<%= ativo && ativo.acquisition_cost ? ativo.acquisition_cost : '' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="0.00"
            />
          </div>
        </div>

        <!-- Taxa de Depreciação e Vida Útil -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="depreciationRate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
              Taxa de Depreciação Anual (%)
            </label>
            <input
              type="number"
              id="depreciationRate"
              name="depreciationRate"
              step="0.01"
              min="0"
              max="100"
              value="<%= ativo ? ativo.depreciation_rate || '10.00' : '10.00' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="10.00"
            />
          </div>
          <div>
            <label for="usefulLifeYears" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Vida Útil (anos)
            </label>
            <input
              type="number"
              id="usefulLifeYears"
              name="usefulLifeYears"
              min="1"
              value="<%= ativo ? ativo.useful_life_years || '10' : '10' %>"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
              placeholder="10"
            />
          </div>
        </div>

        <!-- Status (apenas na edição) -->
        <% if (ativo) { %>
          <div class="mb-6">
            <label for="status" class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Status
            </label>
            <select
              id="status"
              name="status"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200"
            >
              <option value="ACTIVE" <%= ativo.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
              <option value="INACTIVE" <%= ativo.status === 'INACTIVE' ? 'selected' : '' %>>Inativo</option>
              <option value="MAINTENANCE" <%= ativo.status === 'MAINTENANCE' ? 'selected' : '' %>>Em Manutenção</option>
              <option value="DECOMMISSIONED" <%= ativo.status === 'DECOMMISSIONED' ? 'selected' : '' %>>Descomissionado</option>
            </select>
          </div>
        <% } %>

        <!-- Botões -->
        <div class="flex flex-col sm:flex-row justify-end gap-4 pt-6 border-t-2 border-gray-200">
          <a
            href="/patrimonio/ativos"
            class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center justify-center space-x-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Cancelar</span>
          </a>
          <button
            type="submit"
            class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-blue-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2"
          >
            <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
            <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="relative z-10"><%= ativo ? 'Atualizar Ativo' : 'Criar Ativo' %></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  var select = document.getElementById('assetType');
  var modal = document.getElementById('modalNovoTipo');
  var input = document.getElementById('novoTipoNome');
  var btnCancelar = document.getElementById('btnCancelarNovoTipo');
  var btnCriar = document.getElementById('btnCriarNovoTipo');
  var errEl = document.getElementById('novoTipoErro');

  var lastValidValue = '';
  if (select && select.value && select.value !== '__NEW__') lastValidValue = select.value;

  function formatLabel(str) {
    if (!str) return '';
    return str.split(/[\s_]+/).map(function(p) {
      return p.charAt(0).toUpperCase() + (p.slice(1) || '').toLowerCase();
    }).join(' ');
  }

  function normalizeValue(str) {
    return (str || '').trim().toUpperCase().replace(/\s+/g, ' ');
  }

  if (select) {
    select.addEventListener('change', function() {
      if (select.value === '__NEW__') {
        if (modal) modal.classList.remove('hidden');
        if (input) { input.value = ''; input.focus(); }
        if (errEl) { errEl.classList.add('hidden'); errEl.textContent = ''; }
      } else {
        lastValidValue = select.value;
      }
    });
  }

  if (btnCancelar) {
    btnCancelar.addEventListener('click', function() {
      if (modal) modal.classList.add('hidden');
      if (select) select.value = lastValidValue || (select.options[0] ? select.options[0].value : '');
    });
  }

  if (btnCriar && select && modal && input) {
    btnCriar.addEventListener('click', function() {
      var raw = (input.value || '').trim();
      if (!raw) {
        if (errEl) { errEl.textContent = 'Digite o nome do tipo.'; errEl.classList.remove('hidden'); }
        return;
      }
      if (errEl) { errEl.classList.add('hidden'); errEl.textContent = ''; }
      btnCriar.disabled = true;
      btnCriar.textContent = 'Salvando...';

      fetch('/patrimonio/ativos/tipos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ name: raw }),
        credentials: 'same-origin'
      })
        .then(function(r) {
          if (!r.ok) return r.json().then(function(d) { throw new Error(d.error || 'Erro ao salvar tipo'); });
          return r.json();
        })
        .then(function(data) {
          var value = data.typeCode;
          var label = data.typeLabel || formatLabel(value);
          var opts = select.options;
          var existing = false;
          for (var i = 0; i < opts.length; i++) {
            if (opts[i].value === value) { existing = true; break; }
          }
          if (!existing) {
            var newOpt = document.createElement('option');
            newOpt.value = value;
            newOpt.textContent = label;
            var lastOpt = opts[opts.length - 1];
            select.insertBefore(newOpt, lastOpt);
          }
          select.value = value;
          lastValidValue = value;
          modal.classList.add('hidden');
          input.value = '';
        })
        .catch(function(e) {
          if (errEl) { errEl.textContent = e.message || 'Erro ao salvar tipo. Tente de novo.'; errEl.classList.remove('hidden'); }
        })
        .finally(function() {
          btnCriar.disabled = false;
          btnCriar.textContent = 'Criar';
        });
    });
  }
})();
</script>

<%- include('../../../partials/footer') %>
