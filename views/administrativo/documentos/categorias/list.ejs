<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Categorias de Documentos</h1>
      <p class="text-gray-600 mt-2">Organize seus documentos por categorias</p>
    </div>
    <div class="flex gap-3">
      <a href="/administrativo/documentos" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition">
        Voltar para Documentos
      </a>
      <a href="/administrativo/documentos/categorias/nova" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition">
        Nova Categoria
      </a>
    </div>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Categoria criada com sucesso!
    </div>
  <% } %>

  <!-- Informação sobre categorias -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <h3 class="text-sm font-semibold text-blue-800 mb-2">📋 Como funcionam as categorias?</h3>
    <ul class="text-sm text-blue-700 space-y-1">
      <li>• <strong>Categorias</strong> organizam documentos por tipo (ex: "Contratos", "Atas", "Laudos")</li>
      <li>• <strong>Sem categoria</strong> é para documentos genéricos que não se encaixam em categorias específicas</li>
      <li>• Você pode criar quantas categorias precisar</li>
      <li>• Documentos podem ser filtrados por categoria na lista</li>
    </ul>
  </div>

  <!-- Lista de categorias -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (categories.length === 0) { %>
      <div class="p-8 text-center">
        <p class="text-gray-500 mb-4">Nenhuma categoria criada ainda.</p>
        <p class="text-sm text-gray-400 mb-4">Você pode criar documentos sem categoria ou criar categorias para organizá-los melhor.</p>
        <a href="/administrativo/documentos/categorias/nova" class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition">
          Criar Primeira Categoria
        </a>
      </div>
    <% } else { %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nome</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Descrição</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criada em</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% categories.forEach(cat => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= cat.name %></div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm text-gray-500"><%= cat.description || '-' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500">
                  <%= new Date(cat.created_at).toLocaleDateString('pt-BR') %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../../../partials/footer') %>
