<%- include('../../../partials/header', { title: title }) %>
<%- include('../../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Nova categoria de documento'; %>
    <% var resumo = ['Dê um nome à categoria (ex.: Contratos, Atas).', 'Ela aparecerá ao cadastrar documentos e na lista para filtrar.']; %>
    <% var helpModalContent = '<p>Informe o nome da categoria. Ela ficará disponível ao cadastrar documentos e para filtrar na lista.</p>'; %>
    <!-- Cabeçalho -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Nova Categoria de Documento</h1>
        <p class="text-gray-600 mt-2">Crie uma categoria para organizar seus documentos</p>
      </div>
      <%- include('../../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <%- include('../../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Mensagem de erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        <p><%= error %></p>
      </div>
    <% } %>

    <!-- Informação -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-semibold text-blue-800 mb-2">💡 Exemplos de categorias:</h3>
      <ul class="text-sm text-blue-700 space-y-1">
        <li>• <strong>Contratos:</strong> Contratos de limpeza, segurança, manutenção, etc.</li>
        <li>• <strong>Atas:</strong> Atas de reuniões do condomínio</li>
        <li>• <strong>Laudos:</strong> Laudos técnicos, inspeções, etc.</li>
        <li>• <strong>Seguros:</strong> Apólices de seguro</li>
        <li>• <strong>Certificados:</strong> Certificados diversos</li>
      </ul>
    </div>

    <!-- Formulário -->
    <div class="bg-white rounded-lg shadow p-6">
      <form method="POST" action="/administrativo/documentos/categorias">
        <!-- Nome -->
        <div class="mb-6">
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
            Nome da Categoria <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            value="<%= categoria ? categoria.name : '' %>"
            placeholder="Ex: Contratos, Atas, Laudos..."
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Descrição -->
        <div class="mb-6">
          <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
            Descrição (opcional)
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Descreva o tipo de documentos que pertencem a esta categoria..."
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
          ><%= categoria ? categoria.description || '' : '' %></textarea>
        </div>

        <!-- Botões -->
        <div class="flex justify-end gap-4">
          <a href="/administrativo/documentos/categorias" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg font-semibold transition">
            Cancelar
          </a>
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg font-semibold transition">
            Criar Categoria
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../../partials/footer') %>
