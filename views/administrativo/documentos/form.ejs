<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= documento ? 'Editar Documento' : 'Novo Documento' %></h1>
    <p class="text-gray-600 mt-2"><%= documento ? 'Atualize as informações do documento' : 'Adicione um novo documento' %></p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="<%= documento ? '/administrativo/documentos/' + documento.id : '/administrativo/documentos' %>" enctype="multipart/form-data">
      <!-- Título -->
      <div class="mb-4">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Título <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          value="<%= documento ? documento.title : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Ex: Contrato de limpeza 2024"
        />
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição
        </label>
        <textarea
          id="description"
          name="description"
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Descrição do documento..."
        ><%= documento ? documento.description || '' : '' %></textarea>
      </div>

      <!-- Categoria -->
      <div class="mb-4">
        <div class="flex items-center justify-between mb-1">
          <label for="categoryId" class="block text-sm font-medium text-gray-700">
            Categoria
          </label>
          <a href="/administrativo/documentos/categorias" class="text-xs text-green-600 hover:text-green-800">
            + Criar categoria
          </a>
        </div>
        <select
          id="categoryId"
          name="categoryId"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Sem categoria (documento genérico)</option>
          <% categories.forEach(cat => { %>
            <option
              value="<%= cat.id %>"
              <%= documento && documento.category_id == cat.id ? 'selected' : '' %>
            >
              <%= cat.name %>
            </option>
          <% }); %>
        </select>
        <p class="text-xs text-gray-500 mt-1">
          <strong>Sem categoria:</strong> Use para documentos que não se encaixam em categorias específicas. 
          Você pode criar categorias como "Contratos", "Atas", "Laudos", etc.
        </p>
      </div>

      <!-- Tipo -->
      <div class="mb-4">
        <label for="documentType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de Documento
        </label>
        <select
          id="documentType"
          name="documentType"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="DOCUMENT" <%= !documento || documento.document_type === 'DOCUMENT' ? 'selected' : '' %>>Documento</option>
          <option value="CONTRACT" <%= documento && documento.document_type === 'CONTRACT' ? 'selected' : '' %>>Contrato</option>
          <option value="ATA" <%= documento && documento.document_type === 'ATA' ? 'selected' : '' %>>Ata</option>
          <option value="LAUDO" <%= documento && documento.document_type === 'LAUDO' ? 'selected' : '' %>>Laudo</option>
          <option value="OUTRO" <%= documento && documento.document_type === 'OUTRO' ? 'selected' : '' %>>Outro</option>
        </select>
      </div>

      <!-- Upload de PDF (apenas na criação) -->
      <% if (!documento) { %>
        <div class="mb-4">
          <label for="contractFiles" class="block text-sm font-medium text-gray-700 mb-1">
            Arquivo PDF (Contrato/Documento)
          </label>
          <input
            type="file"
            id="contractFiles"
            name="contractFiles"
            accept=".pdf,application/pdf"
            multiple
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          />
          <p class="text-xs text-gray-500 mt-1">
            <strong>Limite:</strong> 50MB por arquivo. Você pode enviar até 10 arquivos por vez.
            <br>
            <strong>Importante:</strong> Para contratos grandes, use este campo. Arquivos são salvos em <code>uploads/contracts/</code>
          </p>
        </div>
      <% } else if (documento.file_path) { %>
        <!-- Mostra arquivo existente na edição -->
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Arquivo Atual
          </label>
          <div class="bg-gray-50 border border-gray-300 rounded-md p-3">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900"><%= documento.file_name || 'Arquivo PDF' %></p>
                <p class="text-xs text-gray-500">Caminho: <%= documento.file_path %></p>
              </div>
              <% 
                const filePath = documento.file_path.includes('uploads/') 
                  ? documento.file_path.split('uploads/')[1] 
                  : documento.file_path.split('uploads\\')[1] || documento.file_path;
              %>
              <a href="/uploads/<%= filePath %>" target="_blank" class="text-green-600 hover:text-green-800 text-sm font-medium">
                Ver PDF →
              </a>
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-1">Para alterar o arquivo, delete e recrie o documento.</p>
        </div>
      <% } %>

      <!-- Data de Vencimento -->
      <div class="mb-4">
        <label for="expiryDate" class="block text-sm font-medium text-gray-700 mb-1">
          Data de Vencimento
        </label>
        <input
          type="date"
          id="expiryDate"
          name="expiryDate"
          value="<%= documento && documento.expiry_date ? new Date(documento.expiry_date).toISOString().split('T')[0] : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        />
        <p class="text-xs text-gray-500 mt-1">Deixe em branco se não houver vencimento</p>
      </div>

      <!-- Status (apenas na edição) -->
      <% if (documento) { %>
        <div class="mb-4">
          <label for="status" class="block text-sm font-medium text-gray-700 mb-1">
            Status
          </label>
          <select
            id="status"
            name="status"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          >
            <option value="ACTIVE" <%= documento.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
            <option value="EXPIRED" <%= documento.status === 'EXPIRED' ? 'selected' : '' %>>Vencido</option>
            <option value="ARCHIVED" <%= documento.status === 'ARCHIVED' ? 'selected' : '' %>>Arquivado</option>
          </select>
        </div>
      <% } %>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/administrativo/documentos"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition"
        >
          <%= documento ? 'Atualizar' : 'Criar' %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
