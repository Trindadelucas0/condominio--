<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus {
    transition: all 0.2s ease;
  }
  
  .input-focus:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-green-50/30 to-emerald-50/30">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex items-center space-x-3 mb-2">
        <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl p-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= documento ? 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' : 'M12 4v16m8-8H4' %>"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-green-900 to-gray-900 bg-clip-text text-transparent">
            <%= documento ? 'Editar Documento' : 'Novo Documento' %>
          </h1>
          <p class="text-gray-600 mt-1"><%= documento ? 'Atualize as informações do documento' : 'Adicione um novo documento' %></p>
        </div>
      </div>
    </div>

    <!-- Mensagem de Erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-red-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-red-800">Erro</p>
            <p class="text-sm text-red-600"><%= error %></p>
          </div>
        </div>
      </div>
    <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="<%= documento ? '/administrativo/documentos/' + documento.id : '/administrativo/documentos' %>" enctype="multipart/form-data">
      <!-- Título -->
      <div class="mb-4">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Título <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          value="<%= documento ? documento.title : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Ex: Contrato de limpeza 2024"
        />
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição
        </label>
        <textarea
          id="description"
          name="description"
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
          placeholder="Descrição do documento..."
        ><%= documento ? documento.description || '' : '' %></textarea>
      </div>

            <!-- Categoria -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="categoryId" class="flex items-center text-sm font-bold text-gray-700">
                  <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  Categoria
                </label>
                <a href="/administrativo/documentos/categorias" class="text-xs text-green-600 hover:text-green-800 font-semibold inline-flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                  Criar categoria
                </a>
              </div>
              <select
                id="categoryId"
                name="categoryId"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="">Sem categoria (documento genérico)</option>
                <% categories.forEach(cat => { %>
                  <option
                    value="<%= cat.id %>"
                    <%= documento && documento.category_id == cat.id ? 'selected' : '' %>
                  >
                    <%= cat.name %>
                  </option>
                <% }); %>
              </select>
              <p class="text-xs text-gray-500 mt-2">
                <strong>Sem categoria:</strong> Use para documentos que não se encaixam em categorias específicas. 
                Você pode criar categorias como "Contratos", "Atas", "Laudos", etc.
              </p>
            </div>

            <!-- Tipo -->
            <div>
              <label for="documentType" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Tipo de Documento
              </label>
              <select
                id="documentType"
                name="documentType"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="DOCUMENT" <%= !documento || documento.document_type === 'DOCUMENT' ? 'selected' : '' %>>Documento</option>
                <option value="CONTRACT" <%= documento && documento.document_type === 'CONTRACT' ? 'selected' : '' %>>Contrato</option>
                <option value="ATA" <%= documento && documento.document_type === 'ATA' ? 'selected' : '' %>>Ata</option>
                <option value="LAUDO" <%= documento && documento.document_type === 'LAUDO' ? 'selected' : '' %>>Laudo</option>
                <option value="OUTRO" <%= documento && documento.document_type === 'OUTRO' ? 'selected' : '' %>>Outro</option>
              </select>
            </div>

            <!-- Upload de PDF (apenas na criação) -->
            <% if (!documento) { %>
              <div class="md:col-span-2">
                <label for="contractFiles" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                  </svg>
                  Arquivo PDF (Contrato/Documento)
                </label>
                <input
                  type="file"
                  id="contractFiles"
                  name="contractFiles"
                  accept=".pdf,application/pdf"
                  multiple
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                />
                <p class="text-xs text-gray-500 mt-2">
                  <strong>Limite:</strong> 50MB por arquivo. Você pode enviar até 10 arquivos por vez.
                  <br>
                  <strong>Importante:</strong> Para contratos grandes, use este campo. Arquivos são salvos em <code class="bg-gray-100 px-1 rounded">uploads/contracts/</code>
                </p>
              </div>
            <% } else if (documento.file_path) { %>
              <!-- Mostra arquivo existente na edição -->
              <div class="md:col-span-2">
                <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Arquivo Atual
                </label>
                <div class="bg-gradient-to-r from-gray-50 to-gray-100 border-2 border-gray-200 rounded-xl p-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-bold text-gray-900"><%= documento.file_name || 'Arquivo PDF' %></p>
                      <p class="text-xs text-gray-500 mt-1">Caminho: <%= documento.file_path %></p>
                    </div>
                    <% 
                      const filePath = documento.file_path.includes('uploads/') 
                        ? documento.file_path.split('uploads/')[1] 
                        : documento.file_path.split('uploads\\')[1] || documento.file_path;
                    %>
                    <a href="/uploads/<%= filePath %>" target="_blank" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      Ver PDF
                    </a>
                  </div>
                </div>
                <p class="text-xs text-gray-500 mt-2">Para alterar o arquivo, delete e recrie o documento.</p>
              </div>
            <% } %>

            <!-- Data de Vencimento -->
            <div>
              <label for="expiryDate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Data de Vencimento
              </label>
              <input
                type="date"
                id="expiryDate"
                name="expiryDate"
                value="<%= documento && documento.expiry_date ? new Date(documento.expiry_date).toISOString().split('T')[0] : '' %>"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
              <p class="text-xs text-gray-500 mt-2">Deixe em branco se não houver vencimento</p>
            </div>

            <!-- Status (apenas na edição) -->
            <% if (documento) { %>
              <div>
                <label for="status" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Status
                </label>
                <select
                  id="status"
                  name="status"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="ACTIVE" <%= documento.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
                  <option value="EXPIRED" <%= documento.status === 'EXPIRED' ? 'selected' : '' %>>Vencido</option>
                  <option value="ARCHIVED" <%= documento.status === 'ARCHIVED' ? 'selected' : '' %>>Arquivado</option>
                </select>
              </div>
            <% } %>
          </div>

          <!-- Botões -->
          <div class="flex justify-end space-x-4 mt-8 pt-6 border-t border-gray-200">
            <a
              href="/administrativo/documentos"
              class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span>Cancelar</span>
            </a>
            <button
              type="submit"
              class="group relative overflow-hidden bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
            >
              <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
              <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="relative z-10"><%= documento ? 'Atualizar' : 'Criar' %></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
