<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Documentos</h1>
      <p class="text-gray-600 mt-2">Gerenciar documentos do condomínio</p>
    </div>
    <div class="flex gap-3">
      <a href="/administrativo/documentos/categorias" class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition">
        Gerenciar Categorias
      </a>
      <a href="/administrativo/documentos/novo" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition">
        Novo Documento
      </a>
    </div>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Documento criado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Documento atualizado com sucesso!
    </div>
  <% } %>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" class="flex flex-wrap gap-4">
      <div>
        <label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">Categoria</label>
        <select
          id="categoryId"
          name="categoryId"
          class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Todas</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= filters.categoryId == cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select
          id="status"
          name="status"
          class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
        >
          <option value="">Todos</option>
          <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
          <option value="EXPIRED" <%= filters.status === 'EXPIRED' ? 'selected' : '' %>>Vencido</option>
          <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Arquivado</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
          Filtrar
        </button>
      </div>
    </form>
  </div>

  <!-- Lista de documentos -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Categoria</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vencimento</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (documents.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhum documento encontrado.
            </td>
          </tr>
        <% } else { %>
          <% documents.forEach(doc => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= doc.title %></div>
                <% if (doc.description) { %>
                  <div class="text-sm text-gray-500"><%= doc.description.substring(0, 50) %><%= doc.description.length > 50 ? '...' : '' %></div>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500">
                  <% if (doc.category_name) { %>
                    <%= doc.category_name %>
                  <% } else { %>
                    <span class="text-gray-400 italic">Sem categoria</span>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                  <%= doc.document_type %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <%= doc.expiry_date ? new Date(doc.expiry_date).toLocaleDateString('pt-BR') : '-' %>
                  <% if (doc.expiry_date && new Date(doc.expiry_date) < new Date() && doc.status === 'ACTIVE') { %>
                    <span class="text-red-600 font-semibold ml-2">Vencido</span>
                  <% } else if (doc.expiry_date) { %>
                    <% const daysUntilExpiry = Math.floor((new Date(doc.expiry_date) - new Date()) / (1000 * 60 * 60 * 24)); %>
                    <% if (daysUntilExpiry <= 30 && daysUntilExpiry > 0) { %>
                      <span class="text-yellow-600 font-semibold ml-2">Vence em <%= daysUntilExpiry %> dias</span>
                    <% } %>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (doc.status === 'ACTIVE') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Ativo
                  </span>
                <% } else if (doc.status === 'EXPIRED') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Vencido
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    Arquivado
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <% if (doc.file_path) { %>
                  <% 
                    // Extrai o caminho relativo a partir de uploads/
                    const filePath = doc.file_path.includes('uploads/') 
                      ? doc.file_path.split('uploads/')[1] 
                      : doc.file_path.split('uploads\\')[1] || doc.file_path;
                  %>
                  <a href="/uploads/<%= filePath %>" target="_blank" class="text-blue-600 hover:text-blue-900 mr-3" title="Abrir PDF">
                    📄 Ver PDF
                  </a>
                <% } %>
                <a href="/administrativo/documentos/<%= doc.id %>/editar" class="text-green-600 hover:text-green-900">
                  Editar
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
