<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .table-row-animate {
    animation: slideIn 0.3s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .status-badge {
    animation: pulse 2s ease-in-out infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-green-50/30 to-emerald-50/30">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <div class="flex items-center space-x-3 mb-2">
            <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl p-3 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-green-900 to-gray-900 bg-clip-text text-transparent">
                Documentos
              </h1>
              <p class="text-gray-600 mt-1">Gerenciar documentos do condomínio</p>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/administrativo/documentos/categorias" class="group relative overflow-hidden bg-gradient-to-r from-gray-600 to-gray-700 text-white px-5 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center space-x-2">
            <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
            <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            <span class="relative z-10">Categorias</span>
          </a>
          <a href="/administrativo/documentos/novo" class="group relative overflow-hidden bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 flex items-center space-x-2">
            <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
            <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span class="relative z-10">Novo Documento</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Mensagens Modernas -->
    <% if (typeof query !== 'undefined' && query.success === 'created') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Documento criado com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Documento atualizado com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Estatísticas Rápidas -->
    <% 
      const totalDocs = documents ? documents.length : 0;
      const activeDocs = documents ? documents.filter(d => d.status === 'ACTIVE').length : 0;
      const expiredDocs = documents ? documents.filter(d => d.status === 'EXPIRED' || (d.expiry_date && new Date(d.expiry_date) < new Date() && d.status === 'ACTIVE')).length : 0;
      const expiringDocs = documents ? documents.filter(d => {
        if (!d.expiry_date || d.status !== 'ACTIVE') return false;
        const daysUntilExpiry = Math.floor((new Date(d.expiry_date) - new Date()) / (1000 * 60 * 60 * 24));
        return daysUntilExpiry <= 30 && daysUntilExpiry > 0;
      }).length : 0;
    %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-green-500 card-hover-effect">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-500 text-sm font-medium mb-1">Total</p>
            <p class="text-3xl font-bold text-gray-900"><%= totalDocs %></p>
          </div>
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-emerald-500 card-hover-effect">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-500 text-sm font-medium mb-1">Ativos</p>
            <p class="text-3xl font-bold text-emerald-600"><%= activeDocs %></p>
          </div>
          <div class="bg-emerald-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-yellow-500 card-hover-effect">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-500 text-sm font-medium mb-1">Vencendo (30d)</p>
            <p class="text-3xl font-bold text-yellow-600"><%= expiringDocs %></p>
          </div>
          <div class="bg-yellow-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-6 shadow-lg border-l-4 border-red-500 card-hover-effect">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-gray-500 text-sm font-medium mb-1">Vencidos</p>
            <p class="text-3xl font-bold text-red-600"><%= expiredDocs %></p>
          </div>
          <div class="bg-red-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Filtros Modernos -->
    <div class="bg-white rounded-xl shadow-lg p-4 mb-8 animate-slide-in">
      <form method="GET" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
          <label for="categoryId" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            Categoria
          </label>
          <select
            id="categoryId"
            name="categoryId"
            class="w-full px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 transition-all duration-200"
          >
            <option value="">Todas</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= filters.categoryId == cat.id ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="flex-1 min-w-[200px]">
          <label for="status" class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            Status
          </label>
          <select
            id="status"
            name="status"
            class="w-full px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 transition-all duration-200"
          >
            <option value="">Todos</option>
            <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
            <option value="EXPIRED" <%= filters.status === 'EXPIRED' ? 'selected' : '' %>>Vencido</option>
            <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Arquivado</option>
          </select>
        </div>
        <div>
          <button type="submit" class="bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-2.5 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105 flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            <span>Filtrar</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Lista de Documentos Moderna -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden animate-slide-in">
      <% if (!documents || documents.length === 0) { %>
        <div class="p-12 text-center">
          <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full mb-6">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Nenhum documento encontrado</h3>
          <p class="text-gray-500 mb-6">Comece adicionando seu primeiro documento ao sistema.</p>
          <a href="/administrativo/documentos/novo" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Adicionar Primeiro Documento
          </a>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Título</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Categoria</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Tipo</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Vencimento</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-right text-xs font-bold text-gray-700 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% documents.forEach((doc, index) => { %>
              <tr class="table-row-animate hover:bg-gradient-to-r hover:from-green-50/50 hover:to-emerald-50/50 transition-all duration-200 card-hover-effect" style="animation-delay: <%= index * 0.05 %>s">
                <td class="px-6 py-4">
                  <div class="text-sm font-bold text-gray-900"><%= doc.title %></div>
                  <% if (doc.description) { %>
                    <div class="text-sm text-gray-500 mt-1"><%= doc.description.substring(0, 50) %><%= doc.description.length > 50 ? '...' : '' %></div>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (doc.category_name) { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-green-100 to-emerald-100 text-green-800">
                      <%= doc.category_name %>
                    </span>
                  <% } else { %>
                    <span class="text-sm text-gray-400 italic">Sem categoria</span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-gray-400 to-gray-500 text-white shadow-md">
                    <%= doc.document_type %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col space-y-1">
                    <div class="text-sm text-gray-900">
                      <%= doc.expiry_date ? new Date(doc.expiry_date).toLocaleDateString('pt-BR') : '-' %>
                    </div>
                    <% if (doc.expiry_date && new Date(doc.expiry_date) < new Date() && doc.status === 'ACTIVE') { %>
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-red-500 to-rose-500 text-white shadow-md status-badge">
                        Vencido
                      </span>
                    <% } else if (doc.expiry_date) { %>
                      <% const daysUntilExpiry = Math.floor((new Date(doc.expiry_date) - new Date()) / (1000 * 60 * 60 * 24)); %>
                      <% if (daysUntilExpiry <= 30 && daysUntilExpiry > 0) { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-yellow-500 to-amber-500 text-white shadow-md">
                          Vence em <%= daysUntilExpiry %> dias
                        </span>
                      <% } %>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (doc.status === 'ACTIVE') { %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-green-500 to-emerald-500 text-white shadow-md">
                      <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                      Ativo
                    </span>
                  <% } else if (doc.status === 'EXPIRED') { %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-red-500 to-rose-500 text-white shadow-md status-badge">
                      <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                      Vencido
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-gray-400 to-gray-500 text-white shadow-md">
                      <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                      Arquivado
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-3">
                    <% if (doc.file_path) { %>
                      <% 
                        const filePath = doc.file_path.includes('uploads/') 
                          ? doc.file_path.split('uploads/')[1] 
                          : doc.file_path.split('uploads\\')[1] || doc.file_path;
                      %>
                      <a href="/uploads/<%= filePath %>" target="_blank" class="inline-flex items-center px-3 py-1.5 bg-gradient-to-r from-blue-500 to-cyan-500 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105" title="Abrir PDF">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        Ver PDF
                      </a>
                    <% } %>
                    <a href="/administrativo/documentos/<%= doc.id %>/editar" class="inline-flex items-center px-3 py-1.5 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      Editar
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
