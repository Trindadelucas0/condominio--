<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>
<%- include('../partials/notifications') %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Alertas SLA</h1>
      <p class="text-gray-600 mt-2">Tarefas e ocorrências com prazo de SLA vencido</p>
    </div>
  </div>

  <!-- Busca e Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" action="/administrativo/alertas" class="flex gap-4 items-end">
      <div class="flex-1">
        <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
        <input 
          type="text" 
          id="search" 
          name="search" 
          value="<%= filters.search || '' %>"
          placeholder="Buscar por título, descrição..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
        />
      </div>
      <div class="w-48">
        <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">Prioridade</label>
        <select 
          id="priority" 
          name="priority" 
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
        >
          <option value="">Todas</option>
          <option value="URGENTE" <%= filters.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
          <option value="ALTA" <%= filters.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
          <option value="NORMAL" <%= filters.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
          <option value="BAIXA" <%= filters.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
        </select>
      </div>
      <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
        🔍 Buscar
      </button>
      <a href="/administrativo/alertas" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
        Limpar
      </a>
    </form>
  </div>

  <!-- Lista de alertas -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (!alerts || alerts.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-lg font-medium">Nenhum alerta SLA encontrado</p>
        <p class="text-sm mt-2">Todas as tarefas e ocorrências estão dentro do prazo de SLA.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% alerts.forEach(alert => { %>
          <div class="p-6 hover:bg-gray-50 transition-colors">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <% if (alert.entity_type === 'TASK') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                      TAREFA
                    </span>
                  <% } else { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-orange-100 text-orange-800">
                      OCORRÊNCIA
                    </span>
                  <% } %>
                  <% if (alert.priority === 'URGENTE') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-red-100 text-red-800">
                      URGENTE
                    </span>
                  <% } else if (alert.priority === 'ALTA') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-orange-100 text-orange-800">
                      ALTA
                    </span>
                  <% } else if (alert.priority === 'NORMAL') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800">
                      NORMAL
                    </span>
                  <% } else { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                      BAIXA
                    </span>
                  <% } %>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-red-100 text-red-800">
                    SLA VENCIDO
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= alert.title %></h3>
                <% if (alert.description) { %>
                  <p class="text-gray-700 mb-2"><%= alert.description.length > 150 ? alert.description.substring(0, 150) + '...' : alert.description %></p>
                <% } %>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 mt-3">
                  <div>
                    <span class="font-medium">Prazo SLA:</span>
                    <span class="text-red-600 font-semibold">
                      <%= new Date(alert.sla_due_date).toLocaleDateString('pt-BR') %>
                    </span>
                  </div>
                  <% if (alert.assigned_to_name) { %>
                    <div>
                      <span class="font-medium">Responsável:</span>
                      <span><%= alert.assigned_to_name %></span>
                    </div>
                  <% } %>
                  <div>
                    <span class="font-medium">Status:</span>
                    <span><%= alert.status %></span>
                  </div>
                </div>
                <p class="text-xs text-gray-500 mt-2">
                  Criado em <%= new Date(alert.created_at).toLocaleString('pt-BR') %>
                </p>
              </div>
              <div class="ml-4 flex flex-col gap-2">
                <% if (alert.entity_type === 'TASK') { %>
                  <a href="/administrativo/tarefas" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition text-center text-sm">
                    Ver Tarefa
                  </a>
                <% } else { %>
                  <a href="/administrativo/ocorrencias/<%= alert.id %>/triar" class="bg-orange-600 text-white px-4 py-2 rounded hover:bg-orange-700 transition text-center text-sm">
                    Ver Ocorrência
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Paginação -->
  <% if (pagination && pagination.totalPages > 1) { %>
    <div class="bg-white rounded-lg shadow p-4 mt-6">
      <div class="flex items-center justify-between">
        <div class="text-sm text-gray-600">
          Mostrando <strong><%= ((pagination.currentPage - 1) * pagination.perPage) + 1 %></strong> até 
          <strong><%= Math.min(pagination.currentPage * pagination.perPage, pagination.totalRecords) %></strong> 
          de <strong><%= pagination.totalRecords %></strong> alertas
        </div>
        <div class="flex items-center space-x-2">
          <% 
            const queryParams = new URLSearchParams();
            if (filters.search) queryParams.set('search', filters.search);
            if (filters.priority) queryParams.set('priority', filters.priority);
            const queryString = queryParams.toString();
          %>
          <% if (pagination.currentPage > 1) { %>
            <a href="/administrativo/alertas?page=<%= pagination.currentPage - 1 %><%= queryString ? '&' + queryString : '' %>" 
               class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
              ← Anterior
            </a>
          <% } %>
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="/administrativo/alertas?page=<%= pagination.currentPage + 1 %><%= queryString ? '&' + queryString : '' %>" 
               class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50">
              Próxima →
            </a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
