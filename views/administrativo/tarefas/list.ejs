<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Tarefas</h1>
      <p class="text-gray-600 mt-2">Tarefas criadas para a equipe operacional</p>
    </div>
    <a href="/administrativo/tarefas/nova" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
      Nova Tarefa
    </a>
  </div>

  <!-- Mensagem de sucesso -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Tarefa criada com sucesso!
    </div>
  <% } %>

  <!-- Lista de tarefas -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Responsável</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vencimento</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Prioridade</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criada em</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (tasks.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhuma tarefa criada ainda.
            </td>
          </tr>
        <% } else { %>
          <% tasks.forEach(task => { %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= task.title %></div>
                <% if (task.description) { %>
                  <div class="text-sm text-gray-500"><%= task.description.substring(0, 50) %><%= task.description.length > 50 ? '...' : '' %></div>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= task.assigned_to_name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <%= new Date(task.due_date).toLocaleDateString('pt-BR') %>
                  <% if (new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                    <span class="text-red-600 font-semibold ml-2">Atrasado</span>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                  <%= task.priority %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (task.status === 'COMPLETED') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Concluída
                  </span>
                <% } else if (task.status === 'IN_PROGRESS') { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    Em Andamento
                  </span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    Pendente
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= new Date(task.created_at).toLocaleDateString('pt-BR') %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
