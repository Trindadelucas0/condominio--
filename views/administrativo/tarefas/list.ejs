<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <div>
      <h1 class="page-title">Tarefas</h1>
      <p class="page-subtitle">Tarefas criadas para a equipe operacional</p>
    </div>
    <a href="/administrativo/tarefas/nova" class="btn-primary w-full sm:w-auto text-center">
      Nova Tarefa
    </a>
  </div>

  <!-- Mensagem de sucesso -->
  <% if (typeof query !== 'undefined' && query.success === 'created') { %>
    <div class="alert-success">
      Tarefa criada com sucesso!
    </div>
  <% } %>

  <!-- Lista de tarefas -->
  <div class="card overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="table-header">Título</th>
          <th class="table-header">Responsável</th>
          <th class="table-header">Vencimento</th>
          <th class="table-header">Prioridade</th>
          <th class="table-header">Status</th>
          <th class="table-header">Criada em</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (tasks.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-4 text-center text-gray-500">
              Nenhuma tarefa criada ainda.
            </td>
          </tr>
        <% } else { %>
          <% tasks.forEach(task => { %>
            <tr class="table-row">
              <td class="table-cell">
                <div class="text-sm font-medium text-gray-900"><%= task.title %></div>
                <% if (task.description) { %>
                  <div class="text-sm text-gray-500"><%= task.description.substring(0, 50) %><%= task.description.length > 50 ? '...' : '' %></div>
                <% } %>
              </td>
              <td class="table-cell">
                <div class="text-sm text-gray-900"><%= task.assigned_to_name %></div>
              </td>
              <td class="table-cell">
                <div class="text-sm text-gray-900">
                  <%= new Date(task.due_date).toLocaleDateString('pt-BR') %>
                  <% if (new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                    <span class="badge-danger ml-2">Atrasado</span>
                  <% } %>
                </div>
              </td>
              <td class="table-cell">
                <span class="badge-primary">
                  <%= task.priority %>
                </span>
              </td>
              <td class="table-cell">
                <% if (task.status === 'COMPLETED') { %>
                  <span class="badge-success">
                    Concluída
                  </span>
                <% } else if (task.status === 'IN_PROGRESS') { %>
                  <span class="badge-info">
                    Em Andamento
                  </span>
                <% } else { %>
                  <span class="badge-warning">
                    Pendente
                  </span>
                <% } %>
              </td>
              <td class="table-cell text-gray-500">
                <%= new Date(task.created_at).toLocaleDateString('pt-BR') %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
      </div>
    </div>
  </div>
</div>
</main>

<%- include('../../partials/footer') %>
