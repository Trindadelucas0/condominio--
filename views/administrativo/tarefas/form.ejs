<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Nova Tarefa</h1>
    <p class="text-gray-600 mt-2">Criar tarefa para a equipe operacional</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-3xl">
    <form method="POST" action="/administrativo/tarefas">
      <!-- Título -->
      <div class="mb-4">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Título <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          value="<%= tarefa ? tarefa.title : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Ex: Manutenção do elevador A"
        />
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição
        </label>
        <textarea
          id="description"
          name="description"
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Descreva a tarefa em detalhes..."
        ><%= tarefa ? tarefa.description : '' %></textarea>
      </div>

      <!-- Responsável -->
      <div class="mb-4">
        <label for="assignedTo" class="block text-sm font-medium text-gray-700 mb-1">
          Responsável (Operacional) <span class="text-red-500">*</span>
        </label>
        <select
          id="assignedTo"
          name="assignedTo"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Selecione um responsável</option>
          <% operacionais.forEach(op => { %>
            <option
              value="<%= op.id %>"
              <%= tarefa && tarefa.assignedTo == op.id ? 'selected' : '' %>
            >
              <%= op.full_name %> (<%= op.username %>)
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Data de Vencimento -->
      <div class="mb-4">
        <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-1">
          Data de Vencimento <span class="text-red-500">*</span>
        </label>
        <input
          type="date"
          id="dueDate"
          name="dueDate"
          required
          value="<%= tarefa ? tarefa.dueDate : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <!-- Prioridade -->
      <div class="mb-4">
        <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">
          Prioridade
        </label>
        <select
          id="priority"
          name="priority"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="BAIXA" <%= tarefa && tarefa.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
          <option value="NORMAL" <%= !tarefa || tarefa.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
          <option value="ALTA" <%= tarefa && tarefa.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
          <option value="URGENTE" <%= tarefa && tarefa.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
        </select>
      </div>

      <!-- Tipo -->
      <div class="mb-4">
        <label for="taskType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de Tarefa
        </label>
        <select
          id="taskType"
          name="taskType"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="CHECKLIST" <%= !tarefa || tarefa.taskType === 'CHECKLIST' ? 'selected' : '' %>>Checklist</option>
          <option value="MANUTENCAO" <%= tarefa && tarefa.taskType === 'MANUTENCAO' ? 'selected' : '' %>>Manutenção</option>
          <option value="OUTRA" <%= tarefa && tarefa.taskType === 'OUTRA' ? 'selected' : '' %>>Outra</option>
        </select>
      </div>

      <!-- Itens de Checklist -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Itens de Checklist (opcional)
        </label>
        <div id="checklistItems" class="space-y-2">
          <div class="flex space-x-2">
            <input
              type="text"
              name="checklistItems[]"
              placeholder="Item do checklist"
              class="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <button
              type="button"
              onclick="removeChecklistItem(this)"
              class="bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700"
            >
              Remover
            </button>
          </div>
        </div>
        <button
          type="button"
          onclick="addChecklistItem()"
          class="mt-2 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700"
        >
          + Adicionar Item
        </button>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/administrativo/tarefas"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
        >
          Criar Tarefa
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function addChecklistItem() {
  const container = document.getElementById('checklistItems');
  const div = document.createElement('div');
  div.className = 'flex space-x-2';
  div.innerHTML = `
    <input
      type="text"
      name="checklistItems[]"
      placeholder="Item do checklist"
      class="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <button
      type="button"
      onclick="removeChecklistItem(this)"
      class="bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700"
    >
      Remover
    </button>
  `;
  container.appendChild(div);
}

function removeChecklistItem(button) {
  button.parentElement.remove();
}
</script>

<%- include('../../partials/footer') %>
