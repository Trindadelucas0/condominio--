<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus {
    transition: all 0.2s ease;
  }
  
  .input-focus:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex items-center space-x-3 mb-2">
        <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
            Nova Tarefa
          </h1>
          <p class="text-gray-600 mt-1">Criar tarefa para a equipe operacional</p>
        </div>
      </div>
    </div>

    <!-- Mensagem de Erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-red-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-red-800">Erro</p>
            <p class="text-sm text-red-600"><%= error %></p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Formulário Moderno -->
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="/administrativo/tarefas">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Título -->
            <div class="md:col-span-2">
              <label for="title" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Título <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                required
                value="<%= tarefa ? tarefa.title : '' %>"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                placeholder="Ex: Manutenção do elevador A"
              />
            </div>

            <!-- Descrição -->
            <div class="md:col-span-2">
              <label for="description" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
                Descrição
              </label>
              <textarea
                id="description"
                name="description"
                rows="4"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 resize-none"
                placeholder="Descreva a tarefa em detalhes..."
              ><%= tarefa ? tarefa.description : '' %></textarea>
            </div>

            <!-- Responsável -->
            <div>
              <label for="assignedTo" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Responsável (Operacional) <span class="text-red-500 ml-1">*</span>
              </label>
              <select
                id="assignedTo"
                name="assignedTo"
                required
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="">Selecione um responsável</option>
                <% operacionais.forEach(op => { %>
                  <option
                    value="<%= op.id %>"
                    <%= tarefa && tarefa.assignedTo == op.id ? 'selected' : '' %>
                  >
                    <%= op.full_name %> (<%= op.username %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <!-- Data de Vencimento -->
            <div>
              <label for="dueDate" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Data de Vencimento <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="date"
                id="dueDate"
                name="dueDate"
                required
                value="<%= tarefa ? tarefa.dueDate : '' %>"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Prioridade -->
            <div>
              <label for="priority" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Prioridade
              </label>
              <select
                id="priority"
                name="priority"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="BAIXA" <%= tarefa && tarefa.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
                <option value="NORMAL" <%= !tarefa || tarefa.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
                <option value="ALTA" <%= tarefa && tarefa.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
                <option value="URGENTE" <%= tarefa && tarefa.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
              </select>
            </div>

            <!-- Tipo -->
            <div>
              <label for="taskType" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Tipo de Tarefa
              </label>
              <select
                id="taskType"
                name="taskType"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              >
                <option value="CHECKLIST" <%= !tarefa || tarefa.taskType === 'CHECKLIST' ? 'selected' : '' %>>Checklist</option>
                <option value="MANUTENCAO" <%= tarefa && tarefa.taskType === 'MANUTENCAO' ? 'selected' : '' %>>Manutenção</option>
                <option value="OUTRA" <%= tarefa && tarefa.taskType === 'OUTRA' ? 'selected' : '' %>>Outra</option>
              </select>
            </div>
          </div>

      <!-- Itens de Checklist -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Itens de Checklist (opcional)
        </label>
        <div id="checklistItems" class="space-y-2">
          <div class="flex space-x-2">
            <input
              type="text"
              name="checklistItems[]"
              placeholder="Item do checklist"
              class="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <button
              type="button"
              onclick="removeChecklistItem(this)"
              class="bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700"
            >
              Remover
            </button>
          </div>
        </div>
        <button
          type="button"
          onclick="addChecklistItem()"
          class="mt-2 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700"
        >
          + Adicionar Item
        </button>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/administrativo/tarefas"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
        >
          Criar Tarefa
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function addChecklistItem() {
  const container = document.getElementById('checklistItems');
  const div = document.createElement('div');
  div.className = 'flex space-x-3';
  div.innerHTML = `
    <input
      type="text"
      name="checklistItems[]"
      placeholder="Item do checklist"
      class="input-focus flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
    />
    <button
      type="button"
      onclick="removeChecklistItem(this)"
      class="bg-gradient-to-r from-red-500 to-rose-500 text-white px-5 py-3 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105"
    >
      Remover
    </button>
  `;
  container.appendChild(div);
}

function removeChecklistItem(button) {
  button.parentElement.remove();
}
</script>

<%- include('../../partials/footer') %>
