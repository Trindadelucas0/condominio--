<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <a href="/administrativo/tarefas" class="text-indigo-600 hover:text-indigo-800 mb-2 inline-block">← Voltar para tarefas</a>
    <h1 class="text-3xl font-bold text-gray-800">Reabrir Tarefa</h1>
    <p class="text-gray-600 mt-2">Informe o motivo para reabrir esta tarefa cancelada. Ela voltará ao status &quot;Pendente&quot;.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <div class="bg-white rounded-xl shadow-lg p-6 max-w-2xl">
    <div class="mb-6 p-4 bg-gray-50 rounded-lg">
      <p class="text-sm text-gray-600">Tarefa</p>
      <p class="font-semibold text-gray-900"><%= task.title %></p>
      <% if (task.assigned_to_name) { %>
        <p class="text-sm text-gray-500 mt-1">Responsável: <%= task.assigned_to_name %></p>
      <% } %>
    </div>

    <form method="POST" action="/administrativo/tarefas/<%= task.id %>/reabrir">
      <div class="mb-6">
        <label for="reason" class="block text-sm font-medium text-gray-700 mb-2">
          Motivo da reabertura <span class="text-red-500">*</span>
        </label>
        <textarea
          id="reason"
          name="reason"
          required
          rows="4"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
          placeholder="Explique por que esta tarefa deve ser reaberta..."
        ></textarea>
      </div>

      <div class="flex gap-4">
        <a href="/administrativo/tarefas" class="px-6 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
          Cancelar
        </a>
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-medium">
          Reabrir Tarefa
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
