<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Nova Assembleia</h1>
    <p class="text-gray-600">Agende uma nova assembleia</p>
  </div>

  <% if (typeof req.query.error !== 'undefined') { %>
    <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow-lg p-6 max-w-3xl">
    <form method="POST" action="/assembleias">
      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="date" class="block text-sm font-medium text-gray-700 mb-2">
              Data <span class="text-red-500">*</span>
            </label>
            <input
              type="date"
              id="date"
              name="date"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label for="time" class="block text-sm font-medium text-gray-700 mb-2">
              Horário
            </label>
            <input
              type="time"
              id="time"
              name="time"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-gray-700 mb-2">
            Tipo <span class="text-red-500">*</span>
          </label>
          <select
            id="type"
            name="type"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="ORDINARIA">Ordinária</option>
            <option value="EXTRAORDINARIA">Extraordinária</option>
            <option value="ESPECIAL">Especial</option>
          </select>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700 mb-2">
            Local
          </label>
          <input
            type="text"
            id="location"
            name="location"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: Salão de Festas"
          />
        </div>

        <div>
          <label for="quorum" class="block text-sm font-medium text-gray-700 mb-2">
            Quórum Necessário
          </label>
          <input
            type="number"
            id="quorum"
            name="quorum"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Número de apartamentos necessários"
          />
        </div>

        <div>
          <label for="agenda" class="block text-sm font-medium text-gray-700 mb-2">
            Pauta <span class="text-red-500">*</span>
          </label>
          <textarea
            id="agenda"
            name="agenda"
            required
            rows="6"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva os assuntos que serão tratados na assembleia..."
          ></textarea>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Criar Assembleia
          </button>
          <a href="/assembleias" class="px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
