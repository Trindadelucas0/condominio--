<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Como funcionam as Assembleias'; %>
  <% var resumo = ['Cadastre assembleias (ordinária, extraordinária, especial) com data, local e pauta.', 'Acompanhe status e quórum. Após realizar, marque como finalizada.', 'Use para convocações e atas; o histórico fica registrado.', 'Quórum e deliberações podem ser registrados no detalhe da assembleia.']; %>
  <% var helpModalContent = '<p><strong>Assembleias</strong> são as reuniões de condôminos. Cadastre data, tipo, local e pauta. Acompanhe status e quórum. Após realizar, marque como finalizada. O histórico fica registrado.</p>'; %>
  <div class="mb-6">
    <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold text-gray-800">Assembleias</h1>
        <%- include('../../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
      <a href="/assembleias/novo" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        + Nova Assembleia
      </a>
    </div>
    <p class="text-gray-600">Gerencie assembleias do condomínio</p>
  </div>
  <%- include('../../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <% if (typeof req.query.success !== 'undefined') { %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      Assembleia criada com sucesso!
    </div>
  <% } %>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Local</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quórum</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (assemblies && assemblies.length > 0) { %>
          <% assemblies.forEach(function(assembly) { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= new Date(assembly.date).toLocaleDateString('pt-BR') %><%= assembly.time ? ' às ' + assembly.time : '' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assembly.type === 'ORDINARIA' ? 'Ordinária' : assembly.type === 'EXTRAORDINARIA' ? 'Extraordinária' : 'Especial' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assembly.location || '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (assembly.status === 'COMPLETED') { %>
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Finalizada</span>
                <% } else if (assembly.status === 'IN_PROGRESS') { %>
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Em Andamento</span>
                <% } else { %>
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Agendada</span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if (assembly.quorum_achieved) { %>
                  <span class="text-green-600 font-semibold">✓ Atingido</span>
                <% } else if (assembly.quorum) { %>
                  <span class="text-yellow-600">Necessário: <%= assembly.quorum %></span>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <a href="/assembleias/<%= assembly.id %>" class="text-blue-600 hover:text-blue-800 font-semibold">
                  Ver Detalhes
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
              Nenhuma assembleia cadastrada ainda.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
