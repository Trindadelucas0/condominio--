                    if (roles.includes('CONSELHO')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Conselho</div>
                        <a href="/conselho/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
