</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle menu mobile
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (toggleButton && mobileMenu) {
      toggleButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const isHidden = mobileMenu.classList.contains('hidden');
        
        if (isHidden) {
          mobileMenu.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
        }
        
        // Animar o ícone do botão (hamburger para X)
        const icon = toggleButton.querySelector('#menu-icon');
        const path = icon?.querySelector('path');
        if (path) {
          if (isHidden) {
            path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
            path.setAttribute('stroke-linecap', 'round');
            path.setAttribute('stroke-linejoin', 'round');
          } else {
            path.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
          }
        }
      });
      
      // Fechar menu ao clicar fora
      document.addEventListener('click', function(e) {
        if (!toggleButton.contains(e.target) && !mobileMenu.contains(e.target)) {
          mobileMenu.classList.add('hidden');
          const icon = toggleButton.querySelector('#menu-icon');
          const path = icon?.querySelector('path');
          if (path) {
            path.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
          }
        }
      });
    }
    
    // Atualizar badge de notificações
    <% if (typeof user !== 'undefined' && user !== null && user.id) { %>
    fetch('/notifications/unread-count')
      .then(response => response.json())
      .then(data => {
        const badge = document.getElementById('notification-badge');
        const badgeMobile = document.getElementById('notification-badge-mobile');
        
        if (badge && data.count > 0) {
          badge.textContent = data.count > 99 ? '99+' : data.count;
          badge.classList.remove('hidden');
        }
        
        if (badgeMobile && data.count > 0) {
          badgeMobile.textContent = data.count > 99 ? '99+' : data.count;
          badgeMobile.classList.remove('hidden');
        }
      })
      .catch(err => console.error('Erro ao buscar notificações:', err));
    <% } %>

    // Destacar link ativo baseado na URL atual
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('#nav-menu a[href], #mobile-menu a[href]');
    
    navLinks.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        link.classList.add('nav-link-active');
      }
    });
  });
</script>
