                    <div class="flex items-center space-x-3 border-l border-primary-400/50 pl-4 ml-4">
                        <div class="hidden xl:flex items-center space-x-2">
                            <div class="w-8 h-8 bg-primary-500 rounded-full flex items-center justify-center text-sm font-bold">
                                <%= (user.fullName || user.full_name || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <span class="text-sm font-medium">
                                <%= user.fullName || user.full_name || 'Usuário' %>
                            </span>
                        </div>
                        <form method="POST" action="/auth/logout" class="inline">
                            <button type="submit" class="bg-primary-700 hover:bg-primary-800 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-300 shadow-md hover:shadow-lg">
                                Sair
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>

            <!-- Menu Mobile Toggle -->
            <button id="mobile-menu-toggle" type="button" class="lg:hidden p-2 rounded-lg hover:bg-primary-700/50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-300 menu-button">
                <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
        
        <!-- Menu Mobile -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-primary-500/30 mt-2 pt-4 animate-slide-down">
            <div class="flex flex-col space-y-1">
                <% 
                if (typeof user !== 'undefined' && user !== null && user.roles && Array.isArray(user.roles)) {
                    const roles = user.roles;
                    
                    if (roles.includes('SUPER_MASTER')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider">Master</div>
                        <a href="/master/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/master/condominios" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Condomínios</a>
