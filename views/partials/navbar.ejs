                    <% }
                    
                    if (roles.includes('SINDICO') || roles.includes('SUBSINDICO')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Síndico</div>
                        <a href="/sindico/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/sindico/tarefas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Tarefas</a>
                        <a href="/sindico/ocorrencias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ocorrências</a>
                        <a href="/sindico/aprovacoes" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Aprovações</a>
                        <a href="/sindico/manutencoes" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Manutenções</a>
                        <a href="/sindico/checklist-modelos" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Modelos Checklist</a>
                        <a href="/sindico/checklists-acompanhamento" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Acompanhar Checklists</a>
                        <a href="/sindico/alertas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Alertas</a>
                        <a href="/sindico/logs" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Logs</a>
                        <a href="/assembleias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Assembleias</a>
                    <% }
                    
                    if (roles.includes('FINANCEIRO')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Financeiro</div>
                        <a href="/financeiro/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/financeiro/entradas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Entradas</a>
                        <a href="/financeiro/saidas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Saídas</a>
                        <a href="/financeiro/apartamentos" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Apartamentos</a>
                        <a href="/financeiro/taxas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Taxas</a>
                        <a href="/financeiro/fechamento-mensal" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Fechamento Mensal</a>
                        <a href="/financeiro/relatorios" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Relatórios</a>
                        <a href="/financeiro/fundo-reserva" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Fundo de Reserva</a>
                        <a href="/financeiro/contas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Contas</a>
                        <a href="/financeiro/orcamentos-pendentes" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Orçamentos</a>
                        <a href="/financeiro/centros-custo" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Centros de Custo</a>
                    <% }
                    
                    if (roles.includes('PATRIMONIO')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Patrimônio</div>
                        <a href="/patrimonio/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/patrimonio/ativos" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ativos</a>
                    <% }
                    
                    if (roles.includes('ADMINISTRATIVO')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Administrativo</div>
                        <a href="/administrativo/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/administrativo/tarefas" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Tarefas</a>
                        <a href="/administrativo/ocorrencias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ocorrências</a>
                        <a href="/administrativo/documentos" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Documentos</a>
                        <a href="/assembleias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Assembleias</a>
                    <% }
                    
                    if (roles.includes('OPERACIONAL')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Operacional</div>
                        <a href="/operacional/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/operacional/checklists-diarios" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Checklists do Dia</a>
                        <a href="/operacional/checklist" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Tarefas</a>
                        <a href="/operacional/ocorrencias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ocorrências</a>
                        <a href="/operacional/manutencoes" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Manutenções</a>
                    <% }
                    
                    if (roles.includes('LIMPEZA') && !roles.includes('OPERACIONAL')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Limpeza</div>
                        <a href="/limpeza/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/operacional/checklists-diarios" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Checklists do Dia</a>
                        <a href="/operacional/checklist" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Tarefas</a>
                        <a href="/limpeza/ocorrencias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ocorrências</a>
                    <% } else if (roles.includes('LIMPEZA') && roles.includes('OPERACIONAL')) { %>
                        <div class="px-3 py-2 text-xs font-semibold text-primary-200 uppercase tracking-wider mt-2">Limpeza</div>
                        <a href="/limpeza/dashboard" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Dashboard</a>
                        <a href="/limpeza/ocorrencias" class="block px-4 py-2.5 rounded-lg hover:bg-primary-700/50 transition-all duration-200 text-sm font-medium">Ocorrências (Limpeza)</a>
