                            { href: '/limpeza/dashboard', label: 'Limpeza - Dashboard', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
                            { href: '/limpeza/ocorrencias', label: 'Ocorrências (Limpeza)', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' }
                        ]});
                        totalLinks += 2;
                    }
                    
                    if (roles.includes('CONSELHO')) {
                        menuItems.push({ type: 'conselho', items: [
                            { href: '/conselho/dashboard', label: 'Dashboard', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' }
                        ]});
                        totalLinks += 1;
                    }

                    // Se tiver mais de 5 links, usar dropdown, senão mostrar inline
                    const useDropdown = totalLinks > 5;
                    
                    if (useDropdown) {
                        // Renderizar com dropdowns organizados por módulo
                        menuItems.forEach((module, idx) => {
                            const moduleNames = {
                                'master': 'Master',
                                'sindico': 'Síndico',
                                'financeiro': 'Financeiro',
                                'patrimonio': 'Patrimônio',
                                'administrativo': 'Administrativo',
                                'operacional': 'Operacional',
                                'limpeza': 'Limpeza',
                                'conselho': 'Conselho'
                            };
                            
                            const moduleName = moduleNames[module.type] || module.type;
                            const mainLink = module.items[0]; // Primeiro item é o dashboard
                            const itemCount = module.items.length;
                            // Se tiver mais de 6 itens, usar múltiplas colunas
                            const useMultiColumn = itemCount > 6;
                            const columnsCount = useMultiColumn ? Math.ceil(itemCount / Math.ceil(itemCount / 3)) : 1;
                %>
                            <div class="nav-dropdown">
                                <a href="<%= mainLink.href %>" class="hover:bg-primary-700/50 px-4 py-2.5 rounded-lg transition-all duration-200 font-medium flex items-center space-x-2 group">
                                    <span><%= moduleName %></span>
                                    <svg class="w-4 h-4 transform group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </a>
                                <div class="nav-dropdown-menu <%= useMultiColumn ? 'multi-column' : '' %>">
                                    <div class="nav-dropdown-header"><%= moduleName %></div>
                                    <div class="nav-dropdown-items-container">
                                        <% if (useMultiColumn) { 
                                            // Dividir itens em 3 colunas de forma equilibrada
                                            const itemsPerColumn = Math.ceil(itemCount / 3);
                                            const columns = [];
                                            for (let i = 0; i < itemCount; i++) {
                                                const colIndex = Math.floor(i / itemsPerColumn);
                                                if (!columns[colIndex]) columns[colIndex] = [];
                                                columns[colIndex].push(module.items[i]);
                                            }
                                            
                                            // Garantir que temos no máximo 3 colunas
                                            while (columns.length > 3) {
                                                const lastCol = columns.pop();
                                                columns[columns.length - 1].push(...lastCol);
                                            }
                                            
                                            columns.forEach((columnItems) => { %>
                                                <div class="nav-dropdown-column">
                                                    <% columnItems.forEach((item) => { %>
                                                        <a href="<%= item.href %>" class="nav-dropdown-item flex items-center space-x-2">
                                                            <svg class="w-4 h-4 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item.icon %>"></path>
                                                            </svg>
                                                            <span><%= item.label %></span>
                                                        </a>
                                                    <% }); %>
                                                </div>
                                            <% });
                                        } else { 
                                            // Renderizar em coluna única
                                            module.items.forEach((item) => { %>
                                                <a href="<%= item.href %>" class="nav-dropdown-item flex items-center space-x-2">
                                                    <svg class="w-4 h-4 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item.icon %>"></path>
                                                    </svg>
                                                    <span><%= item.label %></span>
                                                </a>
                                            <% }); 
                                        } %>
                                    </div>
                                </div>
                            </div>
                <%      });
                    } else {
                        // Renderizar links inline quando há poucos itens
                        menuItems.forEach((module) => {
                            module.items.forEach((item) => { %>
                                <a href="<%= item.href %>" class="hover:bg-primary-700/50 px-4 py-2.5 rounded-lg transition-all duration-200 font-medium">
                                    <%= item.label %>
                                </a>
                    <%      });
                        });
                    }
                }
                %>

                <!-- Notificações -->
                <% if (typeof user !== 'undefined' && user !== null && user.id) { %>
                    <div class="relative ml-2">
                        <a href="/notifications" class="hover:bg-primary-700/50 px-3 py-2.5 rounded-lg relative transition-all duration-200 flex items-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                            </svg>
                            <span id="notification-badge" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center hidden font-semibold notification-badge">0</span>
                        </a>
                    </div>
                <% } %>

                <!-- Informações do usuário e logout -->
