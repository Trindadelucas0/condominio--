<!-- Navbar principal do sistema -->
<!-- NAVBAR DINÂMICA: Exibe menus automaticamente baseado nas roles do usuário -->
<!-- Quando uma role é adicionada ao usuário, os menus aparecem automaticamente -->
<!-- Usa req.user.roles (array) que vem do middleware de autenticação -->

<nav class="bg-blue-600 text-white shadow-lg">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center py-4">
            <!-- Logo/Título -->
            <div class="flex items-center">
                <a href="/" class="text-xl font-bold">Gestão Condominial</a>
            </div>

            <!-- Menu de navegação DINÂMICO (baseado em roles) -->
            <div class="flex items-center space-x-4">
                <% 
                // Verifica se user existe e tem roles
                if (typeof user !== 'undefined' && user.roles && Array.isArray(user.roles)) {
                    const roles = user.roles;
                    
                    // SUPER_MASTER
                    if (roles.includes('SUPER_MASTER')) { %>
                        <a href="/master/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Master - Dashboard</a>
                        <a href="/master/condominios" class="hover:text-blue-200 px-3 py-2 rounded">Condomínios</a>
                        <a href="/master/usuarios" class="hover:text-blue-200 px-3 py-2 rounded">Usuários</a>
                    <% }
                    
                    // SINDICO / SUBSINDICO
                    if (roles.includes('SINDICO') || roles.includes('SUBSINDICO')) { %>
                        <a href="/sindico/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Síndico - Dashboard</a>
                        <a href="/sindico/tarefas" class="hover:text-blue-200 px-3 py-2 rounded">Tarefas</a>
                        <a href="/sindico/ocorrencias" class="hover:text-blue-200 px-3 py-2 rounded">Ocorrências</a>
                        <a href="/sindico/aprovacoes" class="hover:text-blue-200 px-3 py-2 rounded">Aprovações</a>
                        <a href="/sindico/manutencoes" class="hover:text-blue-200 px-3 py-2 rounded">Manutenções</a>
                        <a href="/sindico/alertas" class="hover:text-blue-200 px-3 py-2 rounded">Alertas</a>
                        <a href="/sindico/logs" class="hover:text-blue-200 px-3 py-2 rounded">Logs</a>
                    <% }
                    
                    // FINANCEIRO (módulo separado)
                    if (roles.includes('FINANCEIRO')) { %>
                        <a href="/financeiro/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Financeiro - Dashboard</a>
                        <a href="/financeiro/entradas" class="hover:text-blue-200 px-3 py-2 rounded">Entradas</a>
                        <a href="/financeiro/saidas" class="hover:text-blue-200 px-3 py-2 rounded">Saídas</a>
                        <a href="/financeiro/contas" class="hover:text-blue-200 px-3 py-2 rounded">Contas</a>
                        <a href="/financeiro/orcamentos-pendentes" class="hover:text-blue-200 px-3 py-2 rounded">Orçamentos</a>
                        <a href="/financeiro/centros-custo" class="hover:text-blue-200 px-3 py-2 rounded">Centros de Custo</a>
                    <% }
                    
                    // PATRIMONIO (módulo separado)
                    if (roles.includes('PATRIMONIO')) { %>
                        <a href="/patrimonio/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Patrimônio - Dashboard</a>
                        <a href="/patrimonio/ativos" class="hover:text-blue-200 px-3 py-2 rounded">Ativos</a>
                    <% }
                    
                    // ADMINISTRATIVO (NÃO tem mais acesso a financeiro/patrimonio)
                    if (roles.includes('ADMINISTRATIVO')) { %>
                        <a href="/administrativo/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Admin - Dashboard</a>
                        <a href="/administrativo/tarefas" class="hover:text-blue-200 px-3 py-2 rounded">Tarefas</a>
                        <a href="/administrativo/documentos" class="hover:text-blue-200 px-3 py-2 rounded">Documentos</a>
                    <% }
                    
                    // OPERACIONAL
                    if (roles.includes('OPERACIONAL')) { %>
                        <a href="/operacional/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Operacional - Dashboard</a>
                        <a href="/operacional/checklist" class="hover:text-blue-200 px-3 py-2 rounded">Checklist</a>
                        <a href="/operacional/ocorrencias" class="hover:text-blue-200 px-3 py-2 rounded">Ocorrências</a>
                        <a href="/operacional/manutencoes" class="hover:text-blue-200 px-3 py-2 rounded">Manutenções</a>
                    <% }
                    
                    // LIMPEZA (tem suas próprias rotas de ocorrências)
                    if (roles.includes('LIMPEZA') && !roles.includes('OPERACIONAL')) { %>
                        <a href="/limpeza/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Limpeza - Dashboard</a>
                        <a href="/operacional/checklist" class="hover:text-blue-200 px-3 py-2 rounded">Checklist</a>
                        <a href="/limpeza/ocorrencias" class="hover:text-blue-200 px-3 py-2 rounded">Ocorrências de Limpeza</a>
                    <% } else if (roles.includes('LIMPEZA') && roles.includes('OPERACIONAL')) { %>
                        <!-- Se tem ambas, mostra ambos os menus -->
                        <a href="/operacional/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Operacional - Dashboard</a>
                        <a href="/limpeza/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Limpeza - Dashboard</a>
                        <a href="/operacional/checklist" class="hover:text-blue-200 px-3 py-2 rounded">Checklist</a>
                        <a href="/operacional/ocorrencias" class="hover:text-blue-200 px-3 py-2 rounded">Ocorrências (Zeladoria)</a>
                        <a href="/limpeza/ocorrencias" class="hover:text-blue-200 px-3 py-2 rounded">Ocorrências (Limpeza)</a>
                    <% }
                    
                    // CONSELHO
                    if (roles.includes('CONSELHO')) { %>
                        <a href="/conselho/dashboard" class="hover:text-blue-200 px-3 py-2 rounded">Conselho - Dashboard</a>
                    <% }
                }
                %>

                <!-- Notificações -->
                <% if (typeof user !== 'undefined' && user.id) { %>
                    <div class="relative">
                        <a href="/notifications" class="hover:text-blue-200 px-3 py-2 rounded relative">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                            </svg>
                            <span id="notification-badge" class="absolute top-0 right-0 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center hidden">0</span>
                        </a>
                    </div>
                <% } %>

                <!-- Informações do usuário e logout -->
                <% if (typeof user !== 'undefined') { %>
                    <div class="flex items-center space-x-2 border-l pl-4 ml-4">
                        <span class="text-sm">
                            <%= user.fullName %>
                        </span>
                        <form method="POST" action="/auth/logout" class="inline">
                            <button type="submit" class="bg-blue-700 hover:bg-blue-800 px-4 py-2 rounded text-sm">Sair</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</nav>