<!-- Navbar principal do sistema -->
<!-- NAVBAR DINÂMICA: Exibe menus automaticamente baseado nas roles do usuário -->
<!-- Design moderno e tecnológico com menu dropdown organizado -->

<style>
  /* Animações personalizadas para o navbar */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(34, 163, 41, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(34, 163, 41, 0);
    }
  }

  .animate-slide-down {
    animation: slideDown 0.3s ease-out;
  }

  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }

  /* Estilos para dropdown moderno */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    min-width: 280px;
    max-width: 800px;
    background: white;
    border-radius: 0.75rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
    border: 1px solid rgba(0, 0, 0, 0.05);
    max-height: 80vh;
    overflow-y: auto;
  }

  /* Dropdown com múltiplas colunas quando tem muitos itens */
  .nav-dropdown-menu.multi-column {
    display: flex;
    flex-direction: column;
    min-width: 600px;
    max-width: 900px;
  }

  .nav-dropdown-menu.multi-column .nav-dropdown-items-container {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  .nav-dropdown-menu.multi-column .nav-dropdown-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-right: 1px solid #e5e7eb;
    min-width: 200px;
  }

  .nav-dropdown-menu.multi-column .nav-dropdown-column:last-child {
    border-right: none;
  }

  .nav-dropdown-menu.multi-column .nav-dropdown-item {
    border-bottom: 1px solid #f3f4f6;
    border-right: none;
  }

  .nav-dropdown-menu.multi-column .nav-dropdown-column .nav-dropdown-item:last-child {
    border-bottom: 1px solid #f3f4f6;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown-menu:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-item {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    color: #374151;
    font-size: 0.875rem;
    transition: all 0.2s;
    border-bottom: 1px solid #f3f4f6;
    white-space: nowrap;
  }

  .nav-dropdown-item:last-child {
    border-bottom: none;
  }

  .nav-dropdown-item:hover {
    background: #f9fafb;
    color: #22a329;
    padding-left: 1.25rem;
  }

  .nav-dropdown-header {
    padding: 0.75rem 1rem;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
    grid-column: 1 / -1;
  }

  .nav-dropdown-items-container {
    display: flex;
    flex-direction: column;
  }

  .nav-dropdown-section {
    border-bottom: 1px solid #e5e7eb;
  }

  .nav-dropdown-section:last-child {
    border-bottom: none;
  }

  /* Badge de notificação animado */
  .notification-badge {
    animation: pulse-glow 2s infinite;
  }

  /* Logo com efeito hover */
  .logo-container {
    transition: transform 0.3s ease;
  }

  .logo-container:hover {
    transform: scale(1.05);
  }

  /* Botão de menu moderno */
  .menu-button {
    position: relative;
    overflow: hidden;
  }

  .menu-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .menu-button:hover::before {
    width: 300px;
    height: 300px;
  }

  /* Navbar com gradiente moderno */
  .navbar-gradient {
    background: linear-gradient(135deg, #22a329 0%, #1a8a20 100%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Link ativo */
  .nav-link-active {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 0.5rem;
  }
</style>

