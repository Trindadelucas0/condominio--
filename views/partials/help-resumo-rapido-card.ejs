<%#
  Parâmetros:
  - resumo: array de strings (obrigatório)
  - footnoteHtml: string HTML opcional (rodapé com dica para o modal de ajuda)
  - resumoDefaultOpen: se true, inicia expandido (opcional; predefinição: fechado para poupar espaço)
%>
<% var _items = typeof resumo !== "undefined" && Array.isArray(resumo) ? resumo : []; %>
<% var _open = typeof resumoDefaultOpen !== "undefined" && resumoDefaultOpen; %>
<% if (_items.length > 0) { %>
<details class="help-resumo-details group rounded-xl border border-blue-200/90 bg-gradient-to-br from-primary-50/50 via-slate-50/80 to-blue-50/50 shadow-sm overflow-hidden"<% if (_open) { %> open<% } %>>
  <summary class="flex cursor-pointer list-none items-center gap-3 p-4 sm:p-5 text-left transition-colors hover:bg-white/40 [&::-webkit-details-marker]:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 rounded-xl">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/90 shadow-sm ring-1 ring-primary-200/60">
      <svg class="h-5 w-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <h2 class="text-base font-semibold text-gray-900 leading-tight">Resumo rápido</h2>
      <p class="text-xs text-gray-500 mt-0.5">O essencial desta página — <span class="text-primary-700 font-medium">toque para expandir</span></p>
    </div>
    <svg class="help-resumo-chevron h-5 w-5 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>
  <div class="border-t border-gray-200/80 px-4 pb-4 pt-3 sm:px-5 sm:pb-5 sm:pt-4">
    <ul class="space-y-3 list-none m-0 p-0" role="list">
      <% _items.forEach(function(item, i) { %>
      <li class="flex gap-3 items-start" role="listitem">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-800 text-xs font-bold leading-none" aria-hidden="true"><%= i + 1 %></span>
        <span class="text-sm text-gray-700 leading-relaxed pt-0.5"><%- item %></span>
      </li>
      <% }); %>
    </ul>
    <% if (typeof footnoteHtml !== "undefined" && footnoteHtml) { %>
    <div class="mt-4 pt-3 border-t border-gray-200/90 flex gap-2 items-start">
      <svg class="h-4 w-4 text-gray-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-xs text-gray-600 leading-relaxed"><%- footnoteHtml %></p>
    </div>
    <% } %>
  </div>
</details>
<% } %>
