<%#
  Parâmetros:
  - resumo: array de strings (obrigatório)
  - footnoteHtml: string HTML opcional (rodapé com dica para o modal de ajuda)
  - resumoDefaultOpen: se true, inicia expandido (opcional; predefinição: fechado para poupar espaço)
  - resumoIaTeaser: texto curto opcional (resumo automático visível mesmo com o bloco fechado).
    Se omitido, é gerado a partir dos 1–2 primeiros itens de resumo (texto plano).
%>
<% var _items = typeof resumo !== "undefined" && Array.isArray(resumo) ? resumo : []; %>
<% var _open = typeof resumoDefaultOpen !== "undefined" && resumoDefaultOpen; %>
<% function _resumoStripTags(s) { return String(s || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim(); } %>
<% var _ia = typeof resumoIaTeaser !== "undefined" && resumoIaTeaser ? String(resumoIaTeaser).trim() : ""; %>
<% if (!_ia && _items.length > 0) {
  var _joined = _items.slice(0, 2).map(function (it) { return _resumoStripTags(it); }).join(" ");
  _ia = _joined.length > 280 ? _joined.substring(0, 277) + "…" : _joined;
} %>
<% if (_items.length > 0) { %>
<div class="help-resumo-card w-full rounded-xl border border-blue-200/90 bg-gradient-to-br from-primary-50/50 via-slate-50/80 to-blue-50/50 shadow-sm overflow-hidden flex flex-col">
  <% if (_ia) { %>
  <div class="px-4 py-3 sm:px-5 border-b border-gray-200/80 bg-white/55">
    <div class="flex gap-2.5 items-start">
      <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-indigo-700" title="Resumo automático" aria-hidden="true">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-indigo-800/90 mb-1">Resumo desta página</p>
        <p class="text-sm text-gray-800 leading-relaxed"><%= _ia %></p>
        <p class="text-[10px] text-gray-500 mt-1.5">Sugestão automática para leitura rápida — abaixo, o passo a passo completo.</p>
      </div>
    </div>
  </div>
  <% } %>
  <details class="help-resumo-details group w-full border-0 bg-transparent shadow-none overflow-hidden"<% if (_open) { %> open<% } %>>
    <summary class="flex cursor-pointer list-none items-center gap-3 p-4 sm:p-5 text-left transition-colors hover:bg-white/40 [&::-webkit-details-marker]:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 rounded-none">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/90 shadow-sm ring-1 ring-primary-200/60">
        <svg class="h-5 w-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-gray-900 leading-tight">Resumo rápido</h2>
        <p class="text-xs text-gray-500 mt-0.5"><span class="text-primary-700 font-medium">Toque para ver o passo a passo</span> com todos os pontos.</p>
      </div>
      <svg class="help-resumo-chevron h-5 w-5 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </summary>
    <div class="border-t border-gray-200/80 px-4 pb-4 pt-3 sm:px-5 sm:pb-5 sm:pt-4">
      <ul class="space-y-3 list-none m-0 p-0" role="list">
        <% _items.forEach(function(item, i) { %>
        <li class="flex gap-3 items-start" role="listitem">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-800 text-xs font-bold leading-none" aria-hidden="true"><%= i + 1 %></span>
          <span class="text-sm text-gray-700 leading-relaxed pt-0.5"><%- item %></span>
        </li>
        <% }); %>
      </ul>
      <% if (typeof footnoteHtml !== "undefined" && footnoteHtml) { %>
      <div class="mt-4 pt-3 border-t border-gray-200/90 flex gap-2 items-start">
        <svg class="h-4 w-4 text-gray-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-xs text-gray-600 leading-relaxed"><%- footnoteHtml %></p>
      </div>
      <% } %>
    </div>
  </details>
</div>
<% } %>
