<!-- Modal de itens críticos - aparece após login quando há contas/documentos vencidos ou próximos (Opção B) -->
<div id="critical-items-modal" class="fixed inset-0 z-[9999] hidden flex flex-col items-center justify-center" aria-hidden="true" style="display: none;">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeCriticalItemsModal()"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-hidden animate-fade-in" role="dialog" aria-labelledby="critical-modal-title">
      <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-amber-50 to-orange-50">
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-amber-500 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <div>
            <h2 id="critical-modal-title" class="text-xl font-bold text-gray-900">Itens que precisam de sua atenção</h2>
            <p class="text-sm text-gray-600 mt-0.5">Revise os itens abaixo e tome as ações necessárias</p>
          </div>
        </div>
      </div>
      <div class="p-6 overflow-y-auto max-h-[50vh]">
        <div id="critical-items-content">
          <!-- Preenchido via JavaScript -->
        </div>
      </div>
      <div class="p-6 border-t border-gray-200 bg-gray-50 flex flex-col sm:flex-row gap-3 justify-end">
        <button type="button" onclick="closeCriticalItemsModal()" class="px-5 py-2.5 border border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-100 transition-colors">
          Fechar
        </button>
        <button type="button" onclick="closeCriticalItemsModal()" class="px-5 py-2.5 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors">
          Li e entendi
        </button>
      </div>
    </div>
  </div>
</div>
