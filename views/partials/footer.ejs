<!-- Rodapé do sistema -->
<footer id="tour-footer" class="bg-gradient-to-r from-gray-800 via-gray-900 to-gray-800 text-gray-300 mt-auto py-6 border-t-2 border-primary-600/20">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-3">
        <div class="bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl p-2.5 shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-white">&copy; <%= new Date().getFullYear() %> <span class="text-primary-400">ÊXITO</span> Condomínios</p>
          <p class="text-xs text-gray-400 mt-0.5">Sistema de Gestão Condominial</p>
        </div>
      </div>
      <p class="text-xs text-gray-400">Todos os direitos reservados</p>
    </div>
  </div>
</footer>
<!-- Roles do usuário para o tutorial (conteúdo por departamento) -->
<script>
  window.__userRoles = <%= typeof user !== 'undefined' && user && user.roles ? JSON.stringify(user.roles) : '[]' %>;
</script>
<!-- Script do modal de itens críticos (modal está no header) -->
<script src="/js/critical-items-modal.js"></script>
<!-- Driver.js - Tour guiado (local; abas por departamento) -->
<link rel="stylesheet" href="/css/driver.css"/>
<style id="exito-tour-tabs-css">
  .exito-tour-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; border-bottom: 1px solid rgba(0,0,0,.1); padding-bottom: 8px; }
  .exito-tour-tab { padding: 8px 14px; border: none; background: #f3f4f6; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500; color: #374151; }
  .exito-tour-tab:hover { background: #e5e7eb; }
  .exito-tour-tab.active { background: #22a329; color: #fff; }
  .exito-tour-panel { display: none; padding: 10px 0; font-size: 14px; line-height: 1.6; text-align: left; }
  .exito-tour-panel.active { display: block; }
  .exito-tour-panel h4 { margin: 0 0 8px 0; font-size: 14px; color: #22a329; }
  .exito-tour-panel ul { margin: 6px 0 0 18px; padding: 0; }
</style>
<script src="/js/driver.js.iife.js"></script>
<script>
  window.ExitoTourDriver = (typeof window.driver !== 'undefined' && window.driver && window.driver.js && typeof window.driver.js.driver === 'function') ? window.driver.js.driver : (typeof window.driver !== 'undefined' && window.driver && typeof window.driver.js === 'function' ? window.driver.js : null);
</script>
<script src="/js/sistema-tour.js"></script>
<!-- Registro do Service Worker para cache de recursos (carregamento mais rápido no celular) -->
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  }
</script>
</body>
</html>
