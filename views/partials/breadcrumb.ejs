<%#
  Breadcrumb de navegação. Uso: <%- include('partials/breadcrumb', { items: [ { label: 'Início', url: '/sindico/dashboard' }, { label: 'Receitas', url: '/financeiro/entradas' }, { label: 'Nova receita', url: '' } ] }) %>
  Se url for vazio ou omitido, o item é exibido como texto (não link).
-%>
<% if (typeof items !== 'undefined' && items && items.length > 0) { %>
<nav class="flex items-center space-x-2 text-sm text-gray-600 mb-4" aria-label="Breadcrumb">
  <% items.forEach(function(item, i) { %>
    <% if (i > 0) { %>
      <span class="text-gray-400" aria-hidden="true">/</span>
    <% } %>
    <% if (item.url && item.url !== '') { %>
      <a href="<%= item.url %>" class="hover:text-primary-600 font-medium transition-colors"><%= item.label %></a>
    <% } else { %>
      <span class="text-gray-900 font-semibold" aria-current="page"><%= item.label %></span>
    <% } %>
  <% }); %>
</nav>
<% } %>
