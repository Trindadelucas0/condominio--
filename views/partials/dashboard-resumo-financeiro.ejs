<%#
  Resumo Financeiro (3 cartões): saldo total, saldo do período, período anterior.
  Parâmetros: stats (balance, saldoMesAtual, saldoMesPassado), periodo (opcional), analytics (opcional, trend no primeiro cartão)
%>
<% var _s = typeof stats !== 'undefined' && stats ? stats : {}; %>
<% var _p = typeof periodo !== 'undefined' && periodo ? periodo : (_s.periodo || null); %>
<% var _bal = typeof _s.balance !== 'undefined' ? _s.balance : 0; %>
<% var _sa = typeof _s.saldoMesAtual !== 'undefined' ? _s.saldoMesAtual : 0; %>
<% var _sp = typeof _s.saldoMesPassado !== 'undefined' ? _s.saldoMesPassado : 0; %>
<div class="bg-gradient-to-br from-emerald-50 via-green-50/90 to-teal-50/80 rounded-2xl shadow-xl p-6 mb-6 animate-fade-in-up border border-emerald-300" style="animation-delay: 0.9s">
  <div class="flex items-center space-x-3 mb-4">
    <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg p-2 shadow-sm ring-2 ring-emerald-200/60">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
    </div>
    <h2 class="text-xl font-bold text-gray-900">Resumo Financeiro</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-gradient-to-r <%= _bal >= 0 ? 'from-green-50 to-emerald-50 border-green-300 border-l-green-500' : 'from-red-50 to-rose-50 border-red-300 border-l-red-500' %> rounded-xl p-4 border border-l-2">
      <p class="text-xs font-semibold text-gray-600 mb-1">Saldo total do condomínio</p>
      <p class="text-2xl font-bold <%= _bal >= 0 ? 'text-green-700' : 'text-red-700' %>">
        R$ <%= _bal.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
      </p>
      <p class="text-xs text-gray-500 mt-1">Todos os meses (incl. fechados)</p>
      <% if (typeof analytics !== 'undefined' && analytics && analytics.trend) { %>
        <p class="text-xs mt-2 <%= analytics.trend.trend === 'GROWING' ? 'text-green-600' : analytics.trend.trend === 'DECLINING' ? 'text-red-600' : 'text-gray-600' %>">
          <% if (analytics.trend.trend === 'GROWING') { %>📈 Crescendo<% } else if (analytics.trend.trend === 'DECLINING') { %>📉 Declinando<% } else { %>➡️ Estável<% } %>
          (<%= analytics.trend.rate.toFixed(1) %>%)
        </p>
      <% } %>
    </div>
    <div class="bg-gradient-to-r <%= _sa >= 0 ? 'from-green-50 to-emerald-50 border-green-300 border-l-green-500' : 'from-red-50 to-rose-50 border-red-300 border-l-red-500' %> rounded-xl p-4 border border-l-2">
      <p class="text-xs font-semibold text-gray-600 mb-1">Saldo do período</p>
      <% if (_p && _p.label) { %>
        <p class="text-xs text-gray-500 mb-1"><%= _p.label %></p>
      <% } %>
      <p class="text-2xl font-bold <%= _sa >= 0 ? 'text-green-700' : 'text-red-700' %>">
        R$ <%= _sa.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
      </p>
      <p class="text-xs text-gray-500 mt-1">Entradas − saídas no período selecionado</p>
    </div>
    <div class="bg-gradient-to-r <%= _sp >= 0 ? 'from-green-50 to-emerald-50 border-green-300 border-l-green-500' : 'from-red-50 to-rose-50 border-red-300 border-l-red-500' %> rounded-xl p-4 border border-l-2">
      <p class="text-xs font-semibold text-gray-600 mb-1">Período anterior (comparação)</p>
      <% if (_p && _p.labelAnterior) { %>
        <p class="text-xs text-gray-500 mb-1"><%= _p.labelAnterior %></p>
      <% } %>
      <p class="text-2xl font-bold <%= _sp >= 0 ? 'text-green-700' : 'text-red-700' %>">
        R$ <%= _sp.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
      </p>
      <p class="text-xs text-gray-500 mt-1">Mesma duração, imediatamente antes do período</p>
    </div>
  </div>
</div>
