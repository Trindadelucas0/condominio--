<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Orçamentos Liberados</h1>

  <% if (typeof req !== 'undefined' && req.query.success) { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Operação realizada com sucesso!
    </div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(req.query.error) %>
    </div>
  <% } %>

  <% if (budgets && budgets.length > 0) { %>
    <div class="space-y-4">
      <% budgets.forEach(budget => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-800"><%= budget.title %></h3>
              <p class="text-sm text-gray-500">
                Criado em: <%= new Date(budget.created_at).toLocaleString('pt-BR') %>
              </p>
            </div>
            <div class="text-right">
              <% if (budget.approved_amount) { %>
                <p class="text-2xl font-bold text-green-600">
                  R$ <%= parseFloat(budget.approved_amount).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </p>
                <p class="text-sm text-gray-500">Valor aprovado</p>
              <% } else if (budget.estimated_value) { %>
                <p class="text-2xl font-bold text-blue-600">
                  R$ <%= parseFloat(budget.estimated_value).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                </p>
                <p class="text-sm text-gray-500">Valor estimado</p>
              <% } %>
            </div>
          </div>

          <div class="mb-4">
            <p class="text-gray-700"><%= budget.description || 'Sem descrição' %></p>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
            <div>
              <span class="text-gray-600">Status:</span>
              <span class="px-2 py-1 rounded text-xs font-semibold bg-green-100 text-green-800 ml-2">
                <%= budget.status %>
              </span>
            </div>
            <% if (budget.sindico_notes) { %>
            <div>
              <span class="text-gray-600">Observações do Síndico:</span>
              <span class="font-medium"><%= budget.sindico_notes %></span>
            </div>
            <% } %>
            <% if (budget.financeiro_notes) { %>
            <div>
              <span class="text-gray-600">Observações do Financeiro:</span>
              <span class="font-medium"><%= budget.financeiro_notes %></span>
            </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow p-12 text-center">
      <p class="text-gray-500 text-lg">Nenhum orçamento liberado disponível</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
