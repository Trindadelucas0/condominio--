<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="page-title">Dashboard Operacional</h1>
    <p class="page-subtitle">Painel de operações</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Tarefas Pendentes -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Tarefas Pendentes</p>
          <p class="text-3xl font-bold text-primary-600 mt-2"><%= stats.pendingTasks %></p>
        </div>
        <div class="bg-primary-100 rounded-full p-4">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/checklist" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver checklist →
      </a>
    </div>

    <!-- Tarefas Atrasadas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Tarefas Atrasadas</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.overdueTasks %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Ocorrências Abertas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Ocorrências Abertas</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.openOccurrences %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/ocorrencias" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver ocorrências →
      </a>
    </div>
  </div>

  <!-- Segunda linha - Manutenções e Orçamentos -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Manutenções Pendentes -->
    <% if (stats.pendingMaintenances !== undefined) { %>
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Manutenções Pendentes</p>
          <p class="text-3xl font-bold text-primary-600 mt-2"><%= stats.pendingMaintenances %></p>
        </div>
        <div class="bg-primary-100 rounded-full p-4">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/manutencoes?status=PENDING" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver manutenções →
      </a>
    </div>
    <% } %>

    <!-- Manutenções em Andamento -->
    <% if (stats.inProgressMaintenances !== undefined) { %>
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Manutenções em Andamento</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= stats.inProgressMaintenances %></p>
        </div>
        <div class="bg-yellow-100 rounded-full p-4">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/manutencoes?status=IN_PROGRESS" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver manutenções →
      </a>
    </div>
    <% } %>

    <!-- Orçamentos Liberados -->
    <% if (stats.releasedBudgets !== undefined) { %>
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Orçamentos Liberados</p>
          <p class="text-3xl font-bold text-green-600 mt-2"><%= stats.releasedBudgets %></p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/orcamentos" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver orçamentos →
      </a>
    </div>
    <% } %>
  </div>

  <!-- Ações rápidas -->
  <div class="card">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/operacional/checklist" class="btn-primary text-center">
        Ver Checklist
      </a>
      <a href="/operacional/ocorrencias/nova" class="btn-primary text-center bg-yellow-600 hover:bg-yellow-700 focus:ring-yellow-500">
        Nova Ocorrência
      </a>
      <% if (stats.pendingMaintenances !== undefined && stats.pendingMaintenances > 0) { %>
      <a href="/operacional/manutencoes?status=PENDING" class="btn-primary text-center">
        Ver Manutenções (<%= stats.pendingMaintenances %>)
      </a>
      <% } %>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
