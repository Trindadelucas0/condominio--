<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Operacional</h1>
    <p class="text-gray-600 mt-2">Painel de operações</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Tarefas Pendentes -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Tarefas Pendentes</p>
          <p class="text-3xl font-bold text-blue-600 mt-2"><%= stats.pendingTasks %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/checklist" class="text-blue-600 text-sm mt-4 inline-block hover:underline">
        Ver checklist →
      </a>
    </div>

    <!-- Tarefas Atrasadas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Tarefas Atrasadas</p>
          <p class="text-3xl font-bold text-red-600 mt-2"><%= stats.overdueTasks %></p>
        </div>
        <div class="bg-red-100 rounded-full p-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Ocorrências Abertas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Ocorrências Abertas</p>
          <p class="text-3xl font-bold text-orange-600 mt-2"><%= stats.openOccurrences %></p>
        </div>
        <div class="bg-orange-100 rounded-full p-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
      </div>
      <a href="/operacional/ocorrencias" class="text-orange-600 text-sm mt-4 inline-block hover:underline">
        Ver ocorrências →
      </a>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/operacional/checklist" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition text-center">
        Ver Checklist
      </a>
      <a href="/operacional/ocorrencias/nova" class="bg-orange-600 text-white px-6 py-3 rounded-lg hover:bg-orange-700 transition text-center">
        Nova Ocorrência
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
