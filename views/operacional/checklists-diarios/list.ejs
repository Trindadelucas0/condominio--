<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Checklists do Dia</h1>
    <p class="text-gray-600 mt-2">Execute os checklists atribuídos a você</p>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'completed') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Checklist finalizado com sucesso!
    </div>
  <% } %>

  <!-- Filtro de Data -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" class="flex items-end gap-4">
      <div class="flex-1">
        <label for="date" class="block text-sm font-medium text-gray-700 mb-2">Data</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= date %>"
          class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
        Filtrar
      </button>
      <% if (date !== new Date().toISOString().split('T')[0]) { %>
        <a href="/operacional/checklists-diarios" class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400">
          Hoje
        </a>
      <% } %>
    </form>
  </div>

  <!-- Lista de Checklists -->
  <% if (checklists.length === 0) { %>
    <div class="bg-white rounded-lg shadow p-8 text-center">
      <p class="text-gray-500 text-lg mb-2">Nenhum checklist encontrado para esta data.</p>
      <p class="text-sm text-gray-400">Os checklists são gerados automaticamente com base nos modelos configurados.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% checklists.forEach(checklist => { %>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <!-- Cabeçalho do Card -->
          <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h3 class="text-lg font-semibold text-white"><%= checklist.model_name || 'Checklist' %></h3>
            <p class="text-blue-100 text-sm mt-1">
              <%= new Date(checklist.scheduled_date).toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
          </div>

          <!-- Conteúdo -->
          <div class="p-6">
            <!-- Status -->
            <div class="mb-4">
              <% if (checklist.status === 'PENDING') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                  Pendente
                </span>
              <% } else if (checklist.status === 'IN_PROGRESS') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                  Em Execução
                </span>
              <% } else if (checklist.status === 'COMPLETED') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                  Concluído
                </span>
              <% } else if (checklist.status === 'LATE') { %>
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                  Atrasado
                </span>
              <% } %>
            </div>

            <!-- Progresso -->
            <div class="mb-4">
              <div class="flex justify-between text-sm text-gray-600 mb-2">
                <span>Progresso</span>
                <span><%= checklist.items_done || 0 %> / <%= checklist.items_total || 0 %></span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <% const progress = checklist.items_total > 0 ? (checklist.items_done / checklist.items_total) * 100 : 0; %>
                <div class="bg-blue-600 h-2 rounded-full transition-all" style="width: <%= progress %>%"></div>
              </div>
            </div>

            <!-- Informações -->
            <% if (checklist.model_description) { %>
              <p class="text-sm text-gray-600 mb-4"><%= checklist.model_description.substring(0, 100) %><%= checklist.model_description.length > 100 ? '...' : '' %></p>
            <% } %>

            <!-- Botões -->
            <div class="flex gap-2">
              <% if (checklist.status === 'PENDING') { %>
                <a href="/operacional/checklists-diarios/<%= checklist.id %>" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-center transition">
                  Iniciar Checklist
                </a>
              <% } else if (checklist.status === 'IN_PROGRESS') { %>
                <a href="/operacional/checklists-diarios/<%= checklist.id %>" class="flex-1 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 text-center transition">
                  Continuar Executando
                </a>
              <% } else if (checklist.status === 'COMPLETED') { %>
                <a href="/operacional/checklists-diarios/<%= checklist.id %>" class="flex-1 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 text-center transition">
                  Ver Detalhes
                </a>
              <% } else { %>
                <a href="/operacional/checklists-diarios/<%= checklist.id %>" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-center transition">
                  Executar
                </a>
              <% } %>
            </div>

            <!-- Timestamp -->
            <% if (checklist.completed_at) { %>
              <p class="text-xs text-gray-500 mt-4 text-center">
                Finalizado em: <%= new Date(checklist.completed_at).toLocaleString('pt-BR') %>
              </p>
            <% } else if (checklist.started_at) { %>
              <p class="text-xs text-gray-500 mt-4 text-center">
                Iniciado em: <%= new Date(checklist.started_at).toLocaleString('pt-BR') %>
              </p>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
