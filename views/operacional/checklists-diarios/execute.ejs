<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-800"><%= checklist.model_name || 'Checklist' %></h1>
        <p class="text-gray-600 mt-2">
          <%= new Date(checklist.scheduled_date).toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        <% if (checklist.model_description) { %>
          <p class="text-sm text-gray-500 mt-1"><%= checklist.model_description %></p>
        <% } %>
      </div>
      <div class="flex gap-2">
        <% if (checklist.status === 'PENDING') { %>
          <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/iniciar" class="inline">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
              Iniciar Checklist
            </button>
          </form>
        <% } %>
        <a href="/operacional/checklists-diarios" class="bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400">
          Voltar
        </a>
      </div>
    </div>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'started') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Checklist iniciado! Comece a executar os itens.
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'updated') { %>
    <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4">
      Item atualizado com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'evidence_added') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Foto enviada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= decodeURIComponent(query.error) %>
    </div>
  <% } %>

  <!-- Status e Progresso -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <% if (checklist.status === 'PENDING') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">
            ⏳ Pendente
          </span>
        <% } else if (checklist.status === 'IN_PROGRESS') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">
            🔄 Em Execução
          </span>
        <% } else if (checklist.status === 'COMPLETED') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">
            ✅ Concluído
          </span>
          <p class="text-sm text-gray-600 mt-2">
            Finalizado em: <%= new Date(checklist.completed_at).toLocaleString('pt-BR') %>
          </p>
        <% } else if (checklist.status === 'LATE') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">
            ⚠️ Atrasado
          </span>
        <% } %>
      </div>
      <div class="text-right">
        <div class="text-sm text-gray-600 mb-1">Progresso</div>
        <div class="text-2xl font-bold text-blue-600">
          <%= checklist.items_done || 0 %> / <%= checklist.items_total || 0 %>
        </div>
        <div class="w-48 bg-gray-200 rounded-full h-2 mt-2">
          <% const progress = checklist.items_total > 0 ? ((checklist.items_done || 0) / checklist.items_total) * 100 : 0; %>
          <div class="bg-blue-600 h-2 rounded-full transition-all" style="width: <%= progress %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Itens do Checklist -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Itens do Checklist</h2>
    
    <% if (!checklist.items || checklist.items.length === 0) { %>
      <p class="text-gray-500">Nenhum item encontrado neste checklist.</p>
    <% } else { %>
      <div class="space-y-4">
        <% checklist.items.forEach((item, index) => { %>
          <div class="border border-gray-300 rounded-lg p-4 <%= item.status === 'DONE' ? 'bg-green-50' : item.status === 'NOT_DONE' ? 'bg-red-50' : 'bg-white' %>">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-sm font-medium text-gray-500">#<%= index + 1 %></span>
                  <h3 class="text-lg font-semibold text-gray-800"><%= item.item_name %></h3>
                  <% if (item.requires_photo) { %>
                    <span class="px-2 py-1 text-xs bg-purple-100 text-purple-800 rounded">📷 Foto obrigatória</span>
                  <% } %>
                </div>

                <!-- Status do Item -->
                <div class="mb-3">
                  <% if (item.status === 'PENDING') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                      Pendente
                    </span>
                  <% } else if (item.status === 'DONE') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                      ✓ Feito
                    </span>
                  <% } else if (item.status === 'NOT_DONE') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                      ✗ Não Feito
                    </span>
                  <% } %>
                </div>

                <!-- Comentário -->
                <% if (item.comment) { %>
                  <div class="bg-gray-100 rounded p-3 mb-3">
                    <p class="text-sm text-gray-700"><strong>Observação:</strong> <%= item.comment %></p>
                  </div>
                <% } %>

                <!-- Evidências (Fotos) -->
                <% 
                  const itemEvidences = checklist.evidences ? checklist.evidences.filter(e => e.checklist_item_id === item.id) : [];
                %>
                <% if (itemEvidences.length > 0) { %>
                  <div class="mb-3">
                    <p class="text-sm font-medium text-gray-700 mb-2">Fotos enviadas:</p>
                    <div class="flex gap-2 flex-wrap">
                      <% itemEvidences.forEach(evidence => { %>
                        <a href="/uploads/<%= evidence.file_path.replace(/^.*uploads[\\\/]/, '') %>" target="_blank" class="block">
                          <img src="/uploads/<%= evidence.file_path.replace(/^.*uploads[\\\/]/, '') %>" alt="Evidência" class="w-24 h-24 object-cover rounded border border-gray-300 hover:border-blue-500">
                        </a>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Formulário de Atualização (apenas se não finalizado) -->
                <% if (checklist.status !== 'COMPLETED') { %>
                  <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/items/<%= item.id %>" class="space-y-3">
                    <div class="flex gap-3">
                      <select name="status" required class="border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="PENDING" <%= item.status === 'PENDING' ? 'selected' : '' %>>Pendente</option>
                        <option value="DONE" <%= item.status === 'DONE' ? 'selected' : '' %>>Feito</option>
                        <option value="NOT_DONE" <%= item.status === 'NOT_DONE' ? 'selected' : '' %>>Não Feito</option>
                      </select>
                      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                        Atualizar
                      </button>
                    </div>
                    
                    <div>
                      <textarea
                        name="comment"
                        placeholder="<%= checklist.requires_justification && item.status === 'NOT_DONE' ? 'Justificativa obrigatória...' : 'Observação (opcional)...' %>"
                        rows="2"
                        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
                      ><%= item.comment || '' %></textarea>
                      <p class="text-xs text-gray-500 mt-1">
                        <%= checklist.requires_justification ? 'Justificativa obrigatória quando item não foi feito' : 'Observação opcional' %>
                      </p>
                    </div>
                  </form>

                  <!-- Upload de Foto -->
                  <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/evidencias" enctype="multipart/form-data" class="mt-3">
                    <input type="hidden" name="checklistItemId" value="<%= item.id %>">
                    <div class="flex gap-2">
                      <input
                        type="file"
                        name="evidence"
                        accept="image/*"
                        required
                        class="flex-1 border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
                      />
                      <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
                        📷 Enviar Foto
                      </button>
                    </div>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Evidências Gerais -->
  <% 
    const generalEvidences = checklist.evidences ? checklist.evidences.filter(e => !e.checklist_item_id) : [];
  %>
  <% if (generalEvidences.length > 0) { %>
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Fotos Gerais</h2>
      <div class="grid grid-cols-4 gap-4">
        <% generalEvidences.forEach(evidence => { %>
          <a href="/uploads/<%= evidence.file_path.replace(/^.*uploads[\\\/]/, '') %>" target="_blank" class="block">
            <img src="/uploads/<%= evidence.file_path.replace(/^.*uploads[\\\/]/, '') %>" alt="Evidência" class="w-full h-32 object-cover rounded border border-gray-300 hover:border-blue-500">
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Upload de Foto Geral (apenas se não finalizado) -->
  <% if (checklist.status !== 'COMPLETED') { %>
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Enviar Foto Geral</h2>
      <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/evidencias" enctype="multipart/form-data">
        <div class="flex gap-2">
          <input
            type="file"
            name="evidence"
            accept="image/*"
            required
            class="flex-1 border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
            📷 Enviar Foto
          </button>
        </div>
      </form>
    </div>
  <% } %>

  <!-- Botão Finalizar -->
  <% if (checklist.status === 'IN_PROGRESS') { %>
    <div class="bg-white rounded-lg shadow p-6">
      <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/finalizar">
        <button type="submit" class="w-full bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 font-semibold text-lg">
          ✅ Finalizar Checklist
        </button>
        <p class="text-sm text-gray-500 mt-2 text-center">
          Verifique se todos os itens estão concluídos e se todas as fotos obrigatórias foram enviadas.
        </p>
      </form>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
