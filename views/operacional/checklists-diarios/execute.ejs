<%- include('../../partials/header', { title: title }) %>
<%- include('../../partials/navbar', { user: user }) %>
<%
  const totalEvidences = checklist.evidences ? checklist.evidences.length : 0;
  const canAddEvidence = checklist.status !== 'COMPLETED' && totalEvidences < 2;
  const progressPct = checklist.items_total > 0 ? ((checklist.items_done || 0) / checklist.items_total) * 100 : 0;
  const hasSindicoQuestions = checklist.items && checklist.items.some(i => i.sindico_question);
%>
<div class="container mx-auto px-4 py-8" id="checklist-page" data-checklist-id="<%= checklist.id %>">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-800"><%= checklist.model_name || 'Checklist' %></h1>
        <p class="text-gray-600 mt-2">
          <%= new Date(checklist.scheduled_date).toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        <% if (checklist.model_description) { %>
          <p class="text-sm text-gray-500 mt-1"><%= checklist.model_description %></p>
        <% } %>
      </div>
      <a href="/operacional/checklists-diarios" class="bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400">
        Voltar
      </a>
    </div>
  </div>

  <!-- Mensagens (apenas após redirect) -->
  <% if (typeof query !== 'undefined' && query.success === 'evidence_added') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Foto enviada com sucesso!
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.success === 'responder') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Resposta ao questionamento enviada.
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= typeof query.error === 'string' ? decodeURIComponent(query.error) : query.error %>
    </div>
  <% } %>

  <% if (hasSindicoQuestions) { %>
    <div class="bg-amber-50 border border-amber-300 text-amber-900 px-4 py-3 rounded mb-4 flex items-center gap-2">
      <span class="text-xl">📋</span>
      <div>
        <p class="font-semibold">Há questionamentos ou comentários do síndico</p>
        <p class="text-sm text-amber-800">O síndico comentou ou questionou um ou mais itens. Itens com <strong>solicitar resposta</strong> exigem sua resposta; itens com <strong>só comentário</strong> são apenas para sua ciência. Verifique abaixo.</p>
      </div>
    </div>
  <% } %>

  <!-- Status e Progresso -->
  <div class="bg-white rounded-lg shadow p-6 mb-6" id="progress-section">
    <div class="flex items-center justify-between">
      <div id="status-badge-wrap">
        <% if (checklist.status === 'PENDING') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">⏳ Pendente</span>
        <% } else if (checklist.status === 'IN_PROGRESS') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">🔄 Em Execução</span>
        <% } else if (checklist.status === 'COMPLETED') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">✅ Concluído</span>
          <p class="text-sm text-gray-600 mt-2">Finalizado em: <%= new Date(checklist.completed_at).toLocaleString('pt-BR') %></p>
        <% } else if (checklist.status === 'LATE') { %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">⚠️ Atrasado</span>
        <% } %>
      </div>
      <div class="text-right">
        <div class="text-sm text-gray-600 mb-1">Progresso</div>
        <div class="text-2xl font-bold text-blue-600" id="progress-text"><%= checklist.items_done || 0 %> / <%= checklist.items_total || 0 %></div>
        <div class="w-48 bg-gray-200 rounded-full h-2 mt-2">
          <div class="bg-blue-600 h-2 rounded-full transition-all" id="progress-bar" style="width: <%= progressPct %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Itens do Checklist -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Itens do Checklist</h2>
    <% if (!checklist.items || checklist.items.length === 0) { %>
      <p class="text-gray-500">Nenhum item encontrado neste checklist.</p>
    <% } else { %>
      <div class="space-y-4" id="items-list">
        <% checklist.items.forEach((item, index) => {
          const rowBg = item.status === 'DONE' ? 'bg-green-50' : item.status === 'NOT_DONE' ? 'bg-red-50' : 'bg-white';
        %>
          <div class="border border-gray-300 rounded-lg p-4 item-row <%= rowBg %>" data-item-id="<%= item.id %>">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-sm font-medium text-gray-500">#<%= index + 1 %></span>
                  <h3 class="text-lg font-semibold text-gray-800"><%= item.item_name %></h3>
                  <% if (item.requires_photo) { %>
                    <span class="px-2 py-1 text-xs bg-purple-100 text-purple-800 rounded">📷 Foto obrigatória</span>
                  <% } %>
                </div>

                <div class="mb-3" id="item-status-badge-<%= item.id %>">
                  <% if (item.status === 'PENDING') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Pendente</span>
                  <% } else if (item.status === 'DONE') { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">✓ Feito</span>
                  <% } else { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">✗ Não Feito</span>
                  <% } %>
                </div>

                <% if (item.comment) { %>
                  <div class="bg-gray-100 rounded p-3 mb-3 item-observation-saved" data-item-id="<%= item.id %>">
                    <p class="text-sm text-gray-700"><strong>Observação:</strong> <%= item.comment %></p>
                  </div>
                <% } %>

                <% if (item.sindico_question) { %>
                  <div class="bg-amber-50 border border-amber-300 rounded p-3 mb-3">
                    <% if (item.sindico_exige_resposta) { %>
                      <p class="text-sm font-medium text-amber-900 mb-1">📋 Questionamento do síndico — <span class="text-amber-800">Solicita sua resposta</span></p>
                      <p class="text-xs text-amber-800 font-medium mb-1">O síndico solicitou que você responda.</p>
                    <% } else { %>
                      <p class="text-sm font-medium text-amber-900 mb-1">💬 Comentário do síndico — <span class="text-gray-600">Só para sua ciência</span></p>
                      <p class="text-xs text-gray-600 mb-1">O síndico deixou um comentário (não exige resposta).</p>
                    <% } %>
                    <p class="text-sm text-gray-800 mt-2"><%= item.sindico_question %></p>
                    <% if (item.sindico_question_at) { %>
                      <p class="text-xs text-gray-500 mt-1"><%= new Date(item.sindico_question_at).toLocaleString('pt-BR') %></p>
                    <% } %>
                    <% if (item.resposta_questionamento) { %>
                      <div class="mt-3 pt-3 border-t border-amber-200">
                        <p class="text-sm font-medium text-gray-700 mb-1">Sua resposta:</p>
                        <p class="text-sm text-gray-800"><%= item.resposta_questionamento %></p>
                        <% if (item.resposta_questionamento_at) { %>
                          <p class="text-xs text-gray-500 mt-1"><%= new Date(item.resposta_questionamento_at).toLocaleString('pt-BR') %></p>
                        <% } %>
                      </div>
                    <% } else { %>
                      <div class="mt-3 pt-3 border-t border-amber-200">
                        <p class="text-sm font-medium text-gray-700 mb-2"><%= item.sindico_exige_resposta ? 'Responder ao questionamento (obrigatório)' : 'Responder ou comentar (opcional)' %></p>
                        <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/items/<%= item.id %>/responder-questionamento" class="flex gap-2 flex-wrap items-end">
                          <textarea name="resposta" rows="2"
                            placeholder="<%= item.sindico_exige_resposta ? 'O síndico solicitou sua resposta. Escreva aqui...' : 'Você pode adicionar um comentário (opcional).' %>"
                            class="flex-1 min-w-0 border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500" <%= item.sindico_exige_resposta ? 'required' : '' %>></textarea>
                          <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded font-medium whitespace-nowrap">
                            Enviar resposta
                          </button>
                        </form>
                      </div>
                    <% } %>
                  </div>
                <% } %>

                <% if (checklist.evidences && checklist.evidences.length > 0) {
                  const itemEvs = checklist.evidences.filter(e => e.checklist_item_id === item.id);
                  if (itemEvs.length > 0) { %>
                    <div class="mb-3">
                      <p class="text-sm font-medium text-gray-700 mb-2">Fotos enviadas:</p>
                      <div class="flex gap-2 flex-wrap">
                        <% itemEvs.forEach(evidence => {
                          const fp = (evidence.file_path || '').replace(/\\/g, '/');
                          const href = fp.startsWith('uploads') ? '/' + fp : ('/uploads/checklists/' + (evidence.file_name || fp.split('/').pop() || ''));
                        %>
                          <a href="<%= href %>" target="_blank" class="block">
                            <img src="<%= href %>" alt="Evidência" class="w-24 h-24 object-cover rounded border border-gray-300 hover:border-blue-500">
                          </a>
                        <% }); %>
                      </div>
                    </div>
                  <% }
                } %>

                <% if (checklist.status !== 'COMPLETED') { %>
                  <div class="item-actions space-y-3" data-item-id="<%= item.id %>">
                    <div class="flex gap-3 items-center flex-wrap">
                      <label class="text-sm text-gray-600">Status:</label>
                      <select
                        name="status"
                        class="item-status-select border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
                        data-item-id="<%= item.id %>"
                        data-requires-justification="<%= checklist.requires_justification ? '1' : '0' %>"
                      >
                        <option value="PENDING" <%= item.status === 'PENDING' ? 'selected' : '' %>>Pendente</option>
                        <option value="DONE" <%= item.status === 'DONE' ? 'selected' : '' %>>Feito</option>
                        <option value="NOT_DONE" <%= item.status === 'NOT_DONE' ? 'selected' : '' %>>Não Feito</option>
                      </select>
                    </div>

                    <% if (!item.comment) { %>
                      <div class="item-observation-form" data-item-id="<%= item.id %>">
                        <textarea
                          class="item-comment-input w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
                          rows="2"
                          placeholder="<%= checklist.requires_justification ? 'Justificativa obrigatória quando não feito' : 'Observação (opcional)' %>"
                          data-item-id="<%= item.id %>"
                        ></textarea>
                        <button type="button" class="mt-2 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 item-send-observation" data-item-id="<%= item.id %>">
                          Enviar observação
                        </button>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Fotos (máx. 2, enviar uma vez) -->
  <% 
    const generalEvidences = checklist.evidences ? checklist.evidences.filter(e => !e.checklist_item_id) : [];
  %>
  <% if (checklist.evidences && checklist.evidences.length > 0) { %>
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Imagens (<%= totalEvidences %>/2)</h2>
      <div class="flex gap-4 flex-wrap">
        <% checklist.evidences.forEach(evidence => {
          const fp = (evidence.file_path || '').replace(/\\/g, '/');
          const href = fp.startsWith('uploads') ? '/' + fp : ('/uploads/checklists/' + (evidence.file_name || fp.split('/').pop() || ''));
        %>
          <a href="<%= href %>" target="_blank" class="block">
            <img src="<%= href %>" alt="Evidência" class="w-32 h-32 object-cover rounded border border-gray-300 hover:border-blue-500">
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <% if (canAddEvidence) { %>
    <div class="bg-white rounded-lg shadow p-6 mb-6" id="upload-evidence-section">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Enviar imagem (<%= totalEvidences %>/2)</h2>
      <p class="text-sm text-gray-500 mb-2">Máximo 2 imagens por checklist. Após enviar, não é possível adicionar mais.</p>
      <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/evidencias" enctype="multipart/form-data">
        <div class="flex gap-2 flex-wrap">
          <input type="file" name="evidence" accept="image/*" required class="flex-1 min-w-0 border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
          <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">📷 Enviar</button>
        </div>
      </form>
    </div>
  <% } %>

  <!-- Botão Finalizar (só quando Em Execução) -->
  <div id="finalizar-section" class="<%= checklist.status === 'IN_PROGRESS' ? '' : 'hidden' %>">
    <div class="bg-white rounded-lg shadow p-6">
      <form method="POST" action="/operacional/checklists-diarios/<%= checklist.id %>/finalizar">
        <button type="submit" class="w-full bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 font-semibold text-lg">
          ✅ Finalizar Checklist
        </button>
        <p class="text-sm text-gray-500 mt-2 text-center">
          Verifique se todos os itens estão concluídos e se as fotos obrigatórias foram enviadas.
        </p>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  const page = document.getElementById('checklist-page');
  if (!page) return;
  const checklistId = page.dataset.checklistId;
  const progressText = document.getElementById('progress-text');
  const progressBar = document.getElementById('progress-bar');
  const statusBadgeWrap = document.getElementById('status-badge-wrap');
  const finalizarSection = document.getElementById('finalizar-section');

  function getItemRow(itemId) {
    return document.querySelector('.item-row[data-item-id="' + itemId + '"]');
  }

  function getSelect(itemId) {
    return document.querySelector('.item-status-select[data-item-id="' + itemId + '"]');
  }

  function getCommentInput(itemId) {
    return document.querySelector('.item-comment-input[data-item-id="' + itemId + '"]');
  }

  function updateProgress(done, total) {
    if (!progressText || !progressBar) return;
    progressText.textContent = done + ' / ' + total;
    const pct = total > 0 ? (done / total) * 100 : 0;
    progressBar.style.width = pct + '%';
  }

  function setStatusBadge(status) {
    if (!statusBadgeWrap) return;
    let html = '';
    if (status === 'PENDING') html = '<span class="px-4 py-2 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">⏳ Pendente</span>';
    else if (status === 'IN_PROGRESS') html = '<span class="px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">🔄 Em Execução</span>';
    else if (status === 'COMPLETED') html = '<span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">✅ Concluído</span>';
    else if (status === 'LATE') html = '<span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">⚠️ Atrasado</span>';
    statusBadgeWrap.innerHTML = html;
  }

  function setItemBadge(itemId, status) {
    const wrap = document.getElementById('item-status-badge-' + itemId);
    if (!wrap) return;
    let html = '';
    if (status === 'PENDING') html = '<span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Pendente</span>';
    else if (status === 'DONE') html = '<span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">✓ Feito</span>';
    else html = '<span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">✗ Não Feito</span>';
    wrap.innerHTML = html;
  }

  function setRowBackground(itemId, status) {
    const row = getItemRow(itemId);
    if (!row) return;
    row.classList.remove('bg-white', 'bg-green-50', 'bg-red-50');
    if (status === 'DONE') row.classList.add('bg-green-50');
    else if (status === 'NOT_DONE') row.classList.add('bg-red-50');
    else row.classList.add('bg-white');
  }

  function updateUi(res, itemId) {
    updateProgress(res.progress.done, res.progress.total);
    setStatusBadge(res.checklistStatus);
    setItemBadge(itemId, res.item.status);
    setRowBackground(itemId, res.item.status);
    if (res.checklistStatus === 'IN_PROGRESS' && finalizarSection) {
      finalizarSection.classList.remove('hidden');
    }
  }

  function submitItem(itemId, status, comment, onSuccess) {
    const body = new URLSearchParams({ status: status, comment: comment || '' });

    fetch('/operacional/checklists-diarios/' + checklistId + '/items/' + itemId, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body
    })
      .then(function (r) { return r.json().then(function (j) { return r.ok ? j : Promise.reject(j); }); })
      .then(function (data) {
        updateUi(data, itemId);
        if (typeof onSuccess === 'function') onSuccess(data, itemId, comment);
      })
      .catch(function (err) {
        alert(err && err.error ? err.error : 'Erro ao atualizar.');
      });
  }

  // Status: atualiza sozinho ao mudar o select (sem clicar em botão)
  document.querySelectorAll('.item-status-select').forEach(function (sel) {
    sel.addEventListener('change', function () {
      const itemId = this.dataset.itemId;
      const status = this.value;
      const reqJust = this.dataset.requiresJustification === '1';
      const commentEl = getCommentInput(itemId);
      const comment = commentEl ? commentEl.value.trim() : '';
      if (status === 'NOT_DONE' && reqJust && !comment) {
        alert('Comentário é obrigatório quando o item não foi feito.');
        return;
      }
      submitItem(itemId, status, comment);
    });
  });

  // Observação: enviar uma vez; depois só exibir (sem escrever de novo)
  document.querySelectorAll('.item-send-observation').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const itemId = this.dataset.itemId;
      const commentEl = getCommentInput(itemId);
      const comment = commentEl ? commentEl.value.trim() : '';
      const sel = getSelect(itemId);
      const status = sel ? sel.value : 'PENDING';
      const reqJust = sel && sel.dataset.requiresJustification === '1';
      if (status === 'NOT_DONE' && reqJust && !comment) {
        alert('Justificativa obrigatória quando o item não foi feito.');
        return;
      }
      submitItem(itemId, status, comment, function (_data, _itemId, sentComment) {
        var formWrap = document.querySelector('.item-observation-form[data-item-id="' + itemId + '"]');
        if (formWrap) {
          var saved = document.createElement('div');
          saved.className = 'bg-gray-100 rounded p-3 mb-3 item-observation-saved';
          saved.setAttribute('data-item-id', itemId);
          saved.innerHTML = '<p class="text-sm text-gray-700"><strong>Observação:</strong> ' + (sentComment || '(enviada)') + '</p>';
          formWrap.replaceWith(saved);
        }
      });
    });
  });
})();
</script>

<%- include('../../partials/footer') %>
