<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Detalhe da ocorrência'; %>
  <% var resumo = ['Veja status, descrição, local e imagens da ocorrência.', 'Atualize o andamento ou status conforme o atendimento.', 'Use Voltar para retornar à lista.']; %>
  <% var helpModalContent = '<p>Nesta tela você vê todos os detalhes da ocorrência. Atualize o status e o andamento conforme resolver o problema.</p>'; %>
  <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800"><%= occurrence.title %></h1>
        <p class="text-gray-600 mt-2">Detalhes da ocorrência</p>
      </div>
      <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <div class="flex space-x-3">
      <a href="/operacional/ocorrencias" class="bg-gray-600 text-white px-6 py-2 rounded-lg hover:bg-gray-700 transition">
        Voltar
      </a>
    </div>
  </div>
  <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div>
        <p class="text-sm text-gray-500">Status</p>
        <p class="font-semibold text-gray-900"><%= occurrence.status %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Data</p>
        <p class="font-semibold text-gray-900"><%= new Date(occurrence.created_at).toLocaleDateString('pt-BR') %></p>
      </div>
    </div>

    <div class="mb-4">
      <p class="text-sm text-gray-500">Descrição</p>
      <p class="text-gray-900"><%= occurrence.description || '-' %></p>
    </div>

    <% if (occurrence.location) { %>
      <div class="mb-4">
        <p class="text-sm text-gray-500">Localização</p>
        <p class="text-gray-900"><%= occurrence.location %></p>
      </div>
    <% } %>

    <!-- Imagens da Ocorrência -->
    <% if (occurrence.images && occurrence.images.length > 0) { %>
      <div class="mt-6 pt-6 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Imagens Anexadas</h3>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <% occurrence.images.forEach(function(image) { %>
            <div class="relative group">
              <a href="/<%= image.file_path %>" target="_blank" class="block">
                <img 
                  src="/<%= image.file_path %>" 
                  alt="<%= image.file_name %>" 
                  class="w-full h-48 object-cover rounded-lg border-2 border-gray-200 hover:border-orange-500 transition-all duration-200 cursor-pointer"
                />
                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-200 rounded-lg flex items-center justify-center">
                  <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                  </svg>
                </div>
              </a>
              <p class="text-xs text-gray-500 mt-2 truncate" title="<%= image.file_name %>"><%= image.file_name %></p>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
