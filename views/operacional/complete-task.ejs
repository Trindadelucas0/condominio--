<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <% var helpModalId = 'modalComoFunciona'; %>
  <% var helpTitle = 'Concluir tarefa'; %>
  <% var resumo = ['Informe o que foi feito e anexe evidências se a tarefa exigir.', 'Ao concluir, a tarefa sai da lista de pendentes do operacional.', 'O síndico pode acompanhar as tarefas concluídas.']; %>
  <% var helpModalContent = '<p>Preencha a conclusão da tarefa. Se for obrigatório, anexe fotos como evidência. Após salvar, a tarefa será marcada como concluída.</p>'; %>
  <div class="max-w-3xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Concluir Tarefa</h1>
        <p class="text-gray-600 mt-2">Preencha os dados de conclusão da tarefa</p>
      </div>
      <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Informações da Tarefa -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Informações da Tarefa</h2>
      <div class="space-y-2">
        <p><span class="font-semibold">Título:</span> <%= task.title %></p>
        <% if (task.description) { %>
          <p><span class="font-semibold">Descrição:</span> <%= task.description %></p>
        <% } %>
        <p><span class="font-semibold">Prazo:</span> <%= new Date(task.due_date).toLocaleDateString('pt-BR') %></p>
        <p><span class="font-semibold">Prioridade:</span> <%= task.priority %></p>
        <% if (task.evidence_required === true) { %>
          <div class="mt-4 p-3 bg-yellow-50 border-l-4 border-yellow-500 rounded">
            <p class="text-yellow-800 font-semibold">
              <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              Evidências Obrigatórias
            </p>
            <p class="text-sm text-yellow-700 mt-1">
              Esta tarefa requer pelo menos uma foto como evidência. <%= task.evidences && task.evidences.length > 0 ? `Você já anexou ${task.evidences.length} foto(s).` : 'Por favor, anexe fotos antes de concluir.' %>
            </p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Formulário de Conclusão -->
    <div class="bg-white rounded-lg shadow p-6">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/operacional/tarefas/<%= task.id %>/finalizar" enctype="multipart/form-data">
        <% if (task.evidence_required === true) { %>
        <!-- Fotos / Evidências (obrigatório quando a tarefa exige) -->
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-lg">
          <label for="evidences" class="block text-gray-800 font-semibold mb-2">
            Fotos da execução <span class="text-red-600">*</span>
          </label>
          <p class="text-sm text-gray-600 mb-3">
            Esta tarefa exige pelo menos uma foto como evidência. Envie de 1 a 5 imagens (JPG, PNG, etc.).
          </p>
          <input
            type="file"
            id="evidences"
            name="evidences"
            accept="image/*"
            multiple
            <%= (!task.evidences || task.evidences.length === 0) ? 'required' : '' %>
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-amber-100 file:text-amber-800 file:font-semibold hover:file:bg-amber-200"
          >
          <% if (task.evidences && task.evidences.length > 0) { %>
            <p class="text-sm text-green-700 mt-2">Você já tem <%= task.evidences.length %> foto(s) anexada(s). Pode enviar mais ou concluir.</p>
          <% } %>
        </div>
        <% } %>

        <!-- Sucesso na Conclusão (obrigatório) -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">
            A tarefa foi concluída com sucesso? <span class="text-red-600">*</span>
          </label>
          <div class="flex gap-4">
            <label class="flex items-center">
              <input type="radio" name="completion_success" value="true" required 
                     <%= formData && formData.completion_success === 'true' ? 'checked' : '' %>>
              <span class="ml-2">Sim</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="completion_success" value="false" required
                     <%= formData && formData.completion_success === 'false' ? 'checked' : '' %>>
              <span class="ml-2">Não</span>
            </label>
          </div>
        </div>

        <!-- Observações Finais -->
        <div class="mb-6">
          <label for="completion_notes" class="block text-gray-700 font-semibold mb-2">
            Observações Finais
          </label>
          <textarea
            id="completion_notes"
            name="completion_notes"
            rows="4"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva como foi a execução da tarefa, resultados obtidos, etc."
          ><%= formData && formData.completion_notes ? formData.completion_notes : '' %></textarea>
        </div>

        <!-- Teve Contratempos -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">
            Houve contratempos durante a execução?
          </label>
          <div class="flex gap-4">
            <label class="flex items-center">
              <input type="radio" name="had_issues" value="true"
                     <%= formData && formData.had_issues === 'true' ? 'checked' : '' %>>
              <span class="ml-2">Sim</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="had_issues" value="false" checked>
              <span class="ml-2">Não</span>
            </label>
          </div>
        </div>

        <!-- Descrição dos Contratempos -->
        <div class="mb-6" id="issues-description-section" style="display: none;">
          <label for="issues_description" class="block text-gray-700 font-semibold mb-2">
            Descreva os contratempos encontrados
          </label>
          <textarea
            id="issues_description"
            name="issues_description"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva os problemas, dificuldades ou contratempos que ocorreram..."
          ><%= formData && formData.issues_description ? formData.issues_description : '' %></textarea>
        </div>

        <!-- Tempo Gasto -->
        <div class="mb-6">
          <label for="completion_time_minutes" class="block text-gray-700 font-semibold mb-2">
            Tempo gasto (em minutos)
          </label>
          <input
            type="number"
            id="completion_time_minutes"
            name="completion_time_minutes"
            min="1"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 120 (para 2 horas)"
            value="<%= formData && formData.completion_time_minutes ? formData.completion_time_minutes : '' %>"
          >
        </div>

        <!-- Qualidade da Execução -->
        <div class="mb-6">
          <label for="completion_quality" class="block text-gray-700 font-semibold mb-2">
            Qualidade da execução
          </label>
          <select
            id="completion_quality"
            name="completion_quality"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Selecione...</option>
            <option value="EXCELENTE" <%= formData && formData.completion_quality === 'EXCELENTE' ? 'selected' : '' %>>Excelente</option>
            <option value="BOM" <%= formData && formData.completion_quality === 'BOM' ? 'selected' : '' %>>Bom</option>
            <option value="REGULAR" <%= formData && formData.completion_quality === 'REGULAR' ? 'selected' : '' %>>Regular</option>
            <option value="RUIM" <%= formData && formData.completion_quality === 'RUIM' ? 'selected' : '' %>>Ruim</option>
          </select>
        </div>

        <!-- Botões -->
        <div class="flex gap-4">
          <button
            type="submit"
            class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition"
          >
            Concluir Tarefa
          </button>
          <a
            href="/operacional/checklist"
            class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400 transition"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Mostra/esconde campo de descrição de contratempos
document.querySelectorAll('input[name="had_issues"]').forEach(radio => {
  radio.addEventListener('change', function() {
    const issuesSection = document.getElementById('issues-description-section');
    if (this.value === 'true') {
      issuesSection.style.display = 'block';
      document.getElementById('issues_description').required = true;
    } else {
      issuesSection.style.display = 'none';
      document.getElementById('issues_description').required = false;
    }
  });
});

// Verifica estado inicial
if (document.querySelector('input[name="had_issues"]:checked')?.value === 'true') {
  document.getElementById('issues-description-section').style.display = 'block';
}
</script>

<%- include('../partials/footer') %>
