<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-3xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Resolver Ocorrência</h1>
      <p class="text-gray-600 mt-2">Preencha os dados de resolução da ocorrência</p>
    </div>

    <!-- Informações da Ocorrência -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Informações da Ocorrência</h2>
      <div class="space-y-2">
        <p><span class="font-semibold">Título:</span> <%= occurrence.title %></p>
        <p><span class="font-semibold">Descrição:</span> <%= occurrence.description %></p>
        <% if (occurrence.location) { %>
          <p><span class="font-semibold">Localização:</span> <%= occurrence.location %></p>
        <% } %>
        <p><span class="font-semibold">Prioridade:</span> <%= occurrence.priority %></p>
        <p><span class="font-semibold">Status:</span> <%= occurrence.status %></p>
        <p><span class="font-semibold">Data de criação:</span> <%= new Date(occurrence.created_at).toLocaleString('pt-BR') %></p>
      </div>
    </div>

    <!-- Formulário de Resolução -->
    <div class="bg-white rounded-lg shadow p-6">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/operacional/ocorrencias/<%= occurrence.id %>/resolver">
        <!-- Sucesso na Resolução (obrigatório) -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">
            A ocorrência foi resolvida com sucesso? <span class="text-red-600">*</span>
          </label>
          <div class="flex gap-4">
            <label class="flex items-center">
              <input type="radio" name="resolution_success" value="true" required
                     <%= formData && formData.resolution_success === 'true' ? 'checked' : '' %>>
              <span class="ml-2">Sim</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="resolution_success" value="false" required
                     <%= formData && formData.resolution_success === 'false' ? 'checked' : '' %>>
              <span class="ml-2">Não</span>
            </label>
          </div>
        </div>

        <!-- Notas de Resolução (obrigatório) -->
        <div class="mb-6">
          <label for="resolution_notes" class="block text-gray-700 font-semibold mb-2">
            Notas de Resolução <span class="text-red-600">*</span>
          </label>
          <textarea
            id="resolution_notes"
            name="resolution_notes"
            rows="4"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva como a ocorrência foi resolvida, o que foi feito, soluções aplicadas, etc."
          ><%= formData && formData.resolution_notes ? formData.resolution_notes : '' %></textarea>
        </div>

        <!-- Método de Resolução -->
        <div class="mb-6">
          <label for="resolution_method" class="block text-gray-700 font-semibold mb-2">
            Método de Resolução
          </label>
          <select
            id="resolution_method"
            name="resolution_method"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Selecione...</option>
            <option value="INTERNA" <%= formData && formData.resolution_method === 'INTERNA' ? 'selected' : '' %>>Resolução Interna</option>
            <option value="TERCEIRO" <%= formData && formData.resolution_method === 'TERCEIRO' ? 'selected' : '' %>>Terceirizado</option>
            <option value="MANUTENCAO" <%= formData && formData.resolution_method === 'MANUTENCAO' ? 'selected' : '' %>>Manutenção</option>
            <option value="OUTRA" <%= formData && formData.resolution_method === 'OUTRA' ? 'selected' : '' %>>Outra</option>
          </select>
        </div>

        <!-- Custo da Resolução -->
        <div class="mb-6">
          <label for="resolution_cost" class="block text-gray-700 font-semibold mb-2">
            Custo da Resolução (R$)
          </label>
          <input
            type="number"
            id="resolution_cost"
            name="resolution_cost"
            step="0.01"
            min="0"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="0.00"
            value="<%= formData && formData.resolution_cost ? formData.resolution_cost : '' %>"
          >
        </div>

        <!-- Teve Complicações -->
        <div class="mb-6">
          <label class="block text-gray-700 font-semibold mb-2">
            Houve complicações durante a resolução?
          </label>
          <div class="flex gap-4">
            <label class="flex items-center">
              <input type="radio" name="had_complications" value="true"
                     <%= formData && formData.had_complications === 'true' ? 'checked' : '' %>>
              <span class="ml-2">Sim</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="had_complications" value="false" checked>
              <span class="ml-2">Não</span>
            </label>
          </div>
        </div>

        <!-- Descrição das Complicações -->
        <div class="mb-6" id="complications-description-section" style="display: none;">
          <label for="complications_description" class="block text-gray-700 font-semibold mb-2">
            Descreva as complicações encontradas
          </label>
          <textarea
            id="complications_description"
            name="complications_description"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva as complicações, problemas adicionais ou dificuldades encontradas..."
          ><%= formData && formData.complications_description ? formData.complications_description : '' %></textarea>
        </div>

        <!-- Tempo Gasto -->
        <div class="mb-6">
          <label for="resolution_time_minutes" class="block text-gray-700 font-semibold mb-2">
            Tempo gasto na resolução (em minutos)
          </label>
          <input
            type="number"
            id="resolution_time_minutes"
            name="resolution_time_minutes"
            min="1"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Ex: 90 (para 1h30min)"
            value="<%= formData && formData.resolution_time_minutes ? formData.resolution_time_minutes : '' %>"
          >
        </div>

        <!-- Medidas Preventivas -->
        <div class="mb-6">
          <label for="preventive_measures" class="block text-gray-700 font-semibold mb-2">
            Medidas Preventivas Tomadas
          </label>
          <textarea
            id="preventive_measures"
            name="preventive_measures"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="Descreva medidas preventivas tomadas para evitar que o problema ocorra novamente..."
          ><%= formData && formData.preventive_measures ? formData.preventive_measures : '' %></textarea>
        </div>

        <!-- Botões -->
        <div class="flex gap-4">
          <button
            type="submit"
            class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition"
          >
            Resolver Ocorrência
          </button>
          <a
            href="/operacional/ocorrencias"
            class="bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400 transition"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Mostra/esconde campo de descrição de complicações
document.querySelectorAll('input[name="had_complications"]').forEach(radio => {
  radio.addEventListener('change', function() {
    const complicationsSection = document.getElementById('complications-description-section');
    if (this.value === 'true') {
      complicationsSection.style.display = 'block';
      document.getElementById('complications_description').required = true;
    } else {
      complicationsSection.style.display = 'none';
      document.getElementById('complications_description').required = false;
    }
  });
});

// Verifica estado inicial
if (document.querySelector('input[name="had_complications"]:checked')?.value === 'true') {
  document.getElementById('complications-description-section').style.display = 'block';
}
</script>

<%- include('../partials/footer') %>
