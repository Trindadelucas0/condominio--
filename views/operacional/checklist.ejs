<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Checklist</h1>
    <p class="text-gray-600 mt-2">Tarefas e checklist do dia</p>
  </div>

  <!-- Mensagens -->
  <% if (typeof query !== 'undefined' && query.success === 'completed') { %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      Tarefa finalizada com sucesso!
    </div>
  <% } %>

  <!-- Lista de tarefas -->
  <div class="space-y-4">
    <% if (tasks.length === 0) { %>
      <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
        <p>Nenhuma tarefa pendente no momento.</p>
      </div>
    <% } else { %>
      <% tasks.forEach(task => { %>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex justify-between items-start mb-4">
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-800"><%= task.title %></h3>
              <% if (task.description) { %>
                <p class="text-gray-600 mt-1"><%= task.description %></p>
              <% } %>
              <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                <span>Vencimento: <strong><%= new Date(task.due_date).toLocaleDateString('pt-BR') %></strong></span>
                <% if (new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                  <span class="text-red-600 font-semibold">ATRASADO</span>
                <% } %>
              </div>
            </div>
            <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
              <%= task.status %>
            </span>
          </div>

          <!-- Checklist items -->
          <% if (task.checklists && task.checklists.length > 0) { %>
            <div class="border-t pt-4">
              <h4 class="font-semibold text-gray-700 mb-3">Itens do Checklist:</h4>
              <div class="space-y-2">
                <% task.checklists.forEach(item => { %>
                  <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded">
                    <form method="POST" action="/operacional/checklist/<%= item.id %>/atualizar" class="flex-1" id="form-<%= item.id %>">
                      <div class="flex items-center space-x-3">
                        <input
                          type="radio"
                          name="status"
                          value="DONE"
                          id="done-<%= item.id %>"
                          <%= item.status === 'DONE' ? 'checked' : '' %>
                          onchange="handleStatusChange(<%= item.id %>, 'DONE')"
                          class="text-green-600"
                        />
                        <label for="done-<%= item.id %>" class="flex-1 cursor-pointer"><%= item.item_name %></label>
                        <input
                          type="radio"
                          name="status"
                          value="NOT_DONE"
                          id="notdone-<%= item.id %>"
                          <%= item.status === 'NOT_DONE' ? 'checked' : '' %>
                          onchange="handleStatusChange(<%= item.id %>, 'NOT_DONE')"
                          class="text-red-600"
                        />
                        <label for="notdone-<%= item.id %>" class="cursor-pointer">Não Feito</label>
                      </div>
                      <div id="comment-section-<%= item.id %>" class="mt-2" style="display: <%= item.status === 'NOT_DONE' ? 'block' : 'none' %>">
                        <textarea
                          name="comment"
                          id="comment-<%= item.id %>"
                          placeholder="Justificativa obrigatória"
                          rows="2"
                          class="w-full px-3 py-2 border border-red-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                        ><%= item.comment || '' %></textarea>
                        <button type="button" onclick="submitChecklistItem(<%= item.id %>)" class="mt-2 text-sm bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700">
                          Salvar Justificativa
                        </button>
                      </div>
                      <% if (item.comment && item.status === 'NOT_DONE') { %>
                        <p class="mt-1 text-sm text-red-600"><%= item.comment %></p>
                      <% } %>
                    </form>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Botão finalizar -->
          <% if (task.status !== 'COMPLETED') { %>
            <div class="border-t pt-4 mt-4">
              <a href="/operacional/tarefas/<%= task.id %>/concluir" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700 transition inline-block">
                Concluir Tarefa (Formulário Estruturado)
              </a>
            </div>
          <% } else { %>
            <div class="border-t pt-4 mt-4">
              <div class="bg-green-50 border border-green-200 rounded p-4">
                <p class="text-green-800 font-semibold mb-2">✓ Tarefa concluída em <%= new Date(task.completed_at).toLocaleString('pt-BR') %></p>
                <% if (task.completion_success !== null) { %>
                  <p class="text-sm text-gray-700">
                    <span class="font-semibold">Sucesso:</span> <%= task.completion_success ? 'Sim' : 'Não' %>
                  </p>
                <% } %>
                <% if (task.completion_notes) { %>
                  <p class="text-sm text-gray-700 mt-1">
                    <span class="font-semibold">Observações:</span> <%= task.completion_notes %>
                  </p>
                <% } %>
                <% if (task.had_issues) { %>
                  <p class="text-sm text-orange-700 mt-1">
                    <span class="font-semibold">⚠ Contratempos:</span> <%= task.issues_description || 'Sim' %>
                  </p>
                <% } %>
                <% if (task.completion_quality) { %>
                  <p class="text-sm text-gray-700 mt-1">
                    <span class="font-semibold">Qualidade:</span> <%= task.completion_quality %>
                  </p>
                <% } %>
                <% if (task.completion_time_minutes) { %>
                  <p class="text-sm text-gray-700 mt-1">
                    <span class="font-semibold">Tempo gasto:</span> <%= task.completion_time_minutes %> minutos
                  </p>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<script>
function handleStatusChange(itemId, status) {
  const commentSection = document.getElementById('comment-section-' + itemId);
  const commentField = document.getElementById('comment-' + itemId);
  
  if (status === 'NOT_DONE') {
    // Mostra campo de comentário
    commentSection.style.display = 'block';
    commentField.required = true;
  } else {
    // Esconde campo de comentário e submete direto
    commentSection.style.display = 'none';
    commentField.required = false;
    document.getElementById('form-' + itemId).submit();
  }
}

function submitChecklistItem(itemId) {
  const form = document.getElementById('form-' + itemId);
  const statusField = form.querySelector('input[name="status"]:checked');
  const commentField = document.getElementById('comment-' + itemId);
  
  if (statusField && statusField.value === 'NOT_DONE') {
    if (!commentField.value || commentField.value.trim() === '') {
      alert('Justificativa é obrigatória quando o item não foi feito!');
      commentField.focus();
      return;
    }
  }
  
  form.submit();
}
</script>

<%- include('../partials/footer') %>
