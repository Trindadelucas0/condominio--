<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.02);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .pulse-animation {
    animation: pulse 2s ease-in-out infinite;
  }
  
  .checklist-item {
    transition: all 0.2s ease;
  }
  
  .checklist-item:hover {
    background-color: #f9fafb;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-orange-50/30 to-amber-50/30">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex items-center space-x-3 mb-2">
        <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl p-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-orange-900 to-gray-900 bg-clip-text text-transparent">
            Checklist
          </h1>
          <p class="text-gray-600 mt-1">Tarefas e checklist do dia</p>
        </div>
      </div>
    </div>

    <!-- Filtros e Busca -->
    <div class="mb-6 animate-slide-in">
      <div class="bg-white rounded-2xl shadow-xl p-6">
        <div class="flex items-center space-x-2 mb-4">
          <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
          </svg>
          <h2 class="text-lg font-bold text-gray-800">Filtros</h2>
        </div>
        <form method="GET" action="/operacional/checklist" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Busca Textual -->
            <div class="lg:col-span-2">
              <label for="search" class="block text-sm font-semibold text-gray-700 mb-2">Buscar</label>
              <input 
                type="text" 
                id="search"
                name="search" 
                placeholder="Título ou descrição..." 
                value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>
            
            <!-- Filtro por Prioridade -->
            <div>
              <label for="priority" class="block text-sm font-semibold text-gray-700 mb-2">Prioridade</label>
              <select 
                id="priority"
                name="priority" 
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
                <option value="">Todas</option>
                <option value="URGENTE" <%= typeof query !== 'undefined' && query.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
                <option value="ALTA" <%= typeof query !== 'undefined' && query.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
                <option value="NORMAL" <%= typeof query !== 'undefined' && query.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
                <option value="BAIXA" <%= typeof query !== 'undefined' && query.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
              </select>
            </div>

            <!-- Filtro por Status -->
            <div>
              <label for="status" class="block text-sm font-semibold text-gray-700 mb-2">Status</label>
              <select 
                id="status"
                name="status" 
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
                <option value="">Pendentes</option>
                <option value="PENDING" <%= typeof query !== 'undefined' && query.status === 'PENDING' ? 'selected' : '' %>>Pendente</option>
                <option value="IN_PROGRESS" <%= typeof query !== 'undefined' && query.status === 'IN_PROGRESS' ? 'selected' : '' %>>Em Andamento</option>
                <option value="COMPLETED" <%= typeof query !== 'undefined' && query.status === 'COMPLETED' ? 'selected' : '' %>>Concluída</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Filtro por Data Início -->
            <div>
              <label for="dateFrom" class="block text-sm font-semibold text-gray-700 mb-2">Data de Vencimento (De)</label>
              <input 
                type="date" 
                id="dateFrom"
                name="dateFrom" 
                value="<%= typeof query !== 'undefined' && query.dateFrom ? query.dateFrom : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>

            <!-- Filtro por Data Fim -->
            <div>
              <label for="dateTo" class="block text-sm font-semibold text-gray-700 mb-2">Data de Vencimento (Até)</label>
              <input 
                type="date" 
                id="dateTo"
                name="dateTo" 
                value="<%= typeof query !== 'undefined' && query.dateTo ? query.dateTo : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>
          </div>

          <div class="flex gap-4">
            <button 
              type="submit" 
              class="bg-gradient-to-r from-orange-600 to-amber-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>Aplicar Filtros</span>
            </button>
            <% if (typeof query !== 'undefined' && (query.search || query.priority || query.status || query.dateFrom || query.dateTo)) { %>
            <a href="/operacional/checklist" class="bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-gray-600 transition-colors inline-flex items-center">
              Limpar Filtros
            </a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Mensagem de Sucesso -->
    <% if (typeof query !== 'undefined' && query.success === 'completed') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Tarefa finalizada com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Lista de Tarefas -->
    <div class="space-y-6">
      <% if (tasks.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-xl p-12 text-center animate-slide-in">
          <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-full p-6 w-24 h-24 mx-auto mb-4 flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
          </div>
          <p class="text-xl font-semibold text-gray-700">Nenhuma tarefa pendente no momento.</p>
          <p class="text-gray-500 mt-2">Todas as tarefas foram concluídas!</p>
        </div>
      <% } else { %>
        <% tasks.forEach((task, index) => { %>
          <div class="bg-white rounded-2xl shadow-xl p-6 card-hover-effect animate-slide-in <%= new Date(task.due_date) < new Date() && task.status !== 'COMPLETED' ? 'border-l-4 border-red-500' : '' %>" style="animation-delay: <%= index * 0.1 %>s">
            <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-6 gap-4">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-2xl font-bold text-gray-900"><%= task.title %></h3>
                  <% if (new Date(task.due_date) < new Date() && task.status !== 'COMPLETED') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-red-500 to-red-600 text-white shadow-md pulse-animation">
                      <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                      </svg>
                      ATRASADO
                    </span>
                  <% } %>
                </div>
                <% if (task.description) { %>
                  <p class="text-gray-600 mt-2 leading-relaxed"><%= task.description %></p>
                <% } %>
                <div class="flex flex-wrap items-center gap-4 mt-4">
                  <div class="flex items-center text-sm text-gray-600">
                    <svg class="w-4 h-4 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span>Vencimento: <strong class="text-gray-900"><%= new Date(task.due_date).toLocaleDateString('pt-BR') %></strong></span>
                  </div>
                </div>
              </div>
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-md">
                <%= task.status %>
              </span>
            </div>

            <!-- Checklist Items -->
            <% if (task.checklists && task.checklists.length > 0) { %>
              <div class="border-t border-gray-200 pt-6 mt-6">
                <div class="flex items-center space-x-2 mb-4">
                  <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                  </svg>
                  <h4 class="text-lg font-bold text-gray-900">Itens do Checklist</h4>
                </div>
                <div class="space-y-3">
                  <% task.checklists.forEach(item => { %>
                    <div class="checklist-item bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4 border-l-4 <%= item.status === 'DONE' ? 'border-green-500' : 'border-red-500' %>">
                      <form method="POST" action="/operacional/checklist/<%= item.id %>/atualizar" class="flex-1" id="form-<%= item.id %>">
                        <div class="flex flex-col md:flex-row md:items-center gap-4">
                          <div class="flex-1">
                            <label for="done-<%= item.id %>" class="flex items-center cursor-pointer group">
                              <input
                                type="radio"
                                name="status"
                                value="DONE"
                                id="done-<%= item.id %>"
                                <%= item.status === 'DONE' ? 'checked' : '' %>
                                onchange="handleStatusChange(<%= item.id %>, 'DONE')"
                                class="w-5 h-5 text-green-600 border-gray-300 focus:ring-green-500 cursor-pointer"
                              />
                              <span class="ml-3 text-base font-semibold text-gray-900 group-hover:text-green-600 transition-colors <%= item.status === 'DONE' ? 'line-through text-gray-500' : '' %>">
                                <%= item.item_name %>
                              </span>
                            </label>
                          </div>
                          <div class="flex items-center space-x-4">
                            <label for="notdone-<%= item.id %>" class="flex items-center cursor-pointer group">
                              <input
                                type="radio"
                                name="status"
                                value="NOT_DONE"
                                id="notdone-<%= item.id %>"
                                <%= item.status === 'NOT_DONE' ? 'checked' : '' %>
                                onchange="handleStatusChange(<%= item.id %>, 'NOT_DONE')"
                                class="w-5 h-5 text-red-600 border-gray-300 focus:ring-red-500 cursor-pointer"
                              />
                              <span class="ml-2 text-sm font-semibold text-red-600 group-hover:text-red-700 transition-colors">Não Feito</span>
                            </label>
                          </div>
                        </div>
                        <div id="comment-section-<%= item.id %>" class="mt-4" style="display: <%= item.status === 'NOT_DONE' ? 'block' : 'none' %>">
                          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                            <label class="block text-sm font-bold text-red-800 mb-2">
                              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                              </svg>
                              Justificativa obrigatória
                            </label>
                            <textarea
                              name="comment"
                              id="comment-<%= item.id %>"
                              placeholder="Explique o motivo pelo qual este item não foi concluído..."
                              rows="3"
                              class="w-full px-4 py-3 border-2 border-red-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 transition-all duration-200 resize-none"
                            ><%= item.comment || '' %></textarea>
                            <button type="button" onclick="submitChecklistItem(<%= item.id %>)" class="mt-3 group relative overflow-hidden bg-gradient-to-r from-red-600 to-red-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
                              <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                              <svg class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                              </svg>
                              <span class="relative z-10">Salvar Justificativa</span>
                            </button>
                          </div>
                        </div>
                        <% if (item.comment && item.status === 'NOT_DONE') { %>
                          <div class="mt-3 bg-red-50 border-l-4 border-red-500 rounded-lg p-3">
                            <p class="text-sm text-red-800 font-semibold">Justificativa:</p>
                            <p class="text-sm text-red-700 mt-1"><%= item.comment %></p>
                          </div>
                        <% } %>
                      </form>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <!-- Botão Finalizar / Status de Conclusão -->
            <% if (task.status !== 'COMPLETED') { %>
              <div class="border-t border-gray-200 pt-6 mt-6">
                <a href="/operacional/tarefas/<%= task.id %>/concluir" class="group relative overflow-hidden bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
                  <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                  <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="relative z-10">Concluir Tarefa (Formulário Estruturado)</span>
                </a>
              </div>
            <% } else { %>
              <div class="border-t border-gray-200 pt-6 mt-6">
                <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-xl p-6 shadow-md">
                  <div class="flex items-center space-x-3 mb-4">
                    <div class="bg-green-500 rounded-full p-2">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-green-800 font-bold text-lg">Tarefa Concluída</p>
                      <p class="text-sm text-green-600">Concluída em <%= new Date(task.completed_at).toLocaleString('pt-BR') %></p>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                    <% if (task.completion_success !== null) { %>
                      <div class="bg-white rounded-lg p-3 border border-green-200">
                        <p class="text-xs font-semibold text-gray-600 mb-1">Sucesso</p>
                        <p class="text-sm font-bold <%= task.completion_success ? 'text-green-700' : 'text-red-700' %>">
                          <%= task.completion_success ? 'Sim' : 'Não' %>
                        </p>
                      </div>
                    <% } %>
                    <% if (task.completion_time_minutes) { %>
                      <div class="bg-white rounded-lg p-3 border border-green-200">
                        <p class="text-xs font-semibold text-gray-600 mb-1">Tempo Gasto</p>
                        <p class="text-sm font-bold text-gray-900"><%= task.completion_time_minutes %> minutos</p>
                      </div>
                    <% } %>
                    <% if (task.completion_quality) { %>
                      <div class="bg-white rounded-lg p-3 border border-green-200">
                        <p class="text-xs font-semibold text-gray-600 mb-1">Qualidade</p>
                        <p class="text-sm font-bold text-gray-900"><%= task.completion_quality %></p>
                      </div>
                    <% } %>
                  </div>
                  <% if (task.completion_notes) { %>
                    <div class="mt-4 bg-white rounded-lg p-4 border border-green-200">
                      <p class="text-xs font-semibold text-gray-600 mb-2">Observações</p>
                      <p class="text-sm text-gray-700"><%= task.completion_notes %></p>
                    </div>
                  <% } %>
                  <% if (task.had_issues) { %>
                    <div class="mt-4 bg-gradient-to-r from-orange-50 to-amber-50 border-l-4 border-orange-500 rounded-lg p-4">
                      <div class="flex items-center space-x-2 mb-2">
                        <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <p class="text-sm font-bold text-orange-800">Contratempos</p>
                      </div>
                      <p class="text-sm text-orange-700"><%= task.issues_description || 'Sim' %></p>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Paginação -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 mt-6 animate-slide-in">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div class="text-sm text-gray-600">
            Mostrando <strong><%= ((pagination.page - 1) * pagination.perPage) + 1 %></strong> até 
            <strong><%= Math.min(pagination.page * pagination.perPage, pagination.total) %></strong> 
            de <strong><%= pagination.total %></strong> tarefas
            <span class="text-gray-400">(Página <%= pagination.page %> de <%= pagination.totalPages %>)</span>
          </div>
          <div class="flex items-center space-x-2">
            <% 
              // Construir query string preservando filtros
              const queryParams = new URLSearchParams();
              if (query && query.search) queryParams.set('search', query.search);
              if (query && query.status) queryParams.set('status', query.status);
              if (query && query.priority) queryParams.set('priority', query.priority);
              if (query && query.dateFrom) queryParams.set('dateFrom', query.dateFrom);
              if (query && query.dateTo) queryParams.set('dateTo', query.dateTo);
              if (query && query.perPage) queryParams.set('perPage', query.perPage);
              const queryString = queryParams.toString();
            %>
            <% if (pagination.page > 1) { %>
              <a href="/operacional/checklist?page=<%= pagination.page - 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                <span>Anterior</span>
              </a>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="/operacional/checklist?page=<%= pagination.page + 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <span>Próxima</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
function handleStatusChange(itemId, status) {
  const commentSection = document.getElementById('comment-section-' + itemId);
  const commentField = document.getElementById('comment-' + itemId);
  
  if (status === 'NOT_DONE') {
    // Mostra campo de comentário
    commentSection.style.display = 'block';
    commentField.required = true;
  } else {
    // Esconde campo de comentário e submete direto
    commentSection.style.display = 'none';
    commentField.required = false;
    document.getElementById('form-' + itemId).submit();
  }
}

function submitChecklistItem(itemId) {
  const form = document.getElementById('form-' + itemId);
  const statusField = form.querySelector('input[name="status"]:checked');
  const commentField = document.getElementById('comment-' + itemId);
  
  if (statusField && statusField.value === 'NOT_DONE') {
    if (!commentField.value || commentField.value.trim() === '') {
      alert('Justificativa é obrigatória quando o item não foi feito!');
      commentField.focus();
      return;
    }
  }
  
  form.submit();
}
</script>

