<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Nova Ocorrência</h1>
    <p class="text-gray-600 mt-2">Registre um problema ou ocorrência</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/operacional/ocorrencias">
      <!-- Título -->
      <div class="mb-4">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Título <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          value="<%= ocorrencia ? ocorrencia.title : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Ex: Vazamento no corredor do 2º andar"
        />
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição <span class="text-red-500">*</span>
        </label>
        <textarea
          id="description"
          name="description"
          required
          rows="5"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Descreva o problema em detalhes..."
        ><%= ocorrencia ? ocorrencia.description : '' %></textarea>
      </div>

      <!-- Localização -->
      <div class="mb-4">
        <label for="location" class="block text-sm font-medium text-gray-700 mb-1">
          Localização
        </label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%= ocorrencia ? ocorrencia.location : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Ex: Corredor do 2º andar, Elevador A, etc"
        />
      </div>

      <!-- Prioridade -->
      <div class="mb-4">
        <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">
          Prioridade
        </label>
        <select
          id="priority"
          name="priority"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          <option value="BAIXA" <%= ocorrencia && ocorrencia.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
          <option value="NORMAL" <%= !ocorrencia || ocorrencia.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
          <option value="ALTA" <%= ocorrencia && ocorrencia.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
          <option value="URGENTE" <%= ocorrencia && ocorrencia.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
        </select>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/operacional/ocorrencias"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-orange-600 text-white rounded-md hover:bg-orange-700 transition"
        >
          Criar Ocorrência
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
