<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus {
    transition: all 0.2s ease;
  }
  
  .input-focus:focus {
    border-color: #f97316;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-orange-50/30 to-amber-50/30">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
      <!-- Cabeçalho Moderno -->
      <div class="mb-8 animate-slide-in">
        <div class="flex items-center space-x-3 mb-2">
          <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-orange-900 to-gray-900 bg-clip-text text-transparent">
              <%= ocorrencia ? 'Editar' : 'Nova' %> Ocorrência
            </h1>
            <p class="text-gray-600 mt-1">Registre um problema ou ocorrência</p>
          </div>
        </div>
      </div>

      <!-- Mensagem de Erro -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 animate-slide-in">
          <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
            <div class="bg-red-500 rounded-full p-2">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-red-800">Erro</p>
              <p class="text-sm text-red-600"><%= error %></p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Formulário Moderno -->
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="/operacional/ocorrencias" enctype="multipart/form-data">
          <div class="space-y-6">
            <!-- Título -->
            <div>
              <label for="title" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Título <span class="text-red-500 ml-1">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                required
                value="<%= ocorrencia ? ocorrencia.title : '' %>"
                placeholder="Ex: Vazamento no corredor do 2º andar"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Descrição -->
            <div>
              <label for="description" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
                Descrição <span class="text-red-500 ml-1">*</span>
              </label>
              <textarea
                id="description"
                name="description"
                required
                rows="5"
                placeholder="Descreva o problema em detalhes..."
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 resize-none"
              ><%= ocorrencia ? ocorrencia.description : '' %></textarea>
            </div>

            <!-- Localização -->
            <div>
              <label for="location" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Localização
              </label>
              <input
                type="text"
                id="location"
                name="location"
                value="<%= ocorrencia ? ocorrencia.location : '' %>"
                placeholder="Ex: Corredor do 2º andar, Elevador A, etc"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Prioridade e Tipo em Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Prioridade -->
              <div>
                <label for="priority" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  Prioridade
                </label>
                <select
                  id="priority"
                  name="priority"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="BAIXA" <%= ocorrencia && ocorrencia.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
                  <option value="NORMAL" <%= !ocorrencia || ocorrencia.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
                  <option value="ALTA" <%= ocorrencia && ocorrencia.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
                  <option value="URGENTE" <%= ocorrencia && ocorrencia.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
                </select>
              </div>

              <!-- Tipo de Ocorrência -->
              <div>
                <label for="occurrenceType" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  Tipo de Ocorrência
                </label>
                <select
                  id="occurrenceType"
                  name="occurrenceType"
                  onchange="toggleApprovalFields()"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                >
                  <option value="ROUTINE" <%= ocorrencia && ocorrencia.occurrence_type === 'ROUTINE' ? 'selected' : '' %>>Rotina (está no checklist/rotina)</option>
                  <option value="NON_ROUTINE" <%= !ocorrencia || ocorrencia.occurrence_type === 'NON_ROUTINE' ? 'selected' : '' %>>Fora de Rotina</option>
                  <option value="EMERGENCY" <%= ocorrencia && ocorrencia.occurrence_type === 'EMERGENCY' ? 'selected' : '' %>>Emergência</option>
                </select>
                <p class="text-xs text-gray-500 mt-2">Selecione se está na rotina normal ou é algo fora do comum</p>
              </div>
            </div>

            <!-- Campos de Aprovação (aparecem se não for rotina) -->
            <div id="approvalFields" class="hidden">
              <div class="bg-gradient-to-r from-yellow-50 to-amber-50 border-l-4 border-yellow-500 rounded-xl p-6 shadow-md">
                <div class="flex items-center space-x-3 mb-4">
                  <div class="bg-yellow-500 rounded-lg p-2">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  </div>
                  <h4 class="text-lg font-bold text-gray-900">Configuração de Aprovação</h4>
                </div>
                
                <div class="mb-4">
                  <label class="flex items-center cursor-pointer group">
                    <input type="checkbox" name="requiresApproval" value="true" 
                           <%= ocorrencia && ocorrencia.requires_approval ? 'checked' : '' %>
                           onchange="toggleApprovalDetails()"
                           class="w-5 h-5 text-orange-600 border-gray-300 rounded focus:ring-orange-500 cursor-pointer">
                    <span class="ml-3 text-sm font-semibold text-gray-700 group-hover:text-orange-600 transition-colors">Esta ocorrência precisa de aprovação</span>
                  </label>
                </div>

                <div id="approvalDetails" class="hidden space-y-4 pt-4 border-t border-yellow-200">
                  <div>
                    <label for="approvalRequiredFrom" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                      <svg class="w-4 h-4 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                      Quem deve aprovar?
                    </label>
                    <select
                      id="approvalRequiredFrom"
                      name="approvalRequiredFrom"
                      class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                    >
                      <option value="SINDICO" <%= ocorrencia && ocorrencia.approval_required_from === 'SINDICO' ? 'selected' : 'selected' %>>Síndico</option>
                      <option value="ADMINISTRATIVO" <%= ocorrencia && ocorrencia.approval_required_from === 'ADMINISTRATIVO' ? 'selected' : '' %>>Administrativo</option>
                      <option value="FINANCEIRO" <%= ocorrencia && ocorrencia.approval_required_from === 'FINANCEIRO' ? 'selected' : '' %>>Financeiro</option>
                    </select>
                  </div>

                  <div class="space-y-2">
                    <label class="flex items-center cursor-pointer group">
                      <input type="checkbox" name="isInChecklist" value="true" 
                             <%= ocorrencia && ocorrencia.is_in_checklist ? 'checked' : '' %>
                             class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500 cursor-pointer">
                      <span class="ml-3 text-sm text-gray-700 group-hover:text-orange-600 transition-colors">Está relacionada a um item do checklist diário</span>
                    </label>

                    <label class="flex items-center cursor-pointer group">
                      <input type="checkbox" name="isRoutineTask" value="true" 
                             <%= ocorrencia && ocorrencia.is_routine_task ? 'checked' : '' %>
                             class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500 cursor-pointer">
                      <span class="ml-3 text-sm text-gray-700 group-hover:text-orange-600 transition-colors">É uma tarefa de rotina normal</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <!-- Upload de Imagens -->
            <div>
              <label for="images" class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Imagens (opcional)
              </label>
              <div class="mt-2">
                <input
                  type="file"
                  id="images"
                  name="images"
                  multiple
                  accept="image/*"
                  class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
                />
                <p class="text-xs text-gray-500 mt-2">Você pode selecionar até 10 imagens. Formatos aceitos: JPG, PNG, GIF. Tamanho máximo: 10MB por imagem.</p>
              </div>
              <div id="imagePreview" class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4 hidden">
                <!-- Preview das imagens será inserido aqui via JavaScript -->
              </div>
            </div>

            <!-- Botões -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
              <a href="/operacional/ocorrencias" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Cancelar</span>
              </a>
              <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-orange-600 to-amber-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
                <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="relative z-10"><%= ocorrencia ? 'Atualizar' : 'Criar' %> Ocorrência</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleApprovalFields() {
    const occurrenceType = document.getElementById('occurrenceType').value;
    const approvalFields = document.getElementById('approvalFields');
    
    if (occurrenceType === 'ROUTINE') {
      approvalFields.classList.add('hidden');
      document.querySelector('input[name="requiresApproval"]').checked = false;
      toggleApprovalDetails();
    } else {
      approvalFields.classList.remove('hidden');
      if (occurrenceType === 'EMERGENCY') {
        document.querySelector('input[name="requiresApproval"]').checked = true;
        toggleApprovalDetails();
      }
    }
  }

  function toggleApprovalDetails() {
    const requiresApproval = document.querySelector('input[name="requiresApproval"]').checked;
    const approvalDetails = document.getElementById('approvalDetails');
    
    if (requiresApproval) {
      approvalDetails.classList.remove('hidden');
    } else {
      approvalDetails.classList.add('hidden');
    }
  }

  // Inicializar ao carregar
  document.addEventListener('DOMContentLoaded', function() {
    toggleApprovalFields();
    toggleApprovalDetails();
    
    // Preview de imagens
    const imageInput = document.getElementById('images');
    const imagePreview = document.getElementById('imagePreview');
    
    if (imageInput) {
      imageInput.addEventListener('change', function(e) {
        const files = e.target.files;
        imagePreview.innerHTML = '';
        
        if (files.length > 0) {
          imagePreview.classList.remove('hidden');
          
          Array.from(files).forEach((file, index) => {
            if (file.type.startsWith('image/')) {
              const reader = new FileReader();
              reader.onload = function(e) {
                const div = document.createElement('div');
                div.className = 'relative';
                div.innerHTML = `
                  <img src="${e.target.result}" alt="Preview ${index + 1}" class="w-full h-32 object-cover rounded-lg border-2 border-gray-200">
                  <button type="button" onclick="removeImage(${index})" class="absolute top-1 right-1 bg-red-500 text-white rounded-full p-1 hover:bg-red-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                `;
                imagePreview.appendChild(div);
              };
              reader.readAsDataURL(file);
            }
          });
        } else {
          imagePreview.classList.add('hidden');
        }
      });
    }
  });
  
  function removeImage(index) {
    const imageInput = document.getElementById('images');
    const dt = new DataTransfer();
    const files = Array.from(imageInput.files);
    
    files.forEach((file, i) => {
      if (i !== index) {
        dt.items.add(file);
      }
    });
    
    imageInput.files = dt.files;
    imageInput.dispatchEvent(new Event('change'));
  }
</script>

<%- include('../partials/footer') %>
