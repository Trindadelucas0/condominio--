<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Nova Ocorrência</h1>
    <p class="text-gray-600 mt-2">Registre um problema ou ocorrência</p>
  </div>

  <!-- Mensagem de erro -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= error %>
    </div>
  <% } %>

  <!-- Formulário -->
  <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
    <form method="POST" action="/operacional/ocorrencias">
      <!-- Título -->
      <div class="mb-4">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Título <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          value="<%= ocorrencia ? ocorrencia.title : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Ex: Vazamento no corredor do 2º andar"
        />
      </div>

      <!-- Descrição -->
      <div class="mb-4">
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
          Descrição <span class="text-red-500">*</span>
        </label>
        <textarea
          id="description"
          name="description"
          required
          rows="5"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Descreva o problema em detalhes..."
        ><%= ocorrencia ? ocorrencia.description : '' %></textarea>
      </div>

      <!-- Localização -->
      <div class="mb-4">
        <label for="location" class="block text-sm font-medium text-gray-700 mb-1">
          Localização
        </label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%= ocorrencia ? ocorrencia.location : '' %>"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          placeholder="Ex: Corredor do 2º andar, Elevador A, etc"
        />
      </div>

      <!-- Prioridade -->
      <div class="mb-4">
        <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">
          Prioridade
        </label>
        <select
          id="priority"
          name="priority"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          <option value="BAIXA" <%= ocorrencia && ocorrencia.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
          <option value="NORMAL" <%= !ocorrencia || ocorrencia.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
          <option value="ALTA" <%= ocorrencia && ocorrencia.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
          <option value="URGENTE" <%= ocorrencia && ocorrencia.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
        </select>
      </div>

      <!-- Tipo de Ocorrência -->
      <div class="mb-4">
        <label for="occurrenceType" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de Ocorrência
        </label>
        <select
          id="occurrenceType"
          name="occurrenceType"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
          onchange="toggleApprovalFields()"
        >
          <option value="ROUTINE" <%= ocorrencia && ocorrencia.occurrence_type === 'ROUTINE' ? 'selected' : '' %>>Rotina (está no checklist/rotina)</option>
          <option value="NON_ROUTINE" <%= !ocorrencia || ocorrencia.occurrence_type === 'NON_ROUTINE' ? 'selected' : '' %>>Fora de Rotina</option>
          <option value="EMERGENCY" <%= ocorrencia && ocorrencia.occurrence_type === 'EMERGENCY' ? 'selected' : '' %>>Emergência</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">Selecione se está na rotina normal ou é algo fora do comum</p>
      </div>

      <!-- Campos de Aprovação (aparecem se não for rotina) -->
      <div id="approvalFields" class="mb-4 hidden">
        <div class="bg-yellow-50 border border-yellow-200 rounded p-4">
          <h4 class="text-sm font-semibold text-yellow-800 mb-3">Configuração de Aprovação</h4>
          
          <div class="mb-3">
            <label class="flex items-center">
              <input type="checkbox" name="requiresApproval" value="true" 
                     <%= ocorrencia && ocorrencia.requires_approval ? 'checked' : '' %>
                     onchange="toggleApprovalDetails()"
                     class="mr-2">
              <span class="text-sm text-gray-700">Esta ocorrência precisa de aprovação</span>
            </label>
          </div>

          <div id="approvalDetails" class="hidden space-y-3">
            <div>
              <label for="approvalRequiredFrom" class="block text-sm font-medium text-gray-700 mb-1">
                Quem deve aprovar?
              </label>
              <select
                id="approvalRequiredFrom"
                name="approvalRequiredFrom"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500"
              >
                <option value="SINDICO" <%= ocorrencia && ocorrencia.approval_required_from === 'SINDICO' ? 'selected' : 'selected' %>>Síndico</option>
                <option value="ADMINISTRATIVO" <%= ocorrencia && ocorrencia.approval_required_from === 'ADMINISTRATIVO' ? 'selected' : '' %>>Administrativo</option>
                <option value="FINANCEIRO" <%= ocorrencia && ocorrencia.approval_required_from === 'FINANCEIRO' ? 'selected' : '' %>>Financeiro</option>
              </select>
            </div>

            <div>
              <label class="flex items-center">
                <input type="checkbox" name="isInChecklist" value="true" 
                       <%= ocorrencia && ocorrencia.is_in_checklist ? 'checked' : '' %>
                       class="mr-2">
                <span class="text-sm text-gray-700">Está relacionada a um item do checklist diário</span>
              </label>
            </div>

            <div>
              <label class="flex items-center">
                <input type="checkbox" name="isRoutineTask" value="true" 
                       <%= ocorrencia && ocorrencia.is_routine_task ? 'checked' : '' %>
                       class="mr-2">
                <span class="text-sm text-gray-700">É uma tarefa de rotina normal</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Botões -->
      <div class="flex justify-end space-x-4">
        <a
          href="/operacional/ocorrencias"
          class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="px-6 py-2 bg-orange-600 text-white rounded-md hover:bg-orange-700 transition"
        >
          Criar Ocorrência
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleApprovalFields() {
    const occurrenceType = document.getElementById('occurrenceType').value;
    const approvalFields = document.getElementById('approvalFields');
    
    if (occurrenceType === 'ROUTINE') {
      approvalFields.classList.add('hidden');
      document.querySelector('input[name="requiresApproval"]').checked = false;
      toggleApprovalDetails();
    } else {
      approvalFields.classList.remove('hidden');
      if (occurrenceType === 'EMERGENCY') {
        document.querySelector('input[name="requiresApproval"]').checked = true;
        toggleApprovalDetails();
      }
    }
  }

  function toggleApprovalDetails() {
    const requiresApproval = document.querySelector('input[name="requiresApproval"]').checked;
    const approvalDetails = document.getElementById('approvalDetails');
    
    if (requiresApproval) {
      approvalDetails.classList.remove('hidden');
    } else {
      approvalDetails.classList.add('hidden');
    }
  }

  // Inicializar ao carregar
  document.addEventListener('DOMContentLoaded', function() {
    toggleApprovalFields();
    toggleApprovalDetails();
  });
</script>

<%- include('../partials/footer') %>
