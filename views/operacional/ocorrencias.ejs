<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-animate {
    animation: fadeInUp 0.4s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .status-badge {
    transition: all 0.2s ease;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-orange-50/30 to-amber-50/30">
  <div class="container mx-auto px-4 py-8">
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div class="flex items-center space-x-3">
          <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-orange-900 to-gray-900 bg-clip-text text-transparent">
              Ocorrências
            </h1>
            <p class="text-gray-600 mt-1">Problemas e ocorrências reportadas</p>
          </div>
        </div>
        <a href="/operacional/ocorrencias/nova" class="group relative overflow-hidden bg-gradient-to-r from-orange-600 to-amber-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="relative z-10">Nova Ocorrência</span>
        </a>
      </div>
    </div>

    <!-- Mensagens de Sucesso -->
    <% if (typeof query !== 'undefined' && query.success === 'created') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Ocorrência criada com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.success === 'resolved') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Ocorrência resolvida com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>

  <!-- Lista de ocorrências -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (occurrences.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma ocorrência registrada.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% occurrences.forEach(occurrence => { %>
          <div class="p-6">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-lg font-bold text-gray-900"><%= occurrence.title %></h3>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                    <%= occurrence.status %>
                  </span>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                    <%= occurrence.priority %>
                  </span>
                </div>
                <p class="text-gray-700 mb-2"><%= occurrence.description %></p>
                <% if (occurrence.location) { %>
                  <p class="text-sm text-gray-600 mb-2">
                    <strong>Local:</strong> <%= occurrence.location %>
                  </p>
                <% } %>
                <p class="text-sm text-gray-500">
                  Criada em <%= new Date(occurrence.created_at).toLocaleString('pt-BR') %>
                  <% if (occurrence.resolved_at) { %>
                    • Resolvida em <%= new Date(occurrence.resolved_at).toLocaleString('pt-BR') %>
                  <% } %>
                </p>
                <% if (occurrence.status === 'RESOLVIDA' || occurrence.status === 'ENCERRADA') { %>
                  <div class="bg-green-50 border border-green-200 rounded p-3 mt-3">
                    <% if (occurrence.resolution_success !== null) { %>
                      <p class="text-sm text-gray-700">
                        <span class="font-semibold">Resolução bem sucedida:</span> <%= occurrence.resolution_success ? 'Sim' : 'Não' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_notes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Notas:</span> <%= occurrence.resolution_notes %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_method) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Método:</span> <%= occurrence.resolution_method %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_cost) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Custo:</span> R$ <%= parseFloat(occurrence.resolution_cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                      </p>
                    <% } %>
                    <% if (occurrence.had_complications) { %>
                      <p class="text-sm text-orange-700 mt-1">
                        <span class="font-semibold">⚠ Complicações:</span> <%= occurrence.complications_description || 'Sim' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_time_minutes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Tempo gasto:</span> <%= occurrence.resolution_time_minutes %> minutos
                      </p>
                    <% } %>
                    <% if (occurrence.preventive_measures) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Medidas preventivas:</span> <%= occurrence.preventive_measures %>
                      </p>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <div class="ml-4">
                <% if (occurrence.status !== 'RESOLVIDA' && occurrence.status !== 'ENCERRADA') { %>
                  <a href="/operacional/ocorrencias/<%= occurrence.id %>/resolver" 
                     class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition text-sm">
                    Resolver
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
