<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-animate {
    animation: fadeInUp 0.4s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .status-badge {
    transition: all 0.2s ease;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-orange-50/30 to-amber-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Ocorrências'; %>
    <% var resumo = ['Lista de ocorrências atribuídas a você; filtre por status e busca.', 'Abra uma ocorrência para ver detalhes e atualizar andamento.', 'Crie nova ocorrência para registrar problemas.']; %>
    <% var helpModalContent = '<p>Veja e gerencie as ocorrências. Filtre por status, abra para detalhes e atualizações. Use Nova Ocorrência para registrar um problema.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center space-x-3">
            <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl p-3 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-orange-900 to-gray-900 bg-clip-text text-transparent">
                Ocorrências
              </h1>
              <p class="text-gray-600 mt-1">Problemas e ocorrências reportadas ou atribuídas a você</p>
            </div>
          </div>
          <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
        </div>
        <a href="/operacional/ocorrencias/nova" class="group relative overflow-hidden bg-gradient-to-r from-orange-600 to-amber-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="relative z-10">Nova Ocorrência</span>
        </a>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Filtros e Busca -->
    <div class="mb-6 animate-slide-in">
      <div class="bg-white rounded-2xl shadow-xl p-6">
        <div class="flex items-center space-x-2 mb-4">
          <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
          </svg>
          <h2 class="text-lg font-bold text-gray-800">Filtros</h2>
        </div>
        <form method="GET" action="/operacional/ocorrencias" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <!-- Busca Textual -->
            <div class="lg:col-span-2">
              <label for="search" class="block text-sm font-semibold text-gray-700 mb-2">Buscar</label>
              <input 
                type="text" 
                id="search"
                name="search" 
                placeholder="Título, descrição ou localização..." 
                value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>
            
            <!-- Filtro por Prioridade -->
            <div>
              <label for="priority" class="block text-sm font-semibold text-gray-700 mb-2">Prioridade</label>
              <select 
                id="priority"
                name="priority" 
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
                <option value="">Todas</option>
                <option value="URGENTE" <%= typeof query !== 'undefined' && query.priority === 'URGENTE' ? 'selected' : '' %>>Urgente</option>
                <option value="ALTA" <%= typeof query !== 'undefined' && query.priority === 'ALTA' ? 'selected' : '' %>>Alta</option>
                <option value="NORMAL" <%= typeof query !== 'undefined' && query.priority === 'NORMAL' ? 'selected' : '' %>>Normal</option>
                <option value="BAIXA" <%= typeof query !== 'undefined' && query.priority === 'BAIXA' ? 'selected' : '' %>>Baixa</option>
              </select>
            </div>

            <!-- Filtro por Status -->
            <div>
              <label for="status" class="block text-sm font-semibold text-gray-700 mb-2">Status</label>
              <select 
                id="status"
                name="status" 
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
                <option value="">Todas</option>
                <option value="ABERTA" <%= typeof query !== 'undefined' && query.status === 'ABERTA' ? 'selected' : '' %>>Aberta</option>
                <option value="EM_ATENDIMENTO" <%= typeof query !== 'undefined' && query.status === 'EM_ATENDIMENTO' ? 'selected' : '' %>>Em Atendimento</option>
                <option value="RESOLVIDA" <%= typeof query !== 'undefined' && query.status === 'RESOLVIDA' ? 'selected' : '' %>>Resolvida</option>
                <option value="ENCERRADA" <%= typeof query !== 'undefined' && query.status === 'ENCERRADA' ? 'selected' : '' %>>Encerrada</option>
              </select>
            </div>
            
            <!-- Filtro por Tipo (Minhas / Atribuídas) -->
            <div>
              <label for="assignedToMe" class="block text-sm font-semibold text-gray-700 mb-2">Tipo</label>
              <select 
                id="assignedToMe"
                name="assignedToMe" 
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
                <option value="">Todas</option>
                <option value="assigned" <%= typeof query !== 'undefined' && query.assignedToMe === 'assigned' ? 'selected' : '' %>>Atribuídas a mim</option>
                <option value="reported" <%= typeof query !== 'undefined' && query.assignedToMe === 'reported' ? 'selected' : '' %>>Criadas por mim</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Filtro por Data Início -->
            <div>
              <label for="dateFrom" class="block text-sm font-semibold text-gray-700 mb-2">Data de Criação (De)</label>
              <input 
                type="date" 
                id="dateFrom"
                name="dateFrom" 
                value="<%= typeof query !== 'undefined' && query.dateFrom ? query.dateFrom : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>

            <!-- Filtro por Data Fim -->
            <div>
              <label for="dateTo" class="block text-sm font-semibold text-gray-700 mb-2">Data de Criação (Até)</label>
              <input 
                type="date" 
                id="dateTo"
                name="dateTo" 
                value="<%= typeof query !== 'undefined' && query.dateTo ? query.dateTo : '' %>"
                class="w-full px-4 py-2 rounded-xl border-2 border-gray-300 focus:border-orange-500 focus:outline-none transition-colors"
              >
            </div>
          </div>

          <div class="flex gap-4">
            <button 
              type="submit" 
              class="bg-gradient-to-r from-orange-600 to-amber-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>Aplicar Filtros</span>
            </button>
            <% if (typeof query !== 'undefined' && (query.search || query.priority || query.status || query.dateFrom || query.dateTo)) { %>
            <a href="/operacional/ocorrencias" class="bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-gray-600 transition-colors inline-flex items-center">
              Limpar Filtros
            </a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Mensagens de Sucesso -->
    <% if (typeof query !== 'undefined' && query.success === 'created') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Ocorrência criada com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>
    <% if (typeof query !== 'undefined' && query.success === 'resolved') { %>
      <div class="mb-6 animate-slide-in">
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
          <div class="bg-green-500 rounded-full p-2">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-green-800">Sucesso!</p>
            <p class="text-sm text-green-600">Ocorrência resolvida com sucesso!</p>
          </div>
        </div>
      </div>
    <% } %>

  <!-- Lista de ocorrências -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% if (occurrences.length === 0) { %>
      <div class="p-8 text-center text-gray-500">
        <p>Nenhuma ocorrência registrada.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-200">
        <% occurrences.forEach(occurrence => { %>
          <% const isAssignedToMe = occurrence.assigned_to && occurrence.assigned_to === user.id && occurrence.reported_by !== user.id; %>
          <div class="p-6 <%= isAssignedToMe ? 'bg-orange-50 border-l-4 border-orange-500' : '' %>">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <h3 class="text-lg font-bold text-gray-900"><%= occurrence.title %></h3>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                    <%= occurrence.status %>
                  </span>
                  <span class="px-3 py-1 text-xs font-semibold rounded bg-gray-100 text-gray-800">
                    <%= occurrence.priority %>
                  </span>
                  <% if (occurrence.assigned_to && occurrence.assigned_to === user.id && occurrence.reported_by !== user.id) { %>
                    <span class="px-3 py-1 text-xs font-semibold rounded bg-orange-100 text-orange-800 flex items-center space-x-1" title="Atribuída a você pelo administrativo">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span>Atribuída a você</span>
                    </span>
                  <% } %>
                </div>
                <p class="text-gray-700 mb-2"><%= occurrence.description %></p>
                <% if (occurrence.location) { %>
                  <p class="text-sm text-gray-600 mb-2">
                    <strong>Local:</strong> <%= occurrence.location %>
                  </p>
                <% } %>
                <p class="text-sm text-gray-500">
                  <% if (occurrence.assigned_to && occurrence.assigned_to === user.id && occurrence.reported_by !== user.id) { %>
                    <span class="text-orange-600 font-semibold">📋 Atribuída a você pelo administrativo</span> • 
                  <% } %>
                  Criada em <%= new Date(occurrence.created_at).toLocaleString('pt-BR') %>
                  <% if (occurrence.triaged_at) { %>
                    • Triada em <%= new Date(occurrence.triaged_at).toLocaleString('pt-BR') %>
                  <% } %>
                  <% if (occurrence.resolved_at) { %>
                    • Resolvida em <%= new Date(occurrence.resolved_at).toLocaleString('pt-BR') %>
                  <% } %>
                </p>
                <% if (occurrence.status === 'RESOLVIDA' || occurrence.status === 'ENCERRADA') { %>
                  <div class="bg-green-50 border border-green-200 rounded p-3 mt-3">
                    <% if (occurrence.resolution_success !== null) { %>
                      <p class="text-sm text-gray-700">
                        <span class="font-semibold">Resolução bem sucedida:</span> <%= occurrence.resolution_success ? 'Sim' : 'Não' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_notes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Notas:</span> <%= occurrence.resolution_notes %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_method) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Método:</span> <%= occurrence.resolution_method %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_cost) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Custo:</span> R$ <%= parseFloat(occurrence.resolution_cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                      </p>
                    <% } %>
                    <% if (occurrence.had_complications) { %>
                      <p class="text-sm text-orange-700 mt-1">
                        <span class="font-semibold">⚠ Complicações:</span> <%= occurrence.complications_description || 'Sim' %>
                      </p>
                    <% } %>
                    <% if (occurrence.resolution_time_minutes) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Tempo gasto:</span> <%= occurrence.resolution_time_minutes %> minutos
                      </p>
                    <% } %>
                    <% if (occurrence.preventive_measures) { %>
                      <p class="text-sm text-gray-700 mt-1">
                        <span class="font-semibold">Medidas preventivas:</span> <%= occurrence.preventive_measures %>
                      </p>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <div class="ml-4">
                <% if (occurrence.status !== 'RESOLVIDA' && occurrence.status !== 'ENCERRADA') { %>
                  <a href="/operacional/ocorrencias/<%= occurrence.id %>/resolver" 
                     class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition text-sm">
                    Resolver
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
    
    <!-- Paginação -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="bg-white rounded-2xl shadow-xl p-6 mt-6 animate-slide-in">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div class="text-sm text-gray-600">
            Mostrando <strong><%= ((pagination.page - 1) * pagination.perPage) + 1 %></strong> até 
            <strong><%= Math.min(pagination.page * pagination.perPage, pagination.total) %></strong> 
            de <strong><%= pagination.total %></strong> ocorrências
            <span class="text-gray-400">(Página <%= pagination.page %> de <%= pagination.totalPages %>)</span>
          </div>
          <div class="flex items-center space-x-2">
            <% 
              // Construir query string preservando filtros
              const queryParams = new URLSearchParams();
              if (query && query.search) queryParams.set('search', query.search);
              if (query && query.status) queryParams.set('status', query.status);
              if (query && query.priority) queryParams.set('priority', query.priority);
              if (query && query.assignedToMe) queryParams.set('assignedToMe', query.assignedToMe);
              if (query && query.dateFrom) queryParams.set('dateFrom', query.dateFrom);
              if (query && query.dateTo) queryParams.set('dateTo', query.dateTo);
              if (query && query.perPage) queryParams.set('perPage', query.perPage);
              const queryString = queryParams.toString();
            %>
            <% if (pagination.page > 1) { %>
              <a href="/operacional/ocorrencias?page=<%= pagination.page - 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                <span>Anterior</span>
              </a>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="/operacional/ocorrencias?page=<%= pagination.page + 1 %><%= queryString ? '&' + queryString : '' %>" 
                 class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center space-x-2">
                <span>Próxima</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
