<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .status-badge {
    animation: pulse 2s ease-in-out infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-teal-50/30 to-cyan-50/30">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Cabeçalho Moderno -->
      <div class="mb-8 animate-slide-in">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
          <div>
            <div class="flex items-center space-x-3 mb-2">
              <div class="bg-gradient-to-br from-teal-500 to-cyan-600 rounded-xl p-3 shadow-lg">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-teal-900 to-gray-900 bg-clip-text text-transparent">
                  <%= occurrence.title %>
                </h1>
                <p class="text-gray-600 mt-1">Detalhes da ocorrência de limpeza</p>
              </div>
            </div>
          </div>
          <a href="/limpeza/ocorrencias" class="group inline-flex items-center px-5 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200">
            <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Voltar
          </a>
        </div>
      </div>

      <!-- Informações Principais -->
      <div class="bg-white rounded-2xl shadow-xl p-8 mb-6 animate-slide-in card-hover-effect">
        <div class="flex items-center space-x-3 mb-6">
          <div class="bg-gradient-to-br from-teal-500 to-cyan-600 rounded-lg p-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Informações da Ocorrência</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <!-- Status -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
            <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Status
            </label>
            <% 
              let statusColor = 'from-gray-400 to-gray-500';
              let statusText = occurrence.status;
              if (occurrence.status === 'ABERTA') {
                statusColor = 'from-yellow-500 to-amber-500';
              } else if (occurrence.status === 'EM_ATENDIMENTO') {
                statusColor = 'from-cyan-500 to-blue-500';
              } else if (occurrence.status === 'RESOLVIDA') {
                statusColor = 'from-green-500 to-emerald-500';
              } else if (occurrence.status === 'ENCERRADA') {
                statusColor = 'from-gray-400 to-gray-500';
              }
            %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-gradient-to-r <%= statusColor %> text-white shadow-md <%= occurrence.status === 'EM_ATENDIMENTO' ? 'status-badge' : '' %>">
              <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
              <%= statusText %>
            </span>
          </div>

          <!-- Tipo -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
            <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              Tipo
            </label>
            <% if (limpezaTypeInfo) { %>
              <p class="text-base font-bold text-gray-900"><%= limpezaTypeInfo.label %></p>
              <p class="text-sm text-gray-600 mt-1"><%= limpezaTypeInfo.description %></p>
            <% } else { %>
              <p class="text-base font-bold text-gray-900"><%= occurrence.limpeza_type || 'N/A' %></p>
            <% } %>
          </div>

          <!-- Localização -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
            <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Localização
            </label>
            <p class="text-base font-semibold text-gray-900"><%= occurrence.location || 'Não informada' %></p>
          </div>

          <!-- Data de Criação -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
            <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
              <svg class="w-4 h-4 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              Data de Criação
            </label>
            <p class="text-base font-semibold text-gray-900"><%= new Date(occurrence.created_at).toLocaleString('pt-BR') %></p>
          </div>

          <% if (occurrence.reported_by_name) { %>
            <!-- Reportado por -->
            <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Reportado por
              </label>
              <p class="text-base font-semibold text-gray-900"><%= occurrence.reported_by_name %></p>
            </div>
          <% } %>

          <% if (occurrence.needs_zeladoria) { %>
            <!-- Status de Conversão -->
            <div class="bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl p-4 border-l-4 border-orange-500">
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Status de Conversão
              </label>
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-md">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Requer Zeladoria
              </span>
            </div>
          <% } %>
        </div>

        <!-- Descrição -->
        <div class="mt-6">
          <label class="flex items-center text-sm font-bold text-gray-700 mb-3">
            <svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
            </svg>
            Descrição
          </label>
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-6 border-l-4 border-teal-500">
            <p class="text-base text-gray-900 whitespace-pre-wrap leading-relaxed"><%= occurrence.description %></p>
          </div>
        </div>
      </div>

      <!-- Informação sobre Zeladoria -->
      <% if (occurrence.needs_zeladoria) { %>
        <div class="bg-gradient-to-r from-blue-50 to-cyan-50 border-l-4 border-blue-500 rounded-2xl p-6 mb-6 shadow-lg animate-slide-in">
          <div class="flex items-center space-x-3 mb-4">
            <div class="bg-blue-500 rounded-lg p-2">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Informação Importante</h2>
          </div>
          <div class="bg-white rounded-xl p-4 border border-blue-200">
            <p class="text-sm text-gray-700 leading-relaxed">
              Esta ocorrência de limpeza requer atenção da zeladoria. O administrativo foi notificado e decidirá se é necessário criar uma ocorrência de zeladoria relacionada.
            </p>
          </div>
        </div>
      <% } %>

      <!-- Resolução -->
      <% if (occurrence.resolved_at) { %>
        <div class="bg-white rounded-2xl shadow-xl p-8 animate-slide-in card-hover-effect">
          <div class="flex items-center space-x-3 mb-6">
            <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg p-2">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Resolução</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4">
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Data de Resolução
              </label>
              <p class="text-base font-semibold text-gray-900"><%= new Date(occurrence.resolved_at).toLocaleString('pt-BR') %></p>
            </div>
            <% if (occurrence.resolution_notes) { %>
              <div class="md:col-span-2">
                <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                  <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                  </svg>
                  Notas de Resolução
                </label>
                <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4 border-l-4 border-green-500">
                  <p class="text-base text-gray-900 whitespace-pre-wrap leading-relaxed"><%= occurrence.resolution_notes %></p>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
