<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.02);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .stat-card {
    position: relative;
    overflow: hidden;
  }
  
  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
  }
  
  .stat-card:hover::before {
    left: 100%;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-teal-50/30 to-cyan-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Dashboard Limpeza'; %>
    <% var resumo = ['Visão de ocorrências de limpeza: abertas, em atendimento e resolvidas.', 'Acesse a lista de ocorrências e registre atendimentos.', 'Use os atalhos para agilizar o dia a dia.']; %>
    <% var helpModalContent = '<p>O dashboard mostra totais de ocorrências de limpeza. Use os atalhos para ver a lista, criar ou atender ocorrências.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-fade-in-up">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="flex items-center space-x-4">
          <div class="bg-gradient-to-br from-teal-500 to-cyan-600 rounded-xl p-4 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-teal-900 to-gray-900 bg-clip-text text-transparent">
              Dashboard Limpeza
            </h1>
            <p class="text-gray-600 mt-1">Painel de ocorrências e atividades de limpeza</p>
          </div>
        </div>
        <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>

    <!-- Cards de Estatísticas Principais -->
    <% 
      const openOccurrences = occurrences ? occurrences.filter(o => o.status === 'ABERTA' || o.status === 'EM_ATENDIMENTO').length : 0;
      const resolvedOccurrences = occurrences ? occurrences.filter(o => o.status === 'RESOLVIDA').length : 0;
      const totalOccurrences = occurrences ? occurrences.length : 0;
      const inProgressOccurrences = occurrences ? occurrences.filter(o => o.status === 'EM_ATENDIMENTO').length : 0;
    %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Ocorrências Abertas -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-teal-300 border-l-2 border-l-teal-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-teal-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Ocorrências Abertas</p>
        <p class="text-3xl font-bold text-teal-600 mb-2"><%= openOccurrences %></p>
        <a href="/limpeza/ocorrencias" class="text-teal-600 text-sm font-semibold hover:text-teal-700 transition-colors inline-flex items-center gap-1 group">
          Ver todas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Em Atendimento -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-cyan-300 border-l-2 border-l-cyan-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-cyan-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Em Atendimento</p>
        <p class="text-3xl font-bold text-cyan-600 mb-2"><%= inProgressOccurrences %></p>
        <a href="/limpeza/ocorrencias?status=EM_ATENDIMENTO" class="text-cyan-600 text-sm font-semibold hover:text-cyan-700 transition-colors inline-flex items-center gap-1 group">
          Ver todas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Ocorrências Resolvidas -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-green-300 border-l-2 border-l-green-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Resolvidas</p>
        <p class="text-3xl font-bold text-green-600 mb-2"><%= resolvedOccurrences %></p>
        <a href="/limpeza/ocorrencias?status=RESOLVIDA" class="text-green-600 text-sm font-semibold hover:text-green-700 transition-colors inline-flex items-center gap-1 group">
          Ver todas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Total de Ocorrências -->
      <div class="stat-card bg-white rounded-xl p-6 shadow-lg border border-gray-300 border-l-2 border-l-gray-500 card-hover-effect animate-fade-in-up" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-gray-100 rounded-lg p-3">
            <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
        </div>
        <p class="text-gray-500 text-sm font-medium mb-1">Total</p>
        <p class="text-3xl font-bold text-gray-900 mb-2"><%= totalOccurrences %></p>
        <a href="/limpeza/ocorrencias" class="text-gray-600 text-sm font-semibold hover:text-gray-700 transition-colors inline-flex items-center gap-1 group">
          Ver todas
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="animate-fade-in-up" style="animation-delay: 0.5s;">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Ações Rápidas</h2>
        <p class="text-gray-600">Acesso rápido às principais funcionalidades</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Nova Ocorrência -->
        <a href="/limpeza/ocorrencias/nova" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-teal-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-teal-50/0 to-teal-100/0 group-hover:from-teal-50/50 group-hover:to-teal-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-teal-500 to-teal-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-teal-700 transition-colors duration-300 text-lg">Nova Ocorrência</h3>
            <p class="text-sm text-gray-500">Registrar nova ocorrência de limpeza</p>
          </div>
        </a>

        <!-- Ver Checklist -->
        <a href="/operacional/checklist" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-green-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-green-50/0 to-green-100/0 group-hover:from-green-50/50 group-hover:to-green-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-green-700 transition-colors duration-300 text-lg">Ver Checklist</h3>
            <p class="text-sm text-gray-500">Visualizar checklist diário</p>
          </div>
        </a>

        <!-- Ver Todas as Ocorrências -->
        <a href="/limpeza/ocorrencias" class="group relative bg-white rounded-xl p-6 shadow-lg border border-gray-300 hover:border-cyan-300 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/0 to-cyan-100/0 group-hover:from-cyan-50/50 group-hover:to-cyan-100/30 rounded-xl transition-all duration-300"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-lg group-hover:shadow-xl">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-1 group-hover:text-cyan-700 transition-colors duration-300 text-lg">Todas as Ocorrências</h3>
            <p class="text-sm text-gray-500">Visualizar todas as ocorrências</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Últimas Ocorrências -->
    <div class="animate-fade-in-up" style="animation-delay: 0.6s;">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Últimas Ocorrências</h2>
        <p class="text-gray-600">As 5 ocorrências mais recentes</p>
      </div>
      
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-300">
        <% if (!occurrences || occurrences.length === 0) { %>
          <div class="p-12 text-center">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full mb-6">
              <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Nenhuma ocorrência encontrada</h3>
            <p class="text-gray-500 mb-6">Comece registrando sua primeira ocorrência de limpeza.</p>
            <a href="/limpeza/ocorrencias/nova" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-teal-600 to-cyan-600 text-white rounded-xl font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Criar Primeira Ocorrência
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gradient-to-r from-gray-50 to-gray-100">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Título</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Tipo</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Data</th>
                <th class="px-6 py-4 text-right text-xs font-bold text-gray-700 uppercase tracking-wider">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% occurrences.slice(0, 5).forEach((occurrence, index) => { %>
                <tr class="hover:bg-gradient-to-r hover:from-teal-50/50 hover:to-cyan-50/50 transition-all duration-200 card-hover-effect" style="animation-delay: <%= index * 0.05 %>s">
                  <td class="px-6 py-4">
                    <div class="text-sm font-bold text-gray-900"><%= occurrence.title %></div>
                    <% if (occurrence.location) { %>
                      <div class="text-sm text-gray-500 mt-1">
                        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <%= occurrence.location %>
                      </div>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-md">
                      <%= occurrence.limpeza_type || 'N/A' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% 
                      let statusColor = 'from-gray-400 to-gray-500';
                      let statusText = occurrence.status;
                      if (occurrence.status === 'ABERTA') {
                        statusColor = 'from-yellow-500 to-amber-500';
                      } else if (occurrence.status === 'EM_ATENDIMENTO') {
                        statusColor = 'from-cyan-500 to-blue-500';
                      } else if (occurrence.status === 'RESOLVIDA') {
                        statusColor = 'from-green-500 to-emerald-500';
                      } else if (occurrence.status === 'ENCERRADA') {
                        statusColor = 'from-gray-400 to-gray-500';
                      }
                    %>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r <%= statusColor %> text-white shadow-md">
                      <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                      <%= statusText %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= new Date(occurrence.created_at).toLocaleDateString('pt-BR') %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a href="/limpeza/ocorrencias/<%= occurrence.id %>" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-teal-500 to-cyan-500 text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 transform hover:scale-105">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      Ver detalhes
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          </div>
          <% if (occurrences.length > 5) { %>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-300 text-center">
              <a href="/limpeza/ocorrencias" class="inline-flex items-center text-teal-600 hover:text-teal-700 font-semibold transition-colors duration-200 group">
                <span>Ver todas as ocorrências</span>
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
