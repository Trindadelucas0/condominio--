<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="page-title">Dashboard Limpeza</h1>
    <p class="page-subtitle">Painel de ocorrências e atividades de limpeza</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Ocorrências Abertas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Ocorrências Abertas</p>
          <p class="text-3xl font-bold text-primary-600 mt-2">
            <%= occurrences.filter(o => o.status === 'ABERTA' || o.status === 'EM_ATENDIMENTO').length %>
          </p>
        </div>
        <div class="bg-primary-100 rounded-full p-4">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas →
      </a>
    </div>

    <!-- Ocorrências Resolvidas -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Ocorrências Resolvidas</p>
          <p class="text-3xl font-bold text-green-600 mt-2">
            <%= occurrences.filter(o => o.status === 'RESOLVIDA').length %>
          </p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias?status=RESOLVIDA" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas →
      </a>
    </div>

    <!-- Total de Ocorrências -->
    <div class="card card-hover">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm font-medium">Total de Ocorrências</p>
          <p class="text-3xl font-bold text-gray-600 mt-2">
            <%= occurrences.length %>
          </p>
        </div>
        <div class="bg-gray-100 rounded-full p-4">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias" class="text-primary-600 text-sm mt-4 inline-block hover:text-primary-700 transition-colors duration-200">
        Ver todas →
      </a>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="card mb-8">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="flex flex-wrap gap-4">
      <a href="/limpeza/ocorrencias/nova" class="btn-primary">
        + Nova Ocorrência de Limpeza
      </a>
      <a href="/operacional/checklist" class="btn-primary bg-green-600 hover:bg-green-700 focus:ring-green-500">
        Ver Checklist
      </a>
      <a href="/limpeza/ocorrencias" class="btn-secondary">
        Ver Todas as Ocorrências
      </a>
    </div>
  </div>

  <!-- Últimas ocorrências -->
  <div class="card">
    <div class="border-b border-gray-200 pb-4 mb-4">
      <h2 class="text-xl font-bold text-gray-800">Últimas Ocorrências</h2>
    </div>
    <div>
      <% if (occurrences.length === 0) { %>
        <p class="text-gray-500 text-center py-8">Nenhuma ocorrência registrada ainda.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="table-header">Título</th>
                <th class="table-header">Tipo</th>
                <th class="table-header">Status</th>
                <th class="table-header">Data</th>
                <th class="table-header">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% occurrences.slice(0, 5).forEach(occurrence => { %>
                <tr class="table-row">
                  <td class="table-cell">
                    <div class="text-sm font-medium text-gray-900"><%= occurrence.title %></div>
                    <% if (occurrence.location) { %>
                      <div class="text-sm text-gray-500"><%= occurrence.location %></div>
                    <% } %>
                  </td>
                  <td class="table-cell">
                    <span class="badge-primary">
                      <%= occurrence.limpeza_type || 'N/A' %>
                    </span>
                  </td>
                  <td class="table-cell">
                    <% 
                      const statusColors = {
                        'ABERTA': 'badge-warning',
                        'EM_ATENDIMENTO': 'badge-info',
                        'RESOLVIDA': 'badge-success',
                        'ENCERRADA': 'badge-primary'
                      };
                      const statusColor = statusColors[occurrence.status] || 'badge-primary';
                    %>
                    <span class="<%= statusColor %>">
                      <%= occurrence.status %>
                    </span>
                  </td>
                  <td class="table-cell text-gray-500">
                    <%= new Date(occurrence.created_at).toLocaleDateString('pt-BR') %>
                  </td>
                  <td class="table-cell">
                    <a href="/limpeza/ocorrencias/<%= occurrence.id %>" class="text-primary-600 hover:text-primary-700 transition-colors duration-200">Ver detalhes</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (occurrences.length > 5) { %>
          <div class="mt-4 text-center">
            <a href="/limpeza/ocorrencias" class="text-primary-600 hover:text-primary-700 transition-colors duration-200">Ver todas as ocorrências →</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer') %>
