<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Dashboard Limpeza</h1>
    <p class="text-gray-600 mt-2">Painel de ocorrências e atividades de limpeza</p>
  </div>

  <!-- Cards de estatísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Ocorrências Abertas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Ocorrências Abertas</p>
          <p class="text-3xl font-bold text-blue-600 mt-2">
            <%= occurrences.filter(o => o.status === 'ABERTA' || o.status === 'EM_ATENDIMENTO').length %>
          </p>
        </div>
        <div class="bg-blue-100 rounded-full p-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias" class="text-blue-600 text-sm mt-4 inline-block hover:underline">
        Ver todas →
      </a>
    </div>

    <!-- Ocorrências Resolvidas -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Ocorrências Resolvidas</p>
          <p class="text-3xl font-bold text-green-600 mt-2">
            <%= occurrences.filter(o => o.status === 'RESOLVIDA').length %>
          </p>
        </div>
        <div class="bg-green-100 rounded-full p-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias?status=RESOLVIDA" class="text-green-600 text-sm mt-4 inline-block hover:underline">
        Ver todas →
      </a>
    </div>

    <!-- Total de Ocorrências -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 text-sm">Total de Ocorrências</p>
          <p class="text-3xl font-bold text-gray-600 mt-2">
            <%= occurrences.length %>
          </p>
        </div>
        <div class="bg-gray-100 rounded-full p-4">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
      </div>
      <a href="/limpeza/ocorrencias" class="text-gray-600 text-sm mt-4 inline-block hover:underline">
        Ver todas →
      </a>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="mb-8">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ações Rápidas</h2>
    <div class="flex flex-wrap gap-4">
      <a href="/limpeza/ocorrencias/nova" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
        + Nova Ocorrência de Limpeza
      </a>
      <a href="/operacional/checklist" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition">
        Ver Checklist
      </a>
      <a href="/limpeza/ocorrencias" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-semibold transition">
        Ver Todas as Ocorrências
      </a>
    </div>
  </div>

  <!-- Últimas ocorrências -->
  <div class="bg-white rounded-lg shadow">
    <div class="p-6 border-b">
      <h2 class="text-xl font-bold text-gray-800">Últimas Ocorrências</h2>
    </div>
    <div class="p-6">
      <% if (occurrences.length === 0) { %>
        <p class="text-gray-500 text-center py-8">Nenhuma ocorrência registrada ainda.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Título</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% occurrences.slice(0, 5).forEach(occurrence => { %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= occurrence.title %></div>
                    <% if (occurrence.location) { %>
                      <div class="text-sm text-gray-500"><%= occurrence.location %></div>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                      <%= occurrence.limpeza_type || 'N/A' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% 
                      const statusColors = {
                        'ABERTA': 'bg-yellow-100 text-yellow-800',
                        'EM_ATENDIMENTO': 'bg-blue-100 text-blue-800',
                        'RESOLVIDA': 'bg-green-100 text-green-800',
                        'ENCERRADA': 'bg-gray-100 text-gray-800'
                      };
                      const statusColor = statusColors[occurrence.status] || 'bg-gray-100 text-gray-800';
                    %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= statusColor %>">
                      <%= occurrence.status %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= new Date(occurrence.created_at).toLocaleDateString('pt-BR') %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <a href="/limpeza/ocorrencias/<%= occurrence.id %>" class="text-blue-600 hover:text-blue-900">Ver detalhes</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (occurrences.length > 5) { %>
          <div class="mt-4 text-center">
            <a href="/limpeza/ocorrencias" class="text-blue-600 hover:text-blue-800">Ver todas as ocorrências →</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
