<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .input-focus {
    transition: all 0.2s ease;
  }
  
  .input-focus:focus {
    border-color: #14b8a6;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
  }
  
  .card-glow {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  .card-glow:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-teal-50/30 to-cyan-50/30">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
      <!-- Cabeçalho Moderno -->
      <div class="mb-8 animate-slide-in">
        <div class="flex items-center space-x-3 mb-2">
          <div class="bg-gradient-to-br from-teal-500 to-cyan-600 rounded-xl p-3 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= occurrence ? 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' : 'M12 4v16m8-8H4' %>"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-teal-900 to-gray-900 bg-clip-text text-transparent">
              <%= occurrence ? 'Editar' : 'Nova' %> Ocorrência de Limpeza
            </h1>
            <p class="text-gray-600 mt-1">Reporte problemas relacionados à limpeza</p>
          </div>
        </div>
      </div>

      <!-- Mensagem de Erro -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 animate-slide-in">
          <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md flex items-center space-x-3">
            <div class="bg-red-500 rounded-full p-2">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-red-800">Erro</p>
              <p class="text-sm text-red-600"><%= error %></p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Formulário Moderno -->
      <div class="bg-white rounded-2xl shadow-xl p-8 card-glow animate-slide-in">
        <form method="POST" action="/limpeza/ocorrencias">
          <div class="space-y-6">
            <!-- Tipo de Ocorrência -->
            <div>
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Tipo de Ocorrência <span class="text-red-500 ml-1">*</span>
              </label>
              <select name="limpezaType" required class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200">
                <option value="">Selecione o tipo</option>
                <% limpezaTypes.forEach(type => { %>
                  <option value="<%= type.value %>" <%= occurrence && occurrence.limpezaType === type.value ? 'selected' : '' %>>
                    <%= type.label %>
                  </option>
                <% }); %>
              </select>
              <p class="mt-2 text-sm text-gray-500">
                <strong>Nota:</strong> Ocorrências de "Equipamento com Defeito" são automaticamente convertidas para Zeladoria.
              </p>
            </div>

            <!-- Título -->
            <div>
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                Título <span class="text-red-500 ml-1">*</span>
              </label>
              <input 
                type="text" 
                name="title" 
                required
                value="<%= occurrence ? occurrence.title : '' %>"
                placeholder="Ex: Garagem com materiais obstruindo limpeza"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Descrição -->
            <div>
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
                Descrição <span class="text-red-500 ml-1">*</span>
              </label>
              <textarea 
                name="description" 
                required
                rows="5"
                placeholder="Descreva detalhadamente o problema..."
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200 resize-none"
              ><%= occurrence ? occurrence.description : '' %></textarea>
            </div>

            <!-- Localização -->
            <div>
              <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
                <svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Localização
              </label>
              <input 
                type="text" 
                name="location" 
                value="<%= occurrence ? occurrence.location : '' %>"
                placeholder="Ex: Bloco A, 2º andar, Garagem"
                class="input-focus w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none transition-all duration-200"
              />
            </div>

            <!-- Botões -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
              <a href="/limpeza/ocorrencias" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Cancelar</span>
              </a>
              <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-teal-600 to-cyan-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
                <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
                <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="relative z-10">Salvar Ocorrência</span>
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- Informações sobre Tipos -->
      <div class="mt-8 bg-gradient-to-r from-teal-50 to-cyan-50 rounded-2xl p-6 shadow-lg animate-slide-in">
        <div class="flex items-center space-x-3 mb-4">
          <div class="bg-teal-500 rounded-lg p-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">Tipos de Ocorrência de Limpeza</h3>
        </div>
        <div class="space-y-4">
          <% limpezaTypes.forEach(type => { %>
            <div class="bg-white rounded-xl p-4 border-l-4 border-teal-500 shadow-sm">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h4 class="font-bold text-gray-900 mb-1"><%= type.label %></h4>
                  <p class="text-sm text-gray-600"><%= type.description %></p>
                  <% if (type.needsZeladoria) { %>
                    <div class="mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-orange-100 to-amber-100 text-orange-800">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                      </svg>
                      Será convertida automaticamente para Zeladoria
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
