<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-800"><%= occurrence ? 'Editar' : 'Nova' %> Ocorrência de Limpeza</h1>
      <p class="text-gray-600 mt-2">Reporte problemas relacionados à limpeza</p>
    </div>

    <!-- Mensagem de erro -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        <p><%= error %></p>
      </div>
    <% } %>

    <!-- Formulário -->
    <div class="bg-white rounded-lg shadow p-6">
      <form method="POST" action="/limpeza/ocorrencias">
        <!-- Tipo de Ocorrência -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Tipo de Ocorrência <span class="text-red-500">*</span>
          </label>
          <select name="limpezaType" required class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="">Selecione o tipo</option>
            <% limpezaTypes.forEach(type => { %>
              <option value="<%= type.value %>" <%= occurrence && occurrence.limpezaType === type.value ? 'selected' : '' %>>
                <%= type.label %>
              </option>
            <% }); %>
          </select>
          <p class="mt-1 text-sm text-gray-500">
            <strong>Nota:</strong> Ocorrências de "Equipamento com Defeito" são automaticamente convertidas para Zeladoria.
          </p>
        </div>

        <!-- Título -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Título <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            name="title" 
            required
            value="<%= occurrence ? occurrence.title : '' %>"
            placeholder="Ex: Garagem com materiais obstruindo limpeza"
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Descrição -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Descrição <span class="text-red-500">*</span>
          </label>
          <textarea 
            name="description" 
            required
            rows="5"
            placeholder="Descreva detalhadamente o problema..."
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
          ><%= occurrence ? occurrence.description : '' %></textarea>
        </div>

        <!-- Localização -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Localização
          </label>
          <input 
            type="text" 
            name="location" 
            value="<%= occurrence ? occurrence.location : '' %>"
            placeholder="Ex: Bloco A, 2º andar, Garagem"
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Botões -->
        <div class="flex justify-end gap-4">
          <a href="/limpeza/ocorrencias" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg font-semibold transition">
            Cancelar
          </a>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold transition">
            Salvar Ocorrência
          </button>
        </div>
      </form>
    </div>

    <!-- Informações sobre tipos -->
    <div class="mt-6 bg-blue-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Tipos de Ocorrência de Limpeza</h3>
      <div class="space-y-3">
        <% limpezaTypes.forEach(type => { %>
          <div class="border-l-4 border-blue-500 pl-4">
            <h4 class="font-semibold text-gray-800"><%= type.label %></h4>
            <p class="text-sm text-gray-600"><%= type.description %></p>
            <% if (type.needsZeladoria) { %>
              <p class="text-xs text-orange-600 mt-1">⚠️ Será convertida automaticamente para Zeladoria</p>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
