<%- include('partials/header', { title: 'Erro' }) %>
<% if (typeof user !== 'undefined' && user !== null) { %>
<%- include('partials/navbar', { user: user }) %>
<% } else { %>
<!-- Navbar simplificada para páginas de erro sem usuário -->
<nav class="bg-primary-600 text-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center py-3 sm:py-4">
            <div class="flex items-center space-x-3">
                <div class="bg-white rounded-full p-2 flex-shrink-0">
                    <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                </div>
                <a href="/" class="text-lg sm:text-xl font-bold hover:text-primary-100 transition-colors duration-200">
                    <span class="text-white">ÊXITO</span> <span class="text-primary-200">CONDOMÍNIOS</span>
                </a>
            </div>
            <a href="/auth/login" class="px-4 py-2 bg-white text-primary-600 rounded-lg hover:bg-primary-50 transition-colors font-semibold">
                Entrar
            </a>
        </div>
    </div>
</nav>
<% } %>
<%- include('partials/notifications') %>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-red-50/30 to-pink-50/30 flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full">
        <!-- Card Principal -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden transform transition-all duration-300 hover:shadow-3xl">
            <!-- Cabeçalho com gradiente -->
            <div class="bg-gradient-to-r from-red-500 via-rose-500 to-pink-500 p-8 text-center">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-white/20 rounded-full mb-4 backdrop-blur-sm">
                    <svg class="w-12 h-12 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">Ops! Algo deu errado</h1>
                <p class="text-white/90 text-lg">Não conseguimos processar sua solicitação</p>
            </div>

            <!-- Conteúdo -->
            <div class="p-8">
                <div class="bg-gradient-to-r from-red-50 to-rose-50 rounded-xl p-6 mb-6 border-l-4 border-red-500">
                    <p class="text-gray-800 text-lg font-medium leading-relaxed">
                        <%= typeof message !== 'undefined' ? message : 'Ocorreu um erro ao processar sua solicitação. Por favor, tente novamente.' %>
                    </p>
                </div>

                <% if (typeof error !== 'undefined' && error && Object.keys(error).length > 0 && process.env.NODE_ENV === 'development') { %>
                    <details class="mb-6 bg-gray-50 rounded-xl p-4 border border-gray-200">
                        <summary class="cursor-pointer text-sm font-semibold text-gray-700 mb-2 hover:text-gray-900">
                            🔍 Detalhes técnicos (Modo Desenvolvimento)
                        </summary>
                        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-auto max-h-64">
                            <pre class="text-xs text-green-400 font-mono"><%= JSON.stringify(error, null, 2) %></pre>
                        </div>
                    </details>
                <% } %>

                <!-- Ações -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <button onclick="history.back()" class="flex items-center justify-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-semibold transition-all duration-200 transform hover:scale-105 hover:shadow-lg">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Voltar
                    </button>
                    <a href="/" class="flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-xl font-semibold transition-all duration-200 transform hover:scale-105 hover:shadow-lg">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        Ir para o Início
                    </a>
                </div>

                <!-- Sugestões -->
                <div class="mt-8 pt-6 border-t border-gray-200">
                    <p class="text-sm text-gray-600 mb-3">💡 O que você pode fazer:</p>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li class="flex items-start">
                            <span class="text-green-500 mr-2">✓</span>
                            <span>Verifique se você tem permissão para acessar esta página</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-500 mr-2">✓</span>
                            <span>Tente recarregar a página</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-500 mr-2">✓</span>
                            <span>Se o problema persistir, entre em contato com o administrador</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
