<%- include('partials/header', { title: 'Erro' }) %>
    <div class="min-h-screen flex items-center justify-center px-4">
        <div class="max-w-md w-full bg-white rounded-lg shadow-lg p-8 text-center">
            <div class="mb-6">
                <svg class="mx-auto h-16 w-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-4">Ops! Algo deu errado</h1>
            <p class="text-gray-600 mb-6"><%= typeof message !== 'undefined' ? message : 'Ocorreu um erro ao processar sua solicitação.' %></p>
            
            <% if (typeof error !== 'undefined' && error && Object.keys(error).length > 0 && process.env.NODE_ENV === 'development') { %>
                <div class="bg-gray-100 rounded p-4 mb-6 text-left">
                    <p class="text-sm font-semibold text-gray-700 mb-2">Detalhes do erro (desenvolvimento):</p>
                    <pre class="text-xs text-gray-600 overflow-auto"><%= JSON.stringify(error, null, 2) %></pre>
                </div>
            <% } %>
            
            <div class="space-y-3">
                <a href="javascript:history.back()" class="block w-full btn-secondary text-center">
                    Voltar
                </a>
                <a href="/" class="block w-full btn-primary text-center">
                    Ir para o Início
                </a>
            </div>
        </div>
    </main>
<%- include('partials/footer') %>
