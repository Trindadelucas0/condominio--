<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Sistema de Gestão Condominial</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#86efac',
              400: '#4ade80',
              500: '#2CB930',
              600: '#22a329',
              700: '#1a8a20',
              800: '#147018',
              900: '#0f5612',
            }
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'fade-in': 'fadeIn 0.8s ease-out',
            'slide-in': 'slideIn 0.6s ease-out',
          }
        }
      }
    }
  </script>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .fade-in {
      animation: fadeIn 0.8s ease-out;
    }
    
    .slide-in {
      animation: slideIn 0.6s ease-out;
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-50">
  <!-- Navbar com Login -->
  <nav class="bg-white shadow-lg sticky top-0 z-50 border-b-2 border-primary-500">
    <div class="container mx-auto px-4">
      <div class="flex justify-between items-center py-4">
        <!-- Logo -->
        <div class="flex items-center space-x-3">
          <div class="relative">
            <!-- Círculo verde glossy com efeito 3D -->
            <div class="w-12 h-12 rounded-full relative overflow-hidden shadow-xl" style="background: radial-gradient(circle at 30% 30%, #4ade80, #22a329, #15803d);">
              <!-- Highlight para efeito glossy -->
              <div class="absolute top-1 left-2 w-4 h-4 bg-white/40 rounded-full blur-sm"></div>
              <!-- Logo 'e' estilizado branco dentro - formato euro com barra extra no topo -->
              <svg class="w-8 h-8 text-white absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <!-- Linha vertical esquerda -->
                <line x1="6" y1="7" x2="6" y2="17" stroke="currentColor" stroke-width="2.5"/>
                <!-- Barra horizontal superior (barra extra) -->
                <line x1="6" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva superior (incompleta, estilo euro) -->
                <path d="M6 7 Q12 7 16 10" stroke="currentColor" fill="none" stroke-width="2.5"/>
                <!-- Linha horizontal do meio -->
                <line x1="6" y1="12" x2="16" y2="12" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva do meio (incompleta) -->
                <path d="M6 12 Q12 12 16 14" stroke="currentColor" fill="none" stroke-width="2.5"/>
                <!-- Linha horizontal inferior -->
                <line x1="6" y1="17" x2="16" y2="17" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva inferior (incompleta) -->
                <path d="M6 17 Q12 17 16 14" stroke="currentColor" fill="none" stroke-width="2.5"/>
              </svg>
            </div>
          </div>
          <div>
            <div class="text-xl font-bold">
              <span class="text-gray-900">Êx</span><span class="text-green-600">i</span><span class="text-gray-900">to</span>
            </div>
            <div class="text-xs text-blue-600 font-medium">Gestão Condominial</div>
          </div>
        </div>

        <!-- Formulário de Login -->
        <form method="POST" action="/auth/login" class="flex items-center space-x-3">
          <!-- Mensagem de erro (se houver) -->
          <% if (typeof error !== 'undefined' && error && typeof errorMessages !== 'undefined' && errorMessages[error]) { %>
            <div class="text-red-600 text-sm font-medium mr-2">
              <%= errorMessages[error] %>
            </div>
          <% } else if (typeof error !== 'undefined' && error) { %>
            <div class="text-red-600 text-sm font-medium mr-2">
              <%= error %>
            </div>
          <% } %>
          
          <!-- Campo usuário -->
          <div class="hidden md:block">
            <input
              type="text"
              id="username"
              name="username"
              required
              autofocus
              class="px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all duration-200"
              placeholder="Usuário"
            />
          </div>

          <!-- Campo senha -->
          <div class="hidden md:block">
            <input
              type="password"
              id="password"
              name="password"
              required
              class="px-4 py-2 border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all duration-200"
              placeholder="Senha"
            />
          </div>

          <!-- Botão de enviar -->
          <button
            type="submit"
            class="bg-gradient-to-r from-primary-600 to-primary-700 text-white px-6 py-2 rounded-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="hidden sm:inline">Entrar</span>
          </button>
        </form>
      </div>

      <!-- Formulário Mobile (abaixo do navbar) -->
      <div class="md:hidden pb-4 border-t border-gray-200 mt-2 pt-4">
        <form method="POST" action="/auth/login" class="space-y-3">
          <% if (typeof error !== 'undefined' && error && typeof errorMessages !== 'undefined' && errorMessages[error]) { %>
            <div class="bg-red-50 border-2 border-red-200 rounded-lg p-3 text-red-700 text-sm font-medium">
              <%= errorMessages[error] %>
            </div>
          <% } else if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-50 border-2 border-red-200 rounded-lg p-3 text-red-700 text-sm font-medium">
              <%= error %>
            </div>
          <% } %>
          <input
            type="text"
            name="username"
            required
            autofocus
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all duration-200"
            placeholder="Usuário"
          />
          <input
            type="password"
            name="password"
            required
            class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all duration-200"
            placeholder="Senha"
          />
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-primary-600 to-primary-700 text-white px-6 py-3 rounded-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center space-x-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>Entrar no Sistema</span>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Conteúdo Principal -->
  <main class="container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto">
      <!-- Logo e Título Principal -->
      <div class="text-center mb-16 fade-in">
        <div class="mb-8 inline-block">
          <!-- Logo com círculo verde glossy e 'e' estilizado -->
          <div class="relative">
            <div class="w-40 h-40 rounded-full relative overflow-hidden shadow-2xl mx-auto animate-float" style="background: radial-gradient(circle at 30% 30%, #4ade80, #22a329, #15803d);">
              <!-- Highlight para efeito glossy -->
              <div class="absolute top-4 left-8 w-16 h-16 bg-white/40 rounded-full blur-xl"></div>
              <div class="absolute top-6 left-10 w-12 h-12 bg-white/30 rounded-full blur-md"></div>
              <!-- Logo 'e' estilizado branco dentro - formato euro com barra extra no topo -->
              <svg class="w-24 h-24 text-white absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <!-- Linha vertical esquerda -->
                <line x1="6" y1="7" x2="6" y2="17" stroke="currentColor" stroke-width="2.5"/>
                <!-- Barra horizontal superior (barra extra) -->
                <line x1="6" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva superior (incompleta, estilo euro) -->
                <path d="M6 7 Q12 7 16 10" stroke="currentColor" fill="none" stroke-width="2.5"/>
                <!-- Linha horizontal do meio -->
                <line x1="6" y1="12" x2="16" y2="12" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva do meio (incompleta) -->
                <path d="M6 12 Q12 12 16 14" stroke="currentColor" fill="none" stroke-width="2.5"/>
                <!-- Linha horizontal inferior -->
                <line x1="6" y1="17" x2="16" y2="17" stroke="currentColor" stroke-width="2.5"/>
                <!-- Curva inferior (incompleta) -->
                <path d="M6 17 Q12 17 16 14" stroke="currentColor" fill="none" stroke-width="2.5"/>
              </svg>
            </div>
          </div>
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4">
          <span class="text-gray-900">Êx</span><span class="text-green-600">i</span><span class="text-gray-900">to</span>
        </h1>
        <p class="text-2xl md:text-3xl text-blue-600 font-semibold mb-8">Gestão Condominial</p>
        <div class="w-24 h-1 bg-gradient-to-r from-transparent via-primary-500 to-transparent mx-auto"></div>
      </div>

      <!-- Descrição do Sistema -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16 slide-in">
        <!-- Card 1 -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-primary-500 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl p-4 w-16 h-16 flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Gestão Financeira</h3>
          <p class="text-gray-600 leading-relaxed">
            Controle completo de entradas, saídas, contas a pagar e receber. Relatórios detalhados e aprovações em fluxo de trabalho.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-blue-500 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-4 w-16 h-16 flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Ocorrências e Tarefas</h3>
          <p class="text-gray-600 leading-relaxed">
            Sistema completo de gestão de ocorrências, tarefas e manutenções. Acompanhamento em tempo real com notificações automáticas.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border-l-4 border-purple-500 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl p-4 w-16 h-16 flex items-center justify-center mb-6 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Patrimônio</h3>
          <p class="text-gray-600 leading-relaxed">
            Controle de ativos do condomínio com depreciação automática, histórico de manutenções e gestão completa do patrimônio.
          </p>
        </div>
      </div>

      <!-- Seção de Recursos -->
      <div class="bg-gradient-to-br from-primary-50 to-green-50 rounded-3xl p-12 mb-16 slide-in">
        <h2 class="text-4xl font-bold text-center text-gray-900 mb-12">
          Por que escolher o <span class="text-primary-600">Êxito</span>?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="flex items-start space-x-4">
            <div class="bg-white rounded-lg p-3 shadow-md flex-shrink-0">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Interface Moderna</h3>
              <p class="text-gray-700">Design intuitivo e responsivo, desenvolvido com as melhores práticas de UX/UI.</p>
            </div>
          </div>
          <div class="flex items-start space-x-4">
            <div class="bg-white rounded-lg p-3 shadow-md flex-shrink-0">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Segurança Total</h3>
              <p class="text-gray-700">Sistema de permissões robusto com auditoria completa de todas as ações.</p>
            </div>
          </div>
          <div class="flex items-start space-x-4">
            <div class="bg-white rounded-lg p-3 shadow-md flex-shrink-0">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Alta Performance</h3>
              <p class="text-gray-700">Tecnologia de ponta para garantir velocidade e confiabilidade em todas as operações.</p>
            </div>
          </div>
          <div class="flex items-start space-x-4">
            <div class="bg-white rounded-lg p-3 shadow-md flex-shrink-0">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Suporte Dedicado</h3>
              <p class="text-gray-700">Equipe especializada pronta para ajudar e garantir o melhor uso do sistema.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Rodapé -->
      <div class="text-center fade-in">
        <p class="text-gray-600 font-medium mb-4">
          © <%= new Date().getFullYear() %> Êxito Gestão Condominial. Todos os direitos reservados.
        </p>
        <div class="flex items-center justify-center gap-2">
          <div class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></div>
          <div class="w-2 h-2 bg-primary-400 rounded-full animate-pulse" style="animation-delay: 0.2s;"></div>
          <div class="w-2 h-2 bg-primary-300 rounded-full animate-pulse" style="animation-delay: 0.4s;"></div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
