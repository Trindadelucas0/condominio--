<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-6 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-800"><%= manutencao.title %></h1>
        <p class="text-gray-600 mt-2">
          <span class="px-2 py-1 text-xs font-semibold rounded-full <%= manutencao.maintenance_type === 'PREVENTIVA' ? 'bg-blue-100 text-blue-800' : 'bg-orange-100 text-orange-800' %>">
            <%= manutencao.maintenance_type %>
          </span>
          <% 
            let statusClass = 'bg-gray-100 text-gray-800';
            if (manutencao.status === 'pendente') statusClass = 'bg-yellow-100 text-yellow-800';
            else if (manutencao.status === 'em_andamento') statusClass = 'bg-blue-100 text-blue-800';
            else if (manutencao.status === 'concluida') statusClass = 'bg-green-100 text-green-800';
            else if (manutencao.status === 'cancelada') statusClass = 'bg-red-100 text-red-800';
          %>
          <span id="status-badge" class="px-2 py-1 text-xs font-semibold rounded-full <%= statusClass %> ml-2">
            <span id="status-text"><%= manutencao.status === 'pendente' ? 'Pendente' : 
                manutencao.status === 'em_andamento' ? 'Em Andamento' :
                manutencao.status === 'concluida' ? 'Concluída' : 'Cancelada' %></span>
          </span>
        </p>
      </div>
      <a href="/<%= user.roles && user.roles.includes('SINDICO') ? 'sindico' : 'operacional' %>/manutencoes" class="text-gray-600 hover:text-gray-800">
        ← Voltar
      </a>
    </div>

    <!-- Informações -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Informações</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-gray-600">Descrição</p>
          <p class="text-gray-800"><%= manutencao.description %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Localização</p>
          <p class="text-gray-800"><%= manutencao.location || '-' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Prioridade</p>
          <p class="text-gray-800"><%= manutencao.priority %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Data Prevista</p>
          <p class="text-gray-800"><%= manutencao.scheduled_date ? new Date(manutencao.scheduled_date).toLocaleDateString('pt-BR') : '-' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Responsável</p>
          <p class="text-gray-800"><%= manutencao.assigned_to_name || 'Não atribuído' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Criado por</p>
          <p class="text-gray-800"><%= manutencao.created_by_name || '-' %></p>
        </div>
        <% if (manutencao.asset_name) { %>
        <div>
          <p class="text-sm text-gray-600">Ativo Relacionado</p>
          <p class="text-gray-800"><%= manutencao.asset_name %></p>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Conclusão (se concluída) -->
    <% if (manutencao.status === 'concluida') { %>
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Conclusão</h2>
      <div class="space-y-2">
        <div>
          <p class="text-sm text-gray-600">Concluída em</p>
          <p class="text-gray-800"><%= manutencao.completed_at ? new Date(manutencao.completed_at).toLocaleString('pt-BR') : '-' %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Concluída por</p>
          <p class="text-gray-800"><%= manutencao.completed_by ? 'Operacional' : '-' %></p>
        </div>
        <% if (manutencao.completion_notes) { %>
        <div>
          <p class="text-sm text-gray-600">Notas de Conclusão</p>
          <p class="text-gray-800"><%= manutencao.completion_notes %></p>
        </div>
        <% } %>
        <% if (manutencao.cost) { %>
        <div>
          <p class="text-sm text-gray-600">Custo</p>
          <p class="text-gray-800 font-bold">R$ <%= parseFloat(manutencao.cost).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></p>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Ações -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">Ações</h2>
      <div id="maintenance-feedback" class="hidden mb-4 rounded border px-4 py-3 text-sm"></div>
      <div class="flex space-x-4">
        <% if (user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'))) { %>
          <a href="/sindico/manutencoes/<%= manutencao.id %>/editar" class="bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700">
            Editar Manutenção
          </a>
          <button id="delete-maintenance-btn" type="button" class="bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700">
            Excluir Manutenção
          </button>
        <% } %>
        <% 
          const isManager = user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'));
          const isAssignedOperational = user.roles && user.roles.includes('OPERACIONAL') && manutencao.assigned_to === user.id;
          const canAct = isManager || isAssignedOperational;
        %>
        <% if (canAct && manutencao.status === 'pendente') { %>
          <button type="button" class="status-action-btn bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700" data-status="em_andamento">
            Iniciar
          </button>
        <% } %>
        <% if (canAct && manutencao.status === 'em_andamento') { %>
          <button type="button" class="status-action-btn bg-emerald-600 text-white px-6 py-2 rounded hover:bg-emerald-700" data-status="concluida">
            Dar baixa
          </button>
        <% } %>
        <% if (canAct && (manutencao.status === 'pendente' || manutencao.status === 'em_andamento')) { %>
          <button type="button" class="status-action-btn bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700" data-status="cancelada">
            Cancelar
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const button = document.getElementById('delete-maintenance-btn');
    const feedback = document.getElementById('maintenance-feedback');
    if (!button) return;

    const showFeedback = (message, type) => {
      feedback.textContent = message;
      feedback.className = 'mb-4 rounded border px-4 py-3 text-sm';
      if (type === 'error') {
        feedback.classList.add('border-red-300', 'bg-red-50', 'text-red-700');
      } else {
        feedback.classList.add('border-green-300', 'bg-green-50', 'text-green-700');
      }
      feedback.classList.remove('hidden');
    };

    button.addEventListener('click', async function () {
      if (!window.confirm('Tem certeza que deseja excluir esta manutenção? Esta ação não pode ser desfeita.')) {
        return;
      }
      button.disabled = true;
      const oldText = button.textContent;
      button.textContent = 'Excluindo...';
      try {
        const response = await fetch('/sindico/manutencoes/<%= manutencao.id %>', {
          method: 'DELETE',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error((data && data.error) || 'Falha ao excluir manutenção.');
        }
        showFeedback(data.message || 'Manutenção excluída com sucesso.', 'success');
        window.location.href = '/sindico/manutencoes?success=deleted';
      } catch (error) {
        button.disabled = false;
        button.textContent = oldText;
        showFeedback(error.message || 'Erro ao excluir manutenção.', 'error');
      }
    });

    const rolePrefix = '<%= user.roles && (user.roles.includes("SINDICO") || user.roles.includes("SUBSINDICO")) ? "/sindico" : "/operacional" %>';
    const statusBadge = document.getElementById('status-badge');
    const statusText = document.getElementById('status-text');
    const statusButtons = document.querySelectorAll('.status-action-btn');
    const statusMap = {
      pendente: { text: 'Pendente', classes: ['bg-yellow-100', 'text-yellow-800'] },
      em_andamento: { text: 'Em Andamento', classes: ['bg-blue-100', 'text-blue-800'] },
      concluida: { text: 'Concluída', classes: ['bg-green-100', 'text-green-800'] },
      cancelada: { text: 'Cancelada', classes: ['bg-red-100', 'text-red-800'] },
    };

    statusButtons.forEach((statusButton) => {
      statusButton.addEventListener('click', async function () {
        const nextStatus = this.dataset.status;
        if (!nextStatus) return;
        if (!window.confirm('Confirma a atualização de status desta manutenção?')) return;

        const oldLabel = this.textContent;
        this.disabled = true;
        this.textContent = 'Processando...';
        try {
          const response = await fetch(`${rolePrefix}/manutencoes/<%= manutencao.id %>/status`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ status: nextStatus }),
          });
          const data = await response.json();
          if (!response.ok || !data.success) {
            throw new Error((data && data.error) || 'Falha ao atualizar status');
          }

          if (statusBadge && statusText) {
            statusBadge.classList.remove('bg-yellow-100', 'text-yellow-800', 'bg-blue-100', 'text-blue-800', 'bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
            const visual = statusMap[data.maintenance.status] || statusMap.pendente;
            statusBadge.classList.add(...visual.classes);
            statusText.textContent = visual.text;
          }
          showFeedback(data.message || 'Status atualizado com sucesso.', 'success');
          statusButtons.forEach((btn) => {
            if (btn !== this) btn.disabled = true;
            if (data.maintenance.status === 'concluida' || data.maintenance.status === 'cancelada') {
              btn.classList.add('hidden');
            }
          });
        } catch (error) {
          this.disabled = false;
          this.textContent = oldLabel;
          showFeedback(error.message || 'Erro ao atualizar status.', 'error');
        }
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
