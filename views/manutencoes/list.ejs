<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mx-auto px-4 py-8">
  <!-- Cabeçalho -->
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Manutenções</h1>
      <p class="text-gray-600 mt-2">Gerenciamento de manutenções preventivas e corretivas</p>
    </div>
    <% if (user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'))) { %>
    <a href="/sindico/manutencoes/novo" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
      Nova Manutenção
    </a>
    <% } %>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <form method="GET" class="flex flex-wrap gap-4">
      <select name="status" class="border rounded px-4 py-2">
        <option value="">Todos os status</option>
        <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pendente</option>
        <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>Em Andamento</option>
        <option value="COMPLETED" <%= filters.status === 'COMPLETED' ? 'selected' : '' %>>Concluída</option>
        <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Cancelada</option>
      </select>
      <select name="type" class="border rounded px-4 py-2">
        <option value="">Todos os tipos</option>
        <option value="PREVENTIVA" <%= filters.maintenanceType === 'PREVENTIVA' ? 'selected' : '' %>>Preventiva</option>
        <option value="CORRETIVA" <%= filters.maintenanceType === 'CORRETIVA' ? 'selected' : '' %>>Corretiva</option>
      </select>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
        Filtrar
      </button>
      <a href="/<%= user.roles && user.roles.includes('SINDICO') ? 'sindico' : 'operacional' %>/manutencoes" class="bg-gray-200 text-gray-700 px-6 py-2 rounded hover:bg-gray-300">
        Limpar
      </a>
    </form>
  </div>

  <!-- Lista de manutenções -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Responsável</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data Prevista</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if (manutencoes && manutencoes.length > 0) { %>
          <% manutencoes.forEach(manutencao => { %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= manutencao.title %></div>
                <div class="text-sm text-gray-500"><%= manutencao.description.substring(0, 50) %>...</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs font-semibold rounded-full <%= manutencao.maintenance_type === 'PREVENTIVA' ? 'bg-blue-100 text-blue-800' : 'bg-orange-100 text-orange-800' %>">
                  <%= manutencao.maintenance_type %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% 
                  let statusClass = 'bg-gray-100 text-gray-800';
                  if (manutencao.status === 'PENDING') statusClass = 'bg-yellow-100 text-yellow-800';
                  else if (manutencao.status === 'IN_PROGRESS') statusClass = 'bg-blue-100 text-blue-800';
                  else if (manutencao.status === 'COMPLETED') statusClass = 'bg-green-100 text-green-800';
                  else if (manutencao.status === 'CANCELLED') statusClass = 'bg-red-100 text-red-800';
                %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full <%= statusClass %>">
                  <%= manutencao.status === 'PENDING' ? 'Pendente' : 
                      manutencao.status === 'IN_PROGRESS' ? 'Em Andamento' :
                      manutencao.status === 'COMPLETED' ? 'Concluída' : 'Cancelada' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= manutencao.assigned_to_name || 'Não atribuído' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= manutencao.scheduled_date ? new Date(manutencao.scheduled_date).toLocaleDateString('pt-BR') : '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <a href="/<%= user.roles && user.roles.includes('SINDICO') ? 'sindico' : 'operacional' %>/manutencoes/<%= manutencao.id %>" class="text-blue-600 hover:text-blue-900">Ver</a>
                <% if (user.roles && user.roles.includes('OPERACIONAL') && manutencao.status === 'PENDING' && manutencao.assigned_to === user.id) { %>
                  | <a href="/operacional/manutencoes/<%= manutencao.id %>/iniciar" class="text-green-600 hover:text-green-900" onclick="return confirm('Deseja iniciar esta manutenção?')">Iniciar</a>
                <% } %>
                <% if (user.roles && user.roles.includes('OPERACIONAL') && manutencao.status === 'IN_PROGRESS' && manutencao.assigned_to === user.id) { %>
                  | <a href="/operacional/manutencoes/<%= manutencao.id %>/concluir" class="text-green-600 hover:text-green-900">Concluir</a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
              Nenhuma manutenção encontrada
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
