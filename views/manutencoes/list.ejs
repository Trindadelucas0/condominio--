<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar', { user: user }) %>

<style>
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-in {
    animation: slideIn 0.5s ease-out;
  }
  
  .table-row-animate {
    animation: fadeInUp 0.4s ease-out;
  }
  
  .card-hover-effect {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  
  .status-badge {
    transition: all 0.2s ease;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-indigo-50/30 to-blue-50/30">
  <div class="container mx-auto px-4 py-8">
    <% var helpModalId = 'modalComoFunciona'; %>
    <% var helpTitle = 'Manutenções'; %>
    <% var resumo = ['Lista de manutenções preventivas e corretivas; filtre por status.', 'Síndico pode criar nova manutenção; acompanhe prazos e responsáveis.', 'Abra o detalhe para ver histórico e evidências.']; %>
    <% var helpModalContent = '<p>Gerencie manutenções: veja a lista, filtre por status e abra o detalhe. O síndico pode cadastrar novas manutenções e acompanhar a execução.</p>'; %>
    <!-- Cabeçalho Moderno -->
    <div class="mb-8 animate-slide-in">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center space-x-3">
            <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl p-3 shadow-lg">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 via-indigo-900 to-gray-900 bg-clip-text text-transparent">
                Manutenções
              </h1>
              <p class="text-gray-600 mt-1">Gerenciamento de manutenções preventivas e corretivas</p>
            </div>
          </div>
          <%- include('../partials/help-como-funciona-btn', { helpModalId: helpModalId }) %>
        </div>
        <% if (user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'))) { %>
        <a href="/sindico/manutencoes/novo" class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-blue-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
          <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
          <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span class="relative z-10">Nova Manutenção</span>
        </a>
        <% } %>
      </div>
    </div>
    <%- include('../partials/help-como-funciona', { helpTitle: helpTitle, resumo: resumo, helpModalContent: helpModalContent, helpModalId: helpModalId }) %>
    <div id="maintenance-feedback" class="<%= success || error ? '' : 'hidden' %> mb-4 rounded border px-4 py-3 text-sm <%= error ? 'border-red-300 bg-red-50 text-red-700' : 'border-green-300 bg-green-50 text-green-700' %>">
      <%= error ? decodeURIComponent(error) : (success === 'created' ? 'Manutenção criada com sucesso.' : success === 'updated' ? 'Manutenção atualizada com sucesso.' : success === 'deleted' ? 'Manutenção excluída com sucesso.' : '') %>
    </div>

    <!-- Filtros Modernos -->
    <div class="bg-white rounded-2xl shadow-xl p-6 mb-6 animate-slide-in">
      <form method="GET" class="flex flex-wrap items-end gap-4">
        <div class="flex-1 min-w-[200px]">
          <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Status
          </label>
          <select name="status" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200">
            <option value="">Todos os status</option>
            <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pendente</option>
            <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>Em Andamento</option>
            <option value="COMPLETED" <%= filters.status === 'COMPLETED' ? 'selected' : '' %>>Concluída</option>
            <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Cancelada</option>
          </select>
        </div>
        <div class="flex-1 min-w-[200px]">
          <label class="flex items-center text-sm font-bold text-gray-700 mb-2">
            <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            Tipo
          </label>
          <select name="type" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200">
            <option value="">Todos os tipos</option>
            <option value="PREVENTIVA" <%= filters.maintenanceType === 'PREVENTIVA' ? 'selected' : '' %>>Preventiva</option>
            <option value="CORRETIVA" <%= filters.maintenanceType === 'CORRETIVA' ? 'selected' : '' %>>Corretiva</option>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="group relative overflow-hidden bg-gradient-to-r from-indigo-600 to-blue-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 inline-flex items-center space-x-2">
            <span class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity duration-300"></span>
            <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            <span class="relative z-10">Filtrar</span>
          </button>
          <a href="/<%= user.roles && user.roles.includes('SINDICO') ? 'sindico' : 'operacional' %>/manutencoes" class="px-6 py-3 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 transition-all duration-200 inline-flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Limpar</span>
          </a>
        </div>
      </form>
    </div>

    <!-- Lista de Manutenções -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden animate-slide-in">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gradient-to-r from-indigo-50 to-blue-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Título</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Tipo</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Responsável</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Data Prevista</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if (manutencoes && manutencoes.length > 0) { %>
              <% manutencoes.forEach((manutencao, index) => { %>
                <tr id="maintenance-row-<%= manutencao.id %>" class="table-row-animate card-hover-effect" style="animation-delay: <%= index * 0.05 %>s">
                  <td class="px-6 py-4">
                    <div class="text-sm font-bold text-gray-900"><%= manutencao.title %></div>
                    <div class="text-sm text-gray-500 mt-1"><%= manutencao.description ? (manutencao.description.length > 50 ? manutencao.description.substring(0, 50) + '...' : manutencao.description) : '-' %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= manutencao.maintenance_type === 'PREVENTIVA' ? 'bg-gradient-to-r from-blue-500 to-blue-600 text-white' : 'bg-gradient-to-r from-orange-500 to-amber-600 text-white' %> shadow-md">
                      <%= manutencao.maintenance_type === 'PREVENTIVA' ? 'Preventiva' : 'Corretiva' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% 
                      let statusColor = 'from-gray-400 to-gray-500';
                      let statusText = 'Desconhecido';
                      if (manutencao.status === 'PENDING') {
                        statusColor = 'from-yellow-500 to-amber-500';
                        statusText = 'Pendente';
                      } else if (manutencao.status === 'IN_PROGRESS') {
                        statusColor = 'from-cyan-500 to-blue-500';
                        statusText = 'Em Andamento';
                      } else if (manutencao.status === 'COMPLETED') {
                        statusColor = 'from-green-500 to-emerald-500';
                        statusText = 'Concluída';
                      } else if (manutencao.status === 'CANCELLED') {
                        statusColor = 'from-red-500 to-red-600';
                        statusText = 'Cancelada';
                      }
                    %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r <%= statusColor %> text-white shadow-md status-badge">
                      <span class="w-2 h-2 bg-white rounded-full mr-2"></span>
                      <%= statusText %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center text-sm text-gray-700">
                      <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                      <%= manutencao.assigned_to_name || 'Não atribuído' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center text-sm text-gray-700">
                      <svg class="w-4 h-4 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      <%= manutencao.scheduled_date ? new Date(manutencao.scheduled_date).toLocaleDateString('pt-BR') : '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <div class="flex items-center space-x-3">
                      <a href="/<%= user.roles && user.roles.includes('SINDICO') ? 'sindico' : 'operacional' %>/manutencoes/<%= manutencao.id %>" class="text-indigo-600 hover:text-indigo-800 font-semibold transition-colors inline-flex items-center">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        Ver
                      </a>
                      <% if (user.roles && (user.roles.includes('SINDICO') || user.roles.includes('SUBSINDICO'))) { %>
                        <a href="/sindico/manutencoes/<%= manutencao.id %>/editar" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors inline-flex items-center">
                          Editar
                        </a>
                        <button type="button" class="delete-maintenance-btn text-red-600 hover:text-red-800 font-semibold transition-colors inline-flex items-center" data-id="<%= manutencao.id %>">
                          Excluir
                        </button>
                      <% } %>
                      <% if (user.roles && user.roles.includes('OPERACIONAL') && manutencao.status === 'PENDING' && manutencao.assigned_to === user.id) { %>
                        <form method="POST" action="/operacional/manutencoes/<%= manutencao.id %>/iniciar" class="inline" onsubmit="return confirm('Deseja iniciar esta manutenção?')">
                          <button type="submit" class="text-green-600 hover:text-green-800 font-semibold transition-colors inline-flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Iniciar
                          </button>
                        </form>
                      <% } %>
                      <% if (user.roles && user.roles.includes('OPERACIONAL') && manutencao.status === 'IN_PROGRESS' && manutencao.assigned_to === user.id) { %>
                        <a href="/operacional/manutencoes/<%= manutencao.id %>/concluir" class="text-green-600 hover:text-green-800 font-semibold transition-colors inline-flex items-center">
                          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          Concluir
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center">
                  <div class="flex flex-col items-center">
                    <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-full p-6 w-20 h-20 mb-4 flex items-center justify-center">
                      <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      </svg>
                    </div>
                    <p class="text-lg font-semibold text-gray-700">Nenhuma manutenção encontrada</p>
                    <p class="text-sm text-gray-500 mt-1">Tente ajustar os filtros para encontrar mais resultados</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const feedback = document.getElementById('maintenance-feedback');
    const showFeedback = (message, type) => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = 'mb-4 rounded border px-4 py-3 text-sm';
      if (type === 'error') {
        feedback.classList.add('border-red-300', 'bg-red-50', 'text-red-700');
      } else {
        feedback.classList.add('border-green-300', 'bg-green-50', 'text-green-700');
      }
      feedback.classList.remove('hidden');
    };

    document.querySelectorAll('.delete-maintenance-btn').forEach((button) => {
      button.addEventListener('click', async function () {
        const maintenanceId = this.dataset.id;
        if (!maintenanceId) return;
        if (!window.confirm('Tem certeza que deseja excluir esta manutenção? Esta ação não pode ser desfeita.')) {
          return;
        }

        this.disabled = true;
        const originalText = this.textContent;
        this.textContent = 'Excluindo...';

        try {
          const response = await fetch('/sindico/manutencoes/' + maintenanceId, {
            method: 'DELETE',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
          });
          const data = await response.json();
          if (!response.ok || !data.success) {
            throw new Error((data && data.error) || 'Não foi possível excluir a manutenção.');
          }

          const row = document.getElementById('maintenance-row-' + maintenanceId);
          if (row) row.remove();
          showFeedback(data.message || 'Manutenção excluída com sucesso.', 'success');
        } catch (error) {
          showFeedback(error.message || 'Erro ao excluir manutenção.', 'error');
          this.disabled = false;
          this.textContent = originalText;
        }
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
